macro cfg_cpu=rh850g4kh
[SharedMemory]
	:binDirRelative=../../build/out/shared/
	:outputDirRelative=../../build/obj/shared/

	-G -Omaxdebug
	-nothreshold
	-nochecksum
    
	{ !cfg_build_hello } -I../../../../generic/icumif
	{ cfg_build_hello  } -I../../icumif
	{ !cfg_build_hello } -I../../../../generic/include
	-I../../include
	-I./src

	{optgroup=GhsCompilerOptions} -cpu=${cfg_cpu}

{ !cfg_build_hello } ../../../../generic/src/shared/src/lorem_ipsum.c
{ !cfg_build_hello } ../../../../generic/src/shared/src/shared_data.c
{ cfg_build_hello  } src/shared_data.c
{ cfg_build_hello  } src/lorem_ipsum.c
../startup/shared.startup.850
#src/opbt_tbl.c

## -------------------------------------------------------------------------
## Linker directive file (memory block & section declaration)
## -------------------------------------------------------------------------
{ !cfg_build_hello } ../../config/${target_device}/shared.ld
{ cfg_build_hello  } ../../config/shared.ld
