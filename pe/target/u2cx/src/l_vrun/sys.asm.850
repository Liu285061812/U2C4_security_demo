-- process a big NOP loop to measure the CPU speed

    .text
    .align  4
    .globl  _BENCH_CPU_SPEED
    .type   _BENCH_CPU_SPEED,@function
    
_BENCH_CPU_SPEED:
-- R6:Number of states 
    nop                             -- 1
    nop                             -- 1
    nop                             -- 1
    nop                             -- 1
    add     -10,r6                  -- 1
    nop                             -- 1
    nop                             -- 1
    bz      .BENCH_CPU_SPEED_END    -- 1
    nop                             -- 1
    br      _BENCH_CPU_SPEED        -- 1 
    nop
.BENCH_CPU_SPEED_END:
    jmp     [lp]
   NOP

 
