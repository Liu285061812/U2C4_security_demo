                        9724 --1200: static void test_rsa2048_x509cert_import_id_0(uint8_t skip_verify)
                        9725 --1201: {
                        9726 --1202:     r_icumif_isd_t *p_ISD = (r_icumif_isd_t *)ISD_BUFFER;
                        9727 --1204:     pause_life_signal();
                        9728 --1206:     // initialize the global icum service header
                        9729 --1207:     memset(ISD_BUFFER, 0, SIZE_OF_ISD_BUFFER);  // clear the ISD_BUFFER
                        9730 --1208:     p_ISD = (r_icumif_isd_t *)ISD_BUFFER;
                        9731 --1210:     printf("\nTest with X.509 cert import to index 0 (rsa pkcs#1 2048bit)  (expect a success) ...\n");
                        9732 --1212:     p_ISD->service_id     = SERVICE_03_PK_IMPORT;
                        9733 --1213:     p_ISD->p_callbackfunc = 0;
                        9734 --1214:     p_ISD->job_id         = 0;
                        9735 --1216:     p_ISD->prm.PK_IMPORT.p_x509_certificate             = _2048_rsa_example_cert_der_data;
                        9736 --1217:     p_ISD->prm.PK_IMPORT.x509_certificate_size_in_bytes = _2048_rsa_example_cert_der_data_size;
                        9737 --1218:     p_ISD->prm.PK_IMPORT.key_group                      = KEY_GRP_RSA_PUB;
                        9738 --1219:     p_ISD->prm.PK_IMPORT.key_id                         = 0;
                        9739 --1220:     p_ISD->prm.PK_IMPORT.sig_algo                       = SIGALGO_RSA_PKCS1_V15;
                        9740 --1221:     p_ISD->prm.PK_IMPORT.hash_primitive                 = HASH_PRIMITIVE_SHA2_256;
                        9741 --1222:     p_ISD->prm.PK_IMPORT.sig_key_group                  = KEY_GRP_RSA_PUB;
                        9742 --1223:     p_ISD->prm.PK_IMPORT.sig_key_id                     = 1;
                        9743 --1224:     p_ISD->prm.PK_IMPORT.flags.disable_on_debug         = 0;
                        9744 --1225:     
                        9745 --1226:     p_ISD->prm.PK_IMPORT.skip_verify                    = skip_verify;
                        9746 --1227:     // trigger the security service
                        9747 --1228:     EXEC_SERVICE_WITH_TIMESTAMP(p_ISD);
