                        9865 --1357:     p_ISD->prm.PK_IMPORT.modulus_size_in_bits     = sizeof(rsa2048_x509_signkey_modulus) * 8;
                        9866 --1358:     p_ISD->prm.PK_IMPORT.key_format               = FORMAT_BINARY_PLAIN;
                        9867 --1359:     p_ISD->prm.PK_IMPORT.sig_algo                 = SIGALGO_NONE;
                        9868 --1360:     p_ISD->prm.PK_IMPORT.flags.disable_on_debug   = 0;
                        9869 --1361:     p_ISD->prm.PK_IMPORT.skip_verify              = 0;
