                        9847 --1336: static void test_rsa2048_x509cert_import_setup(void)
                        9848 --1337: {
                        9849 --1338:     r_icumif_isd_t *p_ISD = (r_icumif_isd_t *)ISD_BUFFER;
                        9850 --1340:     // initialize the global icum service header
                        9851 --1341:     memset(ISD_BUFFER, 0, SIZE_OF_ISD_BUFFER);  // clear the ISD_BUFFER
                        9852 --1342:     p_ISD = (r_icumif_isd_t *)ISD_BUFFER;
                        9853 --1344:     printf("\nSetup x509cert_import_with_verify(RSA key pair(2048bit) import index #0)...\n\n");
                        9854 --1346:     p_ISD->service_id     = SERVICE_03_PK_IMPORT;
                        9855 --1347:     p_ISD->p_callbackfunc = 0;
                        9856 --1348:     p_ISD->job_id         = 0;
                        9857 --1349:     
                        9858 --1350:     p_ISD->prm.PK_IMPORT.key_group                = KEY_GRP_RSA_PUB;
                        9859 --1351:     p_ISD->prm.PK_IMPORT.key_id                   = 0;
                        9860 --1352:     p_ISD->prm.PK_IMPORT.p_priv_exp               = rsa2048_x509_signkey_priv_exponent;
                        9861 --1353:     p_ISD->prm.PK_IMPORT.p_pub_exp                = rsa2048_x509_signkey_pub_exponent;
