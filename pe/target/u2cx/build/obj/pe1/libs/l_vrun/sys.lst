                         600 --30: #pragma ghs reference sys_get_package_info
                         601 --32: // ************************************************************************************************************************
                         602 --33: // very simple system services for minimal "hello word" type of application
                         603 --34: // ************************************************************************************************************************
                         604 --35: /*
                         605 --37:     - RH850/U2B resource mapping:
                         606 --38:         - VUART0    -> RLIN30
                         607 --39:                        RLIN30TX -> P22.11 -> connecting to UART0TX on main board
                         608 --40:                        RLIN30RX -> P22.12 -> connecting to UART0RX on main board
                         609 --42:         - VPORT0    -> P21.5  -> connecting to LED7  on main board (CN1 DIGIO_3)
                         610 --43:         - VPORT1    -> P21.4  -> connecting to LED8  on main board (CN1 DIGIO_2)
                         611 --44:         - VPORT2    -> P21.3  -> connecting to LED9  on main board (CN1 DIGIO_1)
                         612 --45:         - VPORT3    -> P21.2  -> connecting to LED10 on main board (CN1 DIGIO_0)
                         613 --47:         - VTIMER0   -> OSTIM 0 
                         614 --48:         - VTIMER1   -> OSTIM 1
                         615 --50: */
                         616 --52: // ************************************************************************************************************************
                         617 --53: // NOTE !  The UART management is in a separate file
                         618 --54: //         The reason being to remove this object (and reference to global vars) if the COM is not used

                                                                      Page 12
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rt01.si
                         619 --55: // ************************************************************************************************************************
                         620 --57: #include DEVICE_FILE
                         621 --59: #include "v850.toolbox.h"
                         622 --61: #include "sys.config.h"
                         623 --62: #include "sys.api.h"
                         624 --63: #include <stdint.h>
                         625 --64: #include "u2c4_clock.h"
                         626 --66: #if (SYS_QUARTZ_FREQ != 20000000)
                         627 --67:     #error INCORRECT FREQUENCY
                         628 --68: #endif
                         629 --70: // ------------------------------------------------------------
                         630 --71: // local macros
                         631 --72: // ------------------------------------------------------------
                         632 --74: #define PASTER(x, y)        x ## y
                         633 --75: #define EVALUATOR(x, y)     PASTER(x, y)
                         634 --77: // defines the interrupt vectors for timers
                         635 --78: #define INT_VTIMER0     EIINT63
                         636 --79: #define INT_VTIMER1     EIINT484
                         637 --81: #define protected_write(N, reg, value) \
                         638 --82:     do{\
                         639 --83:           (EVALUATOR(PROTCMD, N))=0xa5u; (reg)=(value); (reg)=~(value); (reg)=(value);\
                         640 --84:     }while((EVALUATOR(PROTS, N))==1u)
                         641 --86: // ------------------------------------------------------------
                         642 --87: // local defines
                         643 --88: // ------------------------------------------------------------
                         644 --90: // defines the port mode control registers
                         645 --91: #define VPORT0_MODECTL  (PORT0PMC21_5)
                         646 --92: #define VPORT1_MODECTL  (PORT0PMC21_4)
                         647 --93: #define VPORT2_MODECTL  (PORT0PMC21_3)
                         648 --94: #define VPORT3_MODECTL  (PORT0PMC21_2)
                         649 --96: // defines the port mode registers
                         650 --97: #define VPORT0_MODE     (PORT0PM21_5)
                         651 --98: #define VPORT1_MODE     (PORT0PM21_4)
                         652 --99: #define VPORT2_MODE     (PORT0PM21_3)
                         653 --100: #define VPORT3_MODE     (PORT0PM21_2)
                         654 --102: #define VPORT0_SET(LEVLE)   (PORT0PSR21 = ((1<<5U) << 16U) | (LEVLE<<5U))
                         655 --103: #define VPORT1_SET(LEVLE)   (PORT0PSR21 = ((1<<4U) << 16U) | (LEVLE<<4U))
                         656 --104: #define VPORT2_SET(LEVLE)   (PORT0PSR21 = ((1<<3U) << 16U) | (LEVLE<<3U))
                         657 --105: #define VPORT3_SET(LEVLE)   (PORT0PSR21 = ((1<<2U) << 16U) | (LEVLE<<2U))
                         658 --107: // CLK_HSB value
                         659 --108: #define CLK_HSB 80U
