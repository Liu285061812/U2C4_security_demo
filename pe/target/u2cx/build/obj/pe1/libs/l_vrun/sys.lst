                        1199 --551:         while (0U < wait_cnt)
                        1200 --552:         {
                        1201 --553:             wait_cnt--;
                        1202 --554:         }
                        1203 --556:         /* Division ratio of clock source PLL is changed from 1/1 to 3/8(800/640MHz) or 4/8(480MHz). */
                        1204 --557:         CLKD_PLLC.bit.PLLCLKDCSID = clkd_val;
                        1205 --559:         /* Division ratio of clock source SSCG is changed from 1/1 to 3/8(800/640MHz) or 4/8(480MHz). */
                        1206 --560:         CKD_SSCGC.bit.SSCGCLKDCSID = clkd_val;
                        1207 --562:         /* Wait for the Divider clock synchronized. */
                        1208 --563:         while ((1U != CLKD_PLLS.bit.PLLCLKDSYNC)  &&
                        1209 --564:                (1U != CKD_SSCGS.bit.SSCGCLKDSYNC)   );
                        1210 --566:         /* The clock source for the System clock is changed from CLK_IOSC to CLK_PLLO. */
                        1211 --567:         CKSC_CPUC.bit.CPUCLKSCSID = 0U;
                        1212 --569:         /* The clock source for the System clock is changed from CLK_IOSC to CLK_SYS_SSCG. */
                        1213 --570:         CKS_SSCGC.bit.SYSCLKSCSID = 0U;
                        1214 --572:         /* Wait for the System clock is changed. */
                        1215 --573:         while ((0U != CKSC_CPUS.bit.CPUCLKSACT) &&
                        1216 --574:                (0U != CKS_SSCGS.bit.SYSCLKSACT)   );
                        1217 --576:         /* Wait 100us after verifying. */
                        1218 --577:         wait_cnt = 20000U;
                        1219 --578:         while (0U < wait_cnt)
                        1220 --579:         {
                        1221 --580:             wait_cnt--;
                        1222 --581:         }

                                                                      Page 22
