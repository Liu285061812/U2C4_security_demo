                        1223 --583:         /* Division retio of clock source PLL/SSCGi is changed.        */
                        1224 --584:         /* 4/8(1st)->5/8(2nd)->6/8(3rt)->7/8(4th)->1(5th) (800/640MHz) */
                        1225 --585:         /* 5/8(1st)->6/8(2nd)->7/8(3rd)->1(4th)           (480MHz)     */
                        1226 --586:         for (i = 0U; i < clkd_loop_cnt; i++)
                        1227 --587:         {
                        1228 --589:             if (clkd_val < 14U)
                        1229 --590:             {
                        1230 --591:                 clkd_val+=2;
                        1231 --592:             } else {
                        1232 --593:                 clkd_val = 0;
                        1233 --594:             }
                        1234 --596:             /* Division ratio of clock source PLL is changed  */
                        1235 --597:             CLKD_PLLC.bit.PLLCLKDCSID = clkd_val;
                        1236 --599:             /* Division ratio of clock source SSCG is changed  */
                        1237 --600:             CKD_SSCGC.bit.SSCGCLKDCSID = clkd_val;
                        1238 --602:             /* Wait for the Divider clock synchronized. */
                        1239 --603:             while ((1U != CLKD_PLLS.bit.PLLCLKDSYNC) && (1U != CKD_SSCGS.bit.SSCGCLKDSYNC)) ;
                        1240 --604:         }
                        1241 --606:         /* Wait 100us after verifying. */
                        1242 --607:         wait_cnt = 40000U;
                        1243 --608:         while (0U < wait_cnt)
