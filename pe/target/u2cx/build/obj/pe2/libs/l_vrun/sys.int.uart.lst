                         368 --222: /*
                         369 --223:  [Overview]\n
                         370 --224:  reads one byte from the VUART
                         371 --226:  [Description]\n
                         372 --227:  Check the UART status, and if there is received data, extract 1-byte of data
                         373 --228:  from it and return it as a return value.\n
                         374 --229:  If there is no received data, 0xFF is returned as a return value.
                         375 --231:  [Parameters]\n
                         376 --232:  None
                         377 --234:  [Return value]\n
                         378 --235:  0xFF           - No received data\n
                         379 --236:  Other values   - Extracted 1-byte data
                         380 --238:  [Used registers]\n

                                                                      Page 8
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00011641.si
                         381 --239:  SCI31SSR, SCI31RDRL
                         382 --240: */
