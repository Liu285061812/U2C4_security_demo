                         423 --246: /**
                         424 --247: [Overview]\n
                         425 --248:  sends one byte via the VUART
                         426 --250:  [Description]\n
                         427 --251:  Monitor the UART status and wait for the transmittable status (transmission data
                         428 --252:  register is empty).
                         429 --253:  Send 1-byte data when it is ready to be sent.
                         430 --255:  [Parameters]\n
                         431 --256:  1-byte data to send
                         432 --258:  [Return value]\n
                         433 --259:  None
                         434 --261:  [Used registers]\n
                         435 --262:  SCI31SSR, SCI31TDRL
                         436 --264:  [Remarks]\n
                         437 --265:  In this implementation, the loop that monitors the transmittable status may
                         438 --266:  become an endless loop. When using it as a customer, take measures such as timeout.
                         439 --267: */
