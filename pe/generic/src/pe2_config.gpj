[Merged Library]

    :binDirRelative=../${pe_relative}${target_folder}/build/out/pe2/

    -DD_PEID=${cfg_peid}

    -o libpe2.a

pe2/pe2_lib.gpj             [Merged Library]
icumif_lib/icumif_lib.gpj   [Merged Library]
{ cfg_build_hello  } comm_drv/d_comm_pe.gpj         [Merged Library]
{ !cfg_build_hello } ../${pe_relative}${target_folder}/src/driver/comm_drv/d_comm_pe.gpj    [Merged Library]
{ cfg_build_hello  } l_vrun/l_vrun_hello.gpj        [Merged Library]
{ !cfg_build_hello } l_vrun/l_vrun.gpj              [Merged Library]
