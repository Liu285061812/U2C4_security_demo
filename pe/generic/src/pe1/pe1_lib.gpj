#!gbuild

[Merged Library]

    -I../../include/device
    -I../../include/common
    -I../../icumif
    -I../l_vrun/l_vrun_cmd
    -I../../../target/${cfg_family}/include
    -I../../../target/${cfg_family}/src/driver/comm_drv
    -I../../../target/${cfg_family}/src/shared/src
    -I../../../target/${cfg_family}/src/l_vrun
    -I../shared/src
    -I../../include
    -D_TARG_=${cfg_target}
    -DPE1_TEST_AES_KEY_SETUP=${cfg_pe_test_aes_key_setup}
    -DPE1_TEST_AES_CIPHER=${cfg_pe_test_aes_cipher}
    -DPE1_TEST_AES_AUTH=${cfg_pe_test_aes_auth}
    -DPE1_TEST_AES_CMAC=${cfg_pe_test_aes_cmac}
    -DPE1_TEST_RSA_KEY_GENERATE=${cfg_pe_test_rsa_key_generate}
    -DPE1_TEST_RSA_CRYPT=${cfg_pe_test_rsa_crypt}
    -DPE1_TEST_RSA_SIGNATURE=${cfg_pe_test_rsa_signature}

    -o pe1.a

src/debug_sub.c
src/vrun.cmd.c
src/vrun.main.c
src/pe1.c
src/pe1_flash.c
# The categorized menu uses ICUM RAM keys; legacy key-management/GC tests are excluded.
src/pe1_crypto_service_test.c
../../../target/${cfg_family}/src/driver/aceu/aceu.c
src/pe1_aceu_test.c
src/pe1_test_utility.c
src/prepare_mem_check.c
src/OctetStringLib.c
