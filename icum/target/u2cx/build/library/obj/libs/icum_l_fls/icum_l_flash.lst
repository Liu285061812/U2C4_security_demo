                         135 --109: *                 offset
                         136 --110: *                  Byte offset position of the area to be read.
                         137 --111: *                   (offset specification is specified from the beginning of the
                         138 --112: *                    bank when bank specification is valid)
                         139 --113: *                 data_size_in_bytes
                         140 --114: *                  read size.(in 4-byte units)
                         141 --115: *                 p_data
                         142 --116: *                  read data buffer.(4byte boundary)
                         143 --117: * Return Value  :   ER_OK
                         144 --118: *                   ER_L_FLS_FLOW 
                         145 --119: *                   ER_PARAM
                         146 --120: *                   ER_L_FLS_ECC1EDF1
                         147 --121: *                   ER_L_FLS_ECC2EDF1 
                         148 --122: ********************************************************************************/
                         149 --123: uint32_t L_FLS_ReadFlash_ram(const uint32_t target_area, const uint32_t bank, const uint32_t offset,
                         150 --124:                              const uint32_t data_size_in_bytes, uint8_t *p_data)
                         151 --125: {
                         152 --126:     uint32_t lul_fls_status;
                         153 --127:     uint32_t lul_raddr;
                         154 --129:     lul_raddr = L_FLS_ZERO_U32;
                         155 --130:     /* status check */
                         156 --131:     lul_fls_status = D_FLS_CheckStatus_ram();
                         157 --132:     if (ER_D_FLS_UNAVAILABLE == lul_fls_status)
                         158 --133:     {
                         159 --134:         /* FLS non-initialize */
                         160 --135:         lul_fls_status = ER_L_FLS_FLOW;
                         161 --136:     }
                         162 --137:     else if (NULL == p_data)
                         163 --138:     {
                         164 --139:         /* null pointer */
                         165 --140:         lul_fls_status = ER_PARAM;
                         166 --141:     }
                         167 --142:     /* not 4byte align ? */
                         168 --143:     else if (L_FLS_ZERO_U32 != ((uint32_t)p_data % sizeof(uint32_t)))
                         169 --144:     {
                         170 --145:         /* Not 4 byte boundary */
                         171 --146:         lul_fls_status = ER_PARAM;
                         172 --147:     }

                                                                      Page 4
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000sr01.si
                         173 --148:     /* not 4byte align ? */
                         174 --149:     else if (0UL != (offset % sizeof(uint32_t)))
                         175 --150:     {
                         176 --151:         /* Not 4 byte boundary */
                         177 --152:         lul_fls_status = ER_PARAM;
                         178 --153:     }
                         179 --154:     else if (0UL != (data_size_in_bytes % sizeof(uint32_t)))
                         180 --155:     {
                         181 --156:         /* Not 4 byte boundary */
                         182 --157:         lul_fls_status = ER_PARAM;
                         183 --158:     }
                         184 --159:     else
                         185 --160:     {
                         186 --161:         /* Address check */
                         187 --162:         lul_fls_status = D_FLS_CheckAddr_ram(target_area, bank, offset, data_size_in_bytes, &lul_raddr);
                         188 --163:         if (ER_OK != lul_fls_status)
                         189 --164:         {
                         190 --165:             /* Address error */
                         191 --166:         }
                         192 --167:         else
                         193 --168:         {
                         194 --169:             lul_fls_status = ER_OK;
                         195 --170:             /* code flash */
                         196 --171:             switch (target_area)
                         197 --172:             {
                         198 --173:                 case AG_L_FLS_CODE:
                         199 --174:                     /* do nothing */
                         200 --175:                     break;
                         201 --176:                 case AG_L_FLS_DATA:
                         202 --177:                     /* clear ecc error */
                         203 --178:                     (void)D_FLS_CheckECC_ram(AG_D_FLS_CLR);
                         204 --179:                     break;
                         205 --180:                 case AG_L_FLS_SECURITY:
                         206 --181:                     /* do nothing */
                         207 --182:                     break;
                         208 --183:                 default:
                         209 --184:                     /* Parameter error */
                         210 --185:                     lul_fls_status = ER_PARAM;
                         211 --186:                     break;
                         212 --187:             }
                         213 --188:         }
                         214 --189:     }
                         215 --191:     if (ER_OK != lul_fls_status)
                         216 --192:     {
                         217 --193:         /* do nothing */
                         218 --194:     }
                         219 --195:     else
                         220 --196:     {
                         221 --197:         /* clear request of flash mode change */
                         222 --198:         (void)l_FLS_SetDfProgReq_ram(AG_L_FLS_DF_PE_CLR);
                         223 --199:         /* data read */
                         224 --200:         l_FLS_ReadData_ram(lul_raddr, data_size_in_bytes, p_data);
                         225 --201:         /* Check data flash ecc error */
                         226 --202:         if (AG_L_FLS_DATA == target_area)
                         227 --203:         {
                         228 --204:             lul_fls_status = D_FLS_CheckECC_ram(AG_D_FLS_CLR);
                         229 --205:         }
                         230 --206:         else
                         231 --207:         {
                         232 --208:             /* do nothing */
                         233 --209:         }

                                                                      Page 5
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000sr01.si
                         234 --210:     }
                         235 --212:     /* convert driver error code to library error code. */
                         236 --213:     lul_fls_status = l_FLS_ChangeErrCode_ram(lul_fls_status);
                         237 --215:     return (lul_fls_status);
                         238 --216: }
