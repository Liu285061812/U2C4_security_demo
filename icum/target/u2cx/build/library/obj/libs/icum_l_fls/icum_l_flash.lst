                         386 --372: uint32_t L_FLS_REQ_WriteFlash_ram(const uint32_t target_area, const uint32_t bank, const uint32_t offset,
                         387 --373:                                   const uint32_t data_size_in_bytes, const uint8_t *p_data)
                         388 --374: {
                         389 --375:     uint32_t lul_fls_status;
                         390 --376:     uint32_t lul_flash_addr;
                         391 --377:     uint32_t lul_write_size;
                         392 --379:     lul_flash_addr = L_FLS_ZERO_U32;
                         393 --380:     /* Bus guard cancel & Write protect cancel */
                         394 --381:     D_FLS_PrgPrepareOperation_ram();
                         395 --383:     /* status check */
                         396 --384:     lul_fls_status = D_FLS_CheckStatus_ram();
                         397 --385:     if (ER_D_FLS_UNAVAILABLE == lul_fls_status)
                         398 --386:     {
                         399 --387:         /* FLS non-initialize */
                         400 --388:         lul_fls_status = ER_L_FLS_FLOW;
                         401 --389:     }
                         402 --390:     else if (NULL == p_data)
                         403 --391:     {
                         404 --392:         /* null pointer */
                         405 --393:         lul_fls_status = ER_PARAM;
                         406 --394:     }
                         407 --395:     /* not 4byte align ? */
                         408 --396:     else if (0UL != ((uint32_t)p_data % sizeof(uint32_t)))
                         409 --397:     {
                         410 --398:         /* Not 4 byte boundary */
                         411 --399:         lul_fls_status = ER_PARAM;
                         412 --400:     }
                         413 --401:     /* not 4byte align ? */
                         414 --402:     else if (0UL != (offset % sizeof(uint32_t)))
                         415 --403:     {
                         416 --404:         /* Not 4 byte boundary */

                                                                      Page 8
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000sr01.si
                         417 --405:         lul_fls_status = ER_PARAM;
                         418 --406:     }
                         419 --407:     else if (data_size_in_bytes == 0UL)
                         420 --408:     {
                         421 --409:         /* Invalid data size */
                         422 --410:     }
                         423 --411:     /* data size is 4 byte unit ? */
                         424 --412:     else if (0UL != (data_size_in_bytes % sizeof(uint32_t)))
                         425 --413:     {
                         426 --414:         /* Not 4 byte boundary */
                         427 --415:         lul_fls_status = ER_PARAM;
                         428 --416:     }
                         429 --417:     else
                         430 --418:     {
                         431 --419:         /* Address check */
                         432 --420:         lul_fls_status = D_FLS_CheckAddr_ram(target_area, bank, offset, data_size_in_bytes, &lul_flash_addr);
                         433 --421:     }
                         434 --423:     if (ER_OK != lul_fls_status)
                         435 --424:     {
                         436 --425:         /* Do nothing */
                         437 --426:     }
                         438 --427:     /* code flash */
                         439 --428:     else if (target_area == AG_L_FLS_CODE)
                         440 --429:     {
                         441 --430:         (void)D_FLS_GetCfProgramWriteSize_ram(lul_flash_addr, &lul_write_size);
                         442 --431:         /* Flash address is 512 byte boundary ? */
                         443 --432:         if (0UL != (lul_flash_addr % lul_write_size))
                         444 --433:         {
                         445 --434:             /* align error */
                         446 --435:             lul_fls_status = ER_PARAM;
                         447 --436:         }
                         448 --437:         else
                         449 --438:         {
                         450 --439:             /* FlashDrv call */
                         451 --440:             lul_fls_status = D_FLS_ProgramCf_ram(lul_flash_addr, p_data, data_size_in_bytes);
                         452 --441:         }
                         453 --442:     }
                         454 --443:     /* data flash */
                         455 --444:     else if (target_area == AG_L_FLS_DATA)
                         456 --445:     {
                         457 --446:         (void)D_FLS_GetDfProgramWriteSize(lul_flash_addr, &lul_write_size);
                         458 --447:         /* Flash address is 4 byte boundary ? */
                         459 --448:         if (0UL != (lul_flash_addr % lul_write_size))
                         460 --449:         {
                         461 --450:             /* align error */
                         462 --451:             lul_fls_status = ER_PARAM;
                         463 --452:         }
                         464 --453:         else
                         465 --454:         {
                         466 --455:             /* FlashDrv call */
                         467 --456:             lul_fls_status = D_FLS_ProgramDf(lul_flash_addr, p_data, data_size_in_bytes);
                         468 --457:         }
                         469 --458:     }
                         470 --459:     else
                         471 --460:     {
                         472 --461:         lul_fls_status = ER_PARAM;
                         473 --462:     }
                         474 --464:     if (lul_fls_status != ER_IN_PROCESS)
                         475 --465:     {
                         476 --466:         /* Bus guard set & Write protect set */
                         477 --467:         D_FLS_PrgDisposeOperation_ram();

                                                                      Page 9
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000sr01.si
                         478 --468:     }
                         479 --469:     else
                         480 --470:     {
                         481 --471:         /* do nothing */
                         482 --472:     }
                         483 --474:     /* convert driver error code to library error code. */
                         484 --475:     lul_fls_status = l_FLS_ChangeErrCode_ram(lul_fls_status);
                         485 --477:     return (lul_fls_status);
                         486 --478: }
