                         506 --499: uint32_t L_FLS_REQ_WriteSecurity_ram(const uint32_t target_info, const uint32_t set_data)
                         507 --500: {
                         508 --501:     uint32_t lul_fls_status;
                         509 --502:     uint32_t lul_flash_addr;
                         510 --503:     uint32_t lul_write_size;
                         511 --504:     uint8_t  luc_prog_req;
                         512 --505:     uint32_t lul_start_block_addr;
                         513 --506:     /* UpdateSecurity buffer area 32byte */
                         514 --507:     uint32_t lul_cfg_data_area[L_FLS_CFGBUFF_NUM];
                         515 --509:     /* Bus guard cancel & Write protect cancel */
                         516 --510:     D_FLS_PrgPrepareOperation_ram();
                         517 --512:     /* status check */
                         518 --513:     lul_fls_status = D_FLS_CheckStatus_ram();
                         519 --514:     if (ER_D_FLS_UNAVAILABLE == lul_fls_status)
                         520 --515:     {
                         521 --516:         /* FLS non-initialize */
                         522 --517:         lul_fls_status = ER_L_FLS_FLOW;
                         523 --518:     }
                         524 --519:     else
                         525 --520:     {
                         526 --521:         /* Get target address */
                         527 --522:         lul_fls_status = D_FLS_GetOPBTAddress(target_info, &lul_flash_addr);
                         528 --523:     }
                         529 --525:     if (ER_OK != lul_fls_status)
                         530 --526:     {
                         531 --527:         /* do nothing */
                         532 --528:     }
                         533 --529:     else
                         534 --530:     {
                         535 --531:         /* write block calc */
                         536 --532:         (void)D_FLS_GetWriteSizeSec(lul_flash_addr, &lul_write_size);
                         537 --533:         lul_start_block_addr = lul_flash_addr & ~(lul_write_size - 1UL);
                         538 --535:         /* clear request of flash mode change */

                                                                      Page 10
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000sr01.si
                         539 --536:         (void)l_FLS_SetDfProgReq_ram(AG_L_FLS_DF_PE_CLR);
                         540 --538:         /* data read */
                         541 --539:         l_FLS_ReadData_ram(lul_start_block_addr, lul_write_size, (uint8_t *)lul_cfg_data_area);
                         542 --540:         /* request of flash mode change for CPU(PE)? */
                         543 --541:         (void)l_FLS_GetDfProgReq_ram(&luc_prog_req);
                         544 --542:     }
                         545 --544:     if (ER_OK != lul_fls_status)
                         546 --545:     {
                         547 --546:         /* do nothing */
                         548 --547:     }
                         549 --548:     else if ((uint32_t)AG_L_FLS_DF_PE_SET == (uint32_t)luc_prog_req)
                         550 --549:     {
                         551 --550:         lul_fls_status = ER_L_FLS_PROGRAM;
                         552 --551:     }
                         553 --552:     else
                         554 --553:     {
                         555 --554:         /* write data set */
                         556 --555:         lul_fls_status = l_FLS_SetWriteSecurityData_ram(
                         557 --556:             target_info, set_data, &lul_cfg_data_area[((lul_flash_addr - lul_start_block_addr) / L_FLS_ALIGN_SIZE)]);
                         558 --557:     }
                         559 --559:     if (ER_OK == lul_fls_status)
                         560 --560:     {
                         561 --561:         /* FlashDrv call */
                         562 --562:         lul_fls_status = D_FLS_UpdateSecurity(lul_start_block_addr, (const uint8_t *)lul_cfg_data_area, lul_write_size);
                         563 --563:     }
                         564 --564:     else
                         565 --565:     {
                         566 --566:         /* do nothing */
                         567 --567:     }
                         568 --569:     if ((uint32_t)ER_IN_PROCESS != lul_fls_status)
                         569 --570:     {
                         570 --571:         /* Bus guard set & Write protect set */
                         571 --572:         D_FLS_PrgDisposeOperation_ram();
                         572 --573:     }
                         573 --574:     else
                         574 --575:     {
                         575 --576:         /* do nothing */
                         576 --577:     }
                         577 --579:     /* convert driver error code to library error code. */
                         578 --580:     lul_fls_status = l_FLS_ChangeErrCode_ram(lul_fls_status);
                         579 --582:     return (lul_fls_status);
                         580 --583: }
