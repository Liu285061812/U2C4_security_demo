                        4791 --925: /*******************************************************************************
                        4792 --926: * Function ID   : [ICUMFW_CD_L_FLS_0031]:[ICUMFW_UD_L_FLS_0031]
                        4793 --927: * Function Name : l_FLS_ReadData_ram
                        4794 --928: * Description   : Read to the flash area.
                        4795 --929: * Arguments     : target_addr
                        4796 --930: *                  Byte offset position of the area to be read.
                        4797 --931: *                   (offset specification is specified from the beginning of the
                        4798 --932: *                    bank when bank specification is valid)
                        4799 --933: *                 data_size_in_bytes
                        4800 --934: *                  read size.(in 4-byte units)
                        4801 --935: *                 p_data
                        4802 --936: *                  read data buffer.(4byte boundary)
                        4803 --937: * Return Value  : none
                        4804 --938: ********************************************************************************/
                        4805 --939: static void l_FLS_ReadData_ram(const uint32_t target_addr, const uint32_t data_size_in_bytes, uint8_t *p_data)
                        4806 --940: {
                        4807 --941:     volatile uint32_t *p_lp_raddr;
                        4808 --942:     volatile uint32_t *p_lp_rdata;
                        4809 --943:     uint32_t           lul_index;
                        4810 --945:     p_lp_raddr = (volatile uint32_t *)target_addr;
                        4811 --946:     p_lp_rdata = (volatile uint32_t *)p_data;
                        4812 --947:     /* data read */
                        4813 --948:     for (lul_index = 0UL; lul_index < data_size_in_bytes; lul_index += L_FLS_ALIGN_SIZE)
                        4814 --949:     {
                        4815 --950:         *p_lp_rdata = *p_lp_raddr;
                        4816 --951:         p_lp_rdata++;
                        4817 --952:         p_lp_raddr++;
                        4818 --953:     }
                        4819 --954:     return;
                        4820 --955: }
                        4821 --957: /*******************************************************************************
