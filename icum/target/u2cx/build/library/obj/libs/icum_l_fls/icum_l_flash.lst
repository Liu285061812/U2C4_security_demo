                        4903 --1041:         case ER_L_FLS_FLOW:
                        4904 --1042:         case ER_L_FLS_PROTECTION:
                        4905 --1043:         case ER_L_FLS_REJECTED:
                        4906 --1044:         case ER_L_FLS_PROGRAM:
