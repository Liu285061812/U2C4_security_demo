                        3142 --497: *                   ER_L_FLS_FACI_TIME_OUT
                        3143 --498: *******************************************************************************************/
                        3144 --499: uint32_t L_FLS_REQ_WriteSecurity_ram(const uint32_t target_info, const uint32_t set_data)
                        3145 --500: {
                        3146 --501:     uint32_t lul_fls_status;
                        3147 --502:     uint32_t lul_flash_addr;
                        3148 --503:     uint32_t lul_write_size;
                        3149 --504:     uint8_t  luc_prog_req;
                        3150 --505:     uint32_t lul_start_block_addr;
                        3151 --506:     /* UpdateSecurity buffer area 32byte */
                        3152 --507:     uint32_t lul_cfg_data_area[L_FLS_CFGBUFF_NUM];
                        3153 --509:     /* Bus guard cancel & Write protect cancel */
                        3154 --510:     D_FLS_PrgPrepareOperation_ram();
                        3155 --512:     /* status check */
                        3156 --513:     lul_fls_status = D_FLS_CheckStatus_ram();
                        3157 --514:     if (ER_D_FLS_UNAVAILABLE == lul_fls_status)
                        3158 --515:     {
                        3159 --516:         /* FLS non-initialize */
                        3160 --517:         lul_fls_status = ER_L_FLS_FLOW;
                        3161 --518:     }
                        3162 --519:     else
                        3163 --520:     {
                        3164 --521:         /* Get target address */
                        3165 --522:         lul_fls_status = D_FLS_GetOPBTAddress(target_info, &lul_flash_addr);
                        3166 --523:     }
                        3167 --525:     if (ER_OK != lul_fls_status)
                        3168 --526:     {
                        3169 --527:         /* do nothing */
                        3170 --528:     }
                        3171 --529:     else
                        3172 --530:     {
                        3173 --531:         /* write block calc */
                        3174 --532:         (void)D_FLS_GetWriteSizeSec(lul_flash_addr, &lul_write_size);
                        3175 --533:         lul_start_block_addr = lul_flash_addr & ~(lul_write_size - 1UL);
                        3176 --535:         /* clear request of flash mode change */
                        3177 --536:         (void)l_FLS_SetDfProgReq_ram(AG_L_FLS_DF_PE_CLR);
                        3178 --538:         /* data read */
                        3179 --539:         l_FLS_ReadData_ram(lul_start_block_addr, lul_write_size, (uint8_t *)lul_cfg_data_area);
                        3180 --540:         /* request of flash mode change for CPU(PE)? */
                        3181 --541:         (void)l_FLS_GetDfProgReq_ram(&luc_prog_req);
                        3182 --542:     }
                        3183 --544:     if (ER_OK != lul_fls_status)
                        3184 --545:     {
                        3185 --546:         /* do nothing */
                        3186 --547:     }
                        3187 --548:     else if ((uint32_t)AG_L_FLS_DF_PE_SET == (uint32_t)luc_prog_req)
                        3188 --549:     {
                        3189 --550:         lul_fls_status = ER_L_FLS_PROGRAM;
                        3190 --551:     }
                        3191 --552:     else
                        3192 --553:     {
                        3193 --554:         /* write data set */
                        3194 --555:         lul_fls_status = l_FLS_SetWriteSecurityData_ram(
                        3195 --556:             target_info, set_data, &lul_cfg_data_area[((lul_flash_addr - lul_start_block_addr) / L_FLS_ALIGN_SIZE)]);
                        3196 --557:     }
                        3197 --559:     if (ER_OK == lul_fls_status)
                        3198 --560:     {
                        3199 --561:         /* FlashDrv call */
                        3200 --562:         lul_fls_status = D_FLS_UpdateSecurity(lul_start_block_addr, (const uint8_t *)lul_cfg_data_area, lul_write_size);
                        3201 --563:     }
                        3202 --564:     else

                                                                      Page 55
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000sr01.si
                        3203 --565:     {
                        3204 --566:         /* do nothing */
                        3205 --567:     }
                        3206 --569:     if ((uint32_t)ER_IN_PROCESS != lul_fls_status)
                        3207 --570:     {
                        3208 --571:         /* Bus guard set & Write protect set */
                        3209 --572:         D_FLS_PrgDisposeOperation_ram();
                        3210 --573:     }
                        3211 --574:     else
                        3212 --575:     {
                        3213 --576:         /* do nothing */
                        3214 --577:     }
                        3215 --579:     /* convert driver error code to library error code. */
                        3216 --580:     lul_fls_status = l_FLS_ChangeErrCode_ram(lul_fls_status);
                        3217 --582:     return (lul_fls_status);
                        3218 --583: }
                        3219 --585: /*************************************************************************************************
                        3220 --586: * Function ID   : [ICUMFW_CD_L_FLS_0007]:[ICUMFW_UD_L_FLS_0007]
                        3221 --587: * Function Name : L_FLS_IsFinished_ram
                        3222 --588: * Description   : Proceed with this FACI command operation(REQ) by FLS and confirm the completion.
                        3223 --589: * Arguments     : context_id
                        3224 --590: *                  flash context id
