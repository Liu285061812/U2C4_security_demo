                        3266 --635: ********************************************************************************************/
                        3267 --636: uint32_t L_FLS_REQ_Cancel_ram(const uint32_t target_area, const uint32_t bank)
                        3268 --637: {
                        3269 --638:     uint32_t lul_fls_status;
                        3270 --640:     /* status check */
                        3271 --641:     lul_fls_status = D_FLS_CheckStatus_ram();
                        3272 --642:     if (ER_D_FLS_UNAVAILABLE == lul_fls_status)
                        3273 --643:     {
