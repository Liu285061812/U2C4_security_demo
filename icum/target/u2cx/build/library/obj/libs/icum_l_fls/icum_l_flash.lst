                        3232 --598: *                   ER_L_FLS_PROTECTION
                        3233 --599: *                   ER_L_FLS_REJECTED
                        3234 --600: *                   ER_L_FLS_PROGRAM
                        3235 --601: *                   ER_L_FLS_INTERNAL 
                        3236 --602: *                   ER_L_FLS_UNAVAILABLE
                        3237 --603: *                   ER_L_FLS_FACI_TIME_OUT
                        3238 --604: **************************************************************************************************/
                        3239 --605: uint32_t L_FLS_IsFinished_ram(const uint16_t context_id, const uint32_t target_area, const uint32_t bank)
                        3240 --606: {
                        3241 --607:     /* Parmeter Check   */
                        3242 --608:     uint32_t lul_fls_status;
                        3243 --610:     lul_fls_status = D_FLS_IsFinished_ram(context_id, target_area, bank);
                        3244 --612:     /* convert driver error code to library error code. */
                        3245 --613:     lul_fls_status = l_FLS_ChangeErrCode_ram(lul_fls_status);
                        3246 --615:     return (lul_fls_status);
                        3247 --616: }
