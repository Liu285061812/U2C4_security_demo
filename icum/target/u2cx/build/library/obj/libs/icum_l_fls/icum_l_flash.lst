                        4843 --979: static uint32_t l_FLS_ChangeErrCode_ram(const uint32_t d_err_code)
                        4844 --980: {
                        4845 --981:     uint32_t lul_l_err_code;
                        4846 --983:     switch (d_err_code)
                        4847 --984:     {
                        4848 --985:         /* Driver Err */
                        4849 --986:         case ER_D_FLS_CANCEL:
                        4850 --987:             lul_l_err_code = ER_L_FLS_CANCEL;
                        4851 --988:             break;
                        4852 --989:         case ER_D_FLS_PROTECTION:
                        4853 --990:             lul_l_err_code = ER_L_FLS_PROTECTION;
                        4854 --991:             break;
                        4855 --992:         case ER_D_FLS_REJECTED:
                        4856 --993:             lul_l_err_code = ER_L_FLS_REJECTED;
                        4857 --994:             break;
                        4858 --995:         case ER_D_FLS_WRITE:
                        4859 --996:             lul_l_err_code = ER_L_FLS_PROGRAM;
                        4860 --997:             break;
                        4861 --998:         case ER_D_FLS_ERASE:
                        4862 --999:             lul_l_err_code = ER_L_FLS_PROGRAM;
                        4863 --1000:             break;
                        4864 --1001:         case ER_D_FLS_INTERNAL:
                        4865 --1002:             lul_l_err_code = ER_L_FLS_INTERNAL;
                        4866 --1003:             break;
                        4867 --1004:         case ER_D_FLS_FSTOPTOUT:
                        4868 --1005:             lul_l_err_code = ER_L_FLS_INTERNAL;
                        4869 --1006:             break;
                        4870 --1007:         case ER_D_FLS_SETOPRDYTOUT:
                        4871 --1008:             lul_l_err_code = ER_L_FLS_INTERNAL;
                        4872 --1009:             break;
                        4873 --1010:         case ER_D_FLS_SETOPMODTOUT:
                        4874 --1011:             lul_l_err_code = ER_L_FLS_UNAVAILABLE;
                        4875 --1012:             break;
                        4876 --1013:         case ER_D_FLS_UNAVAILABLE:
                        4877 --1014:             lul_l_err_code = ER_L_FLS_UNAVAILABLE;
                        4878 --1015:             break;
                        4879 --1016:         case ER_D_FLS_ECC1EDF1:
                        4880 --1017:             lul_l_err_code = ER_L_FLS_ECC1EDF1;
                        4881 --1018:             break;
                        4882 --1019:         case ER_D_FLS_ECC2EDF1:
                        4883 --1020:             lul_l_err_code = ER_L_FLS_ECC2EDF1;
                        4884 --1021:             break;
                        4885 --1022:         case ER_D_FLS_FACITOUT:
                        4886 --1023:             lul_l_err_code = ER_L_FLS_FACI_TIME_OUT;
                        4887 --1024:             break;
                        4888 --1025:         case ER_D_FLS_SUSPEND:
                        4889 --1026:             lul_l_err_code = ER_PENDING;
                        4890 --1027:             break;
                        4891 --1028:         case ER_D_FLS_RESUME:
                        4892 --1029:             lul_l_err_code = ER_L_FLS_PROGRAM;
                        4893 --1030:             break;
                        4894 --1031:         case ER_D_FLS_REMAP:
                        4895 --1032:             lul_l_err_code = ER_L_FLS_REMAP;
                        4896 --1033:             break;
                        4897 --1035:         /* If an error code of the following library is input, it is output as it is. */
                        4898 --1036:         /* ER_OK - ER_L_FLS_UNAVAILABLE */
                        4899 --1037:         case ER_OK:
                        4900 --1038:         case ER_PARAM:
                        4901 --1039:         case ER_PENDING:
                        4902 --1040:         case ER_IN_PROCESS:

