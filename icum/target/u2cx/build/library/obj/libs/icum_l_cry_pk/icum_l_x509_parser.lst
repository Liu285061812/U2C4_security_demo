                         132 --102: /***************************************************************************************
                         133 --103: * Function ID  : [ICUMFW_CD_L_CRY_X509_0003]:[ICUMFW_UD_L_CRY_X509_0003]
                         134 --104: * Function name: l_X509_ParseTop
                         135 --105: * Description  : Parse x.509 certificate top hierarchy
                         136 --106: *            X.509 certificate v3
                         137 --107: *            - on top: 1 member, which is a sequence
                         138 --108: *            - in the sequence : 3 members has follows:
                         139 --109: *                 - the certificate to be signed
                         140 --110: *                 - the signature algorithm
                         141 --111: *                 - the signature value
                         142 --112: *
                         143 --113: *            SEQUENCE {
                         144 --114: *                SEQUENCE {
                         145 --115: *                    [0] {
                         146 --116: *                        INTEGER 2
                         147 --117: *                        }
                         148 --118: *                    INTEGER
                         149 --119: *                     5E EB E4 CB 24 23 90 EF 72 AE 44 79 40 50 DE 2F
                         150 --120: *                    SEQUENCE {
                         151 --121: *                        OBJECT IDENTIFIER md5withRSAEncryption (1 2 840 113549 1 1 4)
                         152 --122: *                        NULL
                         153 --123: *                        }
                         154 --124: *                    .../...
                         155 --125: *
                         156 --126: *                SEQUENCE {
                         157 --127: *                    OBJECT IDENTIFIER md5withRSAEncryption (1 2 840 113549 1 1 4)
                         158 --128: *                    NULL
                         159 --129: *                    }
                         160 --130: *                BIT STRING 0 unused bits
                         161 --131: *                    A8 88 57 C0 6D AD 3B 35 8D 64 00 72 B8 D5 BE 46
                         162 --132: *                    .../...
                         163 --133: *                }
                         164 --134: * Arguments    : p_X509_cert    :[in]       :address of x.509 certificate
                         165 --135: *                sizeof_cert    :[in]       :byte size of x.509 certificate
                         166 --136: *                p_fields_cert  :[out]      :list of ASN1 DER objects
                         167 --137: *                p_nb_items     :[in/out]   :the number of objects found
                         168 --138: * Return Value : ER_OK
                         169 --139: *                ER_L_X509_INVALID_ARG
                         170 --140: ***************************************************************************************/
                         171 --141: static uint32_t l_X509_ParseTop (const uint8_t  *p_X509_cert,
                         172 	.align	2

                                                                      Page 4
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000mo41.si
