                         718 --252: /**********************************************************************************************************************
                         719 --253: * Function Name : r_pkcl_cmn_pkcl_ret_from_pkcd_ret
                         720 --254: **********************************************************************************************************************/
                         721 --255: /*!****************************************************************************************************************//**
                         722 --256:  * \ingroup     PKCLCommonAPIsInternal
                         723 --257:  * \brief       Returns the return code corresponding to the return code of the PKC driver
                         724 --258:  * \param        [in]   drv_ret                The PKC Driver return code
                         725 --259:  * \return
                         726 --260:  *  - #PKCL_RET_OK:                             The PKC driver return code PKCD_RET_OK entered.
                         727 --261:  *  - #PKCL_RET_PROCESSING:                     The PKC driver return code PKCD_RET_PROCESSING enterd.
                         728 --262:  *  - #PKCL_RET_DRV_INTERNALERR:                The PKC driver return code PKCD_RET_INTERNALERR entered.
                         729 --263:  *  - #PKCL_RET_DRV_PARAMERR:                   The PKC driver return code PKCD_RET_PARAMERR entered.
                         730 --264:  *  - #PKCL_RET_DRV_LENGTHERR:                  The PKC driver return code PKCD_RET_LENGTHERR entered.
                         731 --265:  *  - #PKCL_RET_KEY_PARAMERR:                   The PKC driver return code PKCD_RET_KEY_PARAMERR entered.
                         732 --266:  *  - #PKCL_RET_KEY_LENGTHERR:                  The PKC driver return code PKCD_RET_KEY_LENGTHERR entered.
                         733 --267:  *  - #PKCL_RET_HASHAPIERR:                     The PKC driver return code PKCL_RET_HASHAPIERR entered.
                         734 --268:  *  - #PKCL_RET_PKCCTIMEOUTERR:                 The PKC driver return code PKCD_RET_PKCCTIMEOUTERR entered.
                         735 --269:  *  - #PKCL_RET_PKCCERR:                        The PKC driver return code PKCD_RET_PKCCERR entered.
                         736 --270:  *  - #PKCL_RET_RSA_NON_COPRIME:                The PKC driver return code PKCD_RET_RSA_NON_COPRIME entered.
                         737 --271:  *  - #PKCL_RET_RSA_COMPOSITE:                  The PKC driver return code PKCD_RET_RSA_COMPOSITE entered.
                         738 --272:  *  - #PKCL_RET_EC_VERIFAIL:                    The PKC driver return code PKCD_RET_PKCD_RET_EC_VERIFAIL entered.
                         739 --273:  *  - #PKCL_RET_EC_ZERO_SIGNATURE:              The PKC driver return code PKCD_RET_EC_ZERO_SIGNATURE entered.
                         740 --274:  *  - #PKCL_RET_EDDSA_VERIFAIL:                 The PKC driver return code PKCD_RET_EDDSA_VERIFAIL entered.
                         741 --275:  *  - #PKCL_RET_EDDSA_DECOMPERR:                The PKC driver return code PKCD_RET_EDDSA_DECOMPERR entered.
                         742 --276:  *  - #PKCL_RET_DRV_TAMPERERR:                  The PKC driver return code PKCD_RET_TAMPERERR entered.
                         743 --277:  *  - #PKCL_RET_DRV_FAIL:                       The PKC driver return code other than the above entered.
                         744 --278:  *  - #PKCL_RET_TAMPERERR:                      Tampering has been detected.
                         745 --279:  *  - #PKCL_RET_INTERNALERR:                    Internal processing failed
                         746 --280:  * \par Global Variables
                         747 --281:  *  - None
                         748 --282:  * \par Call PKC-Driver API
                         749 --283:  *  - None

                                                                      Page 14
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00013ps1.si
                         750 --284:  * \par Precondition
                         751 --285:  *  - None
                         752 --286:  * \par Security components
                         753 --287:  *  - no
                         754 --288:  * \par Detailed description
                         755 --289:  *      - Returns the return code corresponding to the return code of cipher driver
                         756 --290:  *      - Implement the following as a glitch countermeasure :
                         757 --291:  *        - Set success return value in two steps
                         758 --292:  *
                         759 --293:  * Pseudo-code for the function can be found below.
                         760 --294:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                         761 --295:  *  -# If drv_ret == PKCD_RET_OK.
                         762 --296:  *    -# Set temp_ret to #PKCL_CMN_RET_OK_HALF_1.
                         763 --297:  *  -# Else if drv_ret == PKCD_RET_PROCESSING
                         764 --298:  *    -# Set temp_ret to #PKCL_CMN_RET_PROC_HALF_1.
                         765 --299:  *  -# Else if drv_ret == PKCD_RET_PRIME_GENERATING
                         766 --300:  *    -# Set temp_ret to #PKCL_CMN_RET_PRIMEGEN_HALF_1.
                         767 --301:  *  -# Else if drv_ret == PKCD_RET_INTERNALERR
                         768 --302:  *    -# Set temp_ret to #PKCL_RET_DRV_INTERNALERR.
                         769 --303:  *  -# Else if drv_ret == PKCD_RET_PARAMERR
                         770 --304:  *    -# Set temp_ret to #PKCL_RET_DRV_PARAMERR.
                         771 --305:  *  -# Else if drv_ret == PKCD_RET_LENGTHERR
                         772 --306:  *    -# Set temp_ret to #PKCL_RET_DRV_LENGTHERR.
                         773 --307:  *  -# Else if drv_ret == PKCD_RET_KEY_PARAMERR
                         774 --308:  *    -# Set temp_ret to #PKCL_RET_KEY_PARAMERR.
                         775 --309:  *  -# Else if drv_ret == PKCD_RET_KEY_LENGTHERR
                         776 --310:  *    -# Set temp_ret to #PKCL_RET_KEY_LENGTHERR.
                         777 --311:  *  -# Else if drv_ret == PKCD_RET_HASHAPIERR
