                        6636 --2264: * Function Name : r_pkcl_ec_chk_select_data
                        6637 --2265: **********************************************************************************************************************/
                        6638 --2266: /*!****************************************************************************************************************//**
                        6639 --2267:  * \ingroup     PKCLECAPIsInternal
                        6640 --2268:  * \brief       Check the argument of type st_pkc_select_data_t.
                        6641 --2269:  * \param       [in]   p_select_data       Signature data or coordinate point data
                        6642 --2270:  * \param       [in]   curve_len           EC curve length
                        6643 --2271:  * \param       [in]   chk_mode            Select whether the data to be checked is scalar data or coordinate points
                        6644 --2272:  * \return
                        6645 --2273:  *  - #PKCL_RET_OK:                       Successful completion
                        6646 --2274:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                        6647 --2275:  *  - #PKCL_RET_PARAMERR:                 Invalid argument entered
                        6648 --2276:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                        6649 --2277:  * \par Security components
                        6650 --2278:  *  - No
                        6651 --2279:  * \par Global Variables
                        6652 --2280:  *  - None
                        6653 --2281:  * \par Call PKC-Driver API
                        6654 --2282:  *  - None
                        6655 --2283:  * \par Precondition
                        6656 --2284:  *  - None
                        6657 --2285:  * \par Detailed description
                        6658 --2286:  *      - Make sure the argument is not NULL.
                        6659 --2287:  *      - Make sure data_type is #PKC_DATA_TYPE_BYTE or #PKC_DATA_TYPE_KEY_BINARY.
                        6660 --2288:  *      - If data_type is #PKC_DATA_TYPE_BYTE, check the following.

                                                                      Page 117
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000q981.si
                        6661 --2289:  *      - If chk_mode is #PKCL_EC_SELECT_MODE_SCALAR,
                        6662 --2290:  *        make sure the byte length is less than or equal to the curve length.
                        6663 --2291:  *      - If chk_mode is #PKCL_EC_SELECT_MODE_POINT,
                        6664 --2292:  *        make sure the byte length is the same as twice the curve length.
                        6665 --2293:  * \par Remarks
                        6666 --2294:  *  - None
                        6667 --2295:  *
                        6668 --2296:  * Pseudo-code for the function can be found below.
                        6669 --2297:  *  -# Initialize ret with #PKCL_RET_INTERNALERR.
                        6670 --2298:  *  -# If (NULL != p_select_data)
                        6671 --2299:  *    -# If (((#PKC_DATA_TYPE_BYTE == p_select_data->data_type) or
                        6672 --2300:  *            (#PKC_DATA_TYPE_KEY_BINARY == p_select_data->data_type)) and
                        6673 --2301:  *            (NULL != p_select_data->p_sel_data))
                        6674 --2302:  *      -# If (NULL != p_select_data->p_sel_data->p_data)
