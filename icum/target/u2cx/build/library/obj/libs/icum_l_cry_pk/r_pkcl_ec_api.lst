                        8280 --2969:  * \return
                        8281 --2970:  *  - #PKCL_RET_OK:                       Successful completion
                        8282 --2971:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                        8283 --2972:  *  - #PKCL_RET_PARAMERR:                 Invalid argument entered
