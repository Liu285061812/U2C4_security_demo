                        8311 --3000:  *          -# Else
                        8312 --3001:  *            -# Set ret to #PKCL_RET_PARAMERR.
                        8313 --3002:  *    -# Else
                        8314 --3003:  *      -# Set ret to #PKCL_RET_PARAMERR.
                        8315 --3004:  *    -# If (#PKCL_RET_OK == ret)
                        8316 --3005:  *      -# If (NULL != p_shared->p_data)
                        8317 --3006:  *        -# If (NULL != p_ctx->p_kdf_info)
                        8318 --3007:  *          -# If (p_shared->len >= p_ctx->p_kdf_info->out_kdf_len)
                        8319 --3008:  *            -# Do nothing.
                        8320 --3009:  *          -# Else
                        8321 --3010:  *            -# Set ret to #PKCL_RET_LENGTHERR.
