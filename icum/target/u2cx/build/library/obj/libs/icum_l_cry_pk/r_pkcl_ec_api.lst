                        6460 --2202:  *          -# Set ret to #PKCL_RET_OK.
                        6461 --2203:  *        -# Else
                        6462 --2204:  *          -# Set ret to #PKCL_RET_LENGTHERR.
                        6463 --2205:  *    -# Else
                        6464 --2206:  *      -# Set ret to #PKCL_RET_PARAMERR.
                        6465 --2207:  *  -# Else
                        6466 --2208:  *    -# Set ret to #PKCL_RET_PARAMERR.
                        6467 --2209:  *  -# Return ret.
                        6468 --2210:  *
