                        7546 --2672: /*!****************************************************************************************************************/ /**
                        7547 --2673:  * \ingroup     PKCLEDDSAAPIsInternal
                        7548 --2674:  * \brief       Check EdDSA variant settings.
                        7549 --2675:  * \param       [in]   eddsa_variant       EdDSA variant
                        7550 --2676:  * \param       [in]   p_ed_ctx            Up to 255 bytes of context set by signers and verifiers in EdDSA
                        7551 --2677:  * \param       [in]   curve_len           EdDSA curve length
                        7552 --2678:  * \return
                        7553 --2679:  *  - #PKCL_RET_OK:                       Successful completion
                        7554 --2680:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                        7555 --2681:  *  - #PKCL_RET_PARAMERR:                 Invalid argument entered
                        7556 --2682:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                        7557 --2683:  * \par Security components
                        7558 --2684:  *  - No
                        7559 --2685:  * \par Global Variables
                        7560 --2686:  *  - None
                        7561 --2687:  * \par Call PKC-Driver API
                        7562 --2688:  *  - None
                        7563 --2689:  * \par Precondition

                                                                      Page 132
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000036c1.si
                        7564 --2690:  *  - None
                        7565 --2691:  * \par Detailed description
                        7566 --2692:  *      - Check the Ed context for each EdDSA variant setting.
                        7567 --2693:  *      - For Ed25519, no context check.
                        7568 --2694:  *      - For Ed25519ctx, check the length of the context length and make sure the context data is not null.
                        7569 --2695:  *      - For Ed25519ph, Ed448, Ed448ph, check the length of the context.
                        7570 --2696:  *        If the length is non-zero, make sure the context data is not null.
                        7571 --2697:  * \par Remarks
                        7572 --2698:  *  - None
                        7573 --2699:  *
                        7574 --2700:  * Pseudo-code for the function can be found below.
                        7575 --2701:  *  -# Initialize ret with #PKCL_RET_INTERNALERR.
                        7576 --2702:  *  -# If ((#PKCL_EDDSA_ED25519_CURVE_LEN == curve_len) and (#PKC_EDDSA_VARIANT_PURE == eddsa_variant))
                        7577 --2703:  *    -# Do nothing
                        7578 --2704:  *  -# Else if ((#PKCL_EDDSA_ED25519_CURVE_LEN == curve_len) and (#PKC_EDDSA_VARIANT_CTX == eddsa_variant))
                        7579 --2705:  *    -# If NULL != p_ed_ctx
                        7580 --2706:  *      -# If ((#PKCL_EDDSA_ED_CTX_LEN_MIN <= p_ed_ctx->len) and (#PKCL_EDDSA_ED_CTX_LEN_MAX >= p_ed_ctx->len))
                        7581 --2707:  *        -# If (NULL != p_ed_ctx->p_data)
                        7582 --2708:  *          -# Set ret to #PKCL_RET_OK.
                        7583 --2709:  *        -# Else
                        7584 --2710:  *          -# Set ret to #PKCL_RET_PARAMERR.
                        7585 --2711:  *      -# Else
                        7586 --2712:  *        -# Set ret to #PKCL_RET_LENGTHERR.
                        7587 --2713:  *    -# Else
                        7588 --2714:  *      -# Set ret to #PKCL_RET_PARAMERR.
                        7589 --2715:  *  -# Else if (((#PKCL_EDDSA_ED25519_CURVE_LEN == curve_len) and (#PKC_EDDSA_VARIANT_HASH == eddsa_variant)) or<br>
                        7590 --2716:  *              ((#PKCL_EDDSA_ED448_CURVE_LEN == curve_len) and (#PKC_EDDSA_VARIANT_PURE == eddsa_variant)) or<br>
                        7591 --2717:  *              ((#PKCL_EDDSA_ED448_CURVE_LEN == curve_len) and (#PKC_EDDSA_VARIANT_HASH == eddsa_variant)))
                        7592 --2718:  *    -# If NULL != p_ed_ctx
                        7593 --2719:  *      -# If (#PKCL_EDDSA_ED_CTX_LEN_MAX >= p_ed_ctx->len)
                        7594 --2720:  *        -# If (0UL == p_ed_ctx->len)
                        7595 --2721:  *          -# Set ret to #PKCL_RET_OK.
                        7596 --2722:  *        -# Else
                        7597 --2723:  *          -# If (NULL != p_ed_ctx->p_data)
                        7598 --2724:  *            -# Set ret to #PKCL_RET_OK.
                        7599 --2725:  *          -# Else
                        7600 --2726:  *            -# Set ret to #PKCL_RET_PARAMERR.
                        7601 --2727:  *      -# Else
                        7602 --2728:  *        -# Set ret to #PKCL_RET_LENGTHERR.
                        7603 --2729:  *    -# Else
                        7604 --2730:  *      -# Set ret to #PKCL_RET_PARAMERR.
                        7605 --2731:  *  -# Else
                        7606 --2732:  *    -# Set ret to #PKCL_RET_PARAMERR.
                        7607 --2733:  *  -# Return ret.
                        7608 --2734:  *
                        7609 --2735:  * \callgraph
                        7610 --2736:  *********************************************************************************************************************/
