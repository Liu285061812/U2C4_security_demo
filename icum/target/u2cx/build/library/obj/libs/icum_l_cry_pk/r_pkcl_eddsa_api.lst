                        9719 --3576:  *      - Call #r_pkcl_eddsa_chk_curve to check the curve information of p_ctx.
                        9720 --3577:  * \par Remarks
                        9721 --3578:  *  - None
                        9722 --3579:  *
                        9723 --3580:  * Pseudo-code for the function can be found below.
                        9724 --3581:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                        9725 --3582:  *  -# Assign a buffer for the EdDSA operation as p_eddsa_sign from p_ctx->p_buf.
                        9726 --3583:  *  -# Set p_msg to p_eddsa_sign->p_msg.
                        9727 --3584:  *  -# Set msg_data.p_data to p_msg.
                        9728 --3585:  *  -# Set msg_data.len to p_eddsa_sign->msg_len.
                        9729 --3586:  *  -# Set hash_ram_data.p_data to hash_ram_val.
                        9730 --3587:  *  -# Set hash_ram_data.len to sizeof(hash_ram_val).
                        9731 --3588:  *  -# Set p_buf_drv to p_ctx->p_buf[sizeof(st_pkcl_eddsa_sign_t)] address.
                        9732 --3589:  *  -# If #PKC_EDDSA_VARIANT_HASH == p_ctx->eddsa_variant
                        9733 --3590:  *    -# If #PKCL_EDDSA_ED448_CURVE_LEN == p_ctx->p_curve_info->curve_len
                        9734 --3591:  *      -# Set hmsg_data.len to #PKCL_EDDSA_SHAKE256BYTES_PH.
                        9735 --3592:  *    -# Set p_hash_ctx to p_ctx->p_hash_info->p_hash_ctx.
                        9736 --3593:  *    -# Execute an external Hash init function p_ctx->p_hash_info->p_hash_init_api to initialize a hash context,
                        9737 --3594:  *       and set the return value to hash_ret.
                        9738 --3595:  *    -# If #PKCL_EXTERNAL_API_OK == hash_ret
                        9739 --3596:  *      -# Execute an external hash update function p_ctx->p_hash_info->p_hash_update_api
                        9740 --3597:  *         to hash a message, and set the return value to hash_ret.
                        9741 --3598:  *      -# If #PKCL_EXTERNAL_API_OK == hash_ret
                        9742 --3599:  *        -# Execute an external hash final function p_ctx->p_hash_info->p_hash_final_api
                        9743 --3600:  *           to set the hased value and its byte size to hmsg_data.p_data,
                        9744 --3601:  *           and set the return value to hash_ret.
                        9745 --3602:  *        -# If #PKCL_EXTERNAL_API_OK == hash_ret
                        9746 --3603:  *          -# Calculate H(R,A,M) value from the signature r, the public key and the message with
                        9747 --3604:  *             R_PKCD_EddsaHashRAM and set drv_ret to the result.
                        9748 --3605:  *          -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9749 --3606:  *        -# Else
                        9750 --3607:  *          -# Set ret to #PKCL_RET_HASHAPIERR.
                        9751 --3608:  *      -# Else
                        9752 --3609:  *        -# Set ret to #PKCL_RET_HASHAPIERR.
                        9753 --3610:  *    -# Else
                        9754 --3611:  *      -# Set ret to #PKCL_RET_HASHAPIERR.
                        9755 --3612:  *  -# Else if (#PKC_EDDSA_VARIANT_PURE == p_ctx->eddsa_variant) or<br>
                        9756 --3613:  *             (#PKC_EDDSA_VARIANT_CTX == p_ctx->eddsa_variant)
                        9757 --3614:  *    -# Calculate H(R,A,M) value from the signature r, the public key and the message with R_PKCD_EddsaHashRAM
                        9758 --3615:  *       and set drv_ret to the result.
                        9759 --3616:  *    -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9760 --3617:  *  -# Else
                        9761 --3618:  *    -# Set ret to #PKCL_RET_INTERNALERR.
                        9762 --3619:  *  -# If #PKCL_RET_OK == ret then,
                        9763 --3620:  *    -# Set H(R,A,M) structure type hash_ram_sel.data_type to #PKC_DATA_TYPE_BYTE.
                        9764 --3621:  *    -# Set H(R,A,M) structure content address hash_ram_sel.p_sel_data to &hash_ram_data.
                        9765 --3622:  *    -# Set the public key structure type pubkey_sel.data_type to #PKC_DATA_TYPE_KEY_BINARY.
                        9766 --3623:  *    -# Set the public key structure content address pubkey_sel.p_sel_data to &pubkey_data.
                        9767 --3624:  *    -# Set the public key address pubkey_sel.p_sel_data to p_eddsa_sign->p_pub_key.
                        9768 --3625:  *    -# Initialize the multiplication of the public key by H(R,A,M) with R_PKCD_EddsaScalarMultInit
                        9769 --3626:  *       and set drv_ret to the result.
                        9770 --3627:  *    -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9771 --3628:  *    -# If #PKCL_RET_OK == ret then,
                        9772 --3629:  *      -# Operate the multiplication of the public key by H(R,A,M) with R_PKCD_EddsaScalarMultOperate
                        9773 --3630:  *         and set drv_ret to the result.
                        9774 --3631:  *      -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9775 --3632:  *      -# If #PKCL_RET_OK == ret then,

                                                                      Page 169
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000036c1.si
                        9776 --3633:  *        -# Set H(R,A,M)*A address ha_data.p_data to ha_val.
                        9777 --3634:  *        -# Set H(R,A,M)*A length ha_data.len to sizeof(ha_val).
                        9778 --3635:  *        -# Finalize the multiplication of the public key by H(R,A,M) with R_PKCD_EddsaScalarMultFinal
                        9779 --3636:  *           and set drv_ret to the result.
                        9780 --3637:  *        -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9781 --3638:  *  -# If #PKCL_RET_OK == ret then,
                        9782 --3639:  *    -# Set sign_s_sel.data_type to #PKC_DATA_TYPE_BYTE.
                        9783 --3640:  *    -# Set sign_s_sel.p_sel_data to p_sign_s_data.
                        9784 --3641:  *    -# Initialize the multiplicaion of the base point by signature s with R_PKCD_EddsaScalarMultBaseInit
                        9785 --3642:  *       and set drv_ret to the result.
                        9786 --3643:  *    -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9787 --3644:  *      -# If #PKCL_RET_OK == ret then,
