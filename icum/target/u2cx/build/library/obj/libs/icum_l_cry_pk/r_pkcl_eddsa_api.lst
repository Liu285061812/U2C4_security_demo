                        9794 --3651:  *          -# Finalize the multiplication of the base point by the signature s with R_PKCD_EddsaScalarMultBaseFinal
                        9795 --3652:  *             and set drv_ret to the result.
                        9796 --3653:  *          -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9797 --3654:  *          -# If #PKCL_RET_OK == ret then,
                        9798 --3655:  *            -# Verify the signature comparing the H(R,A,M)*A, S*B and the signature r with
                        9799 --3656:  *               R_PKCD_EddsaCompareSign and set drv_ret to the result.
                        9800 --3657:  *            -# Convert drv_ret with #r_pkcl_cmn_pkcl_ret_from_pkcd_ret, and output the result to ret.
                        9801 --3658:  *  -# If #PKCL_RET_OK != ret
                        9802 --3659:  *    -# Set ret to #PKCL_RET_TAMPERERR.
                        9803 --3660:  *  -# Return ret.
