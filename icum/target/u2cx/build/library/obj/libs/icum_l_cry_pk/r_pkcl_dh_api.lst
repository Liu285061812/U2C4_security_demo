                        1534 --490: /**********************************************************************************************************************
                        1535 --491: * Function Name : r_pkcl_dh_chk_dh_init_arg
                        1536 --492: **********************************************************************************************************************/
                        1537 --493: /*!****************************************************************************************************************//**
                        1538 --494:  * \ingroup     PKCLDHAPIsInternal
                        1539 --495:  * \brief       Check the arguments of #R_PKCL_DhInit.
                        1540 --496:  * \param       [in]     p_priv_key     DH private key of key binary format
                        1541 --497:  * \param       [in]     p_pub_key      DH public key of key binary format
                        1542 --498:  * \param       [in]     p_ctx          A pointer to a structure that summarizes the parameters required by DH.
                        1543 --499:  * \return
                        1544 --500:  *  - #PKCL_RET_OK:                       Successful completion
                        1545 --501:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                        1546 --502:  *  - #PKCL_RET_PARAMERR:                 Invalid argument entered
                        1547 --503:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                        1548 --504:  * \par Security components
                        1549 --505:  *  - No
                        1550 --506:  * \par Global Variables
                        1551 --507:  *  - None
                        1552 --508:  * \par Call PKC-Driver API
                        1553 --509:  *  - None
                        1554 --510:  * \par Precondition
                        1555 --511:  *  - None
                        1556 --512:  * \par Detailed description
                        1557 --513:  *  - Check the arguments received by the #R_PKCL_DhInit function.
                        1558 --514:  * \par Remarks
                        1559 --515:  *  - None
                        1560 --516:  *
                        1561 --517:  * Pseudo-code for the function can be found below.
                        1562 --518:  * -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                        1563 --519:  * -# If ((NULL != p_priv_key) && (NULL != p_pub_key) && (NULL != p_ctx))
                        1564 --520:  *   -# If ((NULL != p_ctx->p_buf))
                        1565 --521:  *     -# If ((PKC_BOOL_TRUE == p_ctx->is_constant_time_mode) || (PKC_BOOL_FALSE == p_ctx->is_constant_time_mode))
                        1566 --522:  *       -# Check DH domain parameters with #r_pkcl_dh_chk_dh_param, and set ret to the return value.
                        1567 --523:  *       -# If #PKCL_RET_OK == ret
                        1568 --524:  *         -# If NULL != p_ctx->p_kdf_info
                        1569 --525:  *           -# If NULL != p_ctx->p_kdf_info->p_kdf_api
                        1570 --526:  *             -# Do nothing
                        1571 --527:  *           -# Else
                        1572 --528:  *             -# Set ret to #PKCL_RET_PARAMERR
                        1573 --529:  *         -# Else
                        1574 --530:  *           -# Do nothing
                        1575 --531:  *       -# Else
                        1576 --532:  *         -# Do nothing.
                        1577 --533:  *     -# Else
                        1578 --534:  *       -# Set ret to #PKCL_RET_PARAMERR
                        1579 --535:  *   -# Else
                        1580 --536:  *     -# Set ret to #PKCL_RET_PARAMERR
