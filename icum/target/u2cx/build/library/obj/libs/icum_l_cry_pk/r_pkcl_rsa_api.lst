                        9801 --3761:  *        -# Else
                        9802 --3762:  *          -# Set ret to #PKCL_RET_PARAMERR.
                        9803 --3763:  *      -# Else if (#PKC_RSA_PADDING_PKCS1_PSS == p_ctx->padding_option)
                        9804 --3764:  *        -# If (NULL != p_ctx->p_mask_option)
