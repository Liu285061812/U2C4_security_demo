                       15405 --5784: /**********************************************************************************************************************
                       15406 --5785: * Function Name : r_pkcl_rsa_mgf1
                       15407 --5786: **********************************************************************************************************************/
                       15408 --5787: /*!****************************************************************************************************************//**
                       15409 --5788:  * \ingroup     PKCLRSAAPIsInternal

                                                                      Page 265
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       15410 --5789:  * \brief       Calculate the mask used for RSA scheme processing.
                       15411 --5790:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       15412 --5791:  * \param       [in]     p_seed        Seed used to calculate mask generation
                       15413 --5792:  * \param       [in]     seed_len      seed length
                       15414 --5793:  * \param       [out]    p_mask        Output mask
                       15415 --5794:  * \param       [in]     mask_len      Length of mask to generate
                       15416 --5795:  * \return
                       15417 --5796:  *  - #PKCL_RET_OK:                       Successful completion
                       15418 --5797:  *  - #PKCL_RET_HASHAPIERR:               External HASH API returned error
                       15419 --5798:  * \par Security components
                       15420 --5799:  *  - No
                       15421 --5800:  * \par Global Variables
                       15422 --5801:  *  - None
                       15423 --5802:  * \par Call PKC-Driver API
                       15424 --5803:  *  - None
                       15425 --5804:  * \par Precondition
                       15426 --5805:  *  - None
                       15427 --5806:  * \par Detailed description
                       15428 --5807:  *      - Hash the seed and counter values to generate a mask.
                       15429 --5808:  *      - The counter value is converted to big endian by calling #r_pkcl_cmn_ch_big_endian32.
                       15430 --5809:  * \par Remarks
                       15431 --5810:  *  - None
                       15432 --5811:  *
                       15433 --5812:  * Pseudo-code for the function can be found below.
                       15434 --5813:  *  -# Initialize the variable mask_pos with 0.
                       15435 --5814:  *  -# Set mask_len into the variable mask_length.
                       15436 --5815:  *  -# Set 0 into the variable counter.
                       15437 --5816:  *  -# Loop while ((mask_length > 0) and (#PKCL_RET_OK == ret))
                       15438 --5817:  *    -# Get the big endian format of counter, and set it into ch_counter with #r_pkcl_cmn_ch_big_endian32.
                       15439 --5818:  *    -# Increment counter.
                       15440 --5819:  *    -# Initialize the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_init_api,
                       15441 --5820:  *       and set the return value into external_ret.
                       15442 --5821:  *    -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       15443 --5822:  *      -# Input p_seed into the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_update_api,
                       15444 --5823:  *         and set the return value into external_ret.
                       15445 --5824:  *      -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       15446 --5825:  *        -# Input ch_counter into the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_update_api,
                       15447 --5826:  *           and set the return value into external_ret.
                       15448 --5827:  *        -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       15449 --5828:  *          -# Get the hashed value with p_ctx->p_mask_option->p_hash_info->p_hash_final_api,
                       15450 --5829:  *                 set the hashed value and its length into buf and hash_len respectively,
                       15451 --5830:  *                 and set the return value into external_ret.
                       15452 --5831:  *          -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       15453 --5832:  *            -# Set ret to #PKCL_RET_OK.
                       15454 --5833:  *          -# Else
                       15455 --5834:  *            -# Set ret to #PKCL_RET_HASHAPIERR.
                       15456 --5835:  *        -# Else
                       15457 --5836:  *          -# Set ret to #PKCL_RET_HASHAPIERR.
                       15458 --5837:  *      -# Else
                       15459 --5838:  *        -# Set ret to #PKCL_RET_HASHAPIERR.
                       15460 --5839:  *    -# Else
                       15461 --5840:  *      -# Set ret to #PKCL_RET_HASHAPIERR.
                       15462 --5841:  *    -# If (#PKCL_RET_OK == ret)
                       15463 --5842:  *      -# Loop while (store_loop < hash_len) and (mask_length > 0), and increment store_loop for each loop.
                       15464 --5843:  *        -# Set buf[store_loop] into p_mask[mask_pos].
                       15465 --5844:  *        -# Decrement mask_length.
                       15466 --5845:  *        -# Increment mask_pos.
                       15467 --5846:  *  -# Return ret.
                       15468 --5847:  *
                       15469 --5848:  * \callgraph
                       15470 --5849:  *********************************************************************************************************************/

