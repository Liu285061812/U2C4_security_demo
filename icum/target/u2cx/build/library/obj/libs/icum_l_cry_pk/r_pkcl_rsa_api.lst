                       14065 --5291: /*!****************************************************************************************************************//**
                       14066 --5292:  * \ingroup     PKCLRSAAPIsInternal
                       14067 --5293:  * \brief       Perform the EMSA-PSS scheme for RSA signature generation.
                       14068 --5294:  * \param       [in]     p_digest      A structure consisting of the byte length len of the message digest and
                       14069 --5295:  *                                      the data pointer p_data.
                       14070 --5296:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       14071 --5297:  * \param       [in]     mod_len       Byte length of modulus n.
                       14072 --5298:  * \param       [in,out] p_em          Output encode message.
                       14073 --5299:  * \return
                       14074 --5300:  *  - #PKCL_RET_OK:                       Successful completion
                       14075 --5301:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       14076 --5302:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       14077 --5303:  *  - #PKCL_RET_DRBGAPIERR:               External DRBG API returned error
                       14078 --5304:  *  - #PKCL_RET_HASHAPIERR:               External HASH API returned error
                       14079 --5305:  * \par Security components
                       14080 --5306:  *  - No
                       14081 --5307:  * \par Global Variables
                       14082 --5308:  *  - None
                       14083 --5309:  * \par Call PKC-Driver API
                       14084 --5310:  *  - None
                       14085 --5311:  * \par Precondition
                       14086 --5312:  *  - None
                       14087 --5313:  * \par Detailed description
                       14088 --5314:  *      - Create M'by concatenating fixed value padding with digest and salt.
                       14089 --5315:  *      - Hash M'to create H.
                       14090 --5316:  *      - Create a DB by concatenating PS, 0x01, and salt, and calculate the masked DB by xoring with the mask created
                       14091 --5317:  *         from H.
                       14092 --5318:  *      - Create EM by concatenating DB, H and 0xbc.
                       14093 --5319:  * \par Remarks
                       14094 --5320:  *  - None
                       14095 --5321:  *
                       14096 --5322:  * Pseudo-code for the function can be found below.
                       14097 --5323:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       14098 --5324:  *  -# Set salt length p_ctx->p_mask_option->salt_len into the variable salt_len.
                       14099 --5325:  *  -# Set (mod_len * #PKCL_RSA_OCTET) into embits_len.
                       14100 --5326:  *  -# Set hash_len to the hash length used for the mask with #r_pkcl_rsa_get_hash_len.
                       14101 --5327:  *  -# If (hash_len != 0U)
                       14102 --5328:  *    -# If ((p_em->len >= mod_len) && (mod_len >= (salt_len + hash_len + #PKCL_RSA_PSS_PS_LEN_CALC)))
                       14103 --5329:  *      -# Generate a pseudo-random bit sequence with p_ctx->p_drbg_api and set the generated
                       14104 --5330:  *         pseudo-random value into salt_val, and set the return value into external_ret.
                       14105 --5331:  *      -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       14106 --5332:  *        -# Set #PKCL_RSA_PSS_PAD_LEN bytes of zeros to m_data with #r_pkcl_cmn_set_byte.
                       14107 --5333:  *        -# Concatenate p_digest->p_data with m_data[#PKCL_RSA_PSS_PAD_LEN] using #r_pkcl_cmn_cpy_byte.
                       14108 --5334:  *        -# Concatenate salt_val with m_data[PKCL_RSA_PSS_PAD_LEN + p_digest->len]
                       14109 --5335:  *           using #r_pkcl_cmn_cpy_byte.
                       14110 --5336:  *        -# Set (#PKCL_RSA_PSS_PAD_LEN + p_digest->len + salt_len) to m_len.
                       14111 --5337:  *        -# Initialize the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_init_api,
                       14112 --5338:  *           and set the return value into external_ret.
                       14113 --5339:  *        -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       14114 --5340:  *          -# Input m_data into the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_update_api,
                       14115 --5341:  *             and set the return value into external_ret.
                       14116 --5342:  *          -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       14117 --5343:  *            -# Get the hashed value with p_ctx->p_mask_option->p_hash_info->p_hash_final_api,
                       14118 --5344:  *               set the hashed value and its length into hash_data and hash_len,
                       14119 --5345:  *               and set the return value into external_ret.
                       14120 --5346:  *            -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       14121 --5347:  *              -# Set ((mod_len - hash_len) - 1) into db_len.
                       14122 --5348:  *              -# Set (((mod_len - salt_len) - hash_len) - #PKCL_RSA_PSS_PS_LEN_CALC) into ps_len.
                       14123 --5349:  *              -# Set ps_len bytes of zeros to the array db with #r_pkcl_cmn_set_byte.
                       14124 --5350:  *              -# Set 0x01 into db[ps_len].

                                                                      Page 243
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       14125 --5351:  *              -# Concatenate salt_val with db[ps_len+1] using #r_pkcl_cmn_cpy_byte.
                       14126 --5352:  *              -# Generate the masked value of hash_data with #r_pkcl_rsa_mgf1, and set the return velue into ret.
                       14127 --5353:  *              -# If (#PKCL_RET_OK == ret)
                       14128 --5354:  *                -# Loop while xor_loop is less than db_len, and increment xor_loop for each loop.
                       14129 --5355:  *                  -# Set exclusive OR of (db[xor_loop] and mask[xor_loop]) into db[xor_loop].
                       14130 --5356:  *                -# Set (db[0] & (#PKCL_RSA_BIT_CLEAR_NUM >> (mod_len * #PKCL_RSA_OCTET - (embits_len - 1))))
                       14131 --5357:  *                   into db[0].
                       14132 --5358:  *                -# Set db into p_em->p_data with #r_pkcl_cmn_cpy_byte.
                       14133 --5359:  *                -# Concatenate hash_data with p_em->p_data[db_len] with #r_pkcl_cmn_cpy_byte.
                       14134 --5360:  *                -# Set #PKCL_RSA_PSS_PADDING_NUM into p_em->p_data[db_len + hash_len].
                       14135 --5361:  *                -# Set (db_len + hash_len + 1U) into p_em->len.
                       14136 --5362:  *            -# Else
                       14137 --5363:  *              -# Set ret to #PKCL_RET_HASHAPIERR.
                       14138 --5364:  *          -# Else
                       14139 --5365:  *            -# Set ret to #PKCL_RET_HASHAPIERR.
                       14140 --5366:  *        -# Else
                       14141 --5367:  *          -# Set ret to #PKCL_RET_HASHAPIERR.
                       14142 --5368:  *      -# Else
                       14143 --5369:  *        -# Set ret to #PKCL_RET_DRBGAPIERR.
                       14144 --5370:  *    -# Else
                       14145 --5371:  *      -# Set ret to #PKCL_RET_LENGTHERR.
                       14146 --5372:  *  -# Else
                       14147 --5373:  *    -# Set ret to #PKCL_RET_INTERNALERR.
                       14148 --5374:  *  -# Return ret.
                       14149 --5375:  *
                       14150 --5376:  * \callgraph
                       14151 --5377:  *********************************************************************************************************************/
