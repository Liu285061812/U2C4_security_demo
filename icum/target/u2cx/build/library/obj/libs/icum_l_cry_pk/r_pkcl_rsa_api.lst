                       16309 --6146: /*!****************************************************************************************************************//**
                       16310 --6147:  * \ingroup     PKCLRSAAPIsInternal
                       16311 --6148:  * \brief       Verify the plaintext generated by #R_PKCL_RsaDecryptInit ~ #R_PKCL_RsaDecryptFinal.
                       16312 --6149:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       16313 --6150:  * \param       [in]     p_plain_data  A structure consisting of plaintext byte length len and data pointer p_data.
                       16314 --6151:  * \return
                       16315 --6152:  *  - #PKCL_RET_OK:                       Successful completion
                       16316 --6153:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       16317 --6154:  *  - #PKCL_RET_TAMPERERR:                Tampering has been detected
                       16318 --6155:  * \par Security components
                       16319 --6156:  *  - No
                       16320 --6157:  * \par Global Variables
                       16321 --6158:  *  - None
                       16322 --6159:  * \par Call PKC-Driver API
                       16323 --6160:  *  - R_PKCD_RsaModExpInit
                       16324 --6161:  *  - R_PKCD_RsaModExpOperate
                       16325 --6162:  *  - R_PKCD_RsaModExpFinal
                       16326 --6163:  * \par Precondition
                       16327 --6164:  *  - None
                       16328 --6165:  * \par Detailed description
                       16329 --6166:  *      -
                       16330 --6167:  * \par Remarks
                       16331 --6168:  *  - None
                       16332 --6169:  *
                       16333 --6170:  * Pseudo-code for the function can be found below.
                       16334 --6171:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       16335 --6172:  *  -# Set cipher_data_in to the ciphertext and its length entered in #R_PKCL_RsaDecryptInit.
                       16336 --6173:  *  -# If #PKC_RSA_PADDING_NO == p_ctx->padding_option, then
                       16337 --6174:  *    -# Encode the plaintext data with #r_pkcl_rsa_padding_no, and set ret to #PKCL_RET_OK.
                       16338 --6175:  *  -# Else if #PKC_RSA_PADDING_PKCS1 == p_ctx->padding_option, then
                       16339 --6176:  *    -# Encode the plaintext data with #r_pkcl_rsa_enc_scheme_pkcs1, and set temp_ret to the return value.
                       16340 --6177:  *  -# Else
                       16341 --6178:  *    -# Encode the plaintext data with #r_pkcl_rsa_enc_scheme_oaep, and set temp_ret to the return value.
                       16342 --6179:  *  -# If #PKCL_RET_OK == temp_ret, then
                       16343 --6180:  *    -# Initialize RSA modular exponentiation operation with R_PKCD_RsaModExpInit,
                       16344 --6181:  *       and set drv_ret to the return value.
                       16345 --6182:  *    -# If PKCD_RET_OK == drv_ret, then
                       16346 --6183:  *      -# Calculate ciphertext = (encoded message) ^ e mod n with R_PKCD_RsaModExpOperate,
                       16347 --6184:  *         and set drv_ret to the return value.
                       16348 --6185:  *      -# Get the generated ciphertext with R_PKCD_RsaModExpFinal and set drv_ret to the return value.
                       16349 --6186:  *      -# Set cipher_data_out to the generated data and its byte length.
                       16350 --6187:  *  -# If PKCD_RET_OK == drv_ret, then
                       16351 --6188:  *    -# Set ret to 0 for double check.
                       16352 --6189:  *    -# If cipher_data_in.len == cipher_data_out.len

                                                                      Page 281
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       16353 --6190:  *      -# Compare data in cipher_data_out.p_data and cipher_data_in.p_data with #r_pkcl_cmn_cmp_byte,
                       16354 --6191:  *         and set cmp_ret to the comparison result.
                       16355 --6192:  *      -# If #PKC_BOOL_TRUE == cmp_ret
                       16356 --6193:  *        -# Add #PKCL_CMN_RET_OK_HALF_1 to ret.
                       16357 --6194:  *        -# Compare data in cipher_data_out.p_data and cipher_data_in.p_data with #r_pkcl_cmn_cmp_byte,
                       16358 --6195:  *           and set cmp_ret to the comparison result.
                       16359 --6196:  *        -# If #PKC_BOOL_TRUE == cmp_ret, then
                       16360 --6197:  *          -# Add #PKCL_CMN_RET_OK_HALF_2 to ret.
                       16361 --6198:  *        -# Else
                       16362 --6199:  *            -# Do nothing.
                       16363 --6200:  *      -# Else
                       16364 --6201:  *        -# Do nothing.
                       16365 --6202:  *    -# Else
                       16366 --6203:  *      -# Do nothing.
                       16367 --6204:  *  -# Else
                       16368 --6205:  *    -# Do nothing.
                       16369 --6206:  *  -# If #PKCL_RET_OK != ret
                       16370 --6207:  *    -# Set ret to #PKCL_RET_TAMPERERR.
                       16371 --6208:  *  -# Else
                       16372 --6209:  *    -# Do nothing.
                       16373 --6210:  *  -# Return ret.
                       16374 --6211:  *
                       16375 --6212:  * \callgraph
                       16376 --6213:  *********************************************************************************************************************/
