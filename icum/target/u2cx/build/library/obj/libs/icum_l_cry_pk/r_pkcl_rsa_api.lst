                       11604 --4442: /*!****************************************************************************************************************//**
                       11605 --4443:  * \ingroup     PKCLRSAAPIsInternal
                       11606 --4444:  * \brief       Perform the EME-PKCS1-v1_5 scheme for RSA decryption
                       11607 --4445:  * \param       [in]     p_em          A structure consisting of the byte length len of the encoded message and
                       11608 --4446:  *                                      the data pointer p_data.
                       11609 --4447:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       11610 --4448:  * \param       [in]     mod_len       Byte length of modulus n.
                       11611 --4449:  * \param       [in,out] p_plain       Output plaintext.
                       11612 --4450:  * \return
                       11613 --4451:  *  - #PKCL_RET_OK:                       Successful completion
                       11614 --4452:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       11615 --4453:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       11616 --4454:  *  - #PKCL_RET_RSA_SCHEMEERR:            RSA scheme processing failed
                       11617 --4455:  * \par Security components
                       11618 --4456:  *  - No
                       11619 --4457:  * \par Global Variables
                       11620 --4458:  *  - None
                       11621 --4459:  * \par Call PKC-Driver API
                       11622 --4460:  *  - None
                       11623 --4461:  * \par Precondition
                       11624 --4462:  *  - None
                       11625 --4463:  * \par Detailed description
                       11626 --4464:  *      - The plaintext is separated from the encoded message and output.
                       11627 --4465:  * \par Remarks

                                                                      Page 200
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       11628 --4466:  *  - If p_ctx-> verified_gen_plain is not FALSE, save the PS value in p_ctx-> p_buf.
                       11629 --4467:  *
                       11630 --4468:  * Pseudo-code for the function can be found below.
                       11631 --4469:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       11632 --4470:  *  -# If !(p_em->len > mod_len)
                       11633 --4471:  *    -# If ((p_em->p_data[0] == 0x00) and (p_em->p_data[1] == #PKCL_RSA_PKCS_PADDING_NUM))
                       11634 --4472:  *      -# Set #PKCL_RSA_PS_OFFSET into ps_loop.
                       11635 --4473:  *      -# Loop while ((ps_loop < mod_len) and (p_em->p_data[ps_loop] != 0x00))
                       11636 --4474:  *        -# Increment ps_loop.
                       11637 --4475:  *      -# Set (ps_loop - #PKCL_RSA_PS_OFFSET) into ps_len.
                       11638 --4476:  *      -# If (((ps_len - #PKCL_RSA_PS_OFFSET) < mod_len) and (ps_len >= #PKCL_RSA_PKCS_PS_LEN_MIN))
                       11639 --4477:  *        -# If (p_plain->len >= (p_em->len - (#PKCL_RSA_PS_OFFSET + ps_len + 1U)))
                       11640 --4478:  *          -# Set (p_em->len - (#PKCL_RSA_PS_OFFSET + ps_len + 1U)) into p_plain->len.
                       11641 --4479:  *          -# Set p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len + 1]-p_em->p_data[#PKCL_RSA_PS_OFFSET +
                       11642 --4480:  *            ps_len + p_plain->len] into p_plain->p_data with #r_pkcl_cmn_cpy_byte.
                       11643 --4481:  *          -# Set ret to #PKCL_RET_OK.
                       11644 --4482:  *        -# Else
                       11645 --4483:  *          -# Set ret to #PKCL_RET_LENGTHERR.
                       11646 --4484:  *        -# If (#PKC_BOOL_FALSE != p_ctx->verified_gen_plain) && (#PKCL_RET_OK == ret)
                       11647 --4485:  *          -# Store the PS value in the buffer p_verified_plain->cipher.
                       11648 --4486:  *        -# Else
                       11649 --4487:  *          -# Do nothing.
                       11650 --4488:  *      -# Else
                       11651 --4489:  *        -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       11652 --4490:  *    -# Else
                       11653 --4491:  *      -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       11654 --4492:  *  -# Else
                       11655 --4493:  *    -# Set ret to #PKCL_RET_LENGTHERR.
                       11656 --4494:  *
                       11657 --4495:  * \callgraph
                       11658 --4496:  *********************************************************************************************************************/
                       11659 --4497: static pkcl_ret_t r_pkcl_rsa_dec_scheme_pkcs1(const st_pkc_data_t* const p_em, const st_pkc_rsa_ctx_t* const p_ctx,
