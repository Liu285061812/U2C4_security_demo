                       10471 --4011: /*!****************************************************************************************************************//**
                       10472 --4012:  * \ingroup     PKCLRSAAPIsInternal
                       10473 --4013:  * \brief       Perform the EME-PKCS1-v1_5 encoding scheme for RSA encryption.
                       10474 --4014:  * \param       [in]     p_plain       A structure consisting of plaintext byte length len and data pointer p_data.
                       10475 --4015:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       10476 --4016:  * \param       [in]     mod_len       Byte length of modulus n.
                       10477 --4017:  * \param       [in,out] p_em          Output encode message.
                       10478 --4018:  * \param       [in]     p_check_ps    A pointer to PS. If p_check_em is not NULL, PS is obtained from this parameter.
                       10479 --4019:  *                                     This parameter is used when verifying the validity of the decryption operation.
                       10480 --4020:  * \return
                       10481 --4021:  *  - #PKCL_RET_OK:                       Successful completion
                       10482 --4022:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       10483 --4023:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       10484 --4024:  *  - #PKCL_RET_DRBGAPIERR:               External DRBG API returned error
                       10485 --4025:  *  - #PKCL_RET_RSA_SCHEMEERR:            RSA scheme processing failed
                       10486 --4026:  * \par Security components
                       10487 --4027:  *  - No
                       10488 --4028:  * \par Global Variables
                       10489 --4029:  *  - None
                       10490 --4030:  * \par Call PKC-Driver API
                       10491 --4031:  *  - None
                       10492 --4032:  * \par Precondition
                       10493 --4033:  *  - None
                       10494 --4034:  * \par Detailed description
                       10495 --4035:  *      - Call the external DRBG API to generate PS (padding string).
                       10496 --4036:  *        If the generated PS contains 0x00, repeat random number generation until it becomes a number other than 0x00.
                       10497 --4037:  *      - Create EM (encode message) by concatenating fixed value padding, PS, and message.
                       10498 --4038:  * \par Remarks

                                                                      Page 181
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       10499 --4039:  *  - If the argument p_check_ps is not null, use the value of p_check_ps for PS.
                       10500 --4040:  *
                       10501 --4041:  * Pseudo-code for the function can be found below.
                       10502 --4042:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       10503 --4043:  *  -# If ((p_plain->len + #PKCL_RSA_EME_PKCS_PAD_LEN_MIN) <= mod_len)
                       10504 --4044:  *    -# Set the adress of p_em->p_data[PKCL_RSA_PS_OFFSET] into p_ps.
                       10505 --4045:  *    -# Set ((mod_len - p_plain->len) - #PKCL_RSA_PKCS_PS_LEN_CALC) into ps_len.
                       10506 --4046:  *    -# If (NULL != p_check_em)
                       10507 --4047:  *      -# Get the PS value from p_check_em and set p_ps to it with # r_pkcl_cmn_cpy_byte.
                       10508 --4048:  *      -# Set external_ret to #PKCL_EXTERNAL_API_OK.
                       10509 --4049:  *    -# Else
                       10510 --4050:  *      -# Generate a pseudo-random bit sequence with p_ctx->p_drbg_api and set the generated
                       10511 --4051:  *         pseudo-random value into p_ps, and set the return value into external_ret.
                       10512 --4052:  *    -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       10513 --4053:  *      -# Loop while ((ps_loop < ps_len) and (#PKCL_EXTERNAL_API_OK == external_ret) and (#PKCL_RET_OK == ret))
                       10514 --4054:  *        -# Set 0 into zero_loop.
                       10515 --4055:  *        -# Loop while ((p_ps[ps_loop] == 0) and (zero_loop < #PKCL_RSA_PKCS_PS_ZERO_LOOP_MAX) and
                       10516 --4056:  *                       (#PKCL_EXTERNAL_API_OK == external_ret))
                       10517 --4057:  *          -# Generate a pseudo-random bit sequence with p_ctx->p_drbg_api and set the generated
                       10518 --4058:  *             pseudo-random value into p_ps[ps_loop], and set the return value into external_ret.
                       10519 --4059:  *          -# Increment zero_loop.
                       10520 --4060:  *        -# If (#PKCL_RSA_PKCS_PS_ZERO_LOOP_MAX > zero_loop)
                       10521 --4061:  *          -# Set ret to #PKCL_RET_OK.
                       10522 --4062:  *        -# Else
                       10523 --4063:  *          -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       10524 --4064:  *        -# Increment ps_loop.
                       10525 --4065:  *      -# If (#PKCL_RET_OK == ret)
                       10526 --4066:  *        -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       10527 --4067:  *          -# Set 0x00 into p_em->p_data[0].
                       10528 --4068:  *          -# Set #PKCL_RSA_PKCS_PADDING_NUM into p_em->p_data[1].
                       10529 --4069:  *          -# Set 0x00 into p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len]
                       10530 --4070:  *          -# Concatenate p_plain->p_data with p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len + 1]
                       10531 --4071:  *             with #r_pkcl_cmn_cpy_byte.
                       10532 --4072:  *        -# Else
                       10533 --4073:  *          -# Set ret to #PKCL_RET_DRBGAPIERR.
                       10534 --4074:  *    -# Else
                       10535 --4075:  *      -# Set ret to #PKCL_RET_DRBGAPIERR.
                       10536 --4076:  *  -# Else
                       10537 --4077:  *    -# Set ret to #PKCL_RET_LENGTHERR.
                       10538 --4078:  *  -# Return ret.
                       10539 --4079:  *
                       10540 --4080:  * \callgraph
                       10541 --4081:  *********************************************************************************************************************/
