                       12641 --4855: /*!****************************************************************************************************************//**
                       12642 --4856:  * \ingroup     PKCLRSAAPIsInternal
                       12643 --4857:  * \brief       Perform the EMSA-PKCS1-v1_5 scheme for RSA signature generation
                       12644 --4858:  * \param       [in]     p_digest      A structure consisting of the byte length len of the message digest and
                       12645 --4859:  *                                      the data pointer p_data.
                       12646 --4860:  * \param       [in]     hash_type     Hash type used for p_digest.
                       12647 --4861:  * \param       [in]     mod_len       Byte length of modulus n.
                       12648 --4862:  * \param       [in,out] p_em          Output encode message.
                       12649 --4863:  * \return
                       12650 --4864:  *  - #PKCL_RET_OK:                       Successful completion
                       12651 --4865:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       12652 --4866:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       12653 --4867:  *  - #PKCL_RET_RSA_SCHEMEERR:            RSA scheme processing failed
                       12654 --4868:  * \par Security components
                       12655 --4869:  *  - No
                       12656 --4870:  * \par Global Variables
                       12657 --4871:  *  - #s_der_sha1, #s_der_sha224, #s_der_sha256, #s_der_sha384, #s_der_sha512, #s_der_sha512_224,
                       12658 --4872:  *    #s_der_sha512_256, #s_der_sha3_224, #s_der_sha3_256, #s_der_sha3_384, #s_der_sha3_512
                       12659 --4873:  * \par Call PKC-Driver API
                       12660 --4874:  *  - None
                       12661 --4875:  * \par Precondition
                       12662 --4876:  *  - None
                       12663 --4877:  * \par Detailed description
                       12664 --4878:  *      - Get the DER of the DigestInfo value from the hash type.
                       12665 --4879:  *      - Create T, which is a concatenation of DER and hash value.
                       12666 --4880:  *      - Create EM (encode message) by concatenating fixed value padding and PS, T.
                       12667 --4881:  * \par Remarks
                       12668 --4882:  *  - None
                       12669 --4883:  *
                       12670 --4884:  * Pseudo-code for the function can be found below.
                       12671 --4885:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       12672 --4886:  *  -# If (p_em->len >= mod_len)
                       12673 --4887:  *    -# If (#PKC_HASH_TYPE_SHA1 == hash_type)
                       12674 --4888:  *      -# Copy #s_der_sha1 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12675 --4889:  *      -# Set the byte size of #s_der_sha1 into der_len.
                       12676 --4890:  *    -# Else if (#PKC_HASH_TYPE_SHA2_224 == hash_type)
                       12677 --4891:  *      -# Copy #s_der_sha224 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12678 --4892:  *      -# Set the byte size of #s_der_sha224 into der_len.
                       12679 --4893:  *    -# Else if (#PKC_HASH_TYPE_SHA2_256 == hash_type)
                       12680 --4894:  *      -# Copy #s_der_sha256 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12681 --4895:  *      -# Set the byte size of #s_der_sha256 into der_len.
                       12682 --4896:  *    -# Else if (#PKC_HASH_TYPE_SHA2_512 == hash_type)
                       12683 --4897:  *      -# Copy #s_der_sha512 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12684 --4898:  *      -# Set the byte size of #s_der_sha512 into der_len.
                       12685 --4899:  *    -# Else if (#PKC_HASH_TYPE_SHA2_512_224 == hash_type)
                       12686 --4900:  *      -# Copy #s_der_sha512_224 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12687 --4901:  *      -# Set the byte size of #s_der_sha512_224 into der_len.
                       12688 --4902:  *    -# Else if (#PKC_HASH_TYPE_SHA2_256 == hash_type)
                       12689 --4903:  *      -# Copy #s_der_sha512_256 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12690 --4904:  *      -# Set the byte size of #s_der_sha512_256 into der_len.
                       12691 --4905:  *    -# Else if (#PKC_HASH_TYPE_SHA3_224 == hash_type)
                       12692 --4906:  *      -# Copy #s_der_sha3_224 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12693 --4907:  *      -# Set the byte size of #s_der_sha224 into der_len.
                       12694 --4908:  *    -# Else if (#PKC_HASH_TYPE_SHA3_256 == hash_type)
                       12695 --4909:  *      -# Copy #s_der_sha3_256 to the array der_data with #r_pkcl_cmn_cpy_byte.

                                                                      Page 218
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       12696 --4910:  *      -# Set the byte size of #s_der_sha3_256 into der_len.
                       12697 --4911:  *    -# Else if (#PKC_HASH_TYPE_SHA3_384 == hash_type)
                       12698 --4912:  *      -# Copy #s_der_sha3_384 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12699 --4913:  *      -# Set the byte size of #s_der_sha3_384 into der_len.
                       12700 --4914:  *    -# Else
                       12701 --4915:  *      -# Copy #s_der_sha3_512 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       12702 --4916:  *      -# Set the byte size of #s_der_sha3_512 into der_len.
                       12703 --4917:  *    -# Get the hash length with #r_pkcl_rsa_get_hash_len and set the length into the variable hash_len.
                       12704 --4918:  *    -# If (hash_len == p_digest->len)
                       12705 --4919:  *      -# Set (der_len + p_digest->len) into the variable t_len.
                       12706 --4920:  *      -# Set ((p_em->len - t_len) - #PKCL_RSA_PKCS_PS_LEN_CALC) into the variable ps_len.
                       12707 --4921:  *      -# Concatenate ps_len bytes of fixed value (#PKCL_RSA_PKCS_PS_NUM) with p_em->p_data[#PKCL_RSA_PS_OFFSET]
                       12708 --4922:  *         using #r_pkcl_cmn_cpy_byte.
                       12709 --4923:  *      -# Concatenate der_data with p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len + 1] using #r_pkcl_cmn_cpy_byte.
                       12710 --4924:  *      -# Concatenate p_digest->p_data with p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len + 1U + der_len]
                       12711 --4925:  *         using #r_pkcl_cmn_cpy_byte.
                       12712 --4926:  *      -# Set 0x00 into p_em->p_data[0].
                       12713 --4927:  *      -# Set 0x01 into p_em->p_data[1].
                       12714 --4928:  *      -# Set 0x00 into p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len].
                       12715 --4929:  *      -# Set ret to #PKCL_RET_OK.
                       12716 --4930:  *    -# Else
                       12717 --4931:  *      -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       12718 --4932:  *  -# Else
                       12719 --4933:  *    -# Set ret to #PKCL_RET_LENGTHERR.
                       12720 --4934:  *  -# Return ret.
                       12721 --4935:  *
                       12722 --4936:  * \callgraph
                       12723 --4937:  *********************************************************************************************************************/
