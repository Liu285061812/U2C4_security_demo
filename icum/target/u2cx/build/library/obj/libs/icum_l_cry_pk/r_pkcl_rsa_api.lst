                       10889 --4173: /**********************************************************************************************************************
                       10890 --4174: * Function Name : r_pkcl_rsa_enc_scheme_oaep
                       10891 --4175: **********************************************************************************************************************/
                       10892 --4176: /*!****************************************************************************************************************//**
                       10893 --4177:  * \ingroup     PKCLRSAAPIsInternal
                       10894 --4178:  * \brief       Perform the EME-OAEP encoding scheme for RSA encryption
                       10895 --4179:  * \param       [in]     p_plain       A structure consisting of plaintext byte length len and data pointer p_data.
                       10896 --4180:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       10897 --4181:  * \param       [in]     mod_len       Byte length of modulus n.
                       10898 --4182:  * \param       [in,out] p_em          Output encode message.
                       10899 --4183:  * \param       [in]     p_check_seed  A pointer to the random seed. If p_check_seed is not NULL,
                       10900 --4184:  *                                     seed value is obtained from this parameter.
                       10901 --4185:  *                                     This parameter is used when verifying the validity of the decryption operation.
                       10902 --4186:  * \return
                       10903 --4187:  *  - #PKCL_RET_OK:                       Successful completion
                       10904 --4188:  *  - #PKCL_RET_PARAMERR:                 Invalid argument entered
                       10905 --4189:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       10906 --4190:  *  - #PKCL_RET_HASHAPIERR:               External HASH API returned error
                       10907 --4191:  *  - #PKCL_RET_DRBGAPIERR:               External DRBG API returned error
                       10908 --4192:  * \par Security components
                       10909 --4193:  *  - No
                       10910 --4194:  * \par Global Variables
                       10911 --4195:  *  - None
                       10912 --4196:  * \par Call PKC-Driver API
                       10913 --4197:  *  - None
                       10914 --4198:  * \par Precondition
                       10915 --4199:  *  - None
                       10916 --4200:  * \par Detailed description
                       10917 --4201:  *      - Calculate Lhash by calling the external HASH API.
                       10918 --4202:  *      - Create DB by concatenating Lhash, PS, fixed value padding, and messages.
                       10919 --4203:  *      - Call the external DRBG API to generate a seed.

                                                                      Page 188
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       10920 --4204:  *      - Call #r_pkcl_rsa_mgf1 to generate a mask from the DB and seed, and xor the generated mask and DB,
                       10921 --4205:  *         or seed to generate maskedSeed and maskedDB.
                       10922 --4206:  *      - Create EM (encode message) by concatenating 0x00 with maskedSeed and maskedDB.
                       10923 --4207:  * \par Remarks
                       10924 --4208:  *  - If the argument p_check_seed is not null, use the value of p_check_seed for seed.
                       10925 --4209:  *
                       10926 --4210:  * Pseudo-code for the function can be found below.
                       10927 --4211:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       10928 --4212:  *  -# Initialize the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_init_api and set the return value
                       10929 --4213:  *     into the variable external_ret.
                       10930 --4214:  *  -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       10931 --4215:  *    -# If NULL != p_ctx->label.p_data Then,
                       10932 --4216:  *      -# Set p_label to p_ctx->label.p_data.
                       10933 --4217:  *      -# Set label_len to p_ctx->label.len.
                       10934 --4218:  *    -# Else
                       10935 --4219:  *      -# Set p_label to label_empty.
                       10936 --4220:  *      -# Set label_len to 0U.
                       10937 --4221:  *    -# Input p_label into the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_update_api,
                       10938 --4222:  *       and set the return value into external_ret.
                       10939 --4223:  *    -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       10940 --4224:  *      -# Get the hashed value with p_ctx->p_mask_option->p_hash_info->p_hash_final_api,
                       10941 --4225:  *         set the hashed value and its length into lhash_val and lhash_len respectively,
                       10942 --4226:  *         and set the return value into external_ret.
                       10943 --4227:  *      -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       10944 --4228:  *        -# Set ret to #PKCL_RET_OK.
                       10945 --4229:  *      -# Else
                       10946 --4230:  *        -# Set ret to #PKCL_RET_HASHAPIERR.
                       10947 --4231:  *    -# Else
                       10948 --4232:  *      -# Set ret to #PKCL_RET_HASHAPIERR.
                       10949 --4233:  *  -# Else
                       10950 --4234:  *    -# Set ret to #PKCL_RET_HASHAPIERR.
                       10951 --4235:  *  -# If (#PKCL_RET_OK == ret)
                       10952 --4236:  *    -# If (((#PKCL_RSA_DOUBLE_LEN * lhash_len) <= (mod_len - #PKCL_RSA_PS_OFFSET)) and
                       10953 --4237:  *           (p_plain->len <= ((mod_len - (#PKCL_RSA_DOUBLE_LEN * lhash_len)) - #PKCL_RSA_PS_OFFSET)))
                       10954 --4238:  *      -# Copy lhash_val to db with #r_pkcl_cmn_cpy_byte.
                       10955 --4239:  *      -# Set (((mod_len - p_plain->len) - (#PKCL_RSA_DOUBLE_LEN * lhash_len)) - #PKCL_RSA_PS_OFFSET) into ps_len.
                       10956 --4240:  *      -# Concatenate ps_len bytes of zeros with db[lhash_len] using #r_pkcl_cmn_set_byte.
                       10957 --4241:  *      -# Set 0x01 into db[lhash_len + ps_len].
                       10958 --4242:  *      -# Concatenate p_plain->p_data with db[lhash_len + ps_len + 1] using #r_pkcl_cmn_cpy_byte.
                       10959 --4243:  *      -# If (NULL != p_check_seed)
                       10960 --4244:  *        -# Get the PS value from p_check_seed and set seed_val to it with # r_pkcl_cmn_cpy_byte.
                       10961 --4245:  *        -# Set external_ret to #PKCL_EXTERNAL_API_OK.
                       10962 --4246:  *      -# Else
                       10963 --4247:  *        -# Generate seed with p_ctx->p_drbg_api, set the seed into seed_val, and set the return value into
                       10964 --4248:  *           the variable external_ret.
                       10965 --4249:  *      -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       10966 --4250:  *        -# Generate the masked value of seed_val, set the masked value into mask with #r_pkcl_rsa_mgf1,
                       10967 --4251:  *           and set ret to the return value.
                       10968 --4252:  *        -# If (#PKCL_RET_OK == ret)
                       10969 --4253:  *          -# Loop while (xor_loop < ((mod_len - lhash_len) - 1U)), and increment xor_loop for each loop.
                       10970 --4254:  *            -# Set exclusive OR of (db[xor_loop] and mask[xor_loop]) into db[xor_loop].
                       10971 --4255:  *          -# Generate the masked value of db, set the masked value into mask with #r_pkcl_rsa_mgf1,
                       10972 --4256:  *             and set ret to the return value.
                       10973 --4257:  *          -# If (#PKCL_RET_OK == ret)
                       10974 --4258:  *            -# Loop while xor_loop < is less than lhash_len, and increment xor_loop for each loop.
                       10975 --4259:  *              -# Set exclusive OR of (seed_val[xor_loop] and mask[xor_loop]) into seed_val[xor_loop].
                       10976 --4260:  *            -# Set 0 into em_pos.
                       10977 --4261:  *            -# p_em->p_data[em_pos].
                       10978 --4262:  *            -# Set 1 into em_pos.
                       10979 --4263:  *            -# Concatenate seed_val with p_em->p_data[em_pos] using #r_pkcl_cmn_cpy_byte.
                       10980 --4264:  *            -# Set (em_pos + lhash_len) into em_pos.

                                                                      Page 189
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       10981 --4265:  *            -# Concatenate db with p_em->p_data[em_pos] using #r_pkcl_cmn_cpy_byte.
                       10982 --4266:  *            -# Set (em_pos + (mod_len - lhash_len) - 1) into em_pos.
                       10983 --4267:  *      -# Else
                       10984 --4268:  *        -# Set ret to #PKCL_RET_DRBGAPIERR.
                       10985 --4269:  *    -# Else
                       10986 --4270:  *      -# Set ret to #PKCL_RET_LENGTHERR.
                       10987 --4271:  *  -# Return ret.
                       10988 --4272:  *
                       10989 --4273:  * \callgraph
                       10990 --4274:  *********************************************************************************************************************/
                       10991 --4275: static pkcl_ret_t r_pkcl_rsa_enc_scheme_oaep(const st_pkc_data_t* const p_plain, const st_pkc_rsa_ctx_t* const p_ctx,
                       10992 	.align	2
