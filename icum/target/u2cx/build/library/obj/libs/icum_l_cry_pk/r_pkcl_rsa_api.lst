                        8643 --3280:  *                 and set ret to the return value.
                        8644 --3281:  *          -# Else
                        8645 --3282:  *            -# Set ret to #PKCL_RET_PARAMERR.
                        8646 --3283:  *        -# Else if (#PKC_RSA_PADDING_PKCS1_PSS == p_ctx->padding_option)
                        8647 --3284:  *          -# If ((NULL != p_ctx->p_mask_option) and (NULL != p_ctx->p_drbg_api))
