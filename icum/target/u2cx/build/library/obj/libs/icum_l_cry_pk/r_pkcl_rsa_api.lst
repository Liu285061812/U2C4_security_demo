                       13444 --5126:  *    -# Set 0x00 into p_em->p_data[0].
                       13445 --5127:  *    -# Set 0x01 into p_em->p_data[1].
                       13446 --5128:  *    -# Set 0x00 into p_em->p_data[#PKCL_RSA_PS_OFFSET + ps_len].
                       13447 --5129:  *    -# Compare p_em->p_data with another_em.p_data using #r_pkcl_cmn_cmp_byte and set cmp_ret to the return value.
                       13448 --5130:  *    -# If (#PKC_BOOL_TRUE == cmp_ret)
                       13449 --5131:  *      -# Add #PKCL_CMN_RET_OK_HALF_1 to ret.
                       13450 --5132:  *      -# Compare p_em->p_data with another_em.p_data using #r_pkcl_cmn_cmp_byte and set cmp_ret to the return value.
                       13451 --5133:  *      -# If (#PKC_BOOL_TRUE == cmp_ret)
                       13452 --5134:  *        -# Add #PKCL_CMN_RET_OK_HALF_2 to ret.
                       13453 --5135:  *      -# Else
                       13454 --5136:  *        -# Set ret to #PKCL_RET_RSA_VERIFAIL.
                       13455 --5137:  *    -# Else
                       13456 --5138:  *      -# Set ret to #PKCL_RET_RSA_VERIFAIL.
                       13457 --5139:  *  -# Else
                       13458 --5140:  *    -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       13459 --5141:  *  -# If (((#pkcl_ret_t)0U == ret) || (#PKCL_CMN_RET_OK_HALF_1 == ret) || (#PKCL_CMN_RET_OK_HALF_2 == ret)), then
                       13460 --5142:  *    -# Set ret to #PKCL_RET_TAMPERERR.
                       13461 --5143:  *  -# Return ret.
                       13462 --5144:  *
