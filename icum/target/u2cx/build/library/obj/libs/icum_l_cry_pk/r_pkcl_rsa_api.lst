                       13366 --5048: /**********************************************************************************************************************
                       13367 --5049: * Function Name : r_pkcl_rsa_verify_scheme_pkcs1
                       13368 --5050: **********************************************************************************************************************/
                       13369 --5051: /*!****************************************************************************************************************//**
                       13370 --5052:  * \ingroup     PKCLRSAAPIsInternal
                       13371 --5053:  * \brief       Perform the EMSA-PKCS1-v1_5 scheme for RSA signature verification
                       13372 --5054:  * \param       [in]     p_em          A structure consisting of the byte length len of the encoded message and
                       13373 --5055:  *                                      the data pointer p_data.
                       13374 --5056:  * \param       [in]     p_digest      A structure consisting of the byte length len of the message digest and
                       13375 --5057:  *                                      the data pointer p_data.
                       13376 --5058:  * \param       [in]     hash_type     Hash type used for p_digest.
                       13377 --5059:  * \param       [in]     mod_len       Byte length of modulus n.
                       13378 --5060:  * \return
                       13379 --5061:  *  - #PKCL_RET_OK:                       Successful completion
                       13380 --5062:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       13381 --5063:  *  - #PKCL_RET_RSA_SCHEMEERR             RSA scheme processing failed
                       13382 --5064:  *  - #PKCL_RET_RSA_VERIFAIL:             RSA verification failed

                                                                      Page 230
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       13383 --5065:  *  - #PKCL_RET_TAMPERERR:                Tampering has been detected
                       13384 --5066:  * \par Security components
                       13385 --5067:  *  - No
                       13386 --5068:  * \par Global Variables
                       13387 --5069:  *  - #s_der_sha1, #s_der_sha224, #s_der_sha256, #s_der_sha384, #s_der_sha512, #s_der_sha512_224,
                       13388 --5070:  *    #s_der_sha512_256, #s_der_sha3_224, #s_der_sha3_256, #s_der_sha3_384, #s_der_sha3_512
                       13389 --5071:  * \par Call PKC-Driver API
                       13390 --5072:  *  - None
                       13391 --5073:  * \par Precondition
                       13392 --5074:  *  - None
                       13393 --5075:  * \par Detailed description
                       13394 --5076:  *      - Get the DER of the DigestInfo value from the hash type.
                       13395 --5077:  *      - Create T, which is a concatenation of DER and hash value.
                       13396 --5078:  *      - Concatenate fixed value padding with PS and T and compare the created EM'with EM. \n
                       13397 --5079:  *        In case of inconsistency, #PKCL_RET_RSA_VERIFAIL is returned.
                       13398 --5080:  * \par Remarks
                       13399 --5081:  *  - None
                       13400 --5082:  *
                       13401 --5083:  * Pseudo-code for the function can be found below.
                       13402 --5084:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       13403 --5085:  *  -# Set a buffer adress and mod_len to another_em, which is a #st_pkc_data_t type structure variable.
                       13404 --5086:  *  -# If (#PKC_HASH_TYPE_SHA1 == hash_type)
                       13405 --5087:  *    -# Copy #s_der_sha1 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13406 --5088:  *    -# Set the byte size of #s_der_sha1 into der_len.
                       13407 --5089:  *  -# Else if (#PKC_HASH_TYPE_SHA2_224 == hash_type)
                       13408 --5090:  *    -# Copy #s_der_sha224 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13409 --5091:  *    -# Set the byte size of #s_der_sha224 into der_len.
                       13410 --5092:  *  -# Else if (#PKC_HASH_TYPE_SHA2_256 == hash_type)
                       13411 --5093:  *    -# Copy #s_der_sha256 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13412 --5094:  *    -# Set the byte size of #s_der_sha256 into der_len.
                       13413 --5095:  *  -# Else if (#PKC_HASH_TYPE_SHA2_512 == hash_type)
                       13414 --5096:  *    -# Copy #s_der_sha512 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13415 --5097:  *    -# Set the byte size of #s_der_sha512 into der_len.
                       13416 --5098:  *  -# Else if (#PKC_HASH_TYPE_SHA2_512_224 == hash_type)
                       13417 --5099:  *    -# Copy #s_der_sha512_224 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13418 --5100:  *    -# Set the byte size of #s_der_sha512_224 into der_len.
                       13419 --5101:  *  -# Else if (#PKC_HASH_TYPE_SHA2_256 == hash_type)
                       13420 --5102:  *    -# Copy #s_der_sha512_256 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13421 --5103:  *    -# Set the byte size of #s_der_sha512_256 into der_len.
                       13422 --5104:  *  -# Else if (#PKC_HASH_TYPE_SHA3_224 == hash_type)
                       13423 --5105:  *    -# Copy #s_der_sha3_224 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13424 --5106:  *    -# Set the byte size of #s_der_sha224 into der_len.
                       13425 --5107:  *  -# Else if (#PKC_HASH_TYPE_SHA3_256 == hash_type)
                       13426 --5108:  *    -# Copy #s_der_sha3_256 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13427 --5109:  *    -# Set the byte size of #s_der_sha3_256 into der_len.
                       13428 --5110:  *  -# Else if (#PKC_HASH_TYPE_SHA3_384 == hash_type)
                       13429 --5111:  *    -# Copy #s_der_sha3_384 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13430 --5112:  *    -# Set the byte size of #s_der_sha3_384 into der_len.
                       13431 --5113:  *  -# Else
                       13432 --5114:  *    -# Copy #s_der_sha3_512 to the array der_data with #r_pkcl_cmn_cpy_byte.
                       13433 --5115:  *    -# Set the byte size of #s_der_sha3_512 into der_len.
                       13434 --5116:  *  -# Get the hash length with #r_pkcl_rsa_get_hash_len and set the variable hash_len to the length.
                       13435 --5117:  *  -# If (hash_len == p_digest->len)
                       13436 --5118:  *    -# Set ret to 0 fof double check.
                       13437 --5119:  *    -# Set (der_len + p_digest->len) into the variable t_len.
                       13438 --5120:  *    -# Set ((p_em->len - t_len) - #PKCL_RSA_PKCS_PS_LEN_CALC) into the variable ps_len.
                       13439 --5121:  *    -# Concatenate ps_len bytes of fixed value (#PKCL_RSA_PKCS_PS_NUM) with another_em.p_data[#PKCL_RSA_PS_OFFSET]
                       13440 --5122:  *       using #r_pkcl_cmn_cpy_byte.
                       13441 --5123:  *    -# Concatenate der_data with another_em.p_data[#PKCL_RSA_PS_OFFSET + ps_len + 1] using #r_pkcl_cmn_cpy_byte.
                       13442 --5124:  *    -# Concatenate p_digest->p_data with another_em.p_data[#PKCL_RSA_PS_OFFSET + ps_len + 1 + der_len]
                       13443 --5125:  *       using #r_pkcl_cmn_cpy_byte.

                                                                      Page 231
