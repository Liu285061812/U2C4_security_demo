                       14679 --5509: /**********************************************************************************************************************
                       14680 --5510: * Function Name : r_pkcl_rsa_verify_scheme_pss
                       14681 --5511: **********************************************************************************************************************/
                       14682 --5512: /*!****************************************************************************************************************//**
                       14683 --5513:  * \ingroup     PKCLRSAAPIsInternal
                       14684 --5514:  * \brief
                       14685 --5515:  * \param       [in]     p_em          A structure consisting of the byte length len of the encoded message and
                       14686 --5516:  *                                      the data pointer p_data.
                       14687 --5517:  * \param       [in]     p_digest      A structure consisting of the byte length len of the message digest and
                       14688 --5518:  *                                      the data pointer p_data.
                       14689 --5519:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       14690 --5520:  * \param       [in]     mod_len       Byte length of modulus n.
                       14691 --5521:  * \return
                       14692 --5522:  *  - #PKCL_RET_OK:                       Successful completion
                       14693 --5523:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       14694 --5524:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       14695 --5525:  *  - #PKCL_RET_HASHAPIERR:               External HASH API returned error
                       14696 --5526:  *  - #PKCL_RET_RSA_SCHEMEERR:            RSA scheme processing failed
                       14697 --5527:  *  - #PKCL_RET_RSA_VERIFAIL:             RSA verification failed
                       14698 --5528:  *  - #PKCL_RET_TAMPERERR:                Tampering has been detected
                       14699 --5529:  * \par Security components
                       14700 --5530:  *  - No
                       14701 --5531:  * \par Global Variables
                       14702 --5532:  *  - None
                       14703 --5533:  * \par Call PKC-Driver API
                       14704 --5534:  *  - None
                       14705 --5535:  * \par Precondition
                       14706 --5536:  *  - None
                       14707 --5537:  * \par Detailed description

                                                                      Page 253
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       14708 --5538:  *      - Separate the masked DB from the EM and get the DB.
                       14709 --5539:  *      - Create M'by concatenating fixed value padding with digest and salt.
                       14710 --5540:  *      - Hash M'to create H'.
                       14711 --5541:  *      - Compare H and H'. In case of inconsistency, #PKCL_RET_RSA_VERIFAIL is returned.
                       14712 --5542:  * \par Remarks
                       14713 --5543:  *  - None
                       14714 --5544:  *
                       14715 --5545:  * Pseudo-code for the function can be found below.
                       14716 --5546:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       14717 --5547:  *  -# Set salt length p_ctx->p_mask_option->salt_len into the variable salt_len.
                       14718 --5548:  *  -# Set (mod_len * #PKCL_RSA_OCTET) into embits_len.
                       14719 --5549:  *  -# Set hash_len to the hash length used for the mask with #r_pkcl_rsa_get_hash_len.
                       14720 --5550:  *  -# If (hash_len != 0U)
                       14721 --5551:  *    -# If (p_em->len >=  (salt_len + hash_len + #PKCL_RSA_PSS_PS_LEN_CALC))
                       14722 --5552:  *      -# If (#PKCL_RSA_PSS_PADDING_NUM == p_em->p_data[p_em->len-1])
                       14723 --5553:  *        -# Set ((mod_len - hash_len) - 1) into db_len.
                       14724 --5554:  *        -# Set p_em->p_data[0]-p_em->p_data[db_len-1] into db with #r_pkcl_cmn_cpy_byte.
                       14725 --5555:  *        -# Set p_em->p_data[db_len]-p_em->p_data[db_len+hash_len-1] into hash_val with #r_pkcl_cmn_cpy_byte.
                       14726 --5556:  *        -# If ((p_em->p_data[0] &
                       14727 --5557:  *                (~(#PKCL_RSA_BIT_CLEAR_NUM >> ((mod_len * #PKCL_RSA_OCTET) - (embits_len - 1))))) == 0U)
                       14728 --5558:  *          -# Generate the masked variable of hash_val with #r_pkcl_rsa_mgf1, and set ret to the return value.
                       14729 --5559:  *          -# If (#PKCL_RET_OK == ret)
                       14730 --5560:  *            -# Loop while xor_loop is less than db_len, and increment xor_loop for each loop.
                       14731 --5561:  *              -# Set exclusive OR of (db[xor_loop] and mask[xor_loop]) into db[xor_loop].
                       14732 --5562:  *            -# Set (db[0] & (#PKCL_RSA_BIT_CLEAR_NUM >> (mod_len * #PKCL_RSA_OCTET - (embits_len - 1)))) into db[0].
                       14733 --5563:  *            -# Set (((mod_len - salt_len) - hash_len) - #PKCL_RSA_PSS_PS_LEN_CALC) into ps_len.
                       14734 --5564:  *            -# Set db[ps_len + 1U]-db[ps_len + salt_len + 1U] into salt_val with #r_pkcl_cmn_cpy_byte.
                       14735 --5565:  *            -# Set #PKCL_RSA_PSS_PAD_LEN bytes of zeros to m_data with #r_pkcl_cmn_set_byte.
                       14736 --5566:  *            -# Concatenate p_digest->p_data with m_data[#PKCL_RSA_PSS_PAD_LEN] using #r_pkcl_cmn_cpy_byte.
                       14737 --5567:  *            -# Concatenate salt_val with m_data[#PKCL_RSA_PSS_PAD_LEN + p_digest->len] using #r_pkcl_cmn_cpy_byte.
                       14738 --5568:  *            -# Set (#PKCL_RSA_PSS_PAD_LEN + p_digest->len + salt_len) to m_len.
                       14739 --5569:  *            -# Initialize the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_init_api,
                       14740 --5570:  *               and set external_ret to the return value.
                       14741 --5571:  *            -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       14742 --5572:  *              -# Input m_data into the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_update_api,
                       14743 --5573:  *                 and set external_ret to the return value.
                       14744 --5574:  *              -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       14745 --5575:  *                -# Get the hashed value with p_ctx->p_mask_option->p_hash_info->p_hash_final_api,
