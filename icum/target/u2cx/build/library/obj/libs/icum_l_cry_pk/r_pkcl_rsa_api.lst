                        8609 --3246:  * \return
                        8610 --3247:  *  - #PKCL_RET_OK:                       Successful completion
                        8611 --3248:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                        8612 --3249:  *  - #PKCL_RET_PARAMERR:                 Invalid argument entered
