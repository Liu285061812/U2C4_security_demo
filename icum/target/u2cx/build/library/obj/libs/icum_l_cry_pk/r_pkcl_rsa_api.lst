                       15804 --5937: /**********************************************************************************************************************
                       15805 --5938: * Function Name : r_pkcl_rsa_verified_gen_sign
                       15806 --5939: **********************************************************************************************************************/
                       15807 --5940: /*!****************************************************************************************************************//**
                       15808 --5941:  * \ingroup     PKCLRSAAPIsInternal
                       15809 --5942:  * \brief       Verify the signature generated by #R_PKCL_RsaSignInit ~ #R_PKCL_RsaSignFinal.
                       15810 --5943:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       15811 --5944:  * \param       [in]     p_sign_data   A structure consisting of the pointer to the signature p_data
                       15812 --5945:  *                                     and its byte length.
                       15813 --5946:  * \return
                       15814 --5947:  *  - #PKCL_RET_OK:                       Successful completion
                       15815 --5948:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       15816 --5949:  *  - #PKCL_RET_TAMPERERR:                Tampering has been detected
                       15817 --5950:  * \par Security components
                       15818 --5951:  *  - No
                       15819 --5952:  * \par Global Variables
                       15820 --5953:  *  - None
                       15821 --5954:  * \par Call PKC-Driver API
                       15822 --5955:  *  - R_PKCD_RsaModExpInit
                       15823 --5956:  *  - R_PKCD_RsaModExpOperate
                       15824 --5957:  *  - R_PKCD_RsaModExpFinal
                       15825 --5958:  * \par Precondition
                       15826 --5959:  *  - None
                       15827 --5960:  * \par Detailed description
                       15828 --5961:  *      -
                       15829 --5962:  * \par Remarks
                       15830 --5963:  *  - None
                       15831 --5964:  *
                       15832 --5965:  * Pseudo-code for the function can be found below.
                       15833 --5966:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.

                                                                      Page 272
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       15834 --5967:  *  -# Set digest_data to the digest data and its byte length entered in #R_PKCL_RsaSignInit.
                       15835 --5968:  *  -# If #PKC_RSA_PADDING_NO == p_ctx->padding_option, then
                       15836 --5969:  *    -# Encode the plaintext data with #r_pkcl_rsa_padding_no.
                       15837 --5970:  *    -# Set the encoded digest and its byte to digest_data.
                       15838 --5971:  *  -# Else
                       15839 --5972:  *    -# Do nothing.
                       15840 --5973:  *  -# Initialize RSA modular exponentiation operation with R_PKCD_RsaModExpInit, and set drv_ret to the return value.
                       15841 --5974:  *  -# If PKCD_RET_OK == drv_ret, then
                       15842 --5975:  *    -# Calculate (the sinature value in p_sign_data) ^ e mod n, and set drv_ret to the return value.
                       15843 --5976:  *    -# If PKCD_RET_OK == drv_ret, then
                       15844 --5977:  *      -# Get the reslut of the above calculation with R_PKCD_RsaModExpFinal, and set drv_ret to the return value.
                       15845 --5978:  *      -# Set em_data to the result of the above calculation.
                       15846 --5979:  *      -# If PKCD_RET_OK == drv_ret, then
                       15847 --5980:  *        -# If #PKC_RSA_PADDING_PKCS1 == p_ctx->padding_option, then
                       15848 --5981:  *          -# Verify that data in digest_data and em_data are consistent with #r_pkcl_rsa_verify_scheme_pkcs1,
                       15849 --5982:  *             and set ret to the verification result.
                       15850 --5983:  *        -# Else if #PKC_RSA_PADDING_PKCS1_PSS == p_ctx->padding_option, then
