                       11929 --4574: /*!****************************************************************************************************************//**
                       11930 --4575:  * \ingroup     PKCLRSAAPIsInternal
                       11931 --4576:  * \brief       Perform the EME-OAEP scheme for RSA decryption
                       11932 --4577:  * \param       [in]     p_em          A structure consisting of the byte length len of the encoded message and
                       11933 --4578:  *                                      the data pointer p_data.
                       11934 --4579:  * \param       [in]     p_ctx         A pointer to a structure that summarizes the parameters required by RSA.
                       11935 --4580:  * \param       [in]     mod_len       Byte length of modulus n.
                       11936 --4581:  * \param       [in,out] p_plain       Output plaintext.
                       11937 --4582:  * \return
                       11938 --4583:  *  - #PKCL_RET_OK:                       Successful completion
                       11939 --4584:  *  - #PKCL_RET_INTERNALERR:              Internal processing failed
                       11940 --4585:  *  - #PKCL_RET_LENGTHERR:                Invalid argument length entered
                       11941 --4586:  *  - #PKCL_RET_HASHAPIERR:               External HASH API returned error
                       11942 --4587:  *  - #PKCL_RET_RSA_SCHEMEERR:            RSA scheme processing failed
                       11943 --4588:  * \par Security components
                       11944 --4589:  *  - No
                       11945 --4590:  * \par Global Variables
                       11946 --4591:  *  - None
                       11947 --4592:  * \par Call PKC-Driver API
                       11948 --4593:  *  - None
                       11949 --4594:  * \par Precondition
                       11950 --4595:  *  - None
                       11951 --4596:  * \par Detailed description
                       11952 --4597:  *      - Calculate Lhash by calling the external HASH API.
                       11953 --4598:  *      - Calculate seed and DB by separating maskedDB and maskedSeed from the encoded message.
                       11954 --4599:  *      - Get Lhash'from DB and compare with Lhash. \n
                       11955 --4600:  *        In case of inconsistency, #PKCL_RET_RSA_SCHEMEERR is returned.
                       11956 --4601:  *      - Get plaintext from DB.
                       11957 --4602:  * \par Remarks
                       11958 --4603:  *  - If p_ctx-> verified_gen_plain is not FALSE, save the seed value in p_ctx-> p_buf.
                       11959 --4604:  *
                       11960 --4605:  * Pseudo-code for the function can be found below.
                       11961 --4606:  *  -# Initialize the variable ret with #PKCL_RET_INTERNALERR.
                       11962 --4607:  *  -# Initialize the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_init_api and set the return value
                       11963 --4608:  *     to the variable external_ret.
                       11964 --4609:  *  -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       11965 --4610:  *    -# If NULL != p_ctx->label.p_data Then,
                       11966 --4611:  *      -# Set p_label to p_ctx->label.p_data.
                       11967 --4612:  *      -# Set label_len to p_ctx->label.len.
                       11968 --4613:  *    -# Else
                       11969 --4614:  *      -# Set p_label to label_empty.
                       11970 --4615:  *      -# Set label_len to 0U.
                       11971 --4616:  *    -# Input p_label into the hash function with p_ctx->p_mask_option->p_hash_info->p_hash_update_api,
                       11972 --4617:  *       and set the return value into external_ret.
                       11973 --4618:  *    -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       11974 --4619:  *      -# Get the hashed value with p_ctx->p_mask_option->p_hash_info->p_hash_final_api,
                       11975 --4620:  *         set the hashed value and its length into lhash_val and lhash_len respectively,
                       11976 --4621:  *         and set the return value into external_ret.
                       11977 --4622:  *      -# If (#PKCL_EXTERNAL_API_OK == external_ret)
                       11978 --4623:  *        -# Set ret to #PKCL_RET_OK.
                       11979 --4624:  *      -# Else
                       11980 --4625:  *        -# Set ret to #PKCL_RET_HASHAPIERR.
                       11981 --4626:  *    -# Else
                       11982 --4627:  *      -# Set ret to #PKCL_RET_HASHAPIERR.
                       11983 --4628:  *  -# Else
                       11984 --4629:  *    -# Set ret to #PKCL_RET_HASHAPIERR.
                       11985 --4630:  *  -# If (#PKCL_RET_OK == ret)
                       11986 --4631:  *    -# Set 0 into em_pos.
                       11987 --4632:  *    -# Set p_em->p_data[em_pos] into y.

                                                                      Page 206
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qa01.si
                       11988 --4633:  *    -# Set 1 into em_pos.
                       11989 --4634:  *    -# If (0x00 == y)
                       11990 --4635:  *      -# Set p_em->p_data[em_pos]-p_em->p_data[em_pos+lhash_len-1] into seed_val with #r_pkcl_cmn_cpy_byte.
                       11991 --4636:  *      -# Set em_pos+lhash_len into em_pos.
                       11992 --4637:  *      -# Set ((mod_len - lhash_len) - 1) into db_len.
                       11993 --4638:  *      -# Set p_em->p_data[em_pos]-p_em->p_data[em_pos+db_len-1] into db with #r_pkcl_cmn_cpy_byte.
                       11994 --4639:  *      -# Generate the masked value of db with #r_pkcl_rsa_mgf1, set the masked value into mask,
                       11995 --4640:  *         and set the return velue into ret.
                       11996 --4641:  *      -# If (#PKCL_RET_OK == ret)
                       11997 --4642:  *        -# Loop while xor_loop is less than db_len, and increment xor_loop for each loop.
                       11998 --4643:  *          -# Set exclusive OR of (seed_val[xor_loop] and mask[xor_loop]) into seed_val[xor_loop].
                       11999 --4644:  *        -# If (PKC_BOOL_FALSE != p_ctx->verified_gen_plain), then
                       12000 --4645:  *          -# Store the calculated seed value in the buffer p_verified_plain->cipher.
                       12001 --4646:  *        -# Else
                       12002 --4647:  *          -# Do nothing.
                       12003 --4648:  *        -# Generate the masked value of seed_val with #r_pkcl_rsa_mgf1, set the masked value into mask,
                       12004 --4649:  *           and set the return velue into ret.
                       12005 --4650:  *        -# If (#PKCL_RET_OK == ret)
                       12006 --4651:  *          -# Loop while xor_loop is less than db_len, and increment xor_loop for each loop.
                       12007 --4652:  *            -# Set exclusive OR of (db[xor_loop] and mask[xor_loop]) into db[xor_loop].
                       12008 --4653:  *          -# Set db[0]-db[lhash_len-1] into an_lhash_val with #r_pkcl_cmn_cpy_byte.
                       12009 --4654:  *          -# Compare an_lhash_val with lhash_val with #r_pkcl_cmn_cmp_byte, and set the return value into cmp_ret.
                       12010 --4655:  *          -# If (#PKC_BOOL_TRUE == cmp_ret)
                       12011 --4656:  *            -# Set lhash_len into db_pos.
                       12012 --4657:  *            -# Loop while ((db_pos < db_len) and (db[db_pos] != 0x01))
                       12013 --4658:  *              -# Increment db_pos.
                       12014 --4659:  *            -# If (db[db_pos] == 0x01)
                       12015 --4660:  *              -# Set db_pos+1 into dp_pos.
                       12016 --4661:  *              -# Set db_len - db_pos into p_plain->len.
                       12017 --4662:  *              -# Set db[db_pos]-db[db_pos+p_plain->len-1] into p_plain->p_data with #r_pkcl_cmn_cpy_byte.
                       12018 --4663:  *            -# Else
                       12019 --4664:  *              -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       12020 --4665:  *          -# Else
                       12021 --4666:  *            -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       12022 --4667:  *    -# Else
                       12023 --4668:  *      -# Set ret to #PKCL_RET_RSA_SCHEMEERR.
                       12024 --4669:  *  -# Return ret.
                       12025 --4670:  *
                       12026 --4671:  * \callgraph
                       12027 --4672:  *********************************************************************************************************************/
                       12028 --4673: static pkcl_ret_t r_pkcl_rsa_dec_scheme_oaep(const st_pkc_data_t* const p_em, const st_pkc_rsa_ctx_t* const p_ctx,
