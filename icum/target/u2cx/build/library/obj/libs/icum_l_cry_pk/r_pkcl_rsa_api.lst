                          69 --27: /* PRQA S 0310,3305 ++ # D002 In order not to disclose the structure used internally,
                          70 --28:                             after receiving it with type uint8_t*, cast it to the type of the structure. */
                          71 --29: /* PRQA S 0751 ++ # D006 Cast required to match the type of the calling function. */
                          72 --30: /* PRQA S 1503 ++ # D010 No problem if it is unused because it is an API called from outside the library  */
                          73 --31: /* PRQA S 2912,2913,3383,3384 ++ # D012 Have confirmed in advance that the value doesn't wrap around. */
                          74 --32: /* PRQA S 2981 ++ # D013 Local variable ret of APIs sets INTERNALERR to the initial value
                          75 --33:                         as a countermeasure against attacks that pass through processing. */
                          76 --34: /* PRQA S 2984 ++ # D014 Because it is calculated in consideration of future expansion */
                          77 --35: /* PRQA S 2985, 2995 ++ # D015 Required if key length not divisible by 8bit is supported. */
                          78 --36: /* PRQA S 3673 ++ # D017 Because future extensions may edit values in context. */
                          79 --37: /* PRQA S 5002 ++ # D019 There is no problem because it is used in a system that can distinguish
                          80 --38:                     file names of 8 characters or more. */
                          81 --39: /* PRQA S 2880,2992,2996 ++ # D020 Double check in signature verification as a countermeaseure
                          82 --40:                     against attacks that skip a certain process */
