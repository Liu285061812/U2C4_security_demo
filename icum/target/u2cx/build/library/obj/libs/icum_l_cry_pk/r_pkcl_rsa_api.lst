                        9794 --3754:  *          -# Set ret to #PKCL_RET_OK.
                        9795 --3755:  *        -# Else
                        9796 --3756:  *          -# Set ret to #PKCL_RET_PARAMERR.
                        9797 --3757:  *      -# Else if (#PKC_RSA_PADDING_PKCS1 == p_ctx->padding_option)
                        9798 --3758:  *        -# If (NULL == p_ctx->p_mask_option)
