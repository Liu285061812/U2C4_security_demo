                        8639 --3276:  *        -# If ((#PKC_RSA_PADDING_NO == p_ctx->padding_option) or (#PKC_RSA_PADDING_PKCS1 == p_ctx->padding_option))
                        8640 --3277:  *          -# If (NULL == p_ctx->p_mask_option)
                        8641 --3278:  *            -# If (#PKC_RSA_PADDING_PKCS1 == p_ctx->padding_option)
