                        1378 --490: * Function name: mh_MYDATA_ConvertServ
                        1379 --491: * Description  : Convert MyData error to service result
                        1380 --492: * Arguments    : (IN) conv_err : Source error
                        1381 --493: * Return Value : SERV_OK                : Success.
                        1382 --494: *                SERV_PRM_ERROR         : Parameter error
                        1383 --495: *                SERV_PENDING           : Pending
                        1384 --496: *                SERV_IN_PROCESS        : Flash writing is continuing
                        1385 --497: *                SERV_MYDATA_SET_EMPTY  : No data set declared
                        1386 --498: *                SERV_MYDATA_SLOT_EMPTY : Double sided blank
                        1387 --499: *                SERV_MYDATA_INVALID_IDX: Invalid data set index
                        1388 --500: *                SERV_MYDATA_SIZE_ERR   : Invalid data size
                        1389 --501: *                SERV_NVM_UNAVAILABLE   : Unable to use Secure DF
                        1390 --502: *                SERV_SRC_MEM_ERROR     : Abnormality of data slot address
                        1391 --503: *                SERV_DEST_MEM_ERROR    : Error in data storage address
                        1392 --504: *                SERV_NVM_SYS_ERROR     : Abnormality of flash operation
                        1393 --505: *                SERV_NVM_SYS_ERROR_CRITICAL: FACI abnormality
                        1394 --506: *                SERV_NVM_PROG_ERROR    : Flash write error
                        1395 --507: *                SERV_SYS_ERROR         : Not acquire AES usage rights
                        1396 --508: *                SERV_AES_TIMEOUT_ERROR : AES timeout occurred
                        1397 --509: *                SERV_AES_PRM_ERROR     : Abnormality during DVC calculation
                        1398 --510: ****************************************************************************************/
