                         599 --251:     /* Check pointer */
                         600 --252:     wr_pt = (uint32_t)g_wr_pt;
                         601 --253:     if (NVM_WARN_DATA_NUM <= wr_pt)
                         602 --254:     {
                         603 --255:         /* pointer wrap around */
                         604 --256:         wr_pt = (uint32_t)NVM_WARN_WRPT_INIT;
                         605 --257:     }
                         606 --258:     else
                         607 --259:     {
                         608 --260:         /* pointer is Within range */
                         609 --261:     }
                         610 --263:     /* Put ring buffer */
                         611 --264:     g_nvm_warn_buff.data[wr_pt].ds_type    = ds_type;
                         612 --265:     g_nvm_warn_buff.data[wr_pt].slot_index = slot_num;
                         613 --266:     /* pointer update */
                         614 --267:     wr_pt++;
                         615 --268:     g_wr_pt = (uint8_t)wr_pt;
                         616 --269:     /* Set NVM Data Warning occurrence flag */
                         617 --270:     g_nvm_data_warning = NVM_DATA_WARNING;
                         618 --272:     return (ER_OK);
