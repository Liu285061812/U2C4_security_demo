                        1300 --578:                     && (data_status_a.counter == g_data_status_b.counter))
                        1301 --579:                 {
                        1302 --580:                     /* Side-A data adopted */
                        1303 --581:                     /* already stored as read data */
                        1304 --583:                     /* two sides data normal => not warning */
                        1305 --584:                 }
                        1306 --585:                 else
                        1307 --586:                 {
                        1308 --587:                     ret_val = ER_MM_FLS_DATA_INVALID;
