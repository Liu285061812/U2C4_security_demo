                        1682 --984:         ret_val = ER_MM_FLS_AES_PRM_ERROR;
                        1683 --985:     }
                        1684 --986: #endif /* !defined(FSW_DVC_HASH) */
                        1685 --987:     else
                        1686 --988:     {
                        1687 --989:         /* never occur */
                        1688 --990:         ret_val = ER_PARAM;
                        1689 --991:     }
                        1690 --992:     return (ret_val);
                        1691 --993: }
