                        6557 --2789:                 g_phase_GC = FLS_PHASE_7;
                        6558 --2790:             }
                        6559 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                        6560 --2792:             {
                        6561 --2793:                 /* When the flash memory is not yet formatted */
                        6562 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                        6563 --2795:                 g_phase_GC = FLS_PHASE_9;
                        6564 --2796:             }
                        6565 --2797:             else
                        6566 --2798:             {
                        6567 --2799:                 /* When other flash states */
                        6568 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                        6569 --2801:                 g_phase_GC = FLS_PHASE_9;
                        6570 --2802:             }
                        6571 --2803:         }
                        6572 --2804:     }
                        6573 --2805:     else
                        6574 --2806:     {
