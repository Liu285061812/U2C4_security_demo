                        4516 --649: /***************************************************************************************
                        4517 --650: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0022]:[ICUMFW_UD_MM_FlashMNG_0022]
                        4518 --651: * Function name: mm_FLS_ExecWriteDF
                        4519 --652: * Description  : Perform the slot data write for ICU-M DF (Direct addressing)
                        4520 --653: * Arguments    : (in) r_icumif_job_id_t job_id  : job id

                                                                      Page 77
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                        4521 --654: *                (in) uint32_t size     : size of data to write
                        4522 --655: *                (in) uint32_t offset   : byte offset position of the area to be write
                        4523 --656: *                (in) uint8_t *p_data   : address of memory in which data to be written is stored
                        4524 --657: * Return Value : ER_OK
                        4525 --658: *                ER_PARAM
                        4526 --659: *                ER_IN_PROCESS
                        4527 --660: *                ER_MM_FLS_IN_PROGRESS
                        4528 --661: *                ER_MM_FLS_SYS          (ER_L_FLS_FLOW,ER_L_FLS_REJECTED)
                        4529 --662: *                ER_MM_FLS_SYS_CRITICAL (ER_L_FLS_INTERNAL)
                        4530 --663: *                ER_MM_FLS_PROG         (ER_L_FLS_PROGRAM)
                        4531 --664: *                ER_MM_FLS_UNAVAILABLE  (ER_L_FLS_UNAVAILABLE)
                        4532 --665: ***************************************************************************************/
                        4533 --666: static uint32_t mm_FLS_ExecWriteDF(r_icumif_job_id_t job_id, uint32_t size, uint32_t offset, const uint8_t *p_data)
                        4534 --667: {
                        4535 --668:     uint32_t err;
                        4536 --670:     err = ER_OK;
                        4537 --671:     switch ((uint32_t)g_phase_ExWrite)
                        4538 --672:     {
                        4539 --673:         /* write operation acceptance phase */
                        4540 --674:         case FLS_PHASE_0:
                        4541 --675:             err = L_FLS_REQ_WriteFlash_ram(AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM, offset, size, (const uint8_t *)p_data);
                        4542 --676:             if (ER_IN_PROCESS == err)
                        4543 --677:             {
                        4544 --678:                 /* process is progress */
                        4545 --679:                 g_phase_ExWrite = FLS_PHASE_1;
                        4546 --680:             }
                        4547 --681:             else
                        4548 --682:             {
                        4549 --683:                 /* error occurred */
                        4550 --684:                 g_phase_ExWrite = FLS_PHASE_9;
                        4551 --685:             }
                        4552 --686:             break;
                        4553 --688:         /* wait for write operation completion phase */
                        4554 --689:         case FLS_PHASE_1:
                        4555 --690:             err = L_FLS_IsFinished_ram((uint16_t)job_id, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                        4556 --691:             if (ER_IN_PROCESS == err)
                        4557 --692:             {
                        4558 --693:                 /* process is progress */
                        4559 --694:                 /* do nothing          */
                        4560 --695:             }
                        4561 --696:             else
                        4562 --697:             {
                        4563 --698:                 /* operation completion or error occurred */
                        4564 --699:                 g_phase_ExWrite = FLS_PHASE_9;
                        4565 --700:             }
                        4566 --701:             break;
                        4567 --703:         default:
                        4568 --704:             /* Not occurred */
                        4569 --705:             break;
                        4570 --706:     } /* end of switch ((uint32_t)g_phase_ExWrite) */
                        4571 --708:     /* end process */
                        4572 --709:     mm_FLS_EndPhaseInternal(&err, &g_phase_ExWrite);
                        4573 --710:     return (err);
                        4574 --711: }
                        4575 --713: /**********************************************************************************************************************
                        4576 --714: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0023]:[ICUMFW_UD_MM_FlashMNG_0023]
                        4577 --715: * Function name: mm_FLS_GetSlotData
