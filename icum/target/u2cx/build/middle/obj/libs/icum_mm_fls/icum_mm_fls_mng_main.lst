                       20045 --1353:     if (ER_OK != err)
                       20046 --1354:     {
                       20047 --1355:         /* Do nothing */
                       20048 --1356:     }
                       20049 --1357:     else
                       20050 --1358:     {
                       20051 --1359:         /* normal end */
                       20052 --1360:         if (FLS_GC_NORMAL == gc_state)
                       20053 --1361:         {
                       20054 --1362:             /* When the power is not turned off during GC */
                       20055 --1363:             *p_prohibited_block = reserve_block;
                       20056 --1364:         }
                       20057 --1365:         else if (FLS_GC_DURING_1 == gc_state)
                       20058 --1366:         {
                       20059 --1367:             /* When the power is turned off during GC (during data transfer) */
                       20060 --1368:             *p_prohibited_block = reserve_block;
                       20061 --1369:         }
                       20062 --1370:         else if (FLS_GC_DURING_2 == gc_state)
                       20063 --1371:         {
                       20064 --1372:             /* When the power is turned off during GC (during erase) */
                       20065 --1373:             *p_prohibited_block = source_block;
                       20066 --1374:         }
                       20067 --1375:         else if (FLS_GC_ALL_BLANK == gc_state)
                       20068 --1376:         {
                       20069 --1377:             /* When the flash memory is not yet formatted */
                       20070 --1378:             err = ER_MM_FLS_ALL_BLANK;
                       20071 --1379:         }
                       20072 --1380:         else
                       20073 --1381:         {
                       20074 --1382:             /* When other flash states */
                       20075 --1383:             err = ER_MM_FLS_FORMAT_ERR;
                       20076 --1384:         }
                       20077 --1385:     }

                                                                      Page 334
