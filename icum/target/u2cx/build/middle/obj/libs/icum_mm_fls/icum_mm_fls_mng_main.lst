                        4579 --717: * Arguments    : (in) uint16_t target_side          : target side
                        4580 --718: *                (in) flash_location_t *p_index     : specified block index of data set
                        4581 --719: *                (out) uint8_t *p_data              : A pointer to the memory that stores the obtained slot data

                                                                      Page 78
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                        4582 --720: *                (out) data_status_t *p_data_status : A pointer to the memory that stores the obtained slot data status
                        4583 --721: * Return Value : ER_OK
                        4584 --722: *                ER_MM_FLS_DATA_BLANK
                        4585 --723: *                ER_MM_FLS_AES_TIME_OUT
                        4586 --724: *                ER_MM_FLS_AES_PRM_ERROR
                        4587 --725: *                ER_MM_FLS_MEM_SOURCE
                        4588 --726: *                ER_MM_FLS_SYS          (ER_L_FLS_FLOW,ER_L_FLS_REJECTED)
                        4589 --727: *                ER_MM_FLS_DATA_INVALID (ER_L_FLS_ECC2EDF1)
                        4590 --728: ***********************************************************************************************************************/
                        4591 --729: static uint32_t mm_FLS_GetSlotData(const uint16_t target_side, const flash_location_t *const p_index, uint8_t *p_data,
                        4592 --730:                                    data_status_t *const p_data_status)
                        4593 --731: {
                        4594 --732:     uint32_t err;
                        4595 --733:     uint32_t ret_val;
                        4596 --734:     uint32_t offset;
                        4597 --735:     uint16_t check_block_num;
                        4598 --736:     flash_location_t wk_block_index;
                        4599 --737:     fls_data_area_pointer_t data_buffer_pnt;
                        4600 --738:     uint8_t tag_result;
                        4601 --740:     /* return status initial value */
                        4602 --741:     p_data_status->dvc_result = FLS_CHK_OK;
                        4603 --742:     p_data_status->counter    = FLS_ZERO_U32;
                        4604 --743:     p_data_status->ds_type    = FLS_ZERO_U8;
                        4605 --744:     p_data_status->slot_num   = FLS_ZERO_U8;
                        4606 --745:     p_data_status->data_size  = FLS_ZERO_U16;
                        4607 --747:     wk_block_index = *p_index;
                        4608 --748:     data_buffer_pnt.p_u8 = p_data;
                        4609 --750:     /* Check data area header */
                        4610 --751:     /* Check Data TAG (first logical block only) */
                        4611 --752:     err = mm_FLS_CheckTag(target_side, &wk_block_index, &tag_result);
                        4612 --753:     if ((uint32_t)FLS_TAG_VALID == (uint32_t)tag_result)
                        4613 --754:     {
                        4614 --755:         /* the TAG area is non-blank and the value is valid */
                        4615 --756:         /* Data area read (header only) */
                        4616 --757:         mm_FLS_ChangeAddr(target_side, wk_block_index, &offset);
                        4617 --758:         err = mm_FLS_ExecReadDF(AG_L_FLS_BANK_ICUM, offset, sizeof(fls_data_area_header_t), data_buffer_pnt.p_u8);
                        4618 --759:         if (ER_OK != err)
                        4619 --760:         {
                        4620 --761:             /* error occurred */
                        4621 --762:             ret_val = err;
                        4622 --763:         }
                        4623 --764:         else
                        4624 --765:         {
                        4625 --766:             /* Check data size is valid */
                        4626 --767:             err = mm_FLS_PreCheck(FLS_SELECT_ICUM_DF,
                        4627 --768:                                   FLS_SELECT_SECURE,
                        4628 --769:                                   data_buffer_pnt.p_header->ds_type,
                        4629 --770:                                   data_buffer_pnt.p_header->data_size,
                        4630 --771:                                   FLS_OP_READ);
                        4631 --772:             if (ER_OK == err)
                        4632 --773:             {
