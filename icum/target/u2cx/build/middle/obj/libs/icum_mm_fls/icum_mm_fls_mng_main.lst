                       36943 --2637:                 break;
                       36944 --2638:             case FLS_PHASE_2:
                       36945 --2639:                 /* GC destination block erase */
                       36946 --2640:                 err = mm_FLS_EraseGCDest(job_id, reserve_block);
                       36947 --2641:                 break;
                       36948 --2642:             case FLS_PHASE_3:
                       36949 --2643:                 /* Search data map. Read if there is valid data in GC source block. */
                       36950 --2644:                 ret_val = mm_FLS_ReadFblockMapData(source_block,
                       36951 --2645:                                                    &(wk_index.block_idx),
                       36952 --2646:                                                    &ds_type,
