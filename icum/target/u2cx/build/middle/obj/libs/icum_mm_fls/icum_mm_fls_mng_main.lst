                       57965 --4723:         {
                       57966 --4724:             case FLS_PHASE_0:
                       57967 --4725:                 /* Get resource & first physical block erase start */
                       57968 --4726:                 err = mm_FLS_EraseFormatFBlkSt(job_id);
                       57969 --4727:                 break;
                       57970 --4728:             case FLS_PHASE_1:
