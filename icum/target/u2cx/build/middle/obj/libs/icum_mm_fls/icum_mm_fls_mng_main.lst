                       16891 --3737: static uint32_t mm_FLS_ExecEraseDF(const r_icumif_job_id_t job_id, const uint32_t block_num)
                       16892 --3738: {
                       16893 --3739:     uint32_t err;
                       16894 --3740:     uint32_t lul_offset;
                       16895 --3741:     uint32_t lock_handle;
                       16896 --3743:     err = ER_OK;
                       16897 --3744:     lock_handle = (uint32_t)job_id;
                       16898 --3745:     switch ((uint32_t)g_phase_ExErase)
                       16899 --3746:     {
                       16900 --3747:         /* erase operation acceptance phase */
                       16901 --3748:         case FLS_PHASE_0:
                       16902 --3749:             /* convert index to address */
                       16903 --3750:             mm_FLS_ChangeFlagAddr(block_num, FLS_DF_BLOCK_TOP, &lul_offset);
                       16904 --3752:             /* perform the flash erasing */
                       16905 --3753:             err = L_FLS_REQ_EraseFlash_ram(AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM, lul_offset, FLS_ERASE_BLOCK_SIZE);
                       16906 --3755:             if (ER_IN_PROCESS == err)
                       16907 --3756:             {
                       16908 --3757:                 /* change next phase (wait for erase operation completion phase) */
                       16909 --3758:                 g_phase_ExErase = FLS_PHASE_1;
                       16910 --3759:             }
                       16911 --3760:             else
                       16912 --3761:             {
                       16913 --3762:                 /* error occurred */
                       16914 --3763:                 g_phase_ExErase = FLS_PHASE_9;
                       16915 --3764:             }
                       16916 --3765:             break;
                       16917 --3767:         /* wait for erase operation completion phase */
                       16918 --3768:         case FLS_PHASE_1:
                       16919 --3769:             err = L_FLS_IsFinished_ram((uint16_t)lock_handle, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                       16920 --3770:             if (ER_OK == err)
                       16921 --3771:             {
                       16922 --3772:                 /* Erasing process is completed */
                       16923 --3773:                 g_phase_ExErase = FLS_PHASE_9;
                       16924 --3774:             }
                       16925 --3775:             else if (ER_IN_PROCESS == err)
                       16926 --3776:             {
                       16927 --3777:                 /* process is progress */
                       16928 --3778:                 /* do nothing          */
                       16929 --3779:             }
                       16930 --3780:             else
                       16931 --3781:             {
                       16932 --3782:                 /* error occurred */
                       16933 --3783:                 g_phase_ExErase = FLS_PHASE_9;
                       16934 --3784:             }
                       16935 --3785:             break;
                       16936 --3787:         default:
                       16937 --3788:             /* Not occurred */
                       16938 --3789:             break;
                       16939 --3790:     }
