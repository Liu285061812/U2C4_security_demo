                       46040 --2744: /***************************************************************************************
                       46041 --2745: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0095]:[ICUMFW_UD_MM_FlashMNG_0095]
                       46042 --2746: * Function name: mm_FLS_GetGCState
                       46043 --2747: * Description  : Get flash GC state (for MM_FLS_CollectGarbage)
                       46044 --2748: * Arguments    : (in)  r_icumif_job_id_t job_id  : job id
                       46045 --2749: *                (out) uint32_t* p_source_block  : GC source block number
                       46046 --2750: *                (out) uint32_t* p_reserve_block : GC reserve block number

                                                                      Page 764
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       46047 --2751: * Return Value : ER_OK
                       46048 --2752: *                ER_PARAM
                       46049 --2753: *                ER_PENDING
                       46050 --2754: *                ER_MM_FLS_ALL_BLANK
                       46051 --2755: *                ER_MM_FLS_FORMAT_ERR
                       46052 --2756: *                ER_L_FLS_UNAVAILBLE
                       46053 --2757: *                ER_L_FLS_INTERNAL
                       46054 --2758: ***************************************************************************************/
                       46055 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                       46056 --2760:                                   uint32_t *const p_reserve_block)
                       46057 --2761: {
                       46058 --2762:     uint32_t err;
                       46059 --2763:     gc_state_t gc_state;
                       46060 --2765:     /* get flash resource & sets FACIACC flag */
                       46061 --2766:     err = mm_FLS_GetFlashResource(job_id);
                       46062 --2767:     if (ER_OK == err)
                       46063 --2768:     {
                       46064 --2769:         err = mm_FLS_CheckGCFlag(&gc_state, p_source_block, p_reserve_block);
                       46065 --2770:         if (ER_OK != err)
                       46066 --2771:         {
                       46067 --2772:             g_phase_GC = FLS_PHASE_9;
                       46068 --2773:         }
                       46069 --2774:         else
                       46070 --2775:         {
                       46071 --2776:             if (FLS_GC_NORMAL == gc_state)
                       46072 --2777:             {
                       46073 --2778:                 /* When the power is not turned off during GC */
                       46074 --2779:                 g_phase_GC = FLS_PHASE_1;
                       46075 --2780:             }
                       46076 --2781:             else if (FLS_GC_DURING_1 == gc_state)
                       46077 --2782:             {
                       46078 --2783:                 /* When the power is turned off during GC (during data transfer) */
                       46079 --2784:                 g_phase_GC = FLS_PHASE_2;
                       46080 --2785:             }
                       46081 --2786:             else if (FLS_GC_DURING_2 == gc_state)
                       46082 --2787:             {
                       46083 --2788:                 /* When the power is turned off during GC (during erase) */
                       46084 --2789:                 g_phase_GC = FLS_PHASE_7;
                       46085 --2790:             }
                       46086 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                       46087 --2792:             {
                       46088 --2793:                 /* When the flash memory is not yet formatted */
                       46089 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                       46090 --2795:                 g_phase_GC = FLS_PHASE_9;
                       46091 --2796:             }
                       46092 --2797:             else
                       46093 --2798:             {
                       46094 --2799:                 /* When other flash states */
                       46095 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                       46096 --2801:                 g_phase_GC = FLS_PHASE_9;
                       46097 --2802:             }
                       46098 --2803:         }
                       46099 --2804:     }
                       46100 --2805:     else
                       46101 --2806:     {
                       46102 --2807:         g_phase_GC = FLS_PHASE_9;
                       46103 --2808:     }
                       46104 --2809:     return (err);
                       46105 --2810: }
