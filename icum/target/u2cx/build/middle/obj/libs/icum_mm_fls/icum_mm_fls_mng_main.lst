                       27926 --4044:     {
                       27927 --4045:         /* Since side-A TAG area is blank, it is determined as an unwritten area */
                       27928 --4046:         /* Perform a blank check on the side-B (first writing side)  */
                       27929 --4047:         /* Considering power turn off during side-B writing */
                       27930 --4048:         mm_FLS_ChangeAddr(FLS_SIDE_B, *p_flash_location, &offset);
