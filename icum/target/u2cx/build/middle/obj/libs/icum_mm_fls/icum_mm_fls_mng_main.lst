                        1283 --559:                 slot_num = g_data_status_b.slot_num;
                        1284 --560:             }
                        1285 --561:             else if ((uint32_t)FLS_CHK_OK != (uint32_t)g_data_status_b.dvc_result)
                        1286 --562:             {
                        1287 --563:                 /* Side-A data adopted */
                        1288 --564:                 /* already stored as read data */
                        1289 --566:                 /* sets data flash information */
                        1290 --567:                 set_data_warn_flag = FLS_FLAG_ON_U8;
                        1291 --568:                 ds_type = data_status_a.ds_type;
                        1292 --569:                 slot_num = data_status_a.slot_num;
                        1293 --570:             }
                        1294 --571:             else
