                        9197 --665: ***************************************************************************************/
                        9198 --666: static uint32_t mm_FLS_ExecWriteDF(r_icumif_job_id_t job_id, uint32_t size, uint32_t offset, const uint8_t *p_data)
                        9199 --667: {
                        9200 --668:     uint32_t err;
                        9201 --670:     err = ER_OK;
                        9202 --671:     switch ((uint32_t)g_phase_ExWrite)
                        9203 --672:     {
                        9204 --673:         /* write operation acceptance phase */
                        9205 --674:         case FLS_PHASE_0:
