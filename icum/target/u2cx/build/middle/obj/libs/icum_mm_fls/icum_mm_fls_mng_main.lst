                        9207 --676:             if (ER_IN_PROCESS == err)
                        9208 --677:             {
                        9209 --678:                 /* process is progress */
                        9210 --679:                 g_phase_ExWrite = FLS_PHASE_1;
                        9211 --680:             }
                        9212 --681:             else
                        9213 --682:             {
                        9214 --683:                 /* error occurred */
                        9215 --684:                 g_phase_ExWrite = FLS_PHASE_9;
                        9216 --685:             }
                        9217 --686:             break;
                        9218 --688:         /* wait for write operation completion phase */
                        9219 --689:         case FLS_PHASE_1:
                        9220 --690:             err = L_FLS_IsFinished_ram((uint16_t)job_id, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                        9221 --691:             if (ER_IN_PROCESS == err)

                                                                      Page 155
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                        9222 --692:             {
                        9223 --693:                 /* process is progress */
                        9224 --694:                 /* do nothing          */
                        9225 --695:             }
                        9226 --696:             else
                        9227 --697:             {
                        9228 --698:                 /* operation completion or error occurred */
                        9229 --699:                 g_phase_ExWrite = FLS_PHASE_9;
                        9230 --700:             }
                        9231 --701:             break;
                        9232 --703:         default:
                        9233 --704:             /* Not occurred */
                        9234 --705:             break;
                        9235 --706:     } /* end of switch ((uint32_t)g_phase_ExWrite) */
                        9236 --708:     /* end process */
                        9237 --709:     mm_FLS_EndPhaseInternal(&err, &g_phase_ExWrite);
                        9238 --710:     return (err);
                        9239 --711: }
