                       57979 --4737:                 if (ER_OK == err)
                       57980 --4738:                 {
                       57981 --4739:                     /* write successful */
                       57982 --4740:                     g_phase_Format = FLS_PHASE_3;
                       57983 --4741:                 }
                       57984 --4742:                 else if ((ER_MM_FLS_IN_PROGRESS == err) || (ER_IN_PROCESS == err))
                       57985 --4743:                 {
                       57986 --4744:                     /* do nothing : write process in progress */
                       57987 --4745:                 }
                       57988 --4746:                 else
                       57989 --4747:                 {
                       57990 --4748:                     /* error occurred */
                       57991 --4749:                     g_phase_Format = FLS_PHASE_9;
                       57992 --4750:                 }
                       57993 --4751:                 break;

