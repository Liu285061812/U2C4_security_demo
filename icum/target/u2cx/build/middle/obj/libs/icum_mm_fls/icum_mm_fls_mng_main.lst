                       14934 --1701: uint32_t MM_FLS_WriteFlashCfg(r_icumif_job_id_t job_id, uint8_t target_func, uint32_t set_data)
                       14935 --1702: {
                       14936 --1703:     uint32_t err;
                       14937 --1704:     uint32_t ret_val;
                       14938 --1705:     uint32_t target_info;
                       14939 --1706:     uint32_t opbt_info;
                       14940 --1708:     err = mm_FLS_CheckWriteCfgParam(job_id, target_func, set_data, &target_info, &opbt_info);
                       14941 --1709:     if (ER_OK != err)
                       14942 --1710:     {
                       14943 --1711:         /* Do nothing */
                       14944 --1712:     }
                       14945 --1713:     else
                       14946 --1714:     {
                       14947 --1715:         /* check of job id */
                       14948 --1716:         err = L_FLS_CheckContext_ram(job_id, AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       14949 --1717:         if (ER_OK == err)
                       14950 --1718:         {
                       14951 --1719:             /* set FACIACC flag */
                       14952 --1720:             err = L_FLS_SetFACIStatus_ram();
                       14953 --1721:             if (ER_OK == err)
                       14954 --1722:             {
                       14955 --1723:                 /* Get flash resources */
                       14956 --1724:                 err = L_FLS_GetFlashResource_ram((uint32_t)job_id, FLS_ZERO_U8, AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       14957 --1725:                 if (ER_OK == err)
                       14958 --1726:                 {
                       14959 --1727:                     /* perform the flash erasing */
                       14960 --1728:                     err = L_FLS_REQ_WriteSecurity_ram(target_info, opbt_info);
                       14961 --1729:                     mm_FLS_EndProcessWFCfg(&err);
                       14962 --1730:                 }
                       14963 --1731:                 else
                       14964 --1732:                 {
                       14965 --1733:                     /* reset FACIACC flag */
                       14966 --1734:                     (void)L_FLS_ClrFACIStatus_ram();
                       14967 --1735:                 }
                       14968 --1736:             }
                       14969 --1737:             else
                       14970 --1738:             {
                       14971 --1739:                 /* Do nothing */
                       14972 --1740:             }
                       14973 --1741:         }
                       14974 --1742:         else if (ER_IN_PROCESS == err)
                       14975 --1743:         {
                       14976 --1744:             err = L_FLS_IsFinished_ram(job_id, AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       14977 --1745:             mm_FLS_EndProcessWFCfg(&err);
                       14978 --1746:         }
                       14979 --1747:         else
                       14980 --1748:         {
                       14981 --1749:             /* Do nothing */
                       14982 --1750:         }
                       14983 --1751:     } /* end of else */
                       14984 --1753:     ret_val = mm_FLS_ConvertionError(err);
                       14985 --1754:     return (ret_val);
                       14986 --1755: }
