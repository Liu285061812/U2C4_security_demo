                       36954 --2648:                 if (FLS_FOUND == ret_val)
                       36955 --2649:                 {
                       36956 --2650:                     /* there is valid data in GC source block. */
                       36957 --2651:                     wk_index.word_idx = FLS_ZERO_U16;
                       36958 --2652:                     /* Warnings that occur here will be repaired and will not be recorded */
                       36959 --2653:                     g_warning_update_prohibit = FLS_FLAG_ON_U8;
                       36960 --2654:                     err = mm_FLS_AESDSRead(&wk_index, g_read_buffer);
                       36961 --2655:                     g_warning_update_prohibit = FLS_ZERO_U8;
                       36962 --2656:                     if (ER_OK == err)
                       36963 --2657:                     {
