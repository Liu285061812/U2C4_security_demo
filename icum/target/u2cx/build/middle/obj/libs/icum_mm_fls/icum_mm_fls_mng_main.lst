                       15814 --2622:     {
                       15815 --2623:         /* Check context */
                       15816 --2624:         err = L_FLS_CheckContext_ram(job_id, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                       15817 --2625:     }
                       15818 --2627:     if ((ER_OK == err) || (ER_IN_PROCESS == err))
                       15819 --2628:     {
                       15820 --2629:         switch ((uint32_t)g_phase_GC)
                       15821 --2630:         {
                       15822 --2631:             case FLS_PHASE_0:
                       15823 --2632:                 err = mm_FLS_GetGCState(job_id, &source_block, &reserve_block);
                       15824 --2633:                 break;
                       15825 --2634:             case FLS_PHASE_1:
                       15826 --2635:                 /* Write Transfer flag of GC source block */
                       15827 --2636:                 err = mm_FLS_SetTransferFlag(job_id, source_block, reserve_block, flag_buffer_pnt.p_u8);
                       15828 --2637:                 break;
                       15829 --2638:             case FLS_PHASE_2:
                       15830 --2639:                 /* GC destination block erase */
                       15831 --2640:                 err = mm_FLS_EraseGCDest(job_id, reserve_block);
                       15832 --2641:                 break;
                       15833 --2642:             case FLS_PHASE_3:
