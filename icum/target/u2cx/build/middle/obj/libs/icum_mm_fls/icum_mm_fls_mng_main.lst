                       52927 --4647:         }
                       52928 --4648:     }
                       52929 --4649:     else
                       52930 --4650:     {
                       52931 --4651:         ret_val = FLS_CMP_EQUAL;
                       52932 --4652:     }
                       52933 --4653:     return (ret_val);
                       52934 --4654: }
