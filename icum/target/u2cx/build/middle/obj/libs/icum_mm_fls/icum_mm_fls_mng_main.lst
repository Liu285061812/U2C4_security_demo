                       18759 --3909:                 nocheck_block = source_block;
                       18760 --3910:             }
                       18761 --3911:             else if ((uint32_t)FLS_GC_ALL_BLANK == (uint32_t)gc_state)
                       18762 --3912:             {
                       18763 --3913:                 /* When the flash memory is not yet formatted */
                       18764 --3914:                 err = ER_MM_FLS_ALL_BLANK;
                       18765 --3915:             }
                       18766 --3916:             else
                       18767 --3917:             {
                       18768 --3918:                 /* When other flash states */
                       18769 --3919:                 err = ER_MM_FLS_FORMAT_ERR;
                       18770 --3920:             }
                       18771 --3921:             if (((uint32_t)FLS_GC_NORMAL != (uint32_t)gc_state)

                                                                      Page 312
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
