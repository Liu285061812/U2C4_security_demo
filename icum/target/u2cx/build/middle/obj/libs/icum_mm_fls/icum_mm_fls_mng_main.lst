                        3406 --2789:                 g_phase_GC = FLS_PHASE_7;
                        3407 --2790:             }
                        3408 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                        3409 --2792:             {
                        3410 --2793:                 /* When the flash memory is not yet formatted */
                        3411 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                        3412 --2795:                 g_phase_GC = FLS_PHASE_9;
                        3413 --2796:             }
                        3414 --2797:             else
                        3415 --2798:             {
                        3416 --2799:                 /* When other flash states */
                        3417 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                        3418 --2801:                 g_phase_GC = FLS_PHASE_9;
                        3419 --2802:             }
                        3420 --2803:         }
                        3421 --2804:     }
                        3422 --2805:     else
                        3423 --2806:     {
                        3424 --2807:         g_phase_GC = FLS_PHASE_9;
                        3425 --2808:     }
                        3426 --2809:     return (err);
                        3427 --2810: }
