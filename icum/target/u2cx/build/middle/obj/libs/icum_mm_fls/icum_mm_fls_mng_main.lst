                        5192 --1367:             /* When the power is turned off during GC (during data transfer) */
                        5193 --1368:             *p_prohibited_block = reserve_block;
                        5194 --1369:         }
                        5195 --1370:         else if (FLS_GC_DURING_2 == gc_state)
                        5196 --1371:         {
                        5197 --1372:             /* When the power is turned off during GC (during erase) */
