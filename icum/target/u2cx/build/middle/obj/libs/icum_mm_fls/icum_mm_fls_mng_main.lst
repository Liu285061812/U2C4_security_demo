                        9833 --1342: static uint32_t mm_FLS_GetProhibitBlk(uint32_t *const p_prohibited_block)
                        9834 --1343: {
                        9835 --1344:     uint32_t err;
                        9836 --1345:     uint32_t source_block;
                        9837 --1346:     uint32_t reserve_block;
                        9838 --1347:     gc_state_t gc_state;
                        9839 --1349:     source_block = FLS_ZERO_U32;
                        9840 --1350:     reserve_block = FLS_ZERO_U32;
                        9841 --1351:     /* check flash memory status */
                        9842 --1352:     err = mm_FLS_CheckGCFlag(&gc_state, &source_block, &reserve_block);
                        9843 --1353:     if (ER_OK != err)
                        9844 --1354:     {
                        9845 --1355:         /* Do nothing */
                        9846 --1356:     }
                        9847 --1357:     else
                        9848 --1358:     {
                        9849 --1359:         /* normal end */
                        9850 --1360:         if (FLS_GC_NORMAL == gc_state)
                        9851 --1361:         {
                        9852 --1362:             /* When the power is not turned off during GC */
                        9853 --1363:             *p_prohibited_block = reserve_block;
                        9854 --1364:         }
                        9855 --1365:         else if (FLS_GC_DURING_1 == gc_state)
                        9856 --1366:         {
                        9857 --1367:             /* When the power is turned off during GC (during data transfer) */
                        9858 --1368:             *p_prohibited_block = reserve_block;
                        9859 --1369:         }
                        9860 --1370:         else if (FLS_GC_DURING_2 == gc_state)
                        9861 --1371:         {
                        9862 --1372:             /* When the power is turned off during GC (during erase) */
                        9863 --1373:             *p_prohibited_block = source_block;
                        9864 --1374:         }
                        9865 --1375:         else if (FLS_GC_ALL_BLANK == gc_state)
                        9866 --1376:         {
                        9867 --1377:             /* When the flash memory is not yet formatted */
                        9868 --1378:             err = ER_MM_FLS_ALL_BLANK;
                        9869 --1379:         }
                        9870 --1380:         else
                        9871 --1381:         {
                        9872 --1382:             /* When other flash states */
                        9873 --1383:             err = ER_MM_FLS_FORMAT_ERR;
                        9874 --1384:         }
                        9875 --1385:     }
                        9876 --1386:     return (err);
                        9877 --1387: }
