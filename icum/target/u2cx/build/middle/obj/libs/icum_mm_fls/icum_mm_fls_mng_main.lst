                       26652 --2712:                 err = mm_FLS_ExecWriteDF(job_id, FLS_FLAG_SIZE, offset, flag_buffer_pnt.p_u8);
                       26653 --2713:                 if (ER_OK == err)
                       26654 --2714:                 {
