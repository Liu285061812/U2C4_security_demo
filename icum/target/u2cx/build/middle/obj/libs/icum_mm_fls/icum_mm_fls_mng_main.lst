                       28478 --4629:         if ((value1 - value2) > max_value)
                       28479 --4630:         {
                       28480 --4631:             ret_val = FLS_CMP_SMALL;
                       28481 --4632:         }
                       28482 --4633:         else
                       28483 --4634:         {
                       28484 --4635:             ret_val = FLS_CMP_LARGE;
                       28485 --4636:         }
                       28486 --4637:     }
                       28487 --4638:     else if (value1 < value2)
                       28488 --4639:     {
                       28489 --4640:         if ((value2 - value1) > max_value)
                       28490 --4641:         {
                       28491 --4642:             ret_val = FLS_CMP_LARGE;
                       28492 --4643:         }
                       28493 --4644:         else
                       28494 --4645:         {
                       28495 --4646:             ret_val = FLS_CMP_SMALL;
                       28496 --4647:         }
                       28497 --4648:     }
                       28498 --4649:     else
                       28499 --4650:     {
                       28500 --4651:         ret_val = FLS_CMP_EQUAL;
                       28501 --4652:     }
                       28502 --4653:     return (ret_val);
                       28503 --4654: }
