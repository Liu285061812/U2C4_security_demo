                       57872 --4622: ***************************************************************************************/
                       57873 --4623: static uint8_t mm_FLS_CompareValue(const uint32_t value1, const uint32_t value2, const uint32_t max_value)
                       57874 --4624: {
                       57875 --4625:     uint8_t ret_val;
                       57876 --4627:     if (value1 > value2)
                       57877 --4628:     {
                       57878 --4629:         if ((value1 - value2) > max_value)
                       57879 --4630:         {
                       57880 --4631:             ret_val = FLS_CMP_SMALL;
                       57881 --4632:         }
                       57882 --4633:         else
                       57883 --4634:         {
                       57884 --4635:             ret_val = FLS_CMP_LARGE;
                       57885 --4636:         }
                       57886 --4637:     }
                       57887 --4638:     else if (value1 < value2)
                       57888 --4639:     {
                       57889 --4640:         if ((value2 - value1) > max_value)
                       57890 --4641:         {
                       57891 --4642:             ret_val = FLS_CMP_LARGE;
                       57892 --4643:         }
                       57893 --4644:         else
                       57894 --4645:         {
                       57895 --4646:             ret_val = FLS_CMP_SMALL;
                       57896 --4647:         }
                       57897 --4648:     }
                       57898 --4649:     else
                       57899 --4650:     {
                       57900 --4651:         ret_val = FLS_CMP_EQUAL;
                       57901 --4652:     }
                       57902 --4653:     return (ret_val);
                       57903 --4654: }
