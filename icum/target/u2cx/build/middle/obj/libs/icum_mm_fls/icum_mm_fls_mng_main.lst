                       36049 --1701: uint32_t MM_FLS_WriteFlashCfg(r_icumif_job_id_t job_id, uint8_t target_func, uint32_t set_data)
                       36050 --1702: {
                       36051 --1703:     uint32_t err;
                       36052 --1704:     uint32_t ret_val;
                       36053 --1705:     uint32_t target_info;
                       36054 --1706:     uint32_t opbt_info;
                       36055 --1708:     err = mm_FLS_CheckWriteCfgParam(job_id, target_func, set_data, &target_info, &opbt_info);
                       36056 --1709:     if (ER_OK != err)
                       36057 --1710:     {
                       36058 --1711:         /* Do nothing */
                       36059 --1712:     }
                       36060 --1713:     else
                       36061 --1714:     {
                       36062 --1715:         /* check of job id */
                       36063 --1716:         err = L_FLS_CheckContext_ram(job_id, AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       36064 --1717:         if (ER_OK == err)
                       36065 --1718:         {
                       36066 --1719:             /* set FACIACC flag */
                       36067 --1720:             err = L_FLS_SetFACIStatus_ram();
                       36068 --1721:             if (ER_OK == err)
                       36069 --1722:             {
                       36070 --1723:                 /* Get flash resources */
                       36071 --1724:                 err = L_FLS_GetFlashResource_ram((uint32_t)job_id, FLS_ZERO_U8, AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       36072 --1725:                 if (ER_OK == err)
                       36073 --1726:                 {
                       36074 --1727:                     /* perform the flash erasing */
                       36075 --1728:                     err = L_FLS_REQ_WriteSecurity_ram(target_info, opbt_info);
                       36076 --1729:                     mm_FLS_EndProcessWFCfg(&err);
                       36077 --1730:                 }
                       36078 --1731:                 else
                       36079 --1732:                 {
                       36080 --1733:                     /* reset FACIACC flag */
                       36081 --1734:                     (void)L_FLS_ClrFACIStatus_ram();
                       36082 --1735:                 }
                       36083 --1736:             }
                       36084 --1737:             else
                       36085 --1738:             {
                       36086 --1739:                 /* Do nothing */

                                                                      Page 599
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       36087 --1740:             }
                       36088 --1741:         }
                       36089 --1742:         else if (ER_IN_PROCESS == err)
                       36090 --1743:         {
                       36091 --1744:             err = L_FLS_IsFinished_ram(job_id, AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       36092 --1745:             mm_FLS_EndProcessWFCfg(&err);
                       36093 --1746:         }
                       36094 --1747:         else
                       36095 --1748:         {
                       36096 --1749:             /* Do nothing */
                       36097 --1750:         }
                       36098 --1751:     } /* end of else */
                       36099 --1753:     ret_val = mm_FLS_ConvertionError(err);
                       36100 --1754:     return (ret_val);
                       36101 --1755: }
                       36102 --1757: /***************************************************************************************
                       36103 --1758: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0094]:[ICUMFW_UD_MM_FlashMNG_0094]
                       36104 --1759: * Function name: mm_FLS_EndProcessWFCfg
                       36105 --1760: * Description  : end process (for MM_FLS_WriteFlashCfg)
                       36106 --1761: * Arguments    : (in/out) uint32_t* p_err   : Error code
                       36107 --1762: * Return Value : none
                       36108 --1763: ***************************************************************************************/
                       36109 --1764: static void mm_FLS_EndProcessWFCfg(uint32_t *const p_err)
                       36110 --1765: {
                       36111 --1766:     if (ER_IN_PROCESS == *p_err)
                       36112 --1767:     {
                       36113 --1768:         /* process is progress */
                       36114 --1769:         *p_err = ER_MM_FLS_IN_PROGRESS;
                       36115 --1770:     }
                       36116 --1771:     else
                       36117 --1772:     {
                       36118 --1773:         /* Release flash resources */
                       36119 --1774:         (void)L_FLS_FreeFlashResource_ram(AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       36120 --1775:         if (ER_OK == *p_err)
                       36121 --1776:         {
                       36122 --1777:             L_FLS_RetrieveIcumRacRad();
                       36123 --1778:         }
                       36124 --1779:         else
                       36125 --1780:         {
                       36126 --1781:             /* Do nothing */
                       36127 --1782:         }
                       36128 --1783:         /* reset FACIACC flag */
                       36129 --1784:         (void)L_FLS_ClrFACIStatus_ram();
                       36130 --1785:     }
                       36131 --1786: }
