                       14994 --1764: static void mm_FLS_EndProcessWFCfg(uint32_t *const p_err)
                       14995 --1765: {
                       14996 --1766:     if (ER_IN_PROCESS == *p_err)
                       14997 --1767:     {
                       14998 --1768:         /* process is progress */
                       14999 --1769:         *p_err = ER_MM_FLS_IN_PROGRESS;
                       15000 --1770:     }
                       15001 --1771:     else
                       15002 --1772:     {
                       15003 --1773:         /* Release flash resources */
                       15004 --1774:         (void)L_FLS_FreeFlashResource_ram(AG_L_FLS_SECURITY, AG_L_FLS_BANK_EXT);
                       15005 --1775:         if (ER_OK == *p_err)
                       15006 --1776:         {
                       15007 --1777:             L_FLS_RetrieveIcumRacRad();
                       15008 --1778:         }
                       15009 --1779:         else
                       15010 --1780:         {
                       15011 --1781:             /* Do nothing */
                       15012 --1782:         }
                       15013 --1783:         /* reset FACIACC flag */
                       15014 --1784:         (void)L_FLS_ClrFACIStatus_ram();
                       15015 --1785:     }
                       15016 --1786: }
