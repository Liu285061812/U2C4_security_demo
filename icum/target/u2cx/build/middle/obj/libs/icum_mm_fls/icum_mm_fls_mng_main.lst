                        6596 --2829: static uint32_t mm_FLS_SetTransferFlag(r_icumif_job_id_t job_id, const uint32_t source_block,
                        6597 --2830:                                        const uint32_t reserve_block, const uint8_t *p_flag_buffer)
                        6598 --2831: {
                        6599 --2832:     uint32_t err;
                        6600 --2833:     uint32_t offset;
