                         573 --331: static uint32_t mm_FLS_PreCheck(const uint8_t target_flash, const uint8_t target_area, const uint8_t ds_type,
                         574 --332:                                 const uint16_t size, const uint8_t operation)
                         575 --333: {
                         576 --334:     uint32_t err;
                         577 --336:     err = ER_OK;
                         578 --337:     /* check parameter */
                         579 --338:     switch ((uint32_t)operation)
                         580 --339:     {
                         581 --340:         case FLS_OP_READ:
                         582 --341:             /* no error : do nothing */
                         583 --342:             break;
                         584 --343:         case FLS_OP_WRITE:
                         585 --344:             /* no error : do nothing */
                         586 --345:             break;
                         587 --346:         case FLS_OP_ERASE:
                         588 --347:             /* no error : do nothing */
                         589 --348:             break;
                         590 --349:         case FLS_OP_CFG_WRITE:
                         591 --350:             /* no error : do nothing */
                         592 --351:             break;
                         593 --352:         default:
                         594 --353:             err = ER_PARAM;
                         595 --354:             break;
                         596 --355:     } /* end of switch ((uint32_t)operation) */
                         597 --357:     if (ER_OK == err)
                         598 --358:     {
                         599 --359:         /* --- check of parameter --- */

                                                                      Page 11
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                         600 --360:         err = mm_FLS_CheckParam(target_flash, target_area, ds_type, size, operation);
                         601 --361:     }
                         602 --362:     else
                         603 --363:     {
                         604 --364:         /* do nothing */
                         605 --365:     }
                         606 --367:     return (err);
                         607 --368: }
