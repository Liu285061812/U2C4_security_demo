                       25406 --1413: static uint32_t mm_FLS_UpdateWrite(r_icumif_job_id_t job_id, const uint8_t ds_type, const uint8_t slot_num,
                       25407 --1414:                                    const uint16_t size, const fls_data_area_pointer_t data_buffer_pnt,
                       25408 --1415:                                    const flash_location_t *const p_wk_index, uint32_t *const p_update_counter)
                       25409 --1416: {
                       25410 --1417:     uint32_t err;
                       25411 --1418:     flash_location_t dummy_index;
                       25412 --1419:     dvc_calculate_t dvc_param;
                       25413 --1421:     /* Read update counter from previously written data */
                       25414 --1422:     err = mm_FLS_ReadMapData(ds_type, slot_num, &dummy_index, p_update_counter);
                       25415 --1423:     if (ER_OK == err)
                       25416 --1424:     {
                       25417 --1425:         /* If there is previous data, increment the update counter */
                       25418 --1426:         *p_update_counter =
                       25419 --1427:             mm_FLS_IncValue(*p_update_counter, FLS_FULL_U32);
                       25420 --1428:     }
                       25421 --1429:     else
                       25422 --1430:     {
                       25423 --1431:         /* If there is no previous data, set the update counter to 0 */
                       25424 --1432:         *p_update_counter = FLS_ZERO_U32;
                       25425 --1433:     }
                       25426 --1435:     /* Set header information in write buffer */
                       25427 --1436:     data_buffer_pnt.p_header->ds_type = ds_type;
                       25428 --1437:     data_buffer_pnt.p_header->slot_num = slot_num;
                       25429 --1438:     data_buffer_pnt.p_header->data_size = size;
                       25430 --1439:     data_buffer_pnt.p_header->update_counter = *p_update_counter;
                       25431 --1440:     /* DVC calculation of write buffer data */
                       25432 --1441:     dvc_param.p_input = (const uint8_t *)&(data_buffer_pnt.p_header->ds_type);
                       25433 --1442:     dvc_param.data_size = (uint16_t)((uint32_t)size - (uint32_t)sizeof(dvc_t));
                       25434 --1443:     dvc_param.p_output = &(data_buffer_pnt.p_header->dvc);
                       25435 --1444:     /* DVC calculation with AES resource processing */
                       25436 --1445:     err = mm_FLS_CalculateDVC(&dvc_param, &g_phase_Write);
                       25437 --1446:     if (ER_OK == err)
                       25438 --1447:     {
                       25439 --1448:         /* write data */
                       25440 --1449:         err = mm_FLS_DSWrite(job_id, size, p_wk_index, data_buffer_pnt.p_u8);
                       25441 --1450:         if ((ER_MM_FLS_IN_PROGRESS == err) || (ER_IN_PROCESS == err))
                       25442 --1451:         {
                       25443 --1452:             /* write process in progress */
                       25444 --1453:             g_phase_Write = FLS_PHASE_1;
                       25445 --1454:         }
                       25446 --1455:         else
                       25447 --1456:         {
                       25448 --1457:             /* error occurred */
                       25449 --1458:             g_phase_Write = FLS_PHASE_9;
                       25450 --1459:         }
                       25451 --1460:     }
                       25452 --1461:     else
                       25453 --1462:     {
                       25454 --1463:     }
                       25455 --1464:     return (err);
                       25456 --1465: }
