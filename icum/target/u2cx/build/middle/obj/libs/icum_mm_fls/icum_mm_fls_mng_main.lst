                       18783 --3933:             (void)L_FLS_FreeFlashResource_ram(AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                       18784 --3934:         } /* end of else */
                       18785 --3935:     } /* end of if (ER_OK == err) */
                       18786 --3936:     else
                       18787 --3937:     {
                       18788 --3938:         /* get resource error, do nothing */
                       18789 --3939:     }
                       18790 --3941:     if ((ER_MM_FLS_ALL_BLANK != err) && (ER_MM_FLS_FORMAT_ERR != err))
                       18791 --3942:     {
