                       44627 --4623: static uint8_t mm_FLS_CompareValue(const uint32_t value1, const uint32_t value2, const uint32_t max_value)
                       44628 --4624: {
                       44629 --4625:     uint8_t ret_val;
                       44630 --4627:     if (value1 > value2)
                       44631 --4628:     {
                       44632 --4629:         if ((value1 - value2) > max_value)
                       44633 --4630:         {
                       44634 --4631:             ret_val = FLS_CMP_SMALL;
                       44635 --4632:         }
                       44636 --4633:         else
                       44637 --4634:         {
                       44638 --4635:             ret_val = FLS_CMP_LARGE;
                       44639 --4636:         }

                                                                      Page 740
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       44640 --4637:     }
                       44641 --4638:     else if (value1 < value2)
                       44642 --4639:     {
                       44643 --4640:         if ((value2 - value1) > max_value)
                       44644 --4641:         {
                       44645 --4642:             ret_val = FLS_CMP_LARGE;
                       44646 --4643:         }
                       44647 --4644:         else
                       44648 --4645:         {
                       44649 --4646:             ret_val = FLS_CMP_SMALL;
                       44650 --4647:         }
                       44651 --4648:     }
                       44652 --4649:     else
                       44653 --4650:     {
                       44654 --4651:         ret_val = FLS_CMP_EQUAL;
                       44655 --4652:     }
                       44656 --4653:     return (ret_val);
                       44657 --4654: }
