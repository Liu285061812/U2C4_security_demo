                       18773 --3923:                 && ((uint32_t)FLS_GC_DURING_2 != (uint32_t)gc_state))
                       18774 --3924:             {
                       18775 --3925:                 /* Since it is unformatted, no data map is created. */
                       18776 --3926:             }
                       18777 --3927:             else
                       18778 --3928:             {
                       18779 --3929:                 /* All block flash memory mount */
                       18780 --3930:                 mm_FLS_CheckAllFlash(nocheck_block, &err);
                       18781 --3931:             }
