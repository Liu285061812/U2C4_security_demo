                       12969 --4623: static uint8_t mm_FLS_CompareValue(const uint32_t value1, const uint32_t value2, const uint32_t max_value)
                       12970 --4624: {
                       12971 --4625:     uint8_t ret_val;
                       12972 --4627:     if (value1 > value2)
                       12973 --4628:     {
                       12974 --4629:         if ((value1 - value2) > max_value)
                       12975 --4630:         {
                       12976 --4631:             ret_val = FLS_CMP_SMALL;
                       12977 --4632:         }
                       12978 --4633:         else
                       12979 --4634:         {
                       12980 --4635:             ret_val = FLS_CMP_LARGE;
                       12981 --4636:         }
                       12982 --4637:     }
                       12983 --4638:     else if (value1 < value2)
                       12984 --4639:     {
                       12985 --4640:         if ((value2 - value1) > max_value)
                       12986 --4641:         {
                       12987 --4642:             ret_val = FLS_CMP_LARGE;
                       12988 --4643:         }
                       12989 --4644:         else
                       12990 --4645:         {
                       12991 --4646:             ret_val = FLS_CMP_SMALL;
                       12992 --4647:         }
                       12993 --4648:     }
                       12994 --4649:     else
                       12995 --4650:     {
                       12996 --4651:         ret_val = FLS_CMP_EQUAL;
                       12997 --4652:     }
                       12998 --4653:     return (ret_val);
                       12999 --4654: }
