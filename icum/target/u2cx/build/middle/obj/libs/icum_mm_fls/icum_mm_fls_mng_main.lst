                       26683 --2745: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0095]:[ICUMFW_UD_MM_FlashMNG_0095]
                       26684 --2746: * Function name: mm_FLS_GetGCState
                       26685 --2747: * Description  : Get flash GC state (for MM_FLS_CollectGarbage)
                       26686 --2748: * Arguments    : (in)  r_icumif_job_id_t job_id  : job id
                       26687 --2749: *                (out) uint32_t* p_source_block  : GC source block number
                       26688 --2750: *                (out) uint32_t* p_reserve_block : GC reserve block number
                       26689 --2751: * Return Value : ER_OK
                       26690 --2752: *                ER_PARAM
                       26691 --2753: *                ER_PENDING
                       26692 --2754: *                ER_MM_FLS_ALL_BLANK
                       26693 --2755: *                ER_MM_FLS_FORMAT_ERR
                       26694 --2756: *                ER_L_FLS_UNAVAILBLE
                       26695 --2757: *                ER_L_FLS_INTERNAL
                       26696 --2758: ***************************************************************************************/
                       26697 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                       26698 --2760:                                   uint32_t *const p_reserve_block)
                       26699 --2761: {
                       26700 --2762:     uint32_t err;
                       26701 --2763:     gc_state_t gc_state;
                       26702 --2765:     /* get flash resource & sets FACIACC flag */
                       26703 --2766:     err = mm_FLS_GetFlashResource(job_id);
                       26704 --2767:     if (ER_OK == err)
                       26705 --2768:     {
                       26706 --2769:         err = mm_FLS_CheckGCFlag(&gc_state, p_source_block, p_reserve_block);
                       26707 --2770:         if (ER_OK != err)
                       26708 --2771:         {
                       26709 --2772:             g_phase_GC = FLS_PHASE_9;
                       26710 --2773:         }
                       26711 --2774:         else
                       26712 --2775:         {
                       26713 --2776:             if (FLS_GC_NORMAL == gc_state)
                       26714 --2777:             {
                       26715 --2778:                 /* When the power is not turned off during GC */
                       26716 --2779:                 g_phase_GC = FLS_PHASE_1;
                       26717 --2780:             }
                       26718 --2781:             else if (FLS_GC_DURING_1 == gc_state)
                       26719 --2782:             {
                       26720 --2783:                 /* When the power is turned off during GC (during data transfer) */
                       26721 --2784:                 g_phase_GC = FLS_PHASE_2;
                       26722 --2785:             }
                       26723 --2786:             else if (FLS_GC_DURING_2 == gc_state)
                       26724 --2787:             {
                       26725 --2788:                 /* When the power is turned off during GC (during erase) */
                       26726 --2789:                 g_phase_GC = FLS_PHASE_7;
                       26727 --2790:             }
                       26728 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                       26729 --2792:             {
                       26730 --2793:                 /* When the flash memory is not yet formatted */
                       26731 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                       26732 --2795:                 g_phase_GC = FLS_PHASE_9;
                       26733 --2796:             }
                       26734 --2797:             else
                       26735 --2798:             {
                       26736 --2799:                 /* When other flash states */
                       26737 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                       26738 --2801:                 g_phase_GC = FLS_PHASE_9;
                       26739 --2802:             }
                       26740 --2803:         }
                       26741 --2804:     }
                       26742 --2805:     else

                                                                      Page 444
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       26743 --2806:     {
                       26744 --2807:         g_phase_GC = FLS_PHASE_9;
                       26745 --2808:     }
                       26746 --2809:     return (err);
                       26747 --2810: }
                       26748 --2812: /***************************************************************************************
                       26749 --2813: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0096]:[ICUMFW_UD_MM_FlashMNG_0096]
                       26750 --2814: * Function name: mm_FLS_SetTransferFlag
                       26751 --2815: * Description  : Write Transfer flag of GC source block (for MM_FLS_CollectGarbage)
                       26752 --2816: * Arguments    : (in) r_icumif_job_id_t job_id  : job id
                       26753 --2817: *                (in) uint32_t source_block     : GC source block number
                       26754 --2818: *                (in) uint32_t reserve_block    : GC reserve block number
                       26755 --2819: *                (in) uint8_t* p_flag_buffer    : flag buffer
                       26756 --2820: * Return Value : ER_OK
                       26757 --2821: *                ER_PARAM
                       26758 --2822: *                ER_IN_PROCESS
                       26759 --2823: *                ER_MM_FLS_IN_PROGRESS
                       26760 --2824: *                ER_MM_FLS_SYS          (ER_L_FLS_FLOW,ER_L_FLS_REJECTED)
                       26761 --2825: *                ER_MM_FLS_SYS_CRITICAL (ER_L_FLS_INTERNAL)
                       26762 --2826: *                ER_MM_FLS_PROG         (ER_L_FLS_PROGRAM)
                       26763 --2827: *                ER_MM_FLS_UNAVAILABLE  (ER_L_FLS_UNAVAILABLE)
                       26764 --2828: ***************************************************************************************/
                       26765 --2829: static uint32_t mm_FLS_SetTransferFlag(r_icumif_job_id_t job_id, const uint32_t source_block,
                       26766 --2830:                                        const uint32_t reserve_block, const uint8_t *p_flag_buffer)
                       26767 --2831: {
                       26768 --2832:     uint32_t err;
                       26769 --2833:     uint32_t offset;
                       26770 --2835:     /* Write Transfer flag of GC source block */
                       26771 --2836:     mm_FLS_ChangeFlagAddr(source_block, FLS_DF_TRANSFER, &offset);
                       26772 --2837:     err = mm_FLS_ExecWriteDF(job_id, FLS_FLAG_SIZE, offset, p_flag_buffer);
                       26773 --2838:     if (ER_OK == err)
                       26774 --2839:     {
                       26775 --2840:         /* write finished */
                       26776 --2841:         /* Check if erasing has been performed since the power was turned on */
                       26777 --2842:         if ((uint32_t)FLS_NOT_ERASED == (uint32_t)g_block_status)
                       26778 --2843:         {
                       26779 --2844:             /* Since erasing has not been performed since the power was turned on, perform the erasing process. */
                       26780 --2845:             g_phase_GC = FLS_PHASE_2;
                       26781 --2846:         }
                       26782 --2847:         else
                       26783 --2848:         {
                       26784 --2849:             /* Since erasing was performed after turning on the power, the erasing process is skipped. */
                       26785 --2850:             g_write_block_idx[reserve_block] = mm_FLS_GetFirstLBlock(reserve_block);
                       26786 --2851:             g_phase_GC = FLS_PHASE_3;
                       26787 --2852:         }
                       26788 --2853:     }
                       26789 --2854:     else if ((ER_MM_FLS_IN_PROGRESS == err) || (ER_IN_PROCESS == err))
                       26790 --2855:     {
                       26791 --2856:         /* do nothing : write process in progress */
                       26792 --2857:     }
                       26793 --2858:     else
                       26794 --2859:     {
                       26795 --2860:         /* error occurred */
                       26796 --2861:         g_phase_GC = FLS_PHASE_9;
                       26797 --2862:     }
                       26798 --2863:     return (err);
                       26799 --2864: }
