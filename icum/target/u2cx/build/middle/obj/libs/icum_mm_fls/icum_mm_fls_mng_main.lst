                                                                      Page 311
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       18711 --3856:     uint32_t counter;
                       18712 --3857:     gc_state_t gc_state;
                       18713 --3858:     uint32_t source_block;
                       18714 --3859:     uint32_t reserve_block;
                       18715 --3860:     uint32_t nocheck_block;
                       18716 --3861:     gc_warning_t gc_warning;
                       18717 --3862:     uint32_t lock_handle;
                       18718 --3864:     source_block   = FLS_ZERO_U32;
                       18719 --3865:     reserve_block  = FLS_ZERO_U32;
                       18720 --3866:     lock_handle = (uint32_t)FLS_DUMMY_CTX_ID;
                       18721 --3868:     /* Initialize all data map with invalid data */
                       18722 --3869:     for (counter = FLS_ZERO_U32; FLS_DATA_MAP_SIZE > counter; counter++)
                       18723 --3870:     {
                       18724 --3871:         g_data_map[counter].ds_type         = FLS_INVALID_DS_TYPE;
                       18725 --3872:         g_data_map[counter].slot_num        = FLS_INVALID_SLOT_NUM;
                       18726 --3873:         g_data_map[counter].block_idx       = FLS_ZERO_U16;
                       18727 --3874:         g_data_map[counter].update_counter  = FLS_ZERO_U16;
                       18728 --3875:     }
                       18729 --3877:     /* All write pointers are initialized with non-writable values */
                       18730 --3878:     for (fblock = FLS_ZERO_U32; fblock < FLS_NB_BLOCK; fblock++)
                       18731 --3879:     {
                       18732 --3880:         g_write_block_idx[fblock] = (uint16_t)((uint32_t)mm_FLS_GetLastLBlock(fblock) + 1uL);
                       18733 --3881:     }
                       18734 --3883:     /* Get flash resources */
