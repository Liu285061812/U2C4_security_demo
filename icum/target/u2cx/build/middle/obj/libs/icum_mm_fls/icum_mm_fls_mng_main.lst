                       23194 --4647:         }
                       23195 --4648:     }
                       23196 --4649:     else
                       23197 --4650:     {
                       23198 --4651:         ret_val = FLS_CMP_EQUAL;
                       23199 --4652:     }
                       23200 --4653:     return (ret_val);
                       23201 --4654: }
