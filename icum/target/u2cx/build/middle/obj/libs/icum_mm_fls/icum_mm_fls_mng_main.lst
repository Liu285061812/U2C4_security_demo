                       39762 --3698: *               : (in) df_flag_t flag_type  : flag type
                       39763 --3699: *               : (out) uint32_t *p_addr    : flag address
                       39764 --3700: * Return Value  : none
                       39765 --3701: ***************************************************************************************/
                       39766 --3702: static void mm_FLS_ChangeFlagAddr(const uint32_t block_num, const df_flag_t flag_type, uint32_t *const p_addr)
                       39767 --3703: {
                       39768 --3704:     if (FLS_DF_NBEE == flag_type)
                       39769 --3705:     {
                       39770 --3706:         *p_addr = (block_num * FLS_ERASE_BLOCK_SIZE);
                       39771 --3707:     }
                       39772 --3708:     else if (FLS_DF_NBES == flag_type)
                       39773 --3709:     {
                       39774 --3710:         *p_addr = (block_num * FLS_ERASE_BLOCK_SIZE) + (FLS_DF_NBES * FLS_FLAG_SIZE);
                       39775 --3711:     }
                       39776 --3712:     else if (FLS_DF_TRANSFER == flag_type)
                       39777 --3713:     {
                       39778 --3714:         *p_addr = (block_num * FLS_ERASE_BLOCK_SIZE) + (FLS_DF_TRANSFER * FLS_FLAG_SIZE);
                       39779 --3715:     }
                       39780 --3716:     else
                       39781 --3717:     {
                       39782 --3718:         *p_addr = (block_num * FLS_ERASE_BLOCK_SIZE) + (FLS_DF_USE * FLS_FLAG_SIZE);
                       39783 --3719:     }
                       39784 --3720: }
                       39785 --3722: /***************************************************************************************
                       39786 --3723: * Function ID  : [ICUMFW_CD_MM_FlashMNG_0031]:[ICUMFW_UD_MM_FlashMNG_0031]
                       39787 --3724: * Function name: mm_FLS_ExecEraseDF
                       39788 --3725: * Description  : Perform the block erase for ICU-M DF
                       39789 --3726: * Arguments    : (in) r_icumif_job_id_t job_id  : job id
                       39790 --3727: *                (in) uint32_t block_num        : physical block number
                       39791 --3728: * Return Value : ER_OK
                       39792 --3729: *                ER_PARAM
                       39793 --3730: *                ER_IN_PROCESS
                       39794 --3731: *                ER_MM_FLS_IN_PROGRESS
                       39795 --3732: *                ER_MM_FLS_SYS          (ER_L_FLS_FLOW,ER_L_FLS_REJECTED)
                       39796 --3733: *                ER_MM_FLS_SYS_CRITICAL (ER_L_FLS_INTERNAL)
                       39797 --3734: *                ER_MM_FLS_PROG         (ER_L_FLS_PROGRAM)
                       39798 --3735: *                ER_MM_FLS_UNAVAILABLE  (ER_L_FLS_UNAVAILABLE)

                                                                      Page 660
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       39799 --3736: ***************************************************************************************/
                       39800 --3737: static uint32_t mm_FLS_ExecEraseDF(const r_icumif_job_id_t job_id, const uint32_t block_num)
                       39801 --3738: {
                       39802 --3739:     uint32_t err;
                       39803 --3740:     uint32_t lul_offset;
                       39804 --3741:     uint32_t lock_handle;
                       39805 --3743:     err = ER_OK;
                       39806 --3744:     lock_handle = (uint32_t)job_id;
                       39807 --3745:     switch ((uint32_t)g_phase_ExErase)
                       39808 --3746:     {
                       39809 --3747:         /* erase operation acceptance phase */
                       39810 --3748:         case FLS_PHASE_0:
                       39811 --3749:             /* convert index to address */
                       39812 --3750:             mm_FLS_ChangeFlagAddr(block_num, FLS_DF_BLOCK_TOP, &lul_offset);
                       39813 --3752:             /* perform the flash erasing */
                       39814 --3753:             err = L_FLS_REQ_EraseFlash_ram(AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM, lul_offset, FLS_ERASE_BLOCK_SIZE);
                       39815 --3755:             if (ER_IN_PROCESS == err)
                       39816 --3756:             {
                       39817 --3757:                 /* change next phase (wait for erase operation completion phase) */
                       39818 --3758:                 g_phase_ExErase = FLS_PHASE_1;
                       39819 --3759:             }
                       39820 --3760:             else
                       39821 --3761:             {
                       39822 --3762:                 /* error occurred */
                       39823 --3763:                 g_phase_ExErase = FLS_PHASE_9;
                       39824 --3764:             }
                       39825 --3765:             break;
                       39826 --3767:         /* wait for erase operation completion phase */
                       39827 --3768:         case FLS_PHASE_1:
                       39828 --3769:             err = L_FLS_IsFinished_ram((uint16_t)lock_handle, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                       39829 --3770:             if (ER_OK == err)
                       39830 --3771:             {
                       39831 --3772:                 /* Erasing process is completed */
                       39832 --3773:                 g_phase_ExErase = FLS_PHASE_9;
                       39833 --3774:             }
                       39834 --3775:             else if (ER_IN_PROCESS == err)
                       39835 --3776:             {
                       39836 --3777:                 /* process is progress */
                       39837 --3778:                 /* do nothing          */
                       39838 --3779:             }
                       39839 --3780:             else
                       39840 --3781:             {
                       39841 --3782:                 /* error occurred */
                       39842 --3783:                 g_phase_ExErase = FLS_PHASE_9;
                       39843 --3784:             }
                       39844 --3785:             break;
                       39845 --3787:         default:
                       39846 --3788:             /* Not occurred */
                       39847 --3789:             break;
                       39848 --3790:     }
                       39849 --3792:     /* end process */
                       39850 --3793:     mm_FLS_EndPhaseInternal(&err, &g_phase_ExErase);
                       39851 --3794:     return (err);
                       39852 --3795: }
