                       26657 --2717:                     g_phase_GC = FLS_PHASE_9;
                       26658 --2718:                 }
                       26659 --2719:                 else if ((ER_MM_FLS_IN_PROGRESS == err) || (ER_IN_PROCESS == err))
                       26660 --2720:                 {
                       26661 --2721:                     /* do nothing : write process in progress */
                       26662 --2722:                 }
                       26663 --2723:                 else
                       26664 --2724:                 {
                       26665 --2725:                     /* error occurred */
                       26666 --2726:                     g_phase_GC = FLS_PHASE_9;
                       26667 --2727:                 }
                       26668 --2728:                 break;
                       26669 --2729:             default:
                       26670 --2730:                 /* Do nothing */
                       26671 --2731:                 break;
                       26672 --2732:         } /* end of switch ((uint32_t)g_phase_GC) */
                       26673 --2733:     }
                       26674 --2734:     else
                       26675 --2735:     {
                       26676 --2736:         /* Do nothing */
                       26677 --2737:     }
                       26678 --2739:     /* Phase of end process */
                       26679 --2740:     mm_FLS_EndPhaseGCWarning(&err, &g_phase_GC);
