                       21478 --2845:             g_phase_GC = FLS_PHASE_2;
                       21479 --2846:         }
                       21480 --2847:         else

                                                                      Page 357
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       21481 --2848:         {
                       21482 --2849:             /* Since erasing was performed after turning on the power, the erasing process is skipped. */
