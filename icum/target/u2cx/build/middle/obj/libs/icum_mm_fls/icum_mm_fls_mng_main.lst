                       37063 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                       37064 --2760:                                   uint32_t *const p_reserve_block)
                       37065 --2761: {
                       37066 --2762:     uint32_t err;
                       37067 --2763:     gc_state_t gc_state;
                       37068 --2765:     /* get flash resource & sets FACIACC flag */
                       37069 --2766:     err = mm_FLS_GetFlashResource(job_id);
                       37070 --2767:     if (ER_OK == err)
                       37071 --2768:     {
                       37072 --2769:         err = mm_FLS_CheckGCFlag(&gc_state, p_source_block, p_reserve_block);
                       37073 --2770:         if (ER_OK != err)
                       37074 --2771:         {
                       37075 --2772:             g_phase_GC = FLS_PHASE_9;
                       37076 --2773:         }
                       37077 --2774:         else
                       37078 --2775:         {
                       37079 --2776:             if (FLS_GC_NORMAL == gc_state)
                       37080 --2777:             {
                       37081 --2778:                 /* When the power is not turned off during GC */
                       37082 --2779:                 g_phase_GC = FLS_PHASE_1;
                       37083 --2780:             }
                       37084 --2781:             else if (FLS_GC_DURING_1 == gc_state)
                       37085 --2782:             {
                       37086 --2783:                 /* When the power is turned off during GC (during data transfer) */
                       37087 --2784:                 g_phase_GC = FLS_PHASE_2;
                       37088 --2785:             }
                       37089 --2786:             else if (FLS_GC_DURING_2 == gc_state)
                       37090 --2787:             {
                       37091 --2788:                 /* When the power is turned off during GC (during erase) */
                       37092 --2789:                 g_phase_GC = FLS_PHASE_7;
                       37093 --2790:             }
                       37094 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                       37095 --2792:             {
                       37096 --2793:                 /* When the flash memory is not yet formatted */
                       37097 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                       37098 --2795:                 g_phase_GC = FLS_PHASE_9;
                       37099 --2796:             }
                       37100 --2797:             else
                       37101 --2798:             {
                       37102 --2799:                 /* When other flash states */
                       37103 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                       37104 --2801:                 g_phase_GC = FLS_PHASE_9;
                       37105 --2802:             }
                       37106 --2803:         }
                       37107 --2804:     }
                       37108 --2805:     else
                       37109 --2806:     {
                       37110 --2807:         g_phase_GC = FLS_PHASE_9;
