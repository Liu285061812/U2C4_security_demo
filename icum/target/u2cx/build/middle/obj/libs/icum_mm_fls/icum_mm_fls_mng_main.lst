                       18736 --3886:     if (ER_OK == err)
                       18737 --3887:     {
                       18738 --3888:         /* Check block information area */
                       18739 --3889:         err = mm_FLS_CheckGCFlag(&gc_state, &source_block, &reserve_block);
                       18740 --3890:         if (ER_OK != err)
                       18741 --3891:         {
                       18742 --3892:             /* do nothing */
                       18743 --3893:         }
                       18744 --3894:         else
                       18745 --3895:         {
                       18746 --3896:             if ((uint32_t)FLS_GC_NORMAL == (uint32_t)gc_state)
                       18747 --3897:             {
                       18748 --3898:                 /* When the power is not turned off during GC */
                       18749 --3899:                 nocheck_block = reserve_block;
                       18750 --3900:             }
                       18751 --3901:             else if ((uint32_t)FLS_GC_DURING_1 == (uint32_t)gc_state)
                       18752 --3902:             {
