                       57906 --4658: * Function name: mm_FLS_IncValue
                       57907 --4659: * Description  : Increment value (with wrap-around measures).
                       57908 --4660: * Arguments    : value: Increment target value
                       57909 --4661: *                max_value: If value is greater than or equal to max_value,
                       57910 --4662: *                           value is set 0.
                       57911 --4663: * Return Value : incremented value
                       57912 --4664: ***************************************************************************************/
                       57913 --4665: static uint32_t mm_FLS_IncValue(const uint32_t value, const uint32_t max_value)
                       57914 --4666: {
                       57915 --4667:     uint32_t ret_val;
                       57916 --4669:     if (value >= max_value)
                       57917 --4670:     {
                       57918 --4671:         ret_val = 0uL;
                       57919 --4672:     }
                       57920 --4673:     else
                       57921 --4674:     {
                       57922 --4675:         ret_val = value + 1uL;
                       57923 --4676:     }
                       57924 --4678:     return (ret_val);
                       57925 --4679: }
