                       28473 --4623: static uint8_t mm_FLS_CompareValue(const uint32_t value1, const uint32_t value2, const uint32_t max_value)
                       28474 --4624: {
                       28475 --4625:     uint8_t ret_val;
                       28476 --4627:     if (value1 > value2)
