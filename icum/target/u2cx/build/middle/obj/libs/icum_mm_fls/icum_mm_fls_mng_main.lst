                       26815 --2881: static uint32_t mm_FLS_EraseGCDest(const r_icumif_job_id_t job_id, const uint32_t reserve_block)
                       26816 --2882: {
                       26817 --2883:     uint32_t err;
                       26818 --2885:     /* GC destination block erase */
                       26819 --2886:     err = mm_FLS_ExecEraseDF(job_id, reserve_block);
                       26820 --2887:     if (ER_OK == err)
                       26821 --2888:     {
                       26822 --2889:         /* erase finished */
                       26823 --2890:         g_block_status = FLS_ERASED;
                       26824 --2891:         g_write_block_idx[reserve_block] = mm_FLS_GetFirstLBlock(reserve_block);
                       26825 --2892:         g_phase_GC = FLS_PHASE_3;
                       26826 --2893:     }
                       26827 --2894:     else if ((ER_MM_FLS_IN_PROGRESS == err) || (ER_IN_PROCESS == err))
                       26828 --2895:     {
                       26829 --2896:         /* do nothing : erase process in progress */
                       26830 --2897:     }
                       26831 --2898:     else
                       26832 --2899:     {
                       26833 --2900:         /* error occurred */
                       26834 --2901:         g_phase_GC = FLS_PHASE_9;
                       26835 --2902:     }
                       26836 --2903:     return (err);
                       26837 --2904: }
