                       33983 --4643:         }
                       33984 --4644:         else
                       33985 --4645:         {
                       33986 --4646:             ret_val = FLS_CMP_SMALL;
                       33987 --4647:         }
                       33988 --4648:     }
                       33989 --4649:     else
                       33990 --4650:     {
                       33991 --4651:         ret_val = FLS_CMP_EQUAL;
                       33992 --4652:     }
                       33993 --4653:     return (ret_val);
                       33994 --4654: }
