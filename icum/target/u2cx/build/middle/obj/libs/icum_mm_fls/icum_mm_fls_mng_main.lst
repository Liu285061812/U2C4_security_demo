                        1633 --933: static uint32_t mm_FLS_VerifySlotData(fls_data_area_pointer_t data_buffer_pnt, data_status_t *const p_data_status)
                        1634 --934: {
                        1635 --935:     uint32_t err;
                        1636 --936:     uint32_t ret_val;
                        1637 --937: ALIGNVAR(4)
                        1638 --938:     dvc_calculate_t dvc_param;
                        1639 --939: ALIGNVAR(4)
                        1640 --940:     dvc_t dvc_result;
                        1641 --942:     /* sets parameter for DVC processing */
                        1642 --943:     dvc_param.p_input   = (const uint8_t *)&(data_buffer_pnt.p_header->ds_type);
                        1643 --944:     dvc_param.data_size = (uint16_t)(((uint32_t)(data_buffer_pnt.p_header->data_size)) - ((uint32_t)sizeof(dvc_t)));
                        1644 --945:     dvc_param.p_output  = &dvc_result;
