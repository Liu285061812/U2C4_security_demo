                       21395 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                       21396 --2760:                                   uint32_t *const p_reserve_block)
                       21397 --2761: {
                       21398 --2762:     uint32_t err;
                       21399 --2763:     gc_state_t gc_state;
                       21400 --2765:     /* get flash resource & sets FACIACC flag */
                       21401 --2766:     err = mm_FLS_GetFlashResource(job_id);
                       21402 --2767:     if (ER_OK == err)
                       21403 --2768:     {
                       21404 --2769:         err = mm_FLS_CheckGCFlag(&gc_state, p_source_block, p_reserve_block);
                       21405 --2770:         if (ER_OK != err)
                       21406 --2771:         {
                       21407 --2772:             g_phase_GC = FLS_PHASE_9;
                       21408 --2773:         }
                       21409 --2774:         else
                       21410 --2775:         {
                       21411 --2776:             if (FLS_GC_NORMAL == gc_state)
                       21412 --2777:             {
                       21413 --2778:                 /* When the power is not turned off during GC */
                       21414 --2779:                 g_phase_GC = FLS_PHASE_1;
                       21415 --2780:             }
                       21416 --2781:             else if (FLS_GC_DURING_1 == gc_state)
                       21417 --2782:             {
                       21418 --2783:                 /* When the power is turned off during GC (during data transfer) */
                       21419 --2784:                 g_phase_GC = FLS_PHASE_2;

                                                                      Page 356
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       21420 --2785:             }
                       21421 --2786:             else if (FLS_GC_DURING_2 == gc_state)
                       21422 --2787:             {
                       21423 --2788:                 /* When the power is turned off during GC (during erase) */
                       21424 --2789:                 g_phase_GC = FLS_PHASE_7;
                       21425 --2790:             }
                       21426 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                       21427 --2792:             {
                       21428 --2793:                 /* When the flash memory is not yet formatted */
                       21429 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                       21430 --2795:                 g_phase_GC = FLS_PHASE_9;
                       21431 --2796:             }
                       21432 --2797:             else
                       21433 --2798:             {
                       21434 --2799:                 /* When other flash states */
                       21435 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                       21436 --2801:                 g_phase_GC = FLS_PHASE_9;
                       21437 --2802:             }
                       21438 --2803:         }
                       21439 --2804:     }
                       21440 --2805:     else
                       21441 --2806:     {
