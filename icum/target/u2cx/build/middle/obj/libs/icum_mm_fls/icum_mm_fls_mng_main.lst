                       32087 --2758: ***************************************************************************************/
                       32088 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                       32089 --2760:                                   uint32_t *const p_reserve_block)
                       32090 --2761: {
                       32091 --2762:     uint32_t err;
                       32092 --2763:     gc_state_t gc_state;
                       32093 --2765:     /* get flash resource & sets FACIACC flag */
                       32094 --2766:     err = mm_FLS_GetFlashResource(job_id);
                       32095 --2767:     if (ER_OK == err)
                       32096 --2768:     {
                       32097 --2769:         err = mm_FLS_CheckGCFlag(&gc_state, p_source_block, p_reserve_block);
                       32098 --2770:         if (ER_OK != err)
                       32099 --2771:         {
                       32100 --2772:             g_phase_GC = FLS_PHASE_9;
                       32101 --2773:         }
                       32102 --2774:         else
                       32103 --2775:         {
                       32104 --2776:             if (FLS_GC_NORMAL == gc_state)
                       32105 --2777:             {
                       32106 --2778:                 /* When the power is not turned off during GC */
                       32107 --2779:                 g_phase_GC = FLS_PHASE_1;
                       32108 --2780:             }
                       32109 --2781:             else if (FLS_GC_DURING_1 == gc_state)
                       32110 --2782:             {
                       32111 --2783:                 /* When the power is turned off during GC (during data transfer) */
                       32112 --2784:                 g_phase_GC = FLS_PHASE_2;
                       32113 --2785:             }
                       32114 --2786:             else if (FLS_GC_DURING_2 == gc_state)
                       32115 --2787:             {
                       32116 --2788:                 /* When the power is turned off during GC (during erase) */
                       32117 --2789:                 g_phase_GC = FLS_PHASE_7;
                       32118 --2790:             }
                       32119 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                       32120 --2792:             {
                       32121 --2793:                 /* When the flash memory is not yet formatted */
                       32122 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                       32123 --2795:                 g_phase_GC = FLS_PHASE_9;

                                                                      Page 533
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       32124 --2796:             }
                       32125 --2797:             else
                       32126 --2798:             {
                       32127 --2799:                 /* When other flash states */
                       32128 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                       32129 --2801:                 g_phase_GC = FLS_PHASE_9;
                       32130 --2802:             }
                       32131 --2803:         }
                       32132 --2804:     }
                       32133 --2805:     else
                       32134 --2806:     {
                       32135 --2807:         g_phase_GC = FLS_PHASE_9;
                       32136 --2808:     }
                       32137 --2809:     return (err);
                       32138 --2810: }
