                       11210 --2777:             {
                       11211 --2778:                 /* When the power is not turned off during GC */
                       11212 --2779:                 g_phase_GC = FLS_PHASE_1;
                       11213 --2780:             }
                       11214 --2781:             else if (FLS_GC_DURING_1 == gc_state)
                       11215 --2782:             {
                       11216 --2783:                 /* When the power is turned off during GC (during data transfer) */
                       11217 --2784:                 g_phase_GC = FLS_PHASE_2;
                       11218 --2785:             }
                       11219 --2786:             else if (FLS_GC_DURING_2 == gc_state)
                       11220 --2787:             {
                       11221 --2788:                 /* When the power is turned off during GC (during erase) */
                       11222 --2789:                 g_phase_GC = FLS_PHASE_7;
                       11223 --2790:             }
                       11224 --2791:             else if (FLS_GC_ALL_BLANK == gc_state)
                       11225 --2792:             {
                       11226 --2793:                 /* When the flash memory is not yet formatted */
                       11227 --2794:                 err = ER_MM_FLS_ALL_BLANK;
                       11228 --2795:                 g_phase_GC = FLS_PHASE_9;
                       11229 --2796:             }
                       11230 --2797:             else
                       11231 --2798:             {
                       11232 --2799:                 /* When other flash states */
                       11233 --2800:                 err = ER_MM_FLS_FORMAT_ERR;
                       11234 --2801:                 g_phase_GC = FLS_PHASE_9;

