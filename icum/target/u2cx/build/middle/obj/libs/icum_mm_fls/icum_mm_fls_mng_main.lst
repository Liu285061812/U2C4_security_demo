                       23179 --4632:         }
                       23180 --4633:         else
                       23181 --4634:         {
                       23182 --4635:             ret_val = FLS_CMP_LARGE;
                       23183 --4636:         }
                       23184 --4637:     }
                       23185 --4638:     else if (value1 < value2)
