                       25485 --1495: uint32_t MM_FLS_Erase(r_icumif_job_id_t job_id, uint8_t target_flash, uint8_t target_area, uint8_t ds_type,
                       25486 --1496:                       uint8_t slot_num)
                       25487 --1497: {
                       25488 --1498:     uint32_t err;
                       25489 --1500:     /* check of job id */
                       25490 --1501:     if (FLS_ZERO_U32 == (uint32_t)job_id)
                       25491 --1502:     {
                       25492 --1503:         /* does not occur after the UT/IT process */
                       25493 --1504:         err = ER_PARAM;
                       25494 --1505:     }
                       25495 --1506:     else if ((uint32_t)FLS_SELECT_CF == (uint32_t)target_flash)
                       25496 --1507:     {
                       25497 --1508:         /* CodeFlash not supported */
                       25498 --1509:         err = ER_PARAM;
                       25499 --1510:     }
                       25500 --1511:     else if ((uint32_t)FLS_SELECT_SECURE != (uint32_t)target_area)
                       25501 --1512:     {
                       25502 --1513:         /* Supports secure flash only */
                       25503 --1514:         err = ER_PARAM;
                       25504 --1515:     }
                       25505 --1516:     else
                       25506 --1517:     {
                       25507 --1518:         /* Check context */
                       25508 --1519:         err = L_FLS_CheckContext_ram(job_id, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                       25509 --1520:     }
                       25510 --1522:     if ((ER_OK == err) || (ER_IN_PROCESS == err))
                       25511 --1523:     {
                       25512 --1524:         /* Deleting entries from the data map */
                       25513 --1525:         (void)MM_FLS_DeleteMapData(ds_type, slot_num);
                       25514 --1526:         /* All block garbage collection */
                       25515 --1527:         err = mm_FLS_CollectGarbageFull(job_id);
                       25516 --1528:     }
                       25517 --1529:     else
                       25518 --1530:     {
                       25519 --1531:         /* Do nothing */
                       25520 --1532:     }
                       25521 --1533:     return (err);
                       25522 --1534: }

