                       43466 --3397:             mm_FLS_ChangeFlagAddr(fblock, FLS_DF_NBES, &offset);
                       43467 --3398:             err = mm_FLS_CheckBlankCheckArea(offset, FLS_FLAG_SIZE, &(block_info[fblock].nbes));
                       43468 --3399:             if (ER_OK != err)
                       43469 --3400:             {
                       43470 --3401:                 /* error occurred */
                       43471 --3402:             }
