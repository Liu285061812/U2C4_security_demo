                       30876 --1495: uint32_t MM_FLS_Erase(r_icumif_job_id_t job_id, uint8_t target_flash, uint8_t target_area, uint8_t ds_type,
                       30877 --1496:                       uint8_t slot_num)
                       30878 --1497: {
