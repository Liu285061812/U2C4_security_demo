                       14144 --942:     /* sets parameter for DVC processing */
                       14145 --943:     dvc_param.p_input   = (const uint8_t *)&(data_buffer_pnt.p_header->ds_type);
                       14146 --944:     dvc_param.data_size = (uint16_t)(((uint32_t)(data_buffer_pnt.p_header->data_size)) - ((uint32_t)sizeof(dvc_t)));
                       14147 --945:     dvc_param.p_output  = &dvc_result;
