                       14168 --967:         }
                       14169 --968:         else
                       14170 --969:         {
                       14171 --970:             /* Both DVC mismatch */
                       14172 --971:             p_data_status->dvc_result = FLS_CHK_NG;
                       14173 --972:         }
                       14174 --973:         ret_val = ER_OK;
                       14175 --974:     }
                       14176 --975: #if !defined(FSW_DVC_HASH)
                       14177 --976:     else if (ER_ML_DVC_AES_TIMEOUT == err)
                       14178 --977:     {
                       14179 --978:         /* DVC calculation error (AES timeout) */
                       14180 --979:         ret_val = ER_MM_FLS_AES_TIME_OUT;
                       14181 --980:     }
                       14182 --981:     else if (ER_ML_DVC_ALIGN == err)
                       14183 --982:     {
                       14184 --983:         /* DVC calculation error (DVC alignment) */
                       14185 --984:         ret_val = ER_MM_FLS_AES_PRM_ERROR;
                       14186 --985:     }
                       14187 --986: #endif /* !defined(FSW_DVC_HASH) */
                       14188 --987:     else
                       14189 --988:     {
                       14190 --989:         /* never occur */
                       14191 --990:         ret_val = ER_PARAM;
                       14192 --991:     }
                       14193 --992:     return (ret_val);
                       14194 --993: }
