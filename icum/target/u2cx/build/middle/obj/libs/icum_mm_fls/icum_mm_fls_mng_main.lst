                       26592 --2652:                     /* Warnings that occur here will be repaired and will not be recorded */
                       26593 --2653:                     g_warning_update_prohibit = FLS_FLAG_ON_U8;
                       26594 --2654:                     err = mm_FLS_AESDSRead(&wk_index, g_read_buffer);
                       26595 --2655:                     g_warning_update_prohibit = FLS_ZERO_U8;
                       26596 --2656:                     if (ER_OK == err)
                       26597 --2657:                     {
                       26598 --2658:                         /* Map data update (from GC source to GC destination) */
                       26599 --2659:                         err = mm_FLS_WriteMapData(ds_type, slot_num, g_write_block_idx[reserve_block], update_counter);
                       26600 --2660:                         if (ER_OK == err)
                       26601 --2661:                         {
                       26602 --2662:                             g_phase_GC = FLS_PHASE_4;
                       26603 --2663:                         }
                       26604 --2664:                         else
                       26605 --2665:                         {
                       26606 --2666:                             /* error occurred */
                       26607 --2667:                             g_phase_GC = FLS_PHASE_9;
                       26608 --2668:                         }
                       26609 --2669:                     }
                       26610 --2670:                     else
                       26611 --2671:                     {
                       26612 --2672:                         /* read data is invalid or error occurred */
                       26613 --2673:                         g_phase_GC = FLS_PHASE_9;
                       26614 --2674:                     }
                       26615 --2675:                 }
                       26616 --2676:                 else
                       26617 --2677:                 {
                       26618 --2678:                     /* there is not valid data in GC source block. this block GC is over */
                       26619 --2679:                     g_phase_GC = FLS_PHASE_6;
                       26620 --2680:                 }

                                                                      Page 442
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       26621 --2681:                 break;
                       26622 --2682:             case FLS_PHASE_4:
                       26623 --2683:                 /* GC destination block write */
                       26624 --2684:                 err = mm_FLS_WriteGCDest(job_id, reserve_block);
                       26625 --2685:                 break;
                       26626 --2686:             case FLS_PHASE_6:
                       26627 --2687:                 /* Write NBES flag in GC destination block */
                       26628 --2688:                 mm_FLS_ChangeFlagAddr(reserve_block, FLS_DF_NBES, &offset);
                       26629 --2689:                 err = mm_FLS_ExecWriteDF(job_id, FLS_FLAG_SIZE, offset, flag_buffer_pnt.p_u8);
                       26630 --2690:                 if (ER_OK == err)
                       26631 --2691:                 {
