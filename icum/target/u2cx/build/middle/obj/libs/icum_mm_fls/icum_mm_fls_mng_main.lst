                       11193 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                       11194 --2760:                                   uint32_t *const p_reserve_block)
                       11195 --2761: {
                       11196 --2762:     uint32_t err;
                       11197 --2763:     gc_state_t gc_state;
