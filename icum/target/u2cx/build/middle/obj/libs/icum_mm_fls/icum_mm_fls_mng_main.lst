                       26566 --2625:     }
                       26567 --2627:     if ((ER_OK == err) || (ER_IN_PROCESS == err))
                       26568 --2628:     {
                       26569 --2629:         switch ((uint32_t)g_phase_GC)
                       26570 --2630:         {
                       26571 --2631:             case FLS_PHASE_0:
