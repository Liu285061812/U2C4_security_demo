                       14588 --1342: static uint32_t mm_FLS_GetProhibitBlk(uint32_t *const p_prohibited_block)
                       14589 --1343: {
                       14590 --1344:     uint32_t err;
                       14591 --1345:     uint32_t source_block;
                       14592 --1346:     uint32_t reserve_block;
                       14593 --1347:     gc_state_t gc_state;
                       14594 --1349:     source_block = FLS_ZERO_U32;
                       14595 --1350:     reserve_block = FLS_ZERO_U32;
                       14596 --1351:     /* check flash memory status */
                       14597 --1352:     err = mm_FLS_CheckGCFlag(&gc_state, &source_block, &reserve_block);
                       14598 --1353:     if (ER_OK != err)
                       14599 --1354:     {
                       14600 --1355:         /* Do nothing */
                       14601 --1356:     }
                       14602 --1357:     else
                       14603 --1358:     {
                       14604 --1359:         /* normal end */
                       14605 --1360:         if (FLS_GC_NORMAL == gc_state)
                       14606 --1361:         {
                       14607 --1362:             /* When the power is not turned off during GC */
                       14608 --1363:             *p_prohibited_block = reserve_block;
                       14609 --1364:         }
                       14610 --1365:         else if (FLS_GC_DURING_1 == gc_state)
                       14611 --1366:         {
                       14612 --1367:             /* When the power is turned off during GC (during data transfer) */
                       14613 --1368:             *p_prohibited_block = reserve_block;
                       14614 --1369:         }
                       14615 --1370:         else if (FLS_GC_DURING_2 == gc_state)
                       14616 --1371:         {
                       14617 --1372:             /* When the power is turned off during GC (during erase) */
                       14618 --1373:             *p_prohibited_block = source_block;
                       14619 --1374:         }
                       14620 --1375:         else if (FLS_GC_ALL_BLANK == gc_state)
                       14621 --1376:         {
                       14622 --1377:             /* When the flash memory is not yet formatted */
                       14623 --1378:             err = ER_MM_FLS_ALL_BLANK;
                       14624 --1379:         }
                       14625 --1380:         else
                       14626 --1381:         {

                                                                      Page 244
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       14627 --1382:             /* When other flash states */
                       14628 --1383:             err = ER_MM_FLS_FORMAT_ERR;
                       14629 --1384:         }
                       14630 --1385:     }
                       14631 --1386:     return (err);
                       14632 --1387: }
