                       26634 --2694:                 }
                       26635 --2695:                 else if ((ER_MM_FLS_IN_PROGRESS == err) || (ER_IN_PROCESS == err))
                       26636 --2696:                 {
                       26637 --2697:                     /* do nothing : write process in progress */
                       26638 --2698:                 }
                       26639 --2699:                 else
                       26640 --2700:                 {
                       26641 --2701:                     /* error occurred */
                       26642 --2702:                     g_phase_GC = FLS_PHASE_9;
                       26643 --2703:                 }
                       26644 --2704:                 break;
                       26645 --2705:             case FLS_PHASE_7:
