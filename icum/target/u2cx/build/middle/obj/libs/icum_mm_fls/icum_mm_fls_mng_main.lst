                       46139 --2846:         }
                       46140 --2847:         else
                       46141 --2848:         {
                       46142 --2849:             /* Since erasing was performed after turning on the power, the erasing process is skipped. */
                       46143 --2850:             g_write_block_idx[reserve_block] = mm_FLS_GetFirstLBlock(reserve_block);
                       46144 --2851:             g_phase_GC = FLS_PHASE_3;
