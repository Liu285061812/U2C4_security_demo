                        3377 --2759: static uint32_t mm_FLS_GetGCState(const r_icumif_job_id_t job_id, uint32_t *const p_source_block,
                        3378 --2760:                                   uint32_t *const p_reserve_block)
                        3379 --2761: {
                        3380 --2762:     uint32_t err;
                        3381 --2763:     gc_state_t gc_state;
                        3382 --2765:     /* get flash resource & sets FACIACC flag */
                        3383 --2766:     err = mm_FLS_GetFlashResource(job_id);
                        3384 --2767:     if (ER_OK == err)
                        3385 --2768:     {
