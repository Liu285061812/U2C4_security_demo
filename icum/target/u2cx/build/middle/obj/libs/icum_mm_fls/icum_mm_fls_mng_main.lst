                       20035 --1342: static uint32_t mm_FLS_GetProhibitBlk(uint32_t *const p_prohibited_block)
                       20036 --1343: {
                       20037 --1344:     uint32_t err;
                       20038 --1345:     uint32_t source_block;
                       20039 --1346:     uint32_t reserve_block;
                       20040 --1347:     gc_state_t gc_state;
                       20041 --1349:     source_block = FLS_ZERO_U32;
                       20042 --1350:     reserve_block = FLS_ZERO_U32;
                       20043 --1351:     /* check flash memory status */
