                       27957 --4075:     {
                       27958 --4076:         /* When the TAG area is non-blank and the value is invalid */
                       27959 --4077:         next_process = FLS_READ_ONLY_NEXT_PBLOCK;
                       27960 --4078:     }
                       27961 --4079:     else
                       27962 --4080:     {

                                                                      Page 464
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       27963 --4081:         /* error occurred */
                       27964 --4082:         next_process = FLS_READ_ONLY_NEXT_PBLOCK;
                       27965 --4083:     }
                       27966 --4085:     /* Change the next processing pointer and write pointer according to the judgment result */
                       27967 --4086:     if ((uint32_t)FLS_READ_ONLY_NEXT_PBLOCK == (uint32_t)next_process)
                       27968 --4087:     {
                       27969 --4088:         /* go to next physical block & set this physical block read-only */
                       27970 --4089:         p_flash_location->block_idx = (uint16_t)((uint32_t)mm_FLS_GetLastLBlock(fblock) + 1uL);
                       27971 --4090:         g_write_block_idx[fblock] = p_flash_location->block_idx;
                       27972 --4091:     }
                       27973 --4092:     else if ((uint32_t)FLS_NEXT_PBLOCK == (uint32_t)next_process)
                       27974 --4093:     {
                       27975 --4094:         /* go to next physical block */
                       27976 --4095:         p_flash_location->block_idx = (uint16_t)((uint32_t)mm_FLS_GetLastLBlock(fblock) + 1uL);
                       27977 --4096:     }
                       27978 --4097:     else
                       27979 --4098:     {
