                        1382 --666: static uint32_t mm_FLS_ExecWriteDF(r_icumif_job_id_t job_id, uint32_t size, uint32_t offset, const uint8_t *p_data)
                        1383 --667: {
                        1384 --668:     uint32_t err;
                        1385 --670:     err = ER_OK;
                        1386 --671:     switch ((uint32_t)g_phase_ExWrite)
                        1387 --672:     {
                        1388 --673:         /* write operation acceptance phase */
                        1389 --674:         case FLS_PHASE_0:
                        1390 --675:             err = L_FLS_REQ_WriteFlash_ram(AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM, offset, size, (const uint8_t *)p_data);
                        1391 --676:             if (ER_IN_PROCESS == err)
                        1392 --677:             {
                        1393 --678:                 /* process is progress */
                        1394 --679:                 g_phase_ExWrite = FLS_PHASE_1;
                        1395 --680:             }
                        1396 --681:             else
                        1397 --682:             {
                        1398 --683:                 /* error occurred */
                        1399 --684:                 g_phase_ExWrite = FLS_PHASE_9;
                        1400 --685:             }
                        1401 --686:             break;
                        1402 --688:         /* wait for write operation completion phase */
                        1403 --689:         case FLS_PHASE_1:
                        1404 --690:             err = L_FLS_IsFinished_ram((uint16_t)job_id, AG_L_FLS_DATA, AG_L_FLS_BANK_ICUM);
                        1405 --691:             if (ER_IN_PROCESS == err)
                        1406 --692:             {
                        1407 --693:                 /* process is progress */
                        1408 --694:                 /* do nothing          */
                        1409 --695:             }
                        1410 --696:             else
                        1411 --697:             {
                        1412 --698:                 /* operation completion or error occurred */
                        1413 --699:                 g_phase_ExWrite = FLS_PHASE_9;
                        1414 --700:             }
                        1415 --701:             break;
                        1416 --703:         default:
                        1417 --704:             /* Not occurred */
                        1418 --705:             break;
                        1419 --706:     } /* end of switch ((uint32_t)g_phase_ExWrite) */
                        1420 --708:     /* end process */
                        1421 --709:     mm_FLS_EndPhaseInternal(&err, &g_phase_ExWrite);

                                                                      Page 26
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                        1422 --710:     return (err);
                        1423 --711: }
