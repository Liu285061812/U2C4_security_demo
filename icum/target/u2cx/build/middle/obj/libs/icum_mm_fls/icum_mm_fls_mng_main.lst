                       46999 --1728:                     err = L_FLS_REQ_WriteSecurity_ram(target_info, opbt_info);
                       47000 --1729:                     mm_FLS_EndProcessWFCfg(&err);
                       47001 --1730:                 }
                       47002 --1731:                 else
                       47003 --1732:                 {
                       47004 --1733:                     /* reset FACIACC flag */
                       47005 --1734:                     (void)L_FLS_ClrFACIStatus_ram();
                       47006 --1735:                 }
                       47007 --1736:             }
                       47008 --1737:             else
                       47009 --1738:             {
                       47010 --1739:                 /* Do nothing */

