                       47379 --1764: static void mm_FLS_EndProcessWFCfg(uint32_t *const p_err)
                       47380 --1765: {
                       47381 --1766:     if (ER_IN_PROCESS == *p_err)
                       47382 --1767:     {
                       47383 --1768:         /* process is progress */
                       47384 --1769:         *p_err = ER_MM_FLS_IN_PROGRESS;
                       47385 --1770:     }
