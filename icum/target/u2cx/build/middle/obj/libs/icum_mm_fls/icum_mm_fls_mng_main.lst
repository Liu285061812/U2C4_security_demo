                       37050 --2746: * Function name: mm_FLS_GetGCState
                       37051 --2747: * Description  : Get flash GC state (for MM_FLS_CollectGarbage)
                       37052 --2748: * Arguments    : (in)  r_icumif_job_id_t job_id  : job id
                       37053 --2749: *                (out) uint32_t* p_source_block  : GC source block number
                       37054 --2750: *                (out) uint32_t* p_reserve_block : GC reserve block number
                       37055 --2751: * Return Value : ER_OK
                       37056 --2752: *                ER_PARAM
                       37057 --2753: *                ER_PENDING
                       37058 --2754: *                ER_MM_FLS_ALL_BLANK
                       37059 --2755: *                ER_MM_FLS_FORMAT_ERR
