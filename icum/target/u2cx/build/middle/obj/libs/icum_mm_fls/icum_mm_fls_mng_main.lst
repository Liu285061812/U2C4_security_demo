                       36969 --2663:                         }
                       36970 --2664:                         else
                       36971 --2665:                         {
                       36972 --2666:                             /* error occurred */
                       36973 --2667:                             g_phase_GC = FLS_PHASE_9;
                       36974 --2668:                         }
                       36975 --2669:                     }
                       36976 --2670:                     else
                       36977 --2671:                     {
                       36978 --2672:                         /* read data is invalid or error occurred */
                       36979 --2673:                         g_phase_GC = FLS_PHASE_9;
                       36980 --2674:                     }
                       36981 --2675:                 }
                       36982 --2676:                 else
                       36983 --2677:                 {
                       36984 --2678:                     /* there is not valid data in GC source block. this block GC is over */
                       36985 --2679:                     g_phase_GC = FLS_PHASE_6;
                       36986 --2680:                 }
                       36987 --2681:                 break;
                       36988 --2682:             case FLS_PHASE_4:
