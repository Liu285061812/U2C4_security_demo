                       18793 --3944:         gc_warning = mm_FLS_GetCapacityStatus();
                       18794 --3945:         if (((uint32_t)NVM_DATA_WARNING == (uint32_t)g_nvm_data_warning)
                       18795 --3946:             && ((uint32_t)FLS_NO_FULL_WARNING == (uint32_t)gc_warning))
                       18796 --3947:         {
                       18797 --3948:             /* do nothing */
                       18798 --3949:         }
                       18799 --3950:         else
                       18800 --3951:         {
                       18801 --3952:             g_nvm_data_warning = gc_warning;
                       18802 --3953:         }
                       18803 --3954:     }
                       18804 --3955:     else
                       18805 --3956:     {
                       18806 --3957:         /* Do nothing */
                       18807 --3958:     }
