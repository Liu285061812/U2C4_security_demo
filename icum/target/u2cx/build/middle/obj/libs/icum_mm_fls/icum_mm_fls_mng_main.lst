                       15804 --2611:     err = ER_OK;
                       15805 --2612:     flag_buffer = FLS_FLAG_VALUE;
                       15806 --2613:     flag_buffer_pnt.p_u32 = &flag_buffer;
                       15807 --2615:     /* check of job id */
                       15808 --2616:     if (FLS_ZERO_U32 == (uint32_t)job_id)
                       15809 --2617:     {
                       15810 --2618:         /* does not occur after the UT/IT process */
                       15811 --2619:         err = ER_PARAM;
                       15812 --2620:     }
