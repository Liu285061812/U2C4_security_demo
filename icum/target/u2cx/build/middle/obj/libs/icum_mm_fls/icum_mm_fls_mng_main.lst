                       35703 --1342: static uint32_t mm_FLS_GetProhibitBlk(uint32_t *const p_prohibited_block)
                       35704 --1343: {
                       35705 --1344:     uint32_t err;
                       35706 --1345:     uint32_t source_block;
                       35707 --1346:     uint32_t reserve_block;
                       35708 --1347:     gc_state_t gc_state;
                       35709 --1349:     source_block = FLS_ZERO_U32;
                       35710 --1350:     reserve_block = FLS_ZERO_U32;
                       35711 --1351:     /* check flash memory status */
                       35712 --1352:     err = mm_FLS_CheckGCFlag(&gc_state, &source_block, &reserve_block);
                       35713 --1353:     if (ER_OK != err)
                       35714 --1354:     {
                       35715 --1355:         /* Do nothing */
                       35716 --1356:     }
                       35717 --1357:     else
                       35718 --1358:     {
                       35719 --1359:         /* normal end */
                       35720 --1360:         if (FLS_GC_NORMAL == gc_state)

                                                                      Page 593
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       35721 --1361:         {
                       35722 --1362:             /* When the power is not turned off during GC */
                       35723 --1363:             *p_prohibited_block = reserve_block;
                       35724 --1364:         }
                       35725 --1365:         else if (FLS_GC_DURING_1 == gc_state)
                       35726 --1366:         {
                       35727 --1367:             /* When the power is turned off during GC (during data transfer) */
                       35728 --1368:             *p_prohibited_block = reserve_block;
                       35729 --1369:         }
                       35730 --1370:         else if (FLS_GC_DURING_2 == gc_state)
                       35731 --1371:         {
                       35732 --1372:             /* When the power is turned off during GC (during erase) */
                       35733 --1373:             *p_prohibited_block = source_block;
                       35734 --1374:         }
                       35735 --1375:         else if (FLS_GC_ALL_BLANK == gc_state)
                       35736 --1376:         {
                       35737 --1377:             /* When the flash memory is not yet formatted */
                       35738 --1378:             err = ER_MM_FLS_ALL_BLANK;
                       35739 --1379:         }
                       35740 --1380:         else
                       35741 --1381:         {
                       35742 --1382:             /* When other flash states */
                       35743 --1383:             err = ER_MM_FLS_FORMAT_ERR;
                       35744 --1384:         }
                       35745 --1385:     }
                       35746 --1386:     return (err);
                       35747 --1387: }
