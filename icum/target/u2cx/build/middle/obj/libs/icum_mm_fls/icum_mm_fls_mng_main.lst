                       43445 --3375: static uint32_t mm_FLS_CountGCFlag(fls_block_info_t block_info[], uint32_t *const p_counter_ssec,
                       43446 --3376:                                    uint32_t *const p_counter_sses, uint32_t *const p_counter_scec,
                       43447 --3377:                                    uint32_t *const p_counter_transfer, uint32_t *const p_num_ssec,
                       43448 --3378:                                    uint32_t *const p_num_scec, uint32_t *const p_num_transfer)
                       43449 --3379: {
