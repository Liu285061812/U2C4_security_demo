                       14684 --1442:     dvc_param.data_size = (uint16_t)((uint32_t)size - (uint32_t)sizeof(dvc_t));
                       14685 --1443:     dvc_param.p_output = &(data_buffer_pnt.p_header->dvc);
                       14686 --1444:     /* DVC calculation with AES resource processing */
