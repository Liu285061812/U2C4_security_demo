                       33972 --4632:         }
                       33973 --4633:         else
                       33974 --4634:         {
                       33975 --4635:             ret_val = FLS_CMP_LARGE;
                       33976 --4636:         }
                       33977 --4637:     }
                       33978 --4638:     else if (value1 < value2)
