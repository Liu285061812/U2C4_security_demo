                       14150 --949:     err = ML_DVC_Calculate(&dvc_param, ML_DVC_CALC_TYPE_HASH);

                                                                      Page 236
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       14151 --950: #else
                       14152 --951:     err = ML_DVC_Calculate(&dvc_param, ML_DVC_CALC_TYPE_CMAC);
                       14153 --952: #endif
                       14154 --953:     if (ER_OK == err)
                       14155 --954:     {
                       14156 --955:         /* compare calculated DVC and stored DVC */
                       14157 --956:         ret_val = L_Toolbox_MemCmp((const uint8_t *)dvc_param.p_output,
                       14158 --957:                                    (const uint8_t *)(&(data_buffer_pnt.p_header->dvc)),
