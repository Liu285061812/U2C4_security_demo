                       44526 --4515: static uint32_t mm_FLS_GetLastMapData(const flash_block_idx_t limit_index, const uint32_t reserve_block,
                       44527 --4516:                                       uint32_t *const p_last_num)
                       44528 --4517: {
                       44529 --4518:     uint32_t loop_counter;
                       44530 --4519:     uint32_t last_num;
                       44531 --4520:     uint32_t ret_val;
                       44532 --4521:     uint32_t compare_result;
                       44533 --4522:     flash_block_idx_t first_block_idx;
                       44534 --4523:     flash_block_idx_t last_block_idx;
                       44535 --4524:     flash_block_idx_t current_block_idx;
                       44536 --4525:     uint32_t first_fblock;
                       44537 --4527:     last_num        = FLS_ZERO_U32;
                       44538 --4528:     ret_val         = FLS_NOT_FOUND;
                       44539 --4529:     first_fblock    = mm_FLS_GetAfterFBlock(reserve_block);
                       44540 --4530:     first_block_idx = mm_FLS_GetFirstLBlock(first_fblock);
                       44541 --4531:     last_block_idx  = first_block_idx;
                       44542 --4533:     /* Check all the data in the data map */
                       44543 --4534:     for (loop_counter = FLS_ZERO_U32; loop_counter < FLS_DATA_MAP_SIZE; loop_counter++)
                       44544 --4535:     {
                       44545 --4536:         if (((uint32_t)FLS_INVALID_DS_TYPE != (uint32_t)g_data_map[loop_counter].ds_type)
                       44546 --4537:             && ((uint32_t)FLS_INVALID_SLOT_NUM != (uint32_t)g_data_map[loop_counter].slot_num))
                       44547 --4538:         {
                       44548 --4539:             /* for valid data : compare with limit block index */
                       44549 --4540:             current_block_idx = g_data_map[loop_counter].block_idx;
                       44550 --4541:             compare_result = mm_FLS_CompareBlock(current_block_idx, limit_index, first_block_idx);
                       44551 --4542:             if ((uint32_t)FLS_CMP_SMALL == compare_result)
                       44552 --4543:             {
                       44553 --4544:                 /* current_block_idx is less than limit block index */
                       44554 --4545:                 compare_result = mm_FLS_CompareBlock(current_block_idx, last_block_idx, first_block_idx);
                       44555 --4546:                 if ((uint32_t)FLS_CMP_SMALL == compare_result)
                       44556 --4547:                 {
                       44557 --4548:                     /* current_block_idx is less previous maximum index : do nothing */
                       44558 --4549:                 }
                       44559 --4550:                 else
                       44560 --4551:                 {
                       44561 --4552:                     /* current_block_idx is greater than or equal to previous maximum index : overwrite */
                       44562 --4553:                     last_block_idx = current_block_idx;
                       44563 --4554:                     last_num = loop_counter;
                       44564 --4555:                     ret_val = FLS_FOUND;
                       44565 --4556:                 }
                       44566 --4557:             }
                       44567 --4558:             else
                       44568 --4559:             {
                       44569 --4560:                 /* current_block_idx is greater than or equal to limit block index : do nothing */
                       44570 --4561:             }
                       44571 --4562:         }
                       44572 --4563:         else
                       44573 --4564:         {
                       44574 --4565:             /* for invalid data : do nothing */
                       44575 --4566:         }
                       44576 --4567:     }
                       44577 --4568:     *p_last_num = last_num;
                       44578 --4570:     return (ret_val);

