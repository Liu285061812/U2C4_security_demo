                       51542 --4613: * Function name: mm_FLS_CompareValue
                       51543 --4614: * Description  : FLS Compare Value (with wrap-around measures).
                       51544 --4615: * Arguments    : value1: Compare target value 1
                       51545 --4616: *                value2: Compare target value 2
                       51546 --4617: *                max_value: If the difference between value1 and value2 is greater than this value,
                       51547 --4618: *                           it is judged that wrap-around occurs
                       51548 --4619: * Return Value : FLS_CMP_SMALL : value1 < value2
                       51549 --4620: *                FLS_CMP_EQUAL : value1 = value2
                       51550 --4621: *                FLS_CMP_LARGE : value1 > value2
                       51551 --4622: ***************************************************************************************/
                       51552 --4623: static uint8_t mm_FLS_CompareValue(const uint32_t value1, const uint32_t value2, const uint32_t max_value)
                       51553 --4624: {
                       51554 --4625:     uint8_t ret_val;
                       51555 --4627:     if (value1 > value2)
                       51556 --4628:     {
                       51557 --4629:         if ((value1 - value2) > max_value)
                       51558 --4630:         {
                       51559 --4631:             ret_val = FLS_CMP_SMALL;
                       51560 --4632:         }
                       51561 --4633:         else
                       51562 --4634:         {
                       51563 --4635:             ret_val = FLS_CMP_LARGE;
                       51564 --4636:         }
                       51565 --4637:     }
                       51566 --4638:     else if (value1 < value2)
                       51567 --4639:     {

                                                                      Page 858
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                       51568 --4640:         if ((value2 - value1) > max_value)
                       51569 --4641:         {
                       51570 --4642:             ret_val = FLS_CMP_LARGE;
                       51571 --4643:         }
                       51572 --4644:         else
                       51573 --4645:         {
                       51574 --4646:             ret_val = FLS_CMP_SMALL;
                       51575 --4647:         }
                       51576 --4648:     }
                       51577 --4649:     else
                       51578 --4650:     {
                       51579 --4651:         ret_val = FLS_CMP_EQUAL;
                       51580 --4652:     }
