                        1650 --952: #endif
                        1651 --953:     if (ER_OK == err)
                        1652 --954:     {
                        1653 --955:         /* compare calculated DVC and stored DVC */
                        1654 --956:         ret_val = L_Toolbox_MemCmp((const uint8_t *)dvc_param.p_output,
                        1655 --957:                                    (const uint8_t *)(&(data_buffer_pnt.p_header->dvc)),
                        1656 --958:                                    (int16_t)FLS_DVC_SIZE);
                        1657 --959:         if ((uint32_t)FLS_TOOL_CMP_OK == ret_val)
                        1658 --960:         {
                        1659 --961:             /* Both DVC matches */
                        1660 --962:             p_data_status->dvc_result = FLS_CHK_OK;
                        1661 --963:             p_data_status->counter    = data_buffer_pnt.p_header->update_counter;
                        1662 --964:             p_data_status->ds_type    = data_buffer_pnt.p_header->ds_type;
                        1663 --965:             p_data_status->slot_num   = data_buffer_pnt.p_header->slot_num;
                        1664 --966:             p_data_status->data_size  = data_buffer_pnt.p_header->data_size;
                        1665 --967:         }

                                                                      Page 30
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000131o1.si
                        1666 --968:         else
                        1667 --969:         {
                        1668 --970:             /* Both DVC mismatch */
                        1669 --971:             p_data_status->dvc_result = FLS_CHK_NG;
                        1670 --972:         }
                        1671 --973:         ret_val = ER_OK;
                        1672 --974:     }
                        1673 --975: #if !defined(FSW_DVC_HASH)
                        1674 --976:     else if (ER_ML_DVC_AES_TIMEOUT == err)
                        1675 --977:     {
                        1676 --978:         /* DVC calculation error (AES timeout) */
                        1677 --979:         ret_val = ER_MM_FLS_AES_TIME_OUT;
                        1678 --980:     }
                        1679 --981:     else if (ER_ML_DVC_ALIGN == err)
                        1680 --982:     {
