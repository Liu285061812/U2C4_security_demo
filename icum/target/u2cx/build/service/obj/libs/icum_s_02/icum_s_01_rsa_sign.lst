                          86 --46: /**********************************************************************************
                          87 --47: * Local define
                          88 --48: **********************************************************************************/
                          89 --49: /*******************************/
                          90 --50: /* EMSA PSS : salt buffer size */
                          91 --51: /*******************************/
                          92 --52: /* Data length after padding equals to size of RSA Key. It contains size of hash and fixed area. */
                          93 --53: /* Minimum of hash size is 16 bytes(MD5, RIPEMD_128). fix area uses 2 bytes. */
                          94 --54: /* So, salt buffer area uses (sizeof(RSA Key)-16-2) bytes, at maximum. */
                          95 --55: /* if BIGNUM_BITSIZE is 3072, maximum of salt buffer size is (3072/8-16-2 = 366) bytes. */
                          96 --56: /* count of long words for salt buffer is 366 divided by 4. (round up) */
                          97 --57: /* in this case, salt buffer requires 92 longwords. */
                          98 --58: #define SALT_BUFFER_SIZE        ((((R_CRYPT_BIGNUM_BITSIZE / 8u) - 16u - 2u) + 3u) / 4u)
                          99 --60: /* unsigned data size */
                         100 --61: #define NUM2                           (2u)
                         101 --62: #define NUM4                           (4u)
                         102 --63: #define NUM7                           (7u)
                         103 --64: #define NUM8                           (8u)
                         104 --65: #define NUM10                         (10u)
                         105 --66: #define NUM512                       (512u)
