                          84 --46: /**********************************************************************************
                          85 --47: * Local define
                          86 --48: **********************************************************************************/
                          87 --49: /*******************************/
                          88 --50: /* EMSA PSS : salt buffer size */
                          89 --51: /*******************************/
                          90 --52: /* Data length after padding equals to size of RSA Key. It contains size of hash and fixed area. */
                          91 --53: /* Minimum of hash size is 16 bytes(MD5, RIPEMD_128). fix area uses 2 bytes. */
                          92 --54: /* So, salt buffer area uses (sizeof(RSA Key)-16-2) bytes, at maximum. */
                          93 --55: /* if BIGNUM_BITSIZE is 3072, maximum of salt buffer size is (3072/8-16-2 = 366) bytes. */
                          94 --56: /* count of long words for salt buffer is 366 divided by 4. (round up) */
                          95 --57: /* in this case, salt buffer requires 92 longwords. */
                          96 --58: #define SALT_BUFFER_SIZE        ((((R_CRYPT_BIGNUM_BITSIZE / 8u) - 16u - 2u) + 3u) / 4u)
                          97 --60: /* unsigned data size */
                          98 --61: #define NUM2                           (2u)
                          99 --62: #define NUM4                           (4u)
                         100 --63: #define NUM7                           (7u)
                         101 --64: #define NUM8                           (8u)
                         102 --65: #define NUM10                         (10u)
                         103 --66: #define NUM512                       (512u)
