                         235 --155: * Function name: s_01_GenerateRandomSequence
                         236 --156: * Description  : Generate random sequence
                         237 --157: *
                         238 --158: * Arguments    : (IN)       size_in_bytes
                         239 --159: *                           emePkcsFlag
                         240 --160: *                (OUT)      p_udwRandom
                         241 --161: * Return Value : SERV_OK
                         242 --162: *                SERV_PENDING
                         243 --163: *                SERV_UNAVAILABLE
                         244 --164: *                SERV_SYS_ERROR
                         245 --165: *                SERV_NO_INIT_RNG
                         246 --166: *                SERV_NEED_RESEED
                         247 --167: *                SERV_AES_TIMEOUT_ERROR
                         248 --168: ****************************************************************************************/
                         249 --169: uint32_t s_01_GenerateRandomSequence(uint32_t *p_udwRandom, uint16_t size_in_bytes, bool emePkcsFlag)
                         250 --170: {
                         251 --171:     uint32_t    p_resource_id;
                         252 --172:     /* buffer for random : 128 bits */
                         253 --173:     uint32_t    buffer[4];
                         254 --174:     int32_t     remain_bytes;
                         255 --175:     uint32_t    i = 0u;
                         256 --176:     bool        exists;
                         257 --177:     uint32_t    err;
                         258 --178:     uint32_t    skip_flg = FLG_OFF;
                         259 --180:     err = ML_ABTR_GetResource(ABTR_RESOURCE_TYPE_AES, &p_resource_id);
                         260 --181:     switch (err)
                         261 --182:     {
                         262 --183:         case ER_OK:
                         263 --184:             break;
                         264 --185:         case ER_ML_ABTR_EMPTY:
                         265 --186:             err = (uint32_t)SERV_PENDING;
                         266 --187:             break;
                         267 --188:         case ER_ML_ABTR_NOT_RELEASED:
                         268 --189:             err = (uint32_t)SERV_SYS_ERROR;
                         269 --190:             break;
                         270 --191:         case ER_ML_ABTR_NOT_INITIALIZED:
                         271 --192:             err = (uint32_t)SERV_SYS_ERROR;
                         272 --193:             break;
                         273 --194:         case ER_ML_ABTR_TIMER_SET_FAILURE:
                         274 --195:             err = (uint32_t)SERV_SYS_ERROR;
                         275 --196:             break;
                         276 --197:         default:
                         277 --198:             /* Never Occur !! */
                         278 --199:             err = (uint32_t)SERV_SYS_ERROR;
                         279 --200:             break;
                         280 --201:     }
                         281 --202:     if (err != ER_OK)
                         282 --203:     {
                         283 --204:         skip_flg = FLG_ON;
                         284 --205:     }
                         285 --206:     else
                         286 --207:     {
                         287 --208:         /* do nothing */
                         288 --209:     }
                         289 --210:     if (skip_flg == FLG_OFF)
                         290 --211:     {
                         291 --212:         remain_bytes = (int32_t)size_in_bytes;
                         292 --213:         while ((remain_bytes > 0) && (skip_flg == FLG_OFF))
                         293 --214:         {
                         294 --215:             /* get random : 128bits(=16 bytes =4 long word) */

                                                                      Page 6
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00012ug1.si
                         295 --216:             /* 1st parameter, 2 : auto judgement type */
                         296 --217:             err = ML_PRNG_Gen(buffer);
                         297 --218:             switch (err)
                         298 --219:             {
                         299 --220:                 case ER_OK:
                         300 --221:                     break;
                         301 --222:                 case ER_ML_PRNG_STATUS:
                         302 --223:                     err = (uint32_t)SERV_NO_INIT_RNG;
                         303 --224:                     break;
                         304 --225:                 case ER_ML_PRNG_RESEED:
                         305 --226:                     err = (uint32_t)SERV_NEED_RESEED;
                         306 --227:                     break;
                         307 --228:                 case ER_ML_PRNG_TIMEOUT:
                         308 --229:                     err = (uint32_t)SERV_AES_TIMEOUT_ERROR;
                         309 --230:                     break;
                         310 --231:                 case ER_PENDING:
                         311 --232:                     err = (uint32_t)SERV_PENDING;
                         312 --233:                     break;
                         313 --234:                 default:
                         314 --235:                     /* Never Occur !! */
                         315 --236:                     err = (uint32_t)SERV_SYS_ERROR;
                         316 --237:                     break;
                         317 --238:             }
                         318 --239:             if (err != ER_OK)
                         319 --240:             {
                         320 --241:                 skip_flg = FLG_ON;
                         321 --242:             }
                         322 --243:             else
                         323 --244:             {
                         324 --245:                 /* do nothing */
                         325 --246:             }
                         326 --247:             if (skip_flg == FLG_OFF)
                         327 --248:             {
                         328 --249:                 /* register call back function for WDT restart */
                         329 --250:                 D_WDT_StartIfNeeded();
                         330 --252:                 if ((int32_t)emePkcsFlag == true)
                         331 --253:                 {
                         332 --254:                     (void)s_01_ContainsZero((uint8_t *)buffer, PRNG_SIZE_IN_BYTES, &exists);
                         333 --255:                     if ((int8_t)exists == true)
                         334 --256:                     {
                         335 --257:                         continue;
                         336 --258:                     }
                         337 --259:                     else
                         338 --260:                     {
                         339 --261:                         /* do nothing */
                         340 --262:                     }
                         341 --263:                 }
                         342 --264:                 else
                         343 --265:                 {
                         344 --266:                     /* do nothing */
                         345 --267:                 }
                         346 --268:                 if (remain_bytes < (int32_t)PRNG_SIZE_IN_BYTES)
