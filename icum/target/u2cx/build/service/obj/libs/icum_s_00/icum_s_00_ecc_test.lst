                         150 --113:                         (void)D_ECC_SetECCTestProtection(ICUM_ECC_TEST_TYPE_COLLECTIVE,
                         151 --114:                                 ICUM_ECC_TEST_PROTECT_OFF);
                         152 --115:                         /* Store ECC test state unlocked. */
                         153 --116:                         p_ISD->prm.ECC_TEST.ecc_test_lock_status = ECC_TEST_UNLOCKED;
                         154 --117:                     }
                         155 --118:                     else
                         156 --119:                     {
                         157 --120:                         err = ER_PARAM;
                         158 --121:                     }
                         159 --122:                 }
                         160 --123:                 break;
                         161 --125:             case ECC_TEST_END:
                         162 --126:                 /* First call */
                         163 --127:                 if(p_ISD->service_result == SERV_REQUEST)
                         164 --128:                 {
                         165 --129:                     if(status == ECC_TEST_EXE_ON)
                         166 --130:                     {
                         167 --131:                         /* Get default value of ECC test state from system configuration. */
                         168 --132:                         (void)ML_CFG_GetSys_ram(ML_CFG_SYS_TEST_ECC_LOCK,(uint32_t *)&sys_cfg);
                         169 --133:                         if(sys_cfg == ECC_TEST_UNLOCK)
                         170 --134:                         {
                         171 --135:                             /* Set Unlocked to ECCTEST_LOCK of ICUM_LOCKCTRL Register. */
                         172 --136:                             (void)D_ECC_SetECCTestProtection(ICUM_ECC_TEST_TYPE_COLLECTIVE,

                                                                      Page 4
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000a541.si
                         173 --137:                                     ICUM_ECC_TEST_PROTECT_OFF);
                         174 --138:                             /* Store ECC test state unlocked. */
                         175 --139:                             p_ISD->prm.ECC_TEST.ecc_test_lock_status = ECC_TEST_UNLOCKED;
                         176 --140:                         }
                         177 --141:                         else
                         178 --142:                         {
                         179 --143:                             /* Set Locked to ECCTEST_LOCK of ICUM_LOCKCTRL Register. */
                         180 --144:                             (void)D_ECC_SetECCTestProtection(ICUM_ECC_TEST_TYPE_COLLECTIVE,
                         181 --145:                                     ICUM_ECC_TEST_PROTECT_ON);
                         182 --146:                             /* Store ECC test state locked. */
                         183 --147:                             p_ISD->prm.ECC_TEST.ecc_test_lock_status = ECC_TEST_LOCKED;
                         184 --148:                         }
                         185 --149:                         /* Notify ISSD of mode event ECC_TEST_END. */
                         186 --150:                         (void)K_ISSD_SendModeEvent(ISSD_EVT_ECC_TEST_END);
                         187 --151:                     }
                         188 --152:                     else
                         189 --153:                     {
                         190 --154:                         err = ER_PARAM;
                         191 --155:                     }
                         192 --156:                 }
                         193 --157:                 /* Second call */
                         194 --158:                 else
                         195 --159:                 {
                         196 --160:                     if(status == ECC_TEST_EXE_ON)
                         197 --161:                     {
                         198 --162:                         err = ER_PARAM;
                         199 --163:                     }
                         200 --164:                     else
                         201 --165:                     {
                         202 --166:                         /* do nothing */
                         203 --167:                     }
                         204 --168:                 }
                         205 --169:                 break;
                         206 --171:             case ECC_TEST_STATUS:
                         207 --172:                 /* Get lock flag value from ECCTEST_LOCK of ICUM_LOCKCTRL Register. */
                         208 --173:                 (void)D_ECC_GetECCTestProtection(ICUM_ECC_TEST_TYPE_COLLECTIVE,&get_state);
                         209 --174:                 if(get_state != ICUM_ECC_TEST_PROTECT_OFF)
                         210 --175:                 {
                         211 --176:                     /* Store ECC test state locked. */
                         212 --177:                     p_ISD->prm.ECC_TEST.ecc_test_lock_status = ECC_TEST_LOCKED;
                         213 --178:                 }
                         214 --179:                 else
                         215 --180:                 {
                         216 --181:                     /* Store ECC test state unlocked. */
                         217 --182:                     p_ISD->prm.ECC_TEST.ecc_test_lock_status = ECC_TEST_UNLOCKED;
                         218 --183:                 }
                         219 --184:                 break;
                         220 --186:             default:
                         221 --187:                 err = ER_PARAM;
                         222 --188:                 break;
                         223 --189:         }
                         224 --190:     }
                         225 --191:     else
                         226 --192:     {
                         227 --193:         /* do nothing */
                         228 --194:     }
