                         112 --74:     skip_flg = FLG_OFF;
                         113 --75:     
                         114 --76:     /* Check the execute state. */
                         115 --77:     err = s_00_EccTestCheckExeState(&status);
                         116 --79:     if(err != ER_OK)
                         117 --80:     {
