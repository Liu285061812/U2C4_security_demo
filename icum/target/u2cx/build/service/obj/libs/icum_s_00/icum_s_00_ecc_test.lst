                         136 --99:                         (void)K_ISSD_SendModeEvent(ISSD_EVT_ECC_TEST_START);
                         137 --100:                         err = ER_IN_PROCESS;
                         138 --101:                     }
                         139 --102:                     else
                         140 --103:                     {
                         141 --104:                         err = ER_PARAM;
                         142 --105:                     }
                         143 --106:                 }
                         144 --107:                 /* Second call*/
