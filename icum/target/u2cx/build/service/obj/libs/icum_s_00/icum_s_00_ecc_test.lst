                         120 --83:     else
                         121 --84:     {
                         122 --85:         /* do nothing */
                         123 --86:     }
                         124 --87:     if (skip_flg == FLG_OFF)
                         125 --88:     {
                         126 --89:         /* Check value of ECC test operation. */
                         127 --90:         switch(p_ISD->prm.ECC_TEST.ecc_test_operation)
                         128 --91:         {
                         129 --92:             case ECC_TEST_START:
                         130 --93:                 /* First call */
