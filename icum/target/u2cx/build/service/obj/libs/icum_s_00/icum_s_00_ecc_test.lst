                         155 --117:                     }
                         156 --118:                     else
                         157 --119:                     {
                         158 --120:                         err = ER_PARAM;
                         159 --121:                     }
                         160 --122:                 }
                         161 --123:                 break;
                         162 --125:             case ECC_TEST_END:
                         163 --126:                 /* First call */
                         164 --127:                 if(p_ISD->service_result == SERV_REQUEST)
                         165 --128:                 {
                         166 --129:                     if(status == ECC_TEST_EXE_ON)
                         167 --130:                     {
                         168 --131:                         /* Get default value of ECC test state from system configuration. */
                         169 --132:                         (void)ML_CFG_GetSys_ram(ML_CFG_SYS_TEST_ECC_LOCK,(uint32_t *)&sys_cfg);
                         170 --133:                         if(sys_cfg == ECC_TEST_UNLOCK)
                         171 --134:                         {
                         172 --135:                             /* Set Unlocked to ECCTEST_LOCK of ICUM_LOCKCTRL Register. */

                                                                      Page 4
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000v4c1.si
                         173 --136:                             (void)D_ECC_SetECCTestProtection(ICUM_ECC_TEST_TYPE_COLLECTIVE,
                         174 --137:                                     ICUM_ECC_TEST_PROTECT_OFF);
                         175 --138:                             /* Store ECC test state unlocked. */
                         176 --139:                             p_ISD->prm.ECC_TEST.ecc_test_lock_status = ECC_TEST_UNLOCKED;
                         177 --140:                         }
                         178 --141:                         else
