                         484 --469: void digest_cmp(uint8_t *msg_hash_rlt,uint8_t* digest,HASH_TYPE_T hash_type)
                         485 --470: {
                         486 --471:     uint32_t hash_len = 0;
                         487 --472:     uint32_t i =0;
                         488 --473:     switch(hash_type)
                         489 --474:     {
                         490 --475:         case T_HASH_SHA1:
                         491 --476:             hash_len = 20;
                         492 --477:             break;
                         493 --478:         case T_HASH_SHA224:
                         494 --479:             hash_len = 28;
                         495 --480:             break;
                         496 --481:         case T_HASH_SHA256:
                         497 --482:             hash_len = 32;
                         498 --483:             break;
                         499 --484:         default:
                         500 --485:             hash_len = 64;
                         501 --486:             break;
                         502 --487:     }
                         503 --488:     for(i=0;i<hash_len;i++)
                         504 --489:     {
                         505 --490:         if(msg_hash_rlt[i]!=digest[i])
                         506 --491:         {
                         507 --492:             while(1){};
                         508 --493:         }
                         509 --494:     }
                         510 --495: }
