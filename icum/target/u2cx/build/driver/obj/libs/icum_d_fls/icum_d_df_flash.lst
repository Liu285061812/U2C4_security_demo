                         115 --82: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0056]:[ICUMFW_UD_U2B_D_FLS_0056]
                         116 --83: * Function Name : D_FLS_ProgramDf
                         117 --84: * Description   : Request write to the data flash area.
                         118 --85: * Arguments     : flash_addr
                         119 --86: *                   Start address of the data flash area to be written (4-byte boundary).
                         120 --87: *                   It is specified by a relative address with the head address of the block 0
                         121 --88: *                   of the flash set to 0x0000_0000.
                         122 --89: *                 p_data
                         123 --90: *                   data to be written.
                         124 --91: *                 data_size_in_bytes
                         125 --92: *                   Number of bytes to write (in 4-byte units).
                         126 --93: * Return Value  :   ER_OK
                         127 --94: *                   ER_IN_PROCESS
                         128 --95: *                   ER_D_FLS_INTERNAL
                         129 --96: *                   ER_D_FLS_SETOPRDYTOUT
                         130 --97: *                   ER_D_FLS_REJECTED
                         131 --98: *                   ER_D_FLS_SETOPMODTOUT
                         132 --99: *                   ER_D_FLS_FSTOPTOUT
                         133 --100: *                   ER_D_FLS_NON_BLANK
                         134 --101: *                   ER_D_FLS_PROTECTION
                         135 --102: *                   ER_D_FLS_WRITE
                         136 --103: *                   ER_D_FLS_ERASE
                         137 --104: *                   ER_D_FLS_FACITOUT
                         138 --105: **************************************************************************************************/
                         139 --106: uint32_t D_FLS_ProgramDf(const uint32_t flash_addr, const uint8_t *p_data, const uint32_t data_size_in_bytes)
                         140 --107: {
                         141 --108:     uint32_t    lul_fls_status;
                         142 --109:     fls_ctrl_t  *p_fls_ctrl;
                         143 --111:     /* FACI number setteing */
                         144 --112:     (void)d_FLS_SelectFpsys_ram(flash_addr);
                         145 --113:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                         146 --115:     /* control variable setting */
                         147 --116:     p_fls_ctrl->prm.d_status               = ER_D_FLS_REQUEST;
                         148 --117:     p_fls_ctrl->prm.ope_mode               = (uint16_t)R_RFD_MODE_DFPE;
                         149 --118:     p_fls_ctrl->prm.commad_req             = D_FLS_CMDREQ_ON;
                         150 --119:     if (DF_MULTIW8_SIZE <= (data_size_in_bytes - DF_WBUFFER_SIZE))
                         151 --120:     {
                         152 --121:         p_fls_ctrl->prm.command_code           = D_FACI_CMD_MULTI_PROGRAM;
                         153 --122:         p_fls_ctrl->prm.p_write_size_in_bytes  = &d_FLS_GetDfMultiProgramSize;
                         154 --123:     }
                         155 --124:     else
                         156 --125:     {
                         157 --126:         p_fls_ctrl->prm.command_code           = D_FACI_CMD_PROGRAM;
                         158 --127:         p_fls_ctrl->prm.p_write_size_in_bytes  = &D_FLS_GetDfProgramWriteSize;
                         159 --128:     }
                         160 --129:     p_fls_ctrl->prm.flash_addr             = flash_addr;
                         161 --130:     p_fls_ctrl->prm.p_data                 = p_data;
                         162 --131:     p_fls_ctrl->prm.data_size_in_bytes     = data_size_in_bytes;
                         163 --132:     p_fls_ctrl->prm.p_pre_processing       = &d_FLS_PreProcessingDf;
                         164 --133:     p_fls_ctrl->prm.p_faci_commad_set      = &d_FLS_IssueCommand_ram;
                         165 --134:     p_fls_ctrl->prm.p_error_check          = &d_FLS_CheckFaciErrors_ram;
                         166 --135:     p_fls_ctrl->prm.success_resp           = ER_OK;
                         167 --136:     p_fls_ctrl->prm.p_num                  = D_FLS_ZERO_U32;
                         168 --138:     /* Set Max FACI command time + Margin time */
                         169 --139:     p_fls_ctrl->prm.max_time               = TIMEOUT_PROGRAM_DF;
                         170 --141:     lul_fls_status = d_FLS_Handler_ram(g_fls_selected_fpsys);
                         171 --143:     return (lul_fls_status);
                         172 --144: }

