                         234 --222: /********************************************************************************
                         235 --223:  private Function definition
                         236 --224: *********************************************************************************/
                         237 --226: /********************************************************************************
                         238 --227: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0064]:[ICUMFW_UD_U2B_D_FLS_0064]
                         239 --228: * Function Name : d_FLS_PreProcessingSec
                         240 --229: * Description   : Preprocessing of security setting write operation
                         241 --230: * Arguments     : none
                         242 --231: * Return Value  : FLS_ERR_NONE
                         243 --232: *                 ER_D_FLS_DFPRGINTTOUT
                         244 --233: *                 ER_D_FLS_ACCPROHIBIT
                         245 --234: *                 ER_D_FLS_INTERNAL
                         246 --235: *********************************************************************************/
                         247 --236: static uint32_t d_FLS_PreProcessingSec(void)
                         248 --237: {
                         249 --238:     uint32_t    lul_fls_status;
                         250 --239:     uint32_t    boot_pe;
                         251 --240:     uint32_t    bit_position;
                         252 --242:     lul_fls_status = D_FLS_ZERO_U32;
                         253 --243:     boot_pe = D_FLS_ZERO_U32;
                         254 --244:     bit_position = D_FLS_ZERO_U32;
                         255 --246:     /* Get the started PE */
                         256 --247:     lul_fls_status = D_COMM_GetStartupPEInfo(&boot_pe);
                         257 --249:     /* Perform processing for all started PEs */
                         258 --250:     while ((D_FLS_ZERO_U32 != boot_pe) && (ER_OK == lul_fls_status))
                         259 --251:     {
                         260 --252:         /* judge if the PE has been started */
                         261 --253:         if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe))
                         262 --254:         {
                         263 --255:             /* Clear flash mode switching response */
                         264 --256:             g_sec_df_prog_res = FLS_MODE_SW_RESP_CLR;
                         265 --257:             /* Issues a Data Flash (FPSYS0) mode switching request interrupt to the PE */
                         266 --258:             lul_fls_status = D_COMM_TriggerInterruptToPE((icum_comm_target_pe_t)bit_position,
                         267 --259:                                                          ICUM_COMM_ICH_TO_DF_PRG_REQ_0, NULL);
                         268 --260:             if (ER_OK == lul_fls_status)
                         269 --261:             {
                         270 --262:                 /* Waiting for a response from the PE (with time monitoring) */
                         271 --263:                 lul_fls_status = d_FLS_CheckDfProgRes(D_FLS_TIMEOUT_DFPROGRES);
                         272 --264:             }
                         273 --265:             else
                         274 --266:             {
                         275 --267:                 /* Do nothing */
                         276 --268:             }
                         277 --270:             if (ER_OK == lul_fls_status)
                         278 --271:             {
                         279 --272:                 /* If the response interrupt is NACK, the processing ends */
                         280 --273:                 if ((uint8_t)FLS_MODE_SW_RESP_NACK == g_sec_df_prog_res)
                         281 --274:                 {
                         282 --275:                     lul_fls_status = ER_D_FLS_ACCPROHIBIT;
                         283 --276:                 }
                         284 --277:                 else
                         285 --278:                 {
                         286 --279:                     /* Do nothing */
                         287 --280:                 }
                         288 --281:             }
                         289 --282:             else
                         290 --283:             {
                         291 --284:                 /* Do nothing */
                         292 --285:             }
                         293 --286:         } /* end of if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe)) */
                         294 --287:         else

                                                                      Page 6
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qsk1.si
                         295 --288:         {
                         296 --289:             /* Do nothing */
                         297 --290:         }
                         298 --291:         /* To the next PE processing */
                         299 --292:         boot_pe >>= D_FLS_SHIT_1BIT;
                         300 --293:         bit_position++;
                         301 --294:     }
                         302 --296:     if (ER_OK == lul_fls_status)
                         303 --297:     {
                         304 --298:         /* Disable UPGP2 protection */
                         305 --299:         lul_fls_status = D_FLS_SetUPGPProtect_ram(D_FLS_UPGP_ON, D_FLS_UPGP_OFF);
                         306 --300:     }
                         307 --301:     else
                         308 --302:     {
                         309 --303:         /* Do nothing */
                         310 --304:     }
                         311 --306:     switch (lul_fls_status)
                         312 --307:     {
                         313 --308:         case ER_OK:
                         314 --309:             /* Set successful completion */
                         315 --310:             lul_fls_status = FLS_ERR_NONE;
                         316 --311:             break;
                         317 --312:         case ER_D_FLS_DFPRGINTTOUT:
                         318 --313:         case ER_D_FLS_ACCPROHIBIT:
                         319 --314:             /* Do nothing */
                         320 --315:             break;
                         321 --316:         default:
                         322 --317:             /* Set unexpected error */
                         323 --318:             lul_fls_status = ER_D_FLS_INTERNAL;
                         324 --319:             break;
                         325 --320:     } /* end of for switch (lul_fls_status) */
