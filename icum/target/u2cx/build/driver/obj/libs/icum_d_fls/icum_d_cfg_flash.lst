                        1752 --542: /******************************************************************************************
                        1753 --543: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0071]:[ICUMFW_UD_U2B_D_FLS_0071]
                        1754 --544: * Function Name : D_FLS_PostProgramSec
                        1755 --545: * Description   : Set the flash control parameters to complete of security area update
                        1756 --546: * Arguments     : none
                        1757 --547: * Return Value  : FLS_ERR_NONE
                        1758 --548: *                 ER_D_FLS_INTERNAL
                        1759 --549: *******************************************************************************************/
                        1760 --550: uint32_t D_FLS_PostProgramSec(void)
                        1761 --551: {
                        1762 --552:     fls_ctrl_t  *p_fls_ctrl;
                        1763 --553:     uint32_t    lul_fls_status;
                        1764 --554:     uint32_t    boot_pe;
                        1765 --555:     uint32_t    bit_position;
                        1766 --557:     lul_fls_status = D_FLS_ZERO_U32;
                        1767 --558:     boot_pe = D_FLS_ZERO_U32;
                        1768 --559:     bit_position = D_FLS_ZERO_U32;
                        1769 --561:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                        1770 --563:     /* control variable setting */
                        1771 --564:     p_fls_ctrl->prm.d_status                = ER_OK;
                        1772 --565:     p_fls_ctrl->prm.commad_req              = D_FLS_CMDREQ_OFF;
                        1773 --566:     p_fls_ctrl->prm.success_resp            = ER_OK;
                        1774 --568:     /* Set the address of the driver control parameter setting processing function */
                        1775 --569:     /* of the FACI command that is continuously requested                          */
                        1776 --570:     p_fls_ctrl->prm.p_set_ctrl_prm          = NULL;
                        1777 --572:     /* Enable UPGP2 protection */
                        1778 --573:     lul_fls_status = D_FLS_SetUPGPProtect_ram(D_FLS_UPGP_ON, D_FLS_UPGP_ON);
                        1779 --575:     if (ER_OK == lul_fls_status)
                        1780 --576:     {
                        1781 --577:         /* Get the started PE */
                        1782 --578:         lul_fls_status = D_COMM_GetStartupPEInfo(&boot_pe);
                        1783 --579:     }
                        1784 --580:     else
                        1785 --581:     {
                        1786 --582:         /* Do nothing */
                        1787 --583:     }
                        1788 --585:     if (ER_OK == lul_fls_status)
                        1789 --586:     {
                        1790 --587:         /* Perform processing for all started PEs */
                        1791 --588:         while (D_FLS_ZERO_U32 != boot_pe)
                        1792 --589:         {
                        1793 --590:             /* judge if the PE has been started */
                        1794 --591:             if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe))
                        1795 --592:             {
                        1796 --593:                 /* Clear flash mode switching response */

                                                                      Page 31
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qsk1.si
                        1797 --594:                 g_sec_df_prog_res = FLS_MODE_SW_RESP_CLR;
                        1798 --595:                 /* Issues a Data Flash (FPSYS0) mode switching request interrupt to the PE */
                        1799 --596:                 lul_fls_status = D_COMM_TriggerInterruptToPE((icum_comm_target_pe_t)bit_position,
                        1800 --597:                                                              ICUM_COMM_ICH_TO_DF_PRG_REQ_0, NULL);
                        1801 --598:                 if (ER_OK == lul_fls_status)
                        1802 --599:                 {
                        1803 --600:                     /* Waiting for a response from the PE (with time monitoring) */
                        1804 --601:                     lul_fls_status = d_FLS_CheckDfProgRes(D_FLS_TIMEOUT_DFPROGRES);
                        1805 --602:                 }
                        1806 --603:                 else
                        1807 --604:                 {
                        1808 --605:                     /* Do nothing */
                        1809 --606:                 }
                        1810 --607:             } /* end of if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe)) */
                        1811 --608:             else
                        1812 --609:             {
                        1813 --610:                 /* Do nothing */
                        1814 --611:             }
                        1815 --613:             /* To the next PE processing */
                        1816 --614:             boot_pe >>= D_FLS_SHIT_1BIT;
                        1817 --615:             bit_position++;
                        1818 --616:         }
                        1819 --617:     }
                        1820 --618:     else
                        1821 --619:     {
                        1822 --620:         /* Do nothing */
                        1823 --621:     }
                        1824 --623:     if (ER_OK == lul_fls_status)
                        1825 --624:     {
                        1826 --625:         /* Set successful completion */
                        1827 --626:         lul_fls_status = FLS_ERR_NONE;
                        1828 --627:     }
                        1829 --628:     else
                        1830 --629:     {
                        1831 --630:         /* Set unexpected error */
                        1832 --631:         lul_fls_status = ER_D_FLS_INTERNAL;
                        1833 --632:     }
                        1834 --634:     return (lul_fls_status);
                        1835 --635: }
