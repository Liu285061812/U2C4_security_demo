                         503 --542: /******************************************************************************************
                         504 --543: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0071]:[ICUMFW_UD_U2B_D_FLS_0071]
                         505 --544: * Function Name : D_FLS_PostProgramSec
                         506 --545: * Description   : Set the flash control parameters to complete of security area update
                         507 --546: * Arguments     : none
                         508 --547: * Return Value  : FLS_ERR_NONE
                         509 --548: *                 ER_D_FLS_INTERNAL
                         510 --549: *******************************************************************************************/
                         511 --550: uint32_t D_FLS_PostProgramSec(void)
                         512 --551: {
                         513 --552:     fls_ctrl_t  *p_fls_ctrl;
                         514 --553:     uint32_t    lul_fls_status;
                         515 --554:     uint32_t    boot_pe;
                         516 --555:     uint32_t    bit_position;
                         517 --557:     lul_fls_status = D_FLS_ZERO_U32;
                         518 --558:     boot_pe = D_FLS_ZERO_U32;
                         519 --559:     bit_position = D_FLS_ZERO_U32;
                         520 --561:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                         521 --563:     /* control variable setting */
                         522 --564:     p_fls_ctrl->prm.d_status                = ER_OK;
                         523 --565:     p_fls_ctrl->prm.commad_req              = D_FLS_CMDREQ_OFF;
                         524 --566:     p_fls_ctrl->prm.success_resp            = ER_OK;
                         525 --568:     /* Set the address of the driver control parameter setting processing function */
                         526 --569:     /* of the FACI command that is continuously requested                          */
                         527 --570:     p_fls_ctrl->prm.p_set_ctrl_prm          = NULL;
                         528 --572:     /* Enable UPGP2 protection */
                         529 --573:     lul_fls_status = D_FLS_SetUPGPProtect_ram(D_FLS_UPGP_ON, D_FLS_UPGP_ON);
                         530 --575:     if (ER_OK == lul_fls_status)
                         531 --576:     {
                         532 --577:         /* Get the started PE */
                         533 --578:         lul_fls_status = D_COMM_GetStartupPEInfo(&boot_pe);
                         534 --579:     }
                         535 --580:     else
                         536 --581:     {
                         537 --582:         /* Do nothing */
                         538 --583:     }

                                                                      Page 10
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qsk1.si
                         539 --585:     if (ER_OK == lul_fls_status)
                         540 --586:     {
                         541 --587:         /* Perform processing for all started PEs */
                         542 --588:         while (D_FLS_ZERO_U32 != boot_pe)
                         543 --589:         {
                         544 --590:             /* judge if the PE has been started */
                         545 --591:             if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe))
                         546 --592:             {
                         547 --593:                 /* Clear flash mode switching response */
                         548 --594:                 g_sec_df_prog_res = FLS_MODE_SW_RESP_CLR;
                         549 --595:                 /* Issues a Data Flash (FPSYS0) mode switching request interrupt to the PE */
                         550 --596:                 lul_fls_status = D_COMM_TriggerInterruptToPE((icum_comm_target_pe_t)bit_position,
                         551 --597:                                                              ICUM_COMM_ICH_TO_DF_PRG_REQ_0, NULL);
                         552 --598:                 if (ER_OK == lul_fls_status)
                         553 --599:                 {
                         554 --600:                     /* Waiting for a response from the PE (with time monitoring) */
                         555 --601:                     lul_fls_status = d_FLS_CheckDfProgRes(D_FLS_TIMEOUT_DFPROGRES);
                         556 --602:                 }
                         557 --603:                 else
                         558 --604:                 {
                         559 --605:                     /* Do nothing */
                         560 --606:                 }
                         561 --607:             } /* end of if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe)) */
                         562 --608:             else
                         563 --609:             {
                         564 --610:                 /* Do nothing */
                         565 --611:             }
                         566 --613:             /* To the next PE processing */
                         567 --614:             boot_pe >>= D_FLS_SHIT_1BIT;
                         568 --615:             bit_position++;
                         569 --616:         }
                         570 --617:     }
                         571 --618:     else
                         572 --619:     {
                         573 --620:         /* Do nothing */
                         574 --621:     }
                         575 --623:     if (ER_OK == lul_fls_status)
                         576 --624:     {
                         577 --625:         /* Set successful completion */
                         578 --626:         lul_fls_status = FLS_ERR_NONE;
                         579 --627:     }
                         580 --628:     else
                         581 --629:     {
                         582 --630:         /* Set unexpected error */
                         583 --631:         lul_fls_status = ER_D_FLS_INTERNAL;
                         584 --632:     }
                         585 --634:     return (lul_fls_status);
                         586 --635: }
