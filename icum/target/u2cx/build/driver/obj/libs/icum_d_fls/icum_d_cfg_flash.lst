                         155 --130: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0063]:[ICUMFW_UD_U2B_D_FLS_0063]
                         156 --131: * Function Name : D_FLS_UpdateSecurity
                         157 --132: * Description   : Update the security setting area.
                         158 --133: * Arguments     : p_sec_area
                         159 --134: *                  Start address of security buffer.
                         160 --135: *                 size_sec_area
                         161 --136: *                  Size of security setting area.
                         162 --137: *                 p_updated_field
                         163 --138: *                  Start address of the security buffer to be updated.
                         164 --139: *                 size_field
                         165 --140: *                  Size to update (in 4-byte units)
                         166 --141: * Return Value  : ER_OK
                         167 --142: *                 ER_IN_PROCESS
                         168 --143: *                 ER_D_FLS_INTERNAL
                         169 --144: *                 ER_D_FLS_SETOPRDYTOUT
                         170 --145: *                 ER_D_FLS_SETOPMODTOUT
                         171 --146: *                 ER_D_FLS_FSTOPTOUT
                         172 --147: *                 ER_D_FLS_NON_BLANK

                                                                      Page 4
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qsk1.si
                         173 --148: *                 ER_D_FLS_PROTECTION
                         174 --149: *                 ER_D_FLS_WRITE
                         175 --150: *                 ER_D_FLS_ERASE
                         176 --151: *                 ER_D_FLS_REJECTED
                         177 --152: *                 ER_D_FLS_FACITOUT
                         178 --153: *********************************************************************************/
                         179 --154: uint32_t D_FLS_UpdateSecurity(uint32_t target_addr, const uint8_t *p_updated_field, const uint32_t size_field)
                         180 --155: {
                         181 --156:     uint32_t    lul_fls_status;
                         182 --157:     fls_ctrl_t  *p_fls_ctrl;
                         183 --158:     uint32_t    valid_data_read_counter;
                         184 --159:     uint32_t    read_count;
                         185 --160:     uint32_t    *p_property;
                         186 --162:     /* Save function parameters to g_fls_update_sec_prm */
                         187 --163:     g_fls_update_sec_prm.target_addr     = target_addr +
                         188 --164:                                           (D_FLS_SEC_SETTING_START_BACK_ADDRESS - D_FLS_SEC_SETTING_START_ADDRESS);
                         189 --165:     g_fls_update_sec_prm.size_field      = size_field;
                         190 --167:     /* Reads valid side information from the Security setting area write data */
                         191 --168:     for (valid_data_read_counter = 0UL; (sizeof(g_security_area_valid_data) / sizeof(uint8_t)) > valid_data_read_counter; valid_data_read_counter++)
                         192 --169:     {
                         193 --170:         g_security_area_valid_data[valid_data_read_counter] = *(p_updated_field + valid_data_read_counter);
                         194 --171:     }
                         195 --173:     /* Reads valid side information from the Switch area (valid area) */
                         196 --174:     for (valid_data_read_counter = 0UL; (sizeof(g_switch_area_valid_data) / sizeof(uint32_t)) > valid_data_read_counter; valid_data_read_counter++)
                         197 --175:     {
                         198 --176:         g_switch_area_valid_data[valid_data_read_counter] = ((uint32_t *)SWITCH_AREA_VALID_VALID_INFO)[valid_data_read_counter];
                         199 --177:     }
                         200 --179:     /* Reads backup data from the Security setting area (valid area) */
                         201 --180:     for (valid_data_read_counter = 0UL ; valid_data_read_counter < D_FLS_MANDATORY_WRITE_COUNT ; valid_data_read_counter++)
                         202 --181:     {
                         203 --182:         p_property = (uint32_t *)(SECURITY_SETTING_VALID_ST_ADDR + g_sec_area_write_offset[valid_data_read_counter]);
                         204 --183:         for (read_count = 0UL ; read_count < D_FLS_WRITE_COUNT ; read_count++)
                         205 --184:         {
                         206 --185:             g_security_property_backup[valid_data_read_counter][read_count] = p_property[read_count];
                         207 --186:         }
                         208 --187:     }
                         209 --189:     /* FACI number setteing */
                         210 --190:     (void)d_FLS_SelectFpsys_ram(target_addr);
                         211 --191:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                         212 --193:     /* control variable setting */
                         213 --194:     p_fls_ctrl->prm.d_status                = ER_D_FLS_REQUEST;
                         214 --195:     p_fls_ctrl->prm.ope_mode                = R_RFD_MODE_DFPE;
                         215 --197:     p_fls_ctrl->prm.command_code            = D_FACI_CMD_SECURITY_ERASE;
                         216 --199:     p_fls_ctrl->prm.flash_addr              = SECURITY_SETTING_INVAL_ST_ADDR;
                         217 --200:     p_fls_ctrl->prm.commad_req              = D_FLS_CMDREQ_ON;
                         218 --201:     p_fls_ctrl->prm.p_data                  = NULL;
                         219 --202:     p_fls_ctrl->prm.data_size_in_bytes      = SECURITY_SETTING_ERASE_SIZE;
                         220 --203:     p_fls_ctrl->prm.p_pre_processing        = &d_FLS_PreProcessingSec;
                         221 --204:     p_fls_ctrl->prm.p_faci_commad_set       = &d_FLS_IssueCommand_ram;
                         222 --205:     p_fls_ctrl->prm.p_write_size_in_bytes   = &d_FLS_GetEraseWriteSizeSec;
                         223 --206:     p_fls_ctrl->prm.p_error_check           = &d_FLS_CheckFaciErrors_ram;
                         224 --207:     p_fls_ctrl->prm.success_resp            = ER_OK;
                         225 --208:     p_fls_ctrl->prm.p_num                   = 0UL;
                         226 --210:     /* Set Max FACI command time + Margin time */
                         227 --211:     p_fls_ctrl->prm.max_time                = TIMEOUT_ERASE_SEC;
                         228 --213:     /* Set the address of the driver control parameter setting processing function */
                         229 --214:     /* of the FACI command that is continuously requested                          */
                         230 --215:     p_fls_ctrl->prm.p_set_ctrl_prm          = &d_FLS_ProgramSecurity;
                         231 --217:     lul_fls_status = d_FLS_Handler_ram(g_fls_selected_fpsys);
                         232 --219:     return (lul_fls_status);
                         233 --220: }

