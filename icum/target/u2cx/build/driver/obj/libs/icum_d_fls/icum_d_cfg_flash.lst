                        1329 --544: * Function Name : D_FLS_PostProgramSec
                        1330 --545: * Description   : Set the flash control parameters to complete of security area update
                        1331 --546: * Arguments     : none
                        1332 --547: * Return Value  : FLS_ERR_NONE
                        1333 --548: *                 ER_D_FLS_INTERNAL
                        1334 --549: *******************************************************************************************/
                        1335 --550: uint32_t D_FLS_PostProgramSec(void)
                        1336 --551: {
                        1337 --552:     fls_ctrl_t  *p_fls_ctrl;
                        1338 --553:     uint32_t    lul_fls_status;
                        1339 --554:     uint32_t    boot_pe;
                        1340 --555:     uint32_t    bit_position;
                        1341 --557:     lul_fls_status = D_FLS_ZERO_U32;
                        1342 --558:     boot_pe = D_FLS_ZERO_U32;
                        1343 --559:     bit_position = D_FLS_ZERO_U32;
                        1344 --561:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                        1345 --563:     /* control variable setting */
                        1346 --564:     p_fls_ctrl->prm.d_status                = ER_OK;
                        1347 --565:     p_fls_ctrl->prm.commad_req              = D_FLS_CMDREQ_OFF;
                        1348 --566:     p_fls_ctrl->prm.success_resp            = ER_OK;
                        1349 --568:     /* Set the address of the driver control parameter setting processing function */
                        1350 --569:     /* of the FACI command that is continuously requested                          */
                        1351 --570:     p_fls_ctrl->prm.p_set_ctrl_prm          = NULL;
                        1352 --572:     /* Enable UPGP2 protection */
                        1353 --573:     lul_fls_status = D_FLS_SetUPGPProtect_ram(D_FLS_UPGP_ON, D_FLS_UPGP_ON);
                        1354 --575:     if (ER_OK == lul_fls_status)
                        1355 --576:     {
                        1356 --577:         /* Get the started PE */
                        1357 --578:         lul_fls_status = D_COMM_GetStartupPEInfo(&boot_pe);
                        1358 --579:     }
                        1359 --580:     else
                        1360 --581:     {
                        1361 --582:         /* Do nothing */
                        1362 --583:     }
                        1363 --585:     if (ER_OK == lul_fls_status)
                        1364 --586:     {
                        1365 --587:         /* Perform processing for all started PEs */
                        1366 --588:         while (D_FLS_ZERO_U32 != boot_pe)
                        1367 --589:         {
                        1368 --590:             /* judge if the PE has been started */
                        1369 --591:             if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe))

                                                                      Page 24
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000qsk1.si
                        1370 --592:             {
                        1371 --593:                 /* Clear flash mode switching response */
                        1372 --594:                 g_sec_df_prog_res = FLS_MODE_SW_RESP_CLR;
                        1373 --595:                 /* Issues a Data Flash (FPSYS0) mode switching request interrupt to the PE */
                        1374 --596:                 lul_fls_status = D_COMM_TriggerInterruptToPE((icum_comm_target_pe_t)bit_position,
                        1375 --597:                                                              ICUM_COMM_ICH_TO_DF_PRG_REQ_0, NULL);
                        1376 --598:                 if (ER_OK == lul_fls_status)
                        1377 --599:                 {
                        1378 --600:                     /* Waiting for a response from the PE (with time monitoring) */
                        1379 --601:                     lul_fls_status = d_FLS_CheckDfProgRes(D_FLS_TIMEOUT_DFPROGRES);
                        1380 --602:                 }
                        1381 --603:                 else
                        1382 --604:                 {
                        1383 --605:                     /* Do nothing */
                        1384 --606:                 }
                        1385 --607:             } /* end of if (D_FLS_PE_CHECK == (D_FLS_PE_CHECK & boot_pe)) */
                        1386 --608:             else
                        1387 --609:             {
                        1388 --610:                 /* Do nothing */
                        1389 --611:             }
                        1390 --613:             /* To the next PE processing */
                        1391 --614:             boot_pe >>= D_FLS_SHIT_1BIT;
                        1392 --615:             bit_position++;
                        1393 --616:         }
                        1394 --617:     }
                        1395 --618:     else
                        1396 --619:     {
                        1397 --620:         /* Do nothing */
                        1398 --621:     }
                        1399 --623:     if (ER_OK == lul_fls_status)
                        1400 --624:     {
                        1401 --625:         /* Set successful completion */
                        1402 --626:         lul_fls_status = FLS_ERR_NONE;
                        1403 --627:     }
                        1404 --628:     else
                        1405 --629:     {
                        1406 --630:         /* Set unexpected error */
                        1407 --631:         lul_fls_status = ER_D_FLS_INTERNAL;
                        1408 --632:     }
                        1409 --634:     return (lul_fls_status);
                        1410 --635: }
