                         580 --145: * Function Name : D_FLS_EraseCf_ram
                         581 --146: * Description   : Request erase of code flash area.
                         582 --147: * Arguments     : flash_addr
                         583 --148: *                   Start address of the code flash area to be erase.
                         584 --149: *                   Designated by physical address.
                         585 --150: *                 data_size_in_bytes
                         586 --151: *                   Number of bytes to erase (in 4-byte units).
                         587 --152: * Return Value  :   ER_OK
                         588 --153: *                   ER_IN_PROCESS
                         589 --154: *                   ER_D_FLS_INTERNAL
                         590 --155: *                   ER_D_FLS_SETOPRDYTOUT
                         591 --156: *                   ER_D_FLS_REJECTED
                         592 --157: *                   ER_D_FLS_SETOPMODTOUT
                         593 --158: *                   ER_D_FLS_FSTOPTOUT

                                                                      Page 11
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00002es1.si
                         594 --159: *                   ER_D_FLS_FACITOUT
                         595 --160: *                   ER_D_FLS_NON_BLANK
                         596 --161: *                   ER_D_FLS_PROTECTION
                         597 --162: *                   ER_D_FLS_WRITE
                         598 --163: *                   ER_D_FLS_ERASE
                         599 --164: *******************************************************************************************/
                         600 --165: uint32_t D_FLS_EraseCf_ram(const uint32_t flash_addr, const uint32_t data_size_in_bytes)
                         601 --166: {
                         602 --167:     uint32_t    lul_fls_status;
                         603 --168:     fls_ctrl_t  *p_fls_ctrl;
                         604 --170:     /* FACI number setteing */
                         605 --171:     (void)d_FLS_SelectFpsys_ram(flash_addr);
                         606 --172:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                         607 --174:     /* control variable setting */
                         608 --175:     p_fls_ctrl->prm.d_status                 = ER_D_FLS_REQUEST;
                         609 --176:     p_fls_ctrl->prm.ope_mode                 = (uint16_t)R_RFD_MODE_CFPE;
                         610 --177:     p_fls_ctrl->prm.commad_req               = D_FLS_CMDREQ_ON;
                         611 --178:     p_fls_ctrl->prm.command_code             = D_FACI_CMD_BLOCK_ERASE;
                         612 --179:     p_fls_ctrl->prm.flash_addr               = flash_addr;
                         613 --180:     p_fls_ctrl->prm.p_data                   = NULL;
                         614 --181:     p_fls_ctrl->prm.data_size_in_bytes       = data_size_in_bytes;
                         615 --182:     p_fls_ctrl->prm.p_pre_processing         = &d_FLS_PreProcessingCf_ram;
                         616 --183:     p_fls_ctrl->prm.p_faci_commad_set        = &d_FLS_IssueCommand_ram;
                         617 --184:     p_fls_ctrl->prm.p_write_size_in_bytes    = &d_FLS_GetCfEraseWriteSize_ram;
                         618 --185:     p_fls_ctrl->prm.p_error_check            = &d_FLS_CheckFaciErrors_ram;
                         619 --186:     p_fls_ctrl->prm.success_resp             = ER_OK;
                         620 --187:     p_fls_ctrl->prm.p_num                    = D_FLS_ZERO_U32;
                         621 --189:     /* Set Max FACI command time + Margin time */
                         622 --190:     p_fls_ctrl->prm.max_time                 = TIMEOUT_ERASE_CF;
                         623 --192:     lul_fls_status = d_FLS_Handler_ram(g_fls_selected_fpsys);
                         624 --194:     return (lul_fls_status);
                         625 --195: }
