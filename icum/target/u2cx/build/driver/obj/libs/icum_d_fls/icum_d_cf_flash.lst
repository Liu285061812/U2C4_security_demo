                         279 --267: *********************************************************************************/
                         280 --268: uint32_t D_FLS_GetCfProgramWriteSize_ram(UNUSED const uint32_t flash_addr, uint32_t *p_size)
                         281 --269: {
                         282 --270:     if (D_FLS_CF_BANKA_START_ADDRESS <= flash_addr)
                         283 --271:     {
                         284 --272:         /* Normal */
                         285 --273:     }
                         286 --274:     else
                         287 --275:     {
                         288 --276:         /* Abnormal */
                         289 --277:     }
                         290 --279:     *p_size = CF_WBUFFER_SIZE;
                         291 --281:     return (ER_OK);
                         292 --282: }
