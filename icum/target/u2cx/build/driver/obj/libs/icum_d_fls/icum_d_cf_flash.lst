                         232 --215: * Function Name : D_FLS_GetCfEraseBlockSize_ram
                         233 --216: * Description   : get flash erase block size (byte)

                                                                      Page 5
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00002es1.si
                         234 --217: * Arguments     : flash_addr
                         235 --218: *                   code flash address
                         236 --219: *               : *p_size
                         237 --220: *                   erase block size
                         238 --221: * Return Value  :   ER_OK : No error detected
                         239 --222: *********************************************************************************/
                         240 --223: uint32_t D_FLS_GetCfEraseBlockSize_ram(const uint32_t flash_addr, uint32_t *p_size)
                         241 --224: {
                         242 --225:     /* block 0-7 : 16[Kbyte]  */
                         243 --226:     /* block 8-  : 64[Kbyte] */
                         244 --228:     if ((CF_BOOT_AREA_SIZE_BANKA_END > flash_addr) ||
                         245 --229:         ((CF_BOOT_AREA_SIZE_BANKB_START <= flash_addr) && (CF_BOOT_AREA_SIZE_BANKB_END > flash_addr)))
                         246 --230:     {
                         247 --231:         *p_size = CF_ERASE_BLOCK_SIZE_BOOT;
                         248 --232:     }
                         249 --233:     else
                         250 --234:     {
                         251 --235:         *p_size = CF_ERASE_BLOCK_SIZE;
                         252 --236:     }
                         253 --238:     return (ER_OK);
                         254 --239: }
                         255 --241: /********************************************************************************
                         256 --242: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0054]:[ICUMFW_UD_U2B_D_FLS_0054]
