                         261 --247: *               : *p_size
                         262 --248: *                   erase size
                         263 --249: * Return Value  :   FLS_ERR_NONE : No error detected
                         264 --250: *********************************************************************************/
                         265 --251: STATIC uint32_t d_FLS_GetCfEraseWriteSize_ram(const uint32_t flash_addr, uint32_t *p_size)
                         266 --252: {
                         267 --253:     (void)D_FLS_GetCfEraseBlockSize_ram(flash_addr, p_size);
                         268 --255:     return (FLS_ERR_NONE);
                         269 --256: }
