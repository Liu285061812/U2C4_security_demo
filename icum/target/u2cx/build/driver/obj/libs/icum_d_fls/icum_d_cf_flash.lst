                         119 --88: * Function Name : D_FLS_ProgramCf_ram
                         120 --89: * Description   : Request write to the code flash area.
                         121 --90: * Arguments     : flash_addr
                         122 --91: *                   Start address of the data flash area to be written (256-byte boundary).
                         123 --92: *                   It is specified by a relative address with the head address of the block 0
                         124 --93: *                   of the flash set to 0x0000_0000.
                         125 --94: *                 p_data
                         126 --95: *                   data to be written.
                         127 --96: *                 data_size_in_bytes
                         128 --97: *                   Number of bytes to write (in 4-byte units).
                         129 --98: * Return Value  :   ER_OK
                         130 --99: *                   ER_IN_PROCESS
                         131 --100: *                   ER_D_FLS_INTERNAL
                         132 --101: *                   ER_D_FLS_SETOPRDYTOUT
                         133 --102: *                   ER_D_FLS_REJECTED
                         134 --103: *                   ER_D_FLS_SETOPMODTOUT
                         135 --104: *                   ER_D_FLS_FSTOPTOUT
                         136 --105: *                   ER_D_FLS_FACITOUT
                         137 --106: *                   ER_D_FLS_NON_BLANK
                         138 --107: *                   ER_D_FLS_PROTECTION
                         139 --108: *                   ER_D_FLS_WRITE
                         140 --109: *                   ER_D_FLS_ERASE
                         141 --110: **************************************************************************************************/
                         142 --111: uint32_t D_FLS_ProgramCf_ram(const uint32_t flash_addr, const uint8_t *p_data, const uint32_t data_size_in_bytes)
                         143 --112: {
                         144 --113:     uint32_t    lul_fls_status;
                         145 --114:     fls_ctrl_t  *p_fls_ctrl;
                         146 --116:     /* FACI number setteing */
                         147 --117:     (void)d_FLS_SelectFpsys_ram(flash_addr);
                         148 --118:     p_fls_ctrl = &g_fls_ctrl[g_fls_selected_fpsys];
                         149 --120:     /* control variable setting */
                         150 --121:     p_fls_ctrl->prm.d_status                 = ER_D_FLS_REQUEST;
                         151 --122:     p_fls_ctrl->prm.ope_mode                 = (uint16_t)R_RFD_MODE_CFPE;
                         152 --123:     p_fls_ctrl->prm.commad_req               = D_FLS_CMDREQ_ON;
                         153 --124:     p_fls_ctrl->prm.command_code             = D_FACI_CMD_PROGRAM;
                         154 --125:     p_fls_ctrl->prm.flash_addr               = flash_addr;
                         155 --126:     p_fls_ctrl->prm.p_data                   = p_data;
                         156 --127:     p_fls_ctrl->prm.data_size_in_bytes       = data_size_in_bytes;
                         157 --128:     p_fls_ctrl->prm.p_pre_processing         = &d_FLS_PreProcessingCf_ram;
                         158 --129:     p_fls_ctrl->prm.p_faci_commad_set        = &d_FLS_IssueCommand_ram;
                         159 --130:     p_fls_ctrl->prm.p_write_size_in_bytes    = &D_FLS_GetCfProgramWriteSize_ram;
                         160 --131:     p_fls_ctrl->prm.p_error_check            = &d_FLS_CheckFaciErrors_ram;
                         161 --132:     p_fls_ctrl->prm.success_resp             = ER_OK;
                         162 --133:     p_fls_ctrl->prm.p_num                    = D_FLS_ZERO_U32;
                         163 --135:     /* Set Max FACI command time + Margin time */
                         164 --136:     p_fls_ctrl->prm.max_time                 = TIMEOUT_PROGRAM_CF;
                         165 --138:     lul_fls_status = d_FLS_Handler_ram(g_fls_selected_fpsys);
                         166 --140:     return (lul_fls_status);
                         167 --141: }
