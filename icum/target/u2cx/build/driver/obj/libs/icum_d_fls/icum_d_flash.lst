                       18498 --1631: *                 ER_D_FLS_WRITE
                       18499 --1632: *                 ER_D_FLS_ERASE
                       18500 --1633: *                 ER_D_FLS_CANCEL
                       18501 --1634: *                 ER_D_FLS_INTERNAL
                       18502 --1635: *********************************************************************************/
                       18503 --1636: static uint32_t d_FLS_Err2Status_ram(const uint32_t error_code)
                       18504 --1637: {
                       18505 --1638:     uint32_t lul_fls_status;
                       18506 --1640:     if (FLS_ERR_NONE == error_code)
                       18507 --1641:     {
                       18508 --1642:         lul_fls_status = ER_OK;
                       18509 --1643:     }
                       18510 --1644:     else if (FLS_ERR_CANCEL_END == error_code)
                       18511 --1645:     {   /* cancel normal end */
                       18512 --1646:         lul_fls_status = ER_OK;
                       18513 --1647:     }
                       18514 --1648:     else if (D_FLS_ZERO_U32 != (error_code & FLS_ERR_PROTECTION))
                       18515 --1649:     {
                       18516 --1650:         lul_fls_status = ER_D_FLS_PROTECTION;
                       18517 --1651:     }
                       18518 --1652:     else if (D_FLS_ZERO_U32 != (error_code & FLS_ERR_PROG))
                       18519 --1653:     {
                       18520 --1654:         switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code)
                       18521 --1655:         {
                       18522 --1656:             case D_FACI_CMD_PROGRAM:
                       18523 --1657:             case D_FACI_CMD_MULTI_PROGRAM:
                       18524 --1658:                 lul_fls_status = ER_D_FLS_WRITE;
                       18525 --1659:                 break;
                       18526 --1661:             case D_FACI_CMD_BLOCK_ERASE:
                       18527 --1662:                 lul_fls_status = ER_D_FLS_ERASE;
                       18528 --1663:                 break;
                       18529 --1665:             case D_FACI_CMD_FORCED_STOP:
                       18530 --1666:                 lul_fls_status = ER_D_FLS_CANCEL;
                       18531 --1667:                 break;
                       18532 --1669:             case D_FACI_CMD_SECURITY_ERASE:
                       18533 --1670:             case D_FACI_CMD_SECURITY_PROGRAM:
                       18534 --1671:             case D_FACI_CMD_SWITCH_ERASE:
                       18535 --1672:             case D_FACI_CMD_SWITCH_PROGRAM:
                       18536 --1673:             case D_FACI_CMD_TAG_ERASE:
                       18537 --1674:             case D_FACI_CMD_TAG_UPDATE:
                       18538 --1675:                 lul_fls_status = ER_D_FLS_WRITE;
                       18539 --1676:                 break;
                       18540 --1678:             case D_FACI_CMD_STATUS_CLEAR:
                       18541 --1679:                             /* Impossible !!     */
                       18542 --1680:             case D_FACI_CMD_BLANK_CHECK:
                       18543 --1681:                             /* Impossible !!     */
                       18544 --1682:             case D_FACI_CMD_PE_RESUME:
                       18545 --1683:                             /* Impossible !!     */
                       18546 --1684:             default:
                       18547 --1685:                 lul_fls_status = ER_D_FLS_INTERNAL;
                       18548 --1686:                 break;
                       18549 --1687:         } /* end of switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code) */

                                                                      Page 309
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       18550 --1688:     }   /* end of else if (0U != (error_code & FLS_ERR_PROG)) */
                       18551 --1689:     else
                       18552 --1690:     {
                       18553 --1691:         /* other */
                       18554 --1692:         lul_fls_status = ER_D_FLS_INTERNAL;
                       18555 --1693:     }
                       18556 --1694:     return (lul_fls_status);
                       18557 --1695: }
