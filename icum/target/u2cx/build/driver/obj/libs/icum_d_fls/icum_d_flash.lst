                         304 --305: uint32_t d_FLS_Handler_ram(const uint32_t fpsys)
                         305 --306: {
                         306 --307:     uint32_t lstag_fls_err;
                         307 --308:     uint32_t lul_fls_status;
                         308 --309:     uint32_t lul_write_size;
                         309 --310:     uint32_t lul_comp_result;
                         310 --311:     uint32_t lul_continuously_flag;
                         311 --313:     lul_fls_status = g_fls_ctrl[fpsys].prm.d_status;
                         312 --315:     if (D_FLS_STS_AVAILABLE != g_fls_status)
                         313 --316:     {
                         314 --317:         lul_fls_status = ER_D_FLS_INTERNAL;
                         315 --318:     }
                         316 --319:     else if (ER_D_FLS_REQUEST == lul_fls_status)
                         317 --320:     {
