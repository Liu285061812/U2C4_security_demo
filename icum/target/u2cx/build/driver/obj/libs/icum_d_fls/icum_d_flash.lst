                        3665 --305: uint32_t d_FLS_Handler_ram(const uint32_t fpsys)
                        3666 --306: {
                        3667 --307:     uint32_t lstag_fls_err;
                        3668 --308:     uint32_t lul_fls_status;
                        3669 --309:     uint32_t lul_write_size;
                        3670 --310:     uint32_t lul_comp_result;
                        3671 --311:     uint32_t lul_continuously_flag;
                        3672 --313:     lul_fls_status = g_fls_ctrl[fpsys].prm.d_status;
                        3673 --315:     if (D_FLS_STS_AVAILABLE != g_fls_status)
                        3674 --316:     {
                        3675 --317:         lul_fls_status = ER_D_FLS_INTERNAL;
                        3676 --318:     }
                        3677 --319:     else if (ER_D_FLS_REQUEST == lul_fls_status)
                        3678 --320:     {
                        3679 --321:         /* Performs FACI command issue processing */
                        3680 --322:         lul_fls_status = d_FLS_HandlerCommandReq_ram(fpsys);
                        3681 --323:     }
                        3682 --324:     else if (ER_IN_PROCESS == lul_fls_status)
                        3683 --325:     {

                                                                      Page 62
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        3684 --326:         g_fls_ctrl[fpsys].prm.p_write_size_in_bytes((g_fls_ctrl[fpsys].prm.flash_addr + g_fls_ctrl[fpsys].prm.p_num),
                        3685 --327:                                                     &lul_write_size);
                        3686 --328:         /* accepted the cancel API ? */
                        3687 --329:         if ((uint32_t)D_FLS_CMDREQ_ON == (uint32_t)g_fls_ctrl[fpsys].prm.commad_req)
                        3688 --330:         {
                        3689 --331:             /* Force-stop */
                        3690 --332:             g_fls_ctrl[fpsys].prm.commad_req = D_FLS_CMDREQ_OFF;
                        3691 --333:             lstag_fls_err = g_fls_ctrl[fpsys].prm.p_faci_commad_set();
                        3692 --334:             if (FLS_ERR_NONE != lstag_fls_err)
                        3693 --335:             {
                        3694 --336:                 lul_fls_status = d_FLS_Err2Status_ram(lstag_fls_err);
                        3695 --337:                 d_FLS_SetReadMode_ram();
                        3696 --338:                 g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        3697 --339:             }
                        3698 --340:             else
                        3699 --341:             {
                        3700 --342:                 lul_fls_status = ER_IN_PROCESS;
                        3701 --343:             }
                        3702 --344:         }
                        3703 --345:         else
                        3704 --346:         {
                        3705 --347:             lul_comp_result = d_FLS_CheckProcessingCompletion_ram();
                        3706 --348:             if ((uint32_t)ER_OK == lul_comp_result)
                        3707 --349:             {
                        3708 --350:                 lstag_fls_err = g_fls_ctrl[fpsys].prm.p_error_check();
                        3709 --351:                 if (FLS_ERR_NONE != lstag_fls_err)
                        3710 --352:                 {
                        3711 --353:                     d_FLS_SetReadMode_ram();
                        3712 --354:                     lul_fls_status = d_FLS_Err2Status_ram(lstag_fls_err);
                        3713 --355:                     g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        3714 --356:                 }
                        3715 --357:                 else
                        3716 --358:                 {
                        3717 --359:                     /* In case of cancellation, g_fls_ctrl[fpsys].prm.p_num & Lul_write_size is 0 */
                        3718 --360:                     g_fls_ctrl[fpsys].prm.p_num += lul_write_size;
                        3719 --362:                     if (g_fls_ctrl[fpsys].prm.p_num < g_fls_ctrl[fpsys].prm.data_size_in_bytes)
                        3720 --363:                     {   /* In case of cancellation, This condition is not satisfied */
                        3721 --364:                         /* Next block */
                        3722 --365:                         lstag_fls_err = g_fls_ctrl[fpsys].prm.p_faci_commad_set();
                        3723 --366:                         if (FLS_ERR_NONE != lstag_fls_err)
                        3724 --367:                         {
                        3725 --368:                             d_FLS_SetReadMode_ram();
                        3726 --369:                             lul_fls_status = d_FLS_Err2Status_ram(lstag_fls_err);
                        3727 --370:                             g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        3728 --371:                         }
                        3729 --372:                         else
                        3730 --373:                         {
                        3731 --374:                             /* Succeeded in set command, go to normal end */
                        3732 --375:                         }
                        3733 --376:                     }
                        3734 --377:                     else
                        3735 --378:                     {
                        3736 --379:                         /* All Block Complete !! */
                        3737 --380:                         lul_fls_status = d_FLS_SetOperatingMode_ram((uint16_t)R_RFD_MODE_READ, D_FACI_CMD_DUMMY_CMD);
                        3738 --381:                         if ((uint32_t)ER_OK != lul_fls_status)
                        3739 --382:                         {
                        3740 --383:                             d_FLS_SetReadMode_ram();
                        3741 --384:                             g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        3742 --385:                         }
                        3743 --386:                         else
                        3744 --387:                         {

                                                                      Page 63
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        3745 --388:                             lul_fls_status = g_fls_ctrl[fpsys].prm.success_resp;
                        3746 --389:                         }
                        3747 --390:                         /* Issue the FACI command that continuously requests */
                        3748 --391:                         if ((ER_OK == lul_fls_status) && (NULL != g_fls_ctrl[fpsys].prm.p_set_ctrl_prm))
                        3749 --392:                         {
                        3750 --393:                             /* Performs command parameter setting processing */
                        3751 --394:                             lul_continuously_flag = D_FLS_SET1_U32;
                        3752 --395:                             lul_fls_status = g_fls_ctrl[fpsys].prm.p_set_ctrl_prm();
                        3753 --396:                         }
                        3754 --397:                         else
                        3755 --398:                         {
                        3756 --399:                             lul_continuously_flag = D_FLS_ZERO_U32;
                        3757 --400:                         }
                        3758 --401:                         if ((ER_OK == lul_fls_status) && (D_FLS_SET1_U32 == lul_continuously_flag))
                        3759 --402:                         {
                        3760 --403:                             /* Succeeded in set command parameters    */
                        3761 --404:                             /* Performs FACI command issue processing */
                        3762 --405:                             lul_fls_status = d_FLS_HandlerCommandReq_ram(fpsys);
                        3763 --406:                         }
                        3764 --407:                         else
                        3765 --408:                         {
                        3766 --409:                             g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        3767 --410:                         }
                        3768 --411:                     }
                        3769 --412:                 } /* end of else */
                        3770 --413:             } /* end of if ((uint32_t)ER_OK == lul_comp_result) */
                        3771 --414:             else if (ER_D_FLS_FACITOUT == lul_comp_result)
                        3772 --415:             {
                        3773 --416:                 /* In case of FACI timeout, set read mode */
                        3774 --417:                 d_FLS_SetReadMode_ram();
                        3775 --418:                 lul_fls_status = lul_comp_result;
                        3776 --419:             }
                        3777 --420:             else
                        3778 --421:             {
                        3779 --422:                 /* Nothing to do ER_IN_PROCESS == lul_fls_status */
                        3780 --423:             }   /* end of ER_OK == d_FLS_CheckProcessingCompletion_ram() */
                        3781 --424:         } /* end of else */
                        3782 --425:     } /* end of else if (ER_IN_PROCESS == lul_fls_status)  */
                        3783 --426:     else
                        3784 --427:     {
                        3785 --428:         g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        3786 --429:     }
                        3787 --431:     g_fls_ctrl[fpsys].prm.d_status = lul_fls_status;
                        3788 --432:     return (g_fls_ctrl[fpsys].prm.d_status);
                        3789 --433: }
