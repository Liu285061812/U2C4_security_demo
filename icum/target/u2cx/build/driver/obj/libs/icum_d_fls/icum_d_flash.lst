                       10339 --1802:         {
                       10340 --1803:             /* Cancel Normal end */
                       10341 --1804:             lstag_fls_err = FLS_ERR_CANCEL_END;
                       10342 --1805:         }
                       10343 --1806:         else
                       10344 --1807:         {
                       10345 --1808:             /* Err Check NG */
                       10346 --1809:             /* retry */
                       10347 --1810:             retry = (uint8_t)true;
                       10348 --1811:         }
                       10349 --1812:     }
                       10350 --1814:     if ((uint32_t)true == (uint32_t)retry)
                       10351 --1815:     {
                       10352 --1816:         /* Retry */
                       10353 --1818:         /* Set FACI Command code to FACICMD(8bit) */
                       10354 --1819:         lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                       10355 --1820:         if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                       10356 --1821:         {
                       10357 --1822:             /* Do nothing */
                       10358 --1823:         }
                       10359 --1824:         else
                       10360 --1825:         {
                       10361 --1826:             /* Error Check */
                       10362 --1827:             lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                       10363 --1828:             if (lstag_fls_err == FLS_ERR_NONE)
                       10364 --1829:             {
                       10365 --1830:                 /* Cancel Normal end */
                       10366 --1831:                 lstag_fls_err = FLS_ERR_CANCEL_END;
                       10367 --1832:             }
                       10368 --1833:             else
                       10369 --1834:             {
                       10370 --1835:                 /* Retry error */
                       10371 --1836:             }
                       10372 --1837:         }
                       10373 --1838:     }

                                                                      Page 173
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       10374 --1839:     else
                       10375 --1840:     {
                       10376 --1841:         /* Do nothing */
                       10377 --1842:     }
                       10378 --1844:     /* Error Check NG */
                       10379 --1845:     return (lstag_fls_err);
                       10380 --1847: }
                       10381 --1849: /**************************************************************************************
                       10382 --1850: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0029]:[ICUMFW_UD_U2B_D_FLS_0029]
                       10383 --1851: * Function Name : d_FLS_CheckProcessingCompletion_ram
                       10384 --1852: * Description   : Check whether the command is completed
                       10385 --1853: * Arguments     : none
                       10386 --1854: * Return Value  : ER_OK  : FSTAT.FRDY = 1
                       10387 --1855: *                        None of the below is in progress.
                       10388 --1856: *                 ER_IN_PROCESS : FSTAT.FRDY = 0
                       10389 --1857: *                        Processing of the command "Program", "Block Erase",
                       10390 --1858: *                         "Program/Erasure Suspend", "Program/Erasure Resume",
                       10391 --1859: *                         "Forced Stop", "Blank Check", "Config Program", 
                       10392 --1860: *                         "Lock Bit Program", "Lock Bit Read", or "OTP Set" is in
                       10393 --1861: *                         progress.
                       10394 --1862: *                 ER_D_FLS_FACITOUT : FACI timeout
                       10395 --1863: ***************************************************************************************/
                       10396 --1864: static uint32_t d_FLS_CheckProcessingCompletion_ram(void)
                       10397 --1865: {
                       10398 --1866:     uint32_t res;
                       10399 --1867:     uint32_t lul_now;
                       10400 --1868:     uint32_t lul_frdy;
                       10401 --1869:     uint32_t saved_psw;
                       10402 --1870:     T_u4_RFDReturn  l_bu4_returnValue ;
                       10403 --1871:     
                       10404 --1872:     res = ER_IN_PROCESS;
                       10405 --1873:     /* Disable EI Level Maskable Interrupt */
                       10406 --1874:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                       10407 --1876:     l_bu4_returnValue = R_RFD_GetFaciSequenceReady((T_u2_FACI)g_fls_selected_fpsys);
                       10408 --1877:     
                       10409 --1878:     if (R_RFD_STS_READY == l_bu4_returnValue)
                       10410 --1879:     {
                       10411 --1880:         lul_frdy = R_RFD_STS_READY;
                       10412 --1881:     }
                       10413 --1882:     else
                       10414 --1883:     {
                       10415 --1884:         lul_frdy = D_FLS_ZERO_U32;
                       10416 --1885:     }
                       10417 --1886:     
                       10418 --1887:     /* Check FACI command time out */
                       10419 --1888:      D_OST_GetHardCounter(&lul_now);
                       10420 --1890:     /* Enable EI Level Maskable Interrupt */
                       10421 --1891:     ENABLE_INTERRUPT_WITH_CHECK(saved_psw);
                       10422 --1893:     if (D_FLS_ZERO_U32 != lul_frdy)
                       10423 --1894:     {
                       10424 --1895:         res = ER_OK;
                       10425 --1896:     }
                       10426 --1897:     else
                       10427 --1898:     {
                       10428 --1899:         if (g_fls_ctrl[g_fls_selected_fpsys].prm.max_time
                       10429 --1900:             < (uint32_t)(lul_now - g_fls_ctrl[g_fls_selected_fpsys].prm.faci_start_time))
                       10430 --1901:         {
                       10431 --1902:             /* Issue Forced Stop Command */
                       10432 --1903:             (void)d_FLS_IssueCommandCtrl_ram();
                       10433 --1904:             res = ER_D_FLS_FACITOUT;
                       10434 --1905:         }

                                                                      Page 174
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       10435 --1906:         else
                       10436 --1907:         {
                       10437 --1908:             g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter++;
                       10438 --1910:             /* Max times of check FRDY bit */
                       10439 --1911:             if (LIMIT_CHECK_FRDY < g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter)
                       10440 --1912:             {
                       10441 --1913:                 /* Issue Forced Stop Command */
                       10442 --1914:                 (void)d_FLS_IssueCommandCtrl_ram();
                       10443 --1915:                 res = ER_D_FLS_FACITOUT;
                       10444 --1916:             }
                       10445 --1917:             else
                       10446 --1918:             {
                       10447 --1919:                  /* waiting FSTATR_FRDY */
                       10448 --1920:                  /* do nothing yet */
                       10449 --1921:             }
                       10450 --1922:         }
                       10451 --1923:     }
                       10452 --1924:     return (res);
                       10453 --1925: }
