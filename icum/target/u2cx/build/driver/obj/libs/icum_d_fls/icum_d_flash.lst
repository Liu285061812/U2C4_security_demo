                       18405 --1533:                 if ((uint32_t)D_FACI_CMD_FORCED_STOP == (uint32_t)comm_code)
                       18406 --1534:                 {
                       18407 --1535:                     lul_res = ER_OK;
                       18408 --1536:                 }
                       18409 --1537:                 else
                       18410 --1538:                 {
