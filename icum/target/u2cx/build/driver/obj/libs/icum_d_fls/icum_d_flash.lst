                         176 --162:     lul_fls_status = ER_OK;
                         177 --163:     L_Toolbox_MemSet((uint8_t *)&clr_fls_ctrl, D_FLS_ZERO_U8, sizeof(clr_fls_ctrl));
                         178 --164:     L_Toolbox_MemSet((uint8_t *)&comm_cb_regist, D_FLS_ZERO_U8, sizeof(comm_cb_regist));
                         179 --166:     /* parameter check */
                         180 --167:     if (NULL == p_init_prm_pstr)
                         181 --168:     {
                         182 --169:         /* parameter address NULL */
                         183 --170:         lul_fls_status = ER_D_FLS_CONFIGURATION;
                         184 --171:         /* FLS status error */
                         185 --172:     }
                         186 --173:     else
                         187 --174:     {
                         188 --175:         /* Normal */
                         189 --176:     }
                         190 --178:     if (ER_OK == lul_fls_status)
                         191 --179:     {
                         192 --180:         /* save parameter */
                         193 --181:         g_fls_cpu_frequency_MHz = p_init_prm_pstr->cpu_frequency_MHz;
                         194 --182:         /* clock range OK ? */
                         195 --183:         if (((uint32_t)CPU_CLOCK_MIN <= (uint32_t)g_fls_cpu_frequency_MHz)
                         196 --184:             && ((uint32_t)g_fls_cpu_frequency_MHz <= (uint32_t)CPU_CLOCK_MAX))
                         197 --185:         {
                         198 --186:             /* Normal */
                         199 --187:         }
                         200 --188:         else
                         201 --189:         {
                         202 --190:             /* Configuration Error */
                         203 --191:             lul_fls_status = ER_D_FLS_CONFIGURATION;
                         204 --192:         }
                         205 --193:     }
                         206 --194:     else
                         207 --195:     {
                         208 --196:         /* Do nothing */
                         209 --197:     }
                         210 --199:     /* Initializes the RFD28F */
                         211 --200:     lul_fls_status = (uint32_t)R_RFD_Init(0xFFFF);
                         212 --201:     
                         213 --202:     if (ER_OK == lul_fls_status)
                         214 --203:     {
                         215 --204:         /* Enables write access of protected registers */
                         216 --205:         ICUM_DFECC.ICUM_DFKCPROT.UINT32 = KCE_EN;
                         217 --206:         /* ECC Error enable */
                         218 --207:         ICUM_DFECC.CTL.UINT32  &= ~ICUM_ECC_ERROR_DIS;
                         219 --208:         /* Data Flash ECC Error Notification(EI level:INTECCDECERRDF) Disable */
                         220 --209:         ICUM_DFECC.ICUM_DFERRINT.UINT32  &= ~ICUM_DFERRINT_EN;
                         221 --210:         /* Disables write access of protected registers */
                         222 --211:         ICUM_DFECC.ICUM_DFKCPROT.UINT32 = KCE_DIS;
                         223 --213:         /* Initialize flash control table */
                         224 --214:         g_fls_ctrl[R_RFD_FACI0] = clr_fls_ctrl;
                         225 --215:         g_fls_ctrl[R_RFD_FACI2] = clr_fls_ctrl;
                         226 --216:         g_fls_ctrl_bak[R_RFD_FACI0] = clr_fls_ctrl;
                         227 --217:         g_fls_ctrl_bak[R_RFD_FACI2] = clr_fls_ctrl;
                         228 --218:         g_fls_ctrl[R_RFD_FACI0].status = D_FLS_IF0_IDLE;
                         229 --219:         g_fls_ctrl[R_RFD_FACI2].status = D_FLS_IF2_IDLE;
                         230 --220:         g_fls_ctrl_bak[R_RFD_FACI0].status = D_FLS_IF0_IDLE;
                         231 --221:         g_fls_ctrl_bak[R_RFD_FACI2].status = D_FLS_IF2_IDLE;
                         232 --223:         /* Register the handler for the DF mode switching response interrupt */
                         233 --224:         comm_cb_regist.channel = ICUM_COMM_ICH_FM_DF_PRG_NOTIFY | ICUM_COMM_ICH_FM_DF_PRG_ERROR;

