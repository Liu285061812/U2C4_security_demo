                        7010 --1906:         else
                        7011 --1907:         {
                        7012 --1908:             g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter++;
                        7013 --1910:             /* Max times of check FRDY bit */
                        7014 --1911:             if (LIMIT_CHECK_FRDY < g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter)

                                                                      Page 117
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        7015 --1912:             {
