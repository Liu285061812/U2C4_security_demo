                       11955 --1314: * Description   : Bus guard setting. (FACI0/1 Register and FACI0/1 Command Area)
                       11956 --1315: * Arguments     : none
                       11957 --1316: * Return Value  : none
                       11958 --1317: *******************************************************************************************/
                       11959 --1318: void d_FLS_SetBusGuardFromPE_ram(void)
                       11960 --1319: {
                       11961 --1320:     /* Enables write access of protected registers */
                       11962 --1321:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_EN;
                       11963 --1323:     /* Enable Bus Guard */
                       11964 --1324:     if (R_RFD_FACI0 == g_fls_selected_fpsys)
                       11965 --1325:     {
                       11966 --1326:         /* Flash Sequencer Register Area and Command Access Area for CPU(PE)(FACI0) */
                       11967 --1327:         /* => Set Access Guard for PE */
                       11968 --1328:         PBG61.PBGPROT0_1.UINT32 |= ICUM_PBGPROT_EN;
                       11969 --1329:     }
                       11970 --1331:     /* Disables write access of protected registers */
                       11971 --1332:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_DIS;
                       11972 --1334:     return;
                       11973 --1335: }
                       11974 --1337: /******************************************************************************************
                       11975 --1338: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0018]:[ICUMFW_UD_U2B_D_FLS_0018]
                       11976 --1339: * Function Name : d_FLS_ClrBusGuardFromPE_ram
                       11977 --1340: * Description   : Bus guard cancellation. (FACI0/1 Register and FACI0/1 Command area)
                       11978 --1341: * Arguments     : none
                       11979 --1342: * Return Value  : none
                       11980 --1343: *******************************************************************************************/
                       11981 --1344: void d_FLS_ClrBusGuardFromPE_ram(void)
                       11982 --1345: {
                       11983 --1346:     /* Enables write access of protected registers */
                       11984 --1347:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_EN;
                       11985 --1349:     /* Bus Guard Disabled */
                       11986 --1350:     if (R_RFD_FACI0 == g_fls_selected_fpsys)
                       11987 --1351:     {
                       11988 --1352:         /* Flash Sequencer Register Area and Command Access Area for CPU(PE)(FACI0) */
                       11989 --1353:         /* => Cancel Access Guard from PE */
                       11990 --1354:         PBG61.PBGPROT0_1.UINT32 &= ~ICUM_PBGPROT_EN;
                       11991 --1355:     }
                       11992 --1357:     /* Disables write access of protected registers */
                       11993 --1358:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_DIS;
                       11994 --1360:     return;
                       11995 --1361: }
