                        5016 --472:         g_fls_ctrl[iface].prm.p_write_size_in_bytes = &d_FLS_GetDummyWriteSize_ram;
                        5017 --473:         g_fls_ctrl[iface].prm.p_error_check       = &d_FLS_CheckFaciErrors_ram;
                        5018 --474:         g_fls_ctrl[iface].prm.success_resp        = ER_OK;
                        5019 --475:         g_fls_ctrl[iface].prm.p_num               = D_FLS_ZERO_U32;
                        5020 --477:         lul_fls_status = d_FLS_Handler_ram(iface);
                        5021 --478:     } /* end of if (ER_OK == lul_fls_status) */
                        5022 --479:     else

