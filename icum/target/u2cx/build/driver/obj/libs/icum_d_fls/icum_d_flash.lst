                        6690 --1653:     {
                        6691 --1654:         switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code)
                        6692 --1655:         {
                        6693 --1656:             case D_FACI_CMD_PROGRAM:
                        6694 --1657:             case D_FACI_CMD_MULTI_PROGRAM:
                        6695 --1658:                 lul_fls_status = ER_D_FLS_WRITE;
                        6696 --1659:                 break;
                        6697 --1661:             case D_FACI_CMD_BLOCK_ERASE:
                        6698 --1662:                 lul_fls_status = ER_D_FLS_ERASE;
                        6699 --1663:                 break;
                        6700 --1665:             case D_FACI_CMD_FORCED_STOP:
                        6701 --1666:                 lul_fls_status = ER_D_FLS_CANCEL;
                        6702 --1667:                 break;
                        6703 --1669:             case D_FACI_CMD_SECURITY_ERASE:
                        6704 --1670:             case D_FACI_CMD_SECURITY_PROGRAM:
                        6705 --1671:             case D_FACI_CMD_SWITCH_ERASE:
                        6706 --1672:             case D_FACI_CMD_SWITCH_PROGRAM:
                        6707 --1673:             case D_FACI_CMD_TAG_ERASE:
                        6708 --1674:             case D_FACI_CMD_TAG_UPDATE:
                        6709 --1675:                 lul_fls_status = ER_D_FLS_WRITE;
                        6710 --1676:                 break;
                        6711 --1678:             case D_FACI_CMD_STATUS_CLEAR:
                        6712 --1679:                             /* Impossible !!     */
                        6713 --1680:             case D_FACI_CMD_BLANK_CHECK:
                        6714 --1681:                             /* Impossible !!     */
                        6715 --1682:             case D_FACI_CMD_PE_RESUME:

                                                                      Page 112
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        6716 --1683:                             /* Impossible !!     */
                        6717 --1684:             default:
                        6718 --1685:                 lul_fls_status = ER_D_FLS_INTERNAL;
                        6719 --1686:                 break;
                        6720 --1687:         } /* end of switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code) */
                        6721 --1688:     }   /* end of else if (0U != (error_code & FLS_ERR_PROG)) */
                        6722 --1689:     else
                        6723 --1690:     {
                        6724 --1691:         /* other */
                        6725 --1692:         lul_fls_status = ER_D_FLS_INTERNAL;
                        6726 --1693:     }
                        6727 --1694:     return (lul_fls_status);
                        6728 --1695: }
