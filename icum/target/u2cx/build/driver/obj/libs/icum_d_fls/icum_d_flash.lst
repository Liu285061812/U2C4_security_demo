                       15668 --2005:                 break;
                       15669 --2006:             }
                       15670 --2007:             else
                       15671 --2008:             {
                       15672 --2009:                 /* Do nothing */
                       15673 --2010:             }
                       15674 --2011:         } while (R_RFD_STS_BUSY == l_bu4_returnValue);
                       15675 --2013:         if(R_RFD_STS_READY == l_bu4_returnValue)
