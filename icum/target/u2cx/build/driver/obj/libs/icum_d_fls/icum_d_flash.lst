                        1536 --1636: static uint32_t d_FLS_Err2Status_ram(const uint32_t error_code)
                        1537 --1637: {
                        1538 --1638:     uint32_t lul_fls_status;
                        1539 --1640:     if (FLS_ERR_NONE == error_code)
                        1540 --1641:     {
                        1541 --1642:         lul_fls_status = ER_OK;
                        1542 --1643:     }
                        1543 --1644:     else if (FLS_ERR_CANCEL_END == error_code)
                        1544 --1645:     {   /* cancel normal end */
                        1545 --1646:         lul_fls_status = ER_OK;
                        1546 --1647:     }
                        1547 --1648:     else if (D_FLS_ZERO_U32 != (error_code & FLS_ERR_PROTECTION))
                        1548 --1649:     {
                        1549 --1650:         lul_fls_status = ER_D_FLS_PROTECTION;
                        1550 --1651:     }
                        1551 --1652:     else if (D_FLS_ZERO_U32 != (error_code & FLS_ERR_PROG))
                        1552 --1653:     {
                        1553 --1654:         switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code)
                        1554 --1655:         {
                        1555 --1656:             case D_FACI_CMD_PROGRAM:
                        1556 --1657:             case D_FACI_CMD_MULTI_PROGRAM:
                        1557 --1658:                 lul_fls_status = ER_D_FLS_WRITE;
                        1558 --1659:                 break;
                        1559 --1661:             case D_FACI_CMD_BLOCK_ERASE:
                        1560 --1662:                 lul_fls_status = ER_D_FLS_ERASE;
                        1561 --1663:                 break;
                        1562 --1665:             case D_FACI_CMD_FORCED_STOP:
                        1563 --1666:                 lul_fls_status = ER_D_FLS_CANCEL;
                        1564 --1667:                 break;
                        1565 --1669:             case D_FACI_CMD_SECURITY_ERASE:
                        1566 --1670:             case D_FACI_CMD_SECURITY_PROGRAM:
                        1567 --1671:             case D_FACI_CMD_SWITCH_ERASE:
                        1568 --1672:             case D_FACI_CMD_SWITCH_PROGRAM:
                        1569 --1673:             case D_FACI_CMD_TAG_ERASE:
                        1570 --1674:             case D_FACI_CMD_TAG_UPDATE:
                        1571 --1675:                 lul_fls_status = ER_D_FLS_WRITE;
                        1572 --1676:                 break;
                        1573 --1678:             case D_FACI_CMD_STATUS_CLEAR:
                        1574 --1679:                             /* Impossible !!     */
                        1575 --1680:             case D_FACI_CMD_BLANK_CHECK:

                                                                      Page 27
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        1576 --1681:                             /* Impossible !!     */
                        1577 --1682:             case D_FACI_CMD_PE_RESUME:
                        1578 --1683:                             /* Impossible !!     */
                        1579 --1684:             default:
                        1580 --1685:                 lul_fls_status = ER_D_FLS_INTERNAL;
                        1581 --1686:                 break;
                        1582 --1687:         } /* end of switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code) */
                        1583 --1688:     }   /* end of else if (0U != (error_code & FLS_ERR_PROG)) */
                        1584 --1689:     else
                        1585 --1690:     {
                        1586 --1691:         /* other */
                        1587 --1692:         lul_fls_status = ER_D_FLS_INTERNAL;
                        1588 --1693:     }
                        1589 --1694:     return (lul_fls_status);
                        1590 --1695: }
