                       15345 --1661:             case D_FACI_CMD_BLOCK_ERASE:
                       15346 --1662:                 lul_fls_status = ER_D_FLS_ERASE;
                       15347 --1663:                 break;
                       15348 --1665:             case D_FACI_CMD_FORCED_STOP:
                       15349 --1666:                 lul_fls_status = ER_D_FLS_CANCEL;
