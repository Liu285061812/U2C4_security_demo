                         980 --1031: uint32_t D_FLS_CheckECC_ram(const uint8_t clearflg)
                         981 --1032: {
                         982 --1033:     uint32_t lul_fls_status;
                         983 --1034:     uint8_t  luc_clrflg;
                         984 --1036:     luc_clrflg = clearflg;
                         985 --1038:     /* Check ECC 2bit Error */
                         986 --1039:     if (ICUM_DFECCDEDF != 0UL)
                         987 --1040:     {
                         988 --1041:         lul_fls_status = ER_D_FLS_ECC2EDF1;
                         989 --1042:     }
                         990 --1043:     /* Check ECC 1bit Error */
                         991 --1044:     else if ((ICUM_DFECCICUM_DFSERSTR & 0xFUL) != 0UL)
                         992 --1045:     {
                         993 --1046:         lul_fls_status = ER_D_FLS_ECC1EDF1;
                         994 --1047:     }
                         995 --1048:     else
                         996 --1049:     {
                         997 --1050:         lul_fls_status = ER_OK;
                         998 --1051:         luc_clrflg = AG_D_FLS_NOTCLR;
                         999 --1052:     }
                        1000 --1054:     /* ECC error clear */
                        1001 --1055:     if ((uint32_t)AG_D_FLS_NOTCLR != (uint32_t)luc_clrflg)
                        1002 --1056:     {
                        1003 --1057:         ICUM_DFECCICUM_DFSERSTC = 0xFUL;
                        1004 --1058:         ICUM_DFECCICUM_DFDERSTC = 1UL;
                        1005 --1059:     }
                        1006 --1060:     else
                        1007 --1061:     {
                        1008 --1062:         /* No ECC error clear */
                        1009 --1063:     }
                        1010 --1065:     return (lul_fls_status);
                        1011 --1066: }
