                        6987 --1881:     }
                        6988 --1882:     else
                        6989 --1883:     {
                        6990 --1884:         lul_frdy = D_FLS_ZERO_U32;
                        6991 --1885:     }
                        6992 --1886:     
                        6993 --1887:     /* Check FACI command time out */
                        6994 --1888:      D_OST_GetHardCounter(&lul_now);
                        6995 --1890:     /* Enable EI Level Maskable Interrupt */
