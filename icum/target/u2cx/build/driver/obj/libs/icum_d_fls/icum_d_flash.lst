                         653 --672:                 }
                         654 --673:                 else
                         655 --674:                 {
                         656 --675:                     err = ER_OK;
                         657 --676:                 }
                         658 --677:             }
                         659 --678:             else
                         660 --679:             {

                                                                      Page 12
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                         661 --680:                 /* Do nothing */
                         662 --681:             }
                         663 --682:         }
                         664 --683:         else
                         665 --684:         {
                         666 --685:             err = ER_OK;
                         667 --686:         }
                         668 --687:     }
                         669 --688:     else
                         670 --689:     {
                         671 --690:         err = ER_OK;
                         672 --691:     }
