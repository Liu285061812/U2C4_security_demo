                        6674 --1636: static uint32_t d_FLS_Err2Status_ram(const uint32_t error_code)
                        6675 --1637: {
                        6676 --1638:     uint32_t lul_fls_status;
                        6677 --1640:     if (FLS_ERR_NONE == error_code)
                        6678 --1641:     {
