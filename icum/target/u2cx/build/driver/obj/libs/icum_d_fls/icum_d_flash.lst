                        4861 --310:     uint32_t lul_comp_result;
                        4862 --311:     uint32_t lul_continuously_flag;
                        4863 --313:     lul_fls_status = g_fls_ctrl[fpsys].prm.d_status;
                        4864 --315:     if (D_FLS_STS_AVAILABLE != g_fls_status)
                        4865 --316:     {
                        4866 --317:         lul_fls_status = ER_D_FLS_INTERNAL;
                        4867 --318:     }
                        4868 --319:     else if (ER_D_FLS_REQUEST == lul_fls_status)
                        4869 --320:     {
                        4870 --321:         /* Performs FACI command issue processing */
                        4871 --322:         lul_fls_status = d_FLS_HandlerCommandReq_ram(fpsys);
                        4872 --323:     }
                        4873 --324:     else if (ER_IN_PROCESS == lul_fls_status)
                        4874 --325:     {
                        4875 --326:         g_fls_ctrl[fpsys].prm.p_write_size_in_bytes((g_fls_ctrl[fpsys].prm.flash_addr + g_fls_ctrl[fpsys].prm.p_num),
                        4876 --327:                                                     &lul_write_size);
                        4877 --328:         /* accepted the cancel API ? */
                        4878 --329:         if ((uint32_t)D_FLS_CMDREQ_ON == (uint32_t)g_fls_ctrl[fpsys].prm.commad_req)
                        4879 --330:         {
                        4880 --331:             /* Force-stop */
                        4881 --332:             g_fls_ctrl[fpsys].prm.commad_req = D_FLS_CMDREQ_OFF;
                        4882 --333:             lstag_fls_err = g_fls_ctrl[fpsys].prm.p_faci_commad_set();
                        4883 --334:             if (FLS_ERR_NONE != lstag_fls_err)
                        4884 --335:             {
                        4885 --336:                 lul_fls_status = d_FLS_Err2Status_ram(lstag_fls_err);
                        4886 --337:                 d_FLS_SetReadMode_ram();
                        4887 --338:                 g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        4888 --339:             }
                        4889 --340:             else
                        4890 --341:             {
                        4891 --342:                 lul_fls_status = ER_IN_PROCESS;
                        4892 --343:             }
                        4893 --344:         }
                        4894 --345:         else
                        4895 --346:         {
                        4896 --347:             lul_comp_result = d_FLS_CheckProcessingCompletion_ram();
                        4897 --348:             if ((uint32_t)ER_OK == lul_comp_result)
                        4898 --349:             {
                        4899 --350:                 lstag_fls_err = g_fls_ctrl[fpsys].prm.p_error_check();
                        4900 --351:                 if (FLS_ERR_NONE != lstag_fls_err)

                                                                      Page 82
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        4901 --352:                 {
                        4902 --353:                     d_FLS_SetReadMode_ram();
                        4903 --354:                     lul_fls_status = d_FLS_Err2Status_ram(lstag_fls_err);
                        4904 --355:                     g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        4905 --356:                 }
                        4906 --357:                 else
                        4907 --358:                 {
                        4908 --359:                     /* In case of cancellation, g_fls_ctrl[fpsys].prm.p_num & Lul_write_size is 0 */
                        4909 --360:                     g_fls_ctrl[fpsys].prm.p_num += lul_write_size;
                        4910 --362:                     if (g_fls_ctrl[fpsys].prm.p_num < g_fls_ctrl[fpsys].prm.data_size_in_bytes)
                        4911 --363:                     {   /* In case of cancellation, This condition is not satisfied */
                        4912 --364:                         /* Next block */
                        4913 --365:                         lstag_fls_err = g_fls_ctrl[fpsys].prm.p_faci_commad_set();
                        4914 --366:                         if (FLS_ERR_NONE != lstag_fls_err)
                        4915 --367:                         {
                        4916 --368:                             d_FLS_SetReadMode_ram();
                        4917 --369:                             lul_fls_status = d_FLS_Err2Status_ram(lstag_fls_err);
                        4918 --370:                             g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        4919 --371:                         }
                        4920 --372:                         else
                        4921 --373:                         {
                        4922 --374:                             /* Succeeded in set command, go to normal end */
                        4923 --375:                         }
                        4924 --376:                     }
                        4925 --377:                     else
                        4926 --378:                     {
                        4927 --379:                         /* All Block Complete !! */
                        4928 --380:                         lul_fls_status = d_FLS_SetOperatingMode_ram((uint16_t)R_RFD_MODE_READ, D_FACI_CMD_DUMMY_CMD);
                        4929 --381:                         if ((uint32_t)ER_OK != lul_fls_status)
                        4930 --382:                         {
                        4931 --383:                             d_FLS_SetReadMode_ram();
                        4932 --384:                             g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        4933 --385:                         }
                        4934 --386:                         else
                        4935 --387:                         {
                        4936 --388:                             lul_fls_status = g_fls_ctrl[fpsys].prm.success_resp;
                        4937 --389:                         }
                        4938 --390:                         /* Issue the FACI command that continuously requests */
                        4939 --391:                         if ((ER_OK == lul_fls_status) && (NULL != g_fls_ctrl[fpsys].prm.p_set_ctrl_prm))
                        4940 --392:                         {
                        4941 --393:                             /* Performs command parameter setting processing */
                        4942 --394:                             lul_continuously_flag = D_FLS_SET1_U32;
                        4943 --395:                             lul_fls_status = g_fls_ctrl[fpsys].prm.p_set_ctrl_prm();
                        4944 --396:                         }
                        4945 --397:                         else
                        4946 --398:                         {
                        4947 --399:                             lul_continuously_flag = D_FLS_ZERO_U32;
                        4948 --400:                         }
                        4949 --401:                         if ((ER_OK == lul_fls_status) && (D_FLS_SET1_U32 == lul_continuously_flag))
                        4950 --402:                         {
                        4951 --403:                             /* Succeeded in set command parameters    */
                        4952 --404:                             /* Performs FACI command issue processing */
                        4953 --405:                             lul_fls_status = d_FLS_HandlerCommandReq_ram(fpsys);
                        4954 --406:                         }
                        4955 --407:                         else
                        4956 --408:                         {
                        4957 --409:                             g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        4958 --410:                         }
                        4959 --411:                     }
                        4960 --412:                 } /* end of else */
                        4961 --413:             } /* end of if ((uint32_t)ER_OK == lul_comp_result) */

                                                                      Page 83
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        4962 --414:             else if (ER_D_FLS_FACITOUT == lul_comp_result)
                        4963 --415:             {
                        4964 --416:                 /* In case of FACI timeout, set read mode */
                        4965 --417:                 d_FLS_SetReadMode_ram();
                        4966 --418:                 lul_fls_status = lul_comp_result;
