                       10322 --1784: static uint32_t d_FLS_IssueCommandCtrl_ram(void)
                       10323 --1785: {
                       10324 --1786:     uint32_t     lstag_fls_err;
                       10325 --1787:     uint8_t      retry;
                       10326 --1789:     retry = (uint8_t)false;
                       10327 --1790:     /* Set FACI Command code to FACICMD(8bit) */
                       10328 --1791:     lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                       10329 --1792:     if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                       10330 --1793:     {
                       10331 --1794:         /* retry */
                       10332 --1795:         retry = (uint8_t)true;
                       10333 --1796:     }
                       10334 --1797:     else
                       10335 --1798:     {
                       10336 --1799:         /* Err Check */
                       10337 --1800:         lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
