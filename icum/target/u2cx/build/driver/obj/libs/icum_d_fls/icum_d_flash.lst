                       18565 --1704: static void d_FLS_SetReadMode_ram(void)
                       18566 --1705: {
                       18567 --1706:     volatile uint32_t lul_dummy;
                       18568 --1707:     uint16_t lus_fentryr;
                       18569 --1708: 	T_u4_RFDReturn  l_bu4_returnValue ;
                       18570 --1709: 	
                       18571 --1710:     l_bu4_returnValue = R_RFD_CheckPEMode((T_u2_FACI)g_fls_selected_fpsys, R_RFD_MODE_CFPE);
                       18572 --1711:     
                       18573 --1712:     if (R_RFD_OK == l_bu4_returnValue)
                       18574 --1713:     {
                       18575 --1714:         lus_fentryr = (uint16_t)R_RFD_MODE_CFPE;
                       18576 --1715:     }
                       18577 --1716:     else
                       18578 --1717:     {
                       18579 --1718:         lus_fentryr = (uint16_t)R_RFD_MODE_DFPE;
                       18580 --1719:     }
                       18581 --1720:     
                       18582 --1721:     /* Shifts the mode of the flash memory of the target FACI to the read mode */
                       18583 --1722:     (void)R_RFD_ShiftToReadMode((T_u2_FACI)g_fls_selected_fpsys);
                       18584 --1723:     
