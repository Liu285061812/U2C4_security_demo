                       13000 --1058:         ICUM_DFECCICUM_DFDERSTC = 1UL;
                       13001 --1059:     }
                       13002 --1060:     else
                       13003 --1061:     {
                       13004 --1062:         /* No ECC error clear */
                       13005 --1063:     }
                       13006 --1065:     return (lul_fls_status);
                       13007 --1066: }
