                        6981 --1874:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                        6982 --1876:     l_bu4_returnValue = R_RFD_GetFaciSequenceReady((T_u2_FACI)g_fls_selected_fpsys);
                        6983 --1877:     
                        6984 --1878:     if (R_RFD_STS_READY == l_bu4_returnValue)
                        6985 --1879:     {
