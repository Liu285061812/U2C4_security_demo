                        6958 --1851: * Function Name : d_FLS_CheckProcessingCompletion_ram
                        6959 --1852: * Description   : Check whether the command is completed
                        6960 --1853: * Arguments     : none
                        6961 --1854: * Return Value  : ER_OK  : FSTAT.FRDY = 1
                        6962 --1855: *                        None of the below is in progress.
                        6963 --1856: *                 ER_IN_PROCESS : FSTAT.FRDY = 0
                        6964 --1857: *                        Processing of the command "Program", "Block Erase",
                        6965 --1858: *                         "Program/Erasure Suspend", "Program/Erasure Resume",
                        6966 --1859: *                         "Forced Stop", "Blank Check", "Config Program", 
                        6967 --1860: *                         "Lock Bit Program", "Lock Bit Read", or "OTP Set" is in
                        6968 --1861: *                         progress.
                        6969 --1862: *                 ER_D_FLS_FACITOUT : FACI timeout
                        6970 --1863: ***************************************************************************************/
                        6971 --1864: static uint32_t d_FLS_CheckProcessingCompletion_ram(void)
                        6972 --1865: {
