                       18634 --1778: * Function Name : d_FLS_IssueCommandCtrl_ram
                       18635 --1779: * Description   : FACI command issue (For cancel operation)
                       18636 --1780: * Arguments     : none
                       18637 --1781: * Return Value  : FLS_ERR_CANCEL_END
                       18638 --1782: *                 ER_D_FLS_FSTOPTOUT
                       18639 --1783: *********************************************************************************/
                       18640 --1784: static uint32_t d_FLS_IssueCommandCtrl_ram(void)
                       18641 --1785: {
                       18642 --1786:     uint32_t     lstag_fls_err;
                       18643 --1787:     uint8_t      retry;
                       18644 --1789:     retry = (uint8_t)false;
                       18645 --1790:     /* Set FACI Command code to FACICMD(8bit) */
                       18646 --1791:     lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                       18647 --1792:     if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                       18648 --1793:     {
                       18649 --1794:         /* retry */
                       18650 --1795:         retry = (uint8_t)true;
                       18651 --1796:     }
                       18652 --1797:     else
                       18653 --1798:     {
                       18654 --1799:         /* Err Check */
                       18655 --1800:         lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                       18656 --1801:         if (lstag_fls_err == FLS_ERR_NONE)
                       18657 --1802:         {
                       18658 --1803:             /* Cancel Normal end */
                       18659 --1804:             lstag_fls_err = FLS_ERR_CANCEL_END;
                       18660 --1805:         }
                       18661 --1806:         else
                       18662 --1807:         {
                       18663 --1808:             /* Err Check NG */
                       18664 --1809:             /* retry */
                       18665 --1810:             retry = (uint8_t)true;
                       18666 --1811:         }
                       18667 --1812:     }
                       18668 --1814:     if ((uint32_t)true == (uint32_t)retry)
                       18669 --1815:     {
                       18670 --1816:         /* Retry */
                       18671 --1818:         /* Set FACI Command code to FACICMD(8bit) */

                                                                      Page 311
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       18672 --1819:         lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                       18673 --1820:         if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                       18674 --1821:         {
                       18675 --1822:             /* Do nothing */
                       18676 --1823:         }
                       18677 --1824:         else
                       18678 --1825:         {
                       18679 --1826:             /* Error Check */
                       18680 --1827:             lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                       18681 --1828:             if (lstag_fls_err == FLS_ERR_NONE)
                       18682 --1829:             {
                       18683 --1830:                 /* Cancel Normal end */
                       18684 --1831:                 lstag_fls_err = FLS_ERR_CANCEL_END;
                       18685 --1832:             }
                       18686 --1833:             else
                       18687 --1834:             {
                       18688 --1835:                 /* Retry error */
                       18689 --1836:             }
                       18690 --1837:         }
                       18691 --1838:     }
                       18692 --1839:     else
                       18693 --1840:     {
                       18694 --1841:         /* Do nothing */
                       18695 --1842:     }
                       18696 --1844:     /* Error Check NG */
                       18697 --1845:     return (lstag_fls_err);
                       18698 --1847: }
                       18699 --1849: /**************************************************************************************
                       18700 --1850: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0029]:[ICUMFW_UD_U2B_D_FLS_0029]
                       18701 --1851: * Function Name : d_FLS_CheckProcessingCompletion_ram
                       18702 --1852: * Description   : Check whether the command is completed
                       18703 --1853: * Arguments     : none
                       18704 --1854: * Return Value  : ER_OK  : FSTAT.FRDY = 1
                       18705 --1855: *                        None of the below is in progress.
                       18706 --1856: *                 ER_IN_PROCESS : FSTAT.FRDY = 0
                       18707 --1857: *                        Processing of the command "Program", "Block Erase",
                       18708 --1858: *                         "Program/Erasure Suspend", "Program/Erasure Resume",
                       18709 --1859: *                         "Forced Stop", "Blank Check", "Config Program", 
                       18710 --1860: *                         "Lock Bit Program", "Lock Bit Read", or "OTP Set" is in
                       18711 --1861: *                         progress.
                       18712 --1862: *                 ER_D_FLS_FACITOUT : FACI timeout
                       18713 --1863: ***************************************************************************************/
                       18714 --1864: static uint32_t d_FLS_CheckProcessingCompletion_ram(void)
                       18715 --1865: {
                       18716 --1866:     uint32_t res;
                       18717 --1867:     uint32_t lul_now;
                       18718 --1868:     uint32_t lul_frdy;
                       18719 --1869:     uint32_t saved_psw;
                       18720 --1870:     T_u4_RFDReturn  l_bu4_returnValue ;
                       18721 --1871:     
                       18722 --1872:     res = ER_IN_PROCESS;
                       18723 --1873:     /* Disable EI Level Maskable Interrupt */
                       18724 --1874:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                       18725 --1876:     l_bu4_returnValue = R_RFD_GetFaciSequenceReady((T_u2_FACI)g_fls_selected_fpsys);
                       18726 --1877:     
                       18727 --1878:     if (R_RFD_STS_READY == l_bu4_returnValue)
                       18728 --1879:     {
                       18729 --1880:         lul_frdy = R_RFD_STS_READY;
                       18730 --1881:     }
                       18731 --1882:     else
                       18732 --1883:     {

                                                                      Page 312
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       18733 --1884:         lul_frdy = D_FLS_ZERO_U32;
                       18734 --1885:     }
                       18735 --1886:     
                       18736 --1887:     /* Check FACI command time out */
                       18737 --1888:      D_OST_GetHardCounter(&lul_now);
                       18738 --1890:     /* Enable EI Level Maskable Interrupt */
                       18739 --1891:     ENABLE_INTERRUPT_WITH_CHECK(saved_psw);
                       18740 --1893:     if (D_FLS_ZERO_U32 != lul_frdy)
                       18741 --1894:     {
                       18742 --1895:         res = ER_OK;
                       18743 --1896:     }
                       18744 --1897:     else
                       18745 --1898:     {
                       18746 --1899:         if (g_fls_ctrl[g_fls_selected_fpsys].prm.max_time
                       18747 --1900:             < (uint32_t)(lul_now - g_fls_ctrl[g_fls_selected_fpsys].prm.faci_start_time))
                       18748 --1901:         {
                       18749 --1902:             /* Issue Forced Stop Command */
                       18750 --1903:             (void)d_FLS_IssueCommandCtrl_ram();
                       18751 --1904:             res = ER_D_FLS_FACITOUT;
                       18752 --1905:         }
                       18753 --1906:         else
                       18754 --1907:         {
                       18755 --1908:             g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter++;
                       18756 --1910:             /* Max times of check FRDY bit */
                       18757 --1911:             if (LIMIT_CHECK_FRDY < g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter)
                       18758 --1912:             {
                       18759 --1913:                 /* Issue Forced Stop Command */
                       18760 --1914:                 (void)d_FLS_IssueCommandCtrl_ram();
                       18761 --1915:                 res = ER_D_FLS_FACITOUT;
                       18762 --1916:             }
                       18763 --1917:             else
                       18764 --1918:             {
                       18765 --1919:                  /* waiting FSTATR_FRDY */
                       18766 --1920:                  /* do nothing yet */
                       18767 --1921:             }
                       18768 --1922:         }
                       18769 --1923:     }
                       18770 --1924:     return (res);
                       18771 --1925: }
