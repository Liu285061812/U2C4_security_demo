                       15383 --1703: *********************************************************************************/
                       15384 --1704: static void d_FLS_SetReadMode_ram(void)
                       15385 --1705: {
                       15386 --1706:     volatile uint32_t lul_dummy;
                       15387 --1707:     uint16_t lus_fentryr;
                       15388 --1708: 	T_u4_RFDReturn  l_bu4_returnValue ;
                       15389 --1709: 	
                       15390 --1710:     l_bu4_returnValue = R_RFD_CheckPEMode((T_u2_FACI)g_fls_selected_fpsys, R_RFD_MODE_CFPE);
                       15391 --1711:     
                       15392 --1712:     if (R_RFD_OK == l_bu4_returnValue)
                       15393 --1713:     {
                       15394 --1714:         lus_fentryr = (uint16_t)R_RFD_MODE_CFPE;
                       15395 --1715:     }
                       15396 --1716:     else
                       15397 --1717:     {
                       15398 --1718:         lus_fentryr = (uint16_t)R_RFD_MODE_DFPE;
                       15399 --1719:     }
                       15400 --1720:     
                       15401 --1721:     /* Shifts the mode of the flash memory of the target FACI to the read mode */
                       15402 --1722:     (void)R_RFD_ShiftToReadMode((T_u2_FACI)g_fls_selected_fpsys);
                       15403 --1723:     
                       15404 --1724:     if ((uint32_t)R_RFD_MODE_CFPE == (uint32_t)lus_fentryr)
                       15405 --1725:     {
                       15406 --1726:         lul_dummy = ICUM_FCCTL.ICUM_FCBWCTL.UINT32;
                       15407 --1727:         ICUM_FCCTL.ICUM_FCBWCTL.UINT32 = D_FLS_ZERO_U32;
                       15408 --1728:         ICUM_FCCTL.ICUM_FCBWCTL.UINT32 |= FCBWCTL_ICHCLR;
                       15409 --1729:         ICUM_FCCTL.ICUM_FCBWCTL.UINT32 |= lul_dummy;
                       15410 --1730:         /* Dummy Read ( ICUM_FCCTLICUM_FCBWCTL = 0 Bus transaction execution) */
                       15411 --1731:         lul_dummy = ICUM_FCCTLICUM_FCBWCTL;
                       15412 --1732:         /* Synchronize memory */
                       15413 --1733:         __SYNCM();
                       15414 --1734:         /* Synchronize pipeline */
                       15415 --1735:         __SYNCP();
                       15416 --1736:         /* Re-prefetch after clearing the prefetched instructions and data. */
                       15417 --1737:         __SYNCI();
                       15418 --1738:     }
                       15419 --1739:     else
                       15420 --1740:     {
                       15421 --1741:         /* Nothing to do for read mode/DF_PE mode */
                       15422 --1742:     }
                       15423 --1744:     return;
                       15424 --1745: }
