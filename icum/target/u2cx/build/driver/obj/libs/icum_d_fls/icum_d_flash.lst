                       11309 --606: static uint32_t d_FLS_CheckCondition_ram(const uint16_t context_id, const uint8_t priority,
                       11310 --607:                                          const uint32_t target_area, const uint32_t bank)
                       11311 --608: {
                       11312 --609:     uint32_t err;
                       11313 --610:     uint32_t iface;
                       11314 --611:     fls_ctx_t *p_current;
                       11315 --612:     uint32_t  firmware_bank;
                       11316 --614:     iface = R_RFD_FACI0;
                       11317 --616:     err = d_FLS_GetInterface_ram(target_area, bank, &iface);
                       11318 --617:     if (ER_OK == err)
                       11319 --618:     {
                       11320 --619:         p_current = &g_fls_ctrl[iface].context;
                       11321 --620:     }
                       11322 --621:     else
                       11323 --622:     {
                       11324 --623:         /* Do nothing */
                       11325 --624:     }
                       11326 --626:     if (ER_OK != err)
                       11327 --627:     {
                       11328 --628:         /* Do nothing */
                       11329 --629:     }
                       11330 --630:     else if ((D_FLS_ZERO_U32 != (uint32_t)p_current->id) && ((uint32_t)p_current->id == (uint32_t)context_id))
                       11331 --631:     {
                       11332 --632:         /* Cannot get multiplexed resources */
                       11333 --633:         err = ER_D_FLS_UNAVAILABLE;
                       11334 --634:     }
                       11335 --635:     else if ((R_RFD_FACI0 == iface) &&
                       11336 --636:              (D_FLS_ZERO_U32 != (uint32_t)g_fls_ctrl_bak[iface].context.id))
                       11337 --637:     {

                                                                      Page 189
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       11338 --638:         if ((uint32_t)context_id == (uint32_t)g_fls_ctrl_bak[iface].context.id)
                       11339 --639:         {
                       11340 --640:             /* Suspended context */
                       11341 --641:             err = ER_D_FLS_UNAVAILABLE;
                       11342 --642:         }
                       11343 --643:         else
                       11344 --644:         {
                       11345 --645:             err = ER_PENDING;
                       11346 --646:         }
                       11347 --647:     }
                       11348 --648:     else if ((D_FLS_ZERO_U32 != (uint32_t)p_current->id)
                       11349 --649:                 && ((p_current->target_area == target_area) && (p_current->target_bank == bank)))
                       11350 --650:     {
                       11351 --651:         err = ER_PENDING;
                       11352 --652:     }
                       11353 --653:     else if (R_RFD_FACI0 == iface)
                       11354 --654:     {
                       11355 --655:         err = ER_PENDING;
                       11356 --656:     }
                       11357 --657:     else if ((D_FLS_ZERO_U32 != (uint32_t)p_current->id) && ((uint32_t)p_current->priority <= (uint32_t)priority))
                       11358 --658:     {
                       11359 --659:         err = ER_PENDING;
                       11360 --660:     }
                       11361 --661:     else if ((D_FLS_ZERO_U32 != (uint32_t)p_current->id) && ((uint32_t)p_current->priority > (uint32_t)priority))
                       11362 --662:     {
                       11363 --663:         /* Checking the RAM execution mode of the preceding job */
                       11364 --664:         if (AG_D_FLS_CODE == p_current->target_area)
                       11365 --665:         {
                       11366 --666:             err = d_FLS_GetCFBankNumber(D_FLS_ICUM_FIRMWARE_START_ADDRESS, &firmware_bank);
                       11367 --667:             if (ER_OK == err)
                       11368 --668:             {
                       11369 --669:                 if (firmware_bank == p_current->target_bank)
