                       15026 --1318: void d_FLS_SetBusGuardFromPE_ram(void)
                       15027 --1319: {
                       15028 --1320:     /* Enables write access of protected registers */
                       15029 --1321:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_EN;
                       15030 --1323:     /* Enable Bus Guard */
                       15031 --1324:     if (R_RFD_FACI0 == g_fls_selected_fpsys)
                       15032 --1325:     {
                       15033 --1326:         /* Flash Sequencer Register Area and Command Access Area for CPU(PE)(FACI0) */
                       15034 --1327:         /* => Set Access Guard for PE */
                       15035 --1328:         PBG61.PBGPROT0_1.UINT32 |= ICUM_PBGPROT_EN;
                       15036 --1329:     }
                       15037 --1331:     /* Disables write access of protected registers */
                       15038 --1332:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_DIS;
                       15039 --1334:     return;
                       15040 --1335: }
                       15041 --1337: /******************************************************************************************
