                       15351 --1669:             case D_FACI_CMD_SECURITY_ERASE:
                       15352 --1670:             case D_FACI_CMD_SECURITY_PROGRAM:
                       15353 --1671:             case D_FACI_CMD_SWITCH_ERASE:
                       15354 --1672:             case D_FACI_CMD_SWITCH_PROGRAM:
                       15355 --1673:             case D_FACI_CMD_TAG_ERASE:
                       15356 --1674:             case D_FACI_CMD_TAG_UPDATE:
                       15357 --1675:                 lul_fls_status = ER_D_FLS_WRITE;
                       15358 --1676:                 break;
                       15359 --1678:             case D_FACI_CMD_STATUS_CLEAR:
                       15360 --1679:                             /* Impossible !!     */
                       15361 --1680:             case D_FACI_CMD_BLANK_CHECK:
                       15362 --1681:                             /* Impossible !!     */
                       15363 --1682:             case D_FACI_CMD_PE_RESUME:
                       15364 --1683:                             /* Impossible !!     */
                       15365 --1684:             default:
                       15366 --1685:                 lul_fls_status = ER_D_FLS_INTERNAL;
                       15367 --1686:                 break;
                       15368 --1687:         } /* end of switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code) */
                       15369 --1688:     }   /* end of else if (0U != (error_code & FLS_ERR_PROG)) */
                       15370 --1689:     else
