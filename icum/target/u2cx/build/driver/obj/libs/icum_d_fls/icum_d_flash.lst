                         544 --558:             lul_fls_status = d_FLS_Handler_ram(iface);
                         545 --559:             if (lul_fls_status != ER_IN_PROCESS)
                         546 --560:             {
                         547 --561:                 /* Req end & Gard ON Req =>Bus guard set & Write protect set */
