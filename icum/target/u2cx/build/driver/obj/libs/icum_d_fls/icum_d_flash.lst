                        3865 --515:     uint32_t iface;
                        3866 --516:     uint32_t err;

                                                                      Page 65
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        3867 --518:     luc_fls_gard_flg = 0U;
                        3868 --519:     lul_fls_status = ER_PARAM;
                        3869 --520:     iface = R_RFD_FACI0;
                        3870 --522:     err = d_FLS_GetInterface_ram(target_area, bank, &iface);
                        3871 --523:     if (ER_OK == err)
                        3872 --524:     {
                        3873 --525:         /* result address NULL */
                        3874 --526:         if ((D_FLS_ZERO_U32 == (uint32_t)context_id)
                        3875 --527:             || (((uint32_t)context_id != (uint32_t)g_fls_ctrl[iface].context.id) 
                        3876 --528:                 &&  ((uint32_t)context_id != (uint32_t)g_fls_ctrl_bak[iface].context.id)))
                        3877 --529:         {
                        3878 --530:             /* Do nothing */
                        3879 --531:         }
                        3880 --532:         else if ((uint32_t)context_id == (uint32_t)g_fls_ctrl_bak[iface].context.id)
                        3881 --533:         {
                        3882 --534:             lul_fls_status = ER_IN_PROCESS;
                        3883 --535:         }
                        3884 --536:         else
                        3885 --537:         {
                        3886 --538:             /* Flash Req executed ? */
                        3887 --539:             if (((uint32_t)D_FACI_CMD_BLOCK_ERASE == (uint32_t)g_fls_ctrl[iface].prm.command_code) ||
                        3888 --540:                 ((uint32_t)D_FACI_CMD_PROGRAM == (uint32_t)g_fls_ctrl[iface].prm.command_code) ||
                        3889 --541:                 ((uint32_t)D_FACI_CMD_MULTI_PROGRAM == (uint32_t)g_fls_ctrl[iface].prm.command_code) ||
