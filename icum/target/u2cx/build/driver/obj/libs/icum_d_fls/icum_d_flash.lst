                         533 --546:                 ((uint32_t)D_FACI_CMD_SWITCH_PROGRAM == (uint32_t)g_fls_ctrl[iface].prm.command_code) ||
                         534 --547:                 ((uint32_t)D_FACI_CMD_TAG_ERASE == (uint32_t)g_fls_ctrl[iface].prm.command_code) ||
                         535 --548:                 ((uint32_t)D_FACI_CMD_TAG_UPDATE == (uint32_t)g_fls_ctrl[iface].prm.command_code))
                         536 --549:             {
                         537 --550:                 luc_fls_gard_flg = 1U;
                         538 --551:             }

