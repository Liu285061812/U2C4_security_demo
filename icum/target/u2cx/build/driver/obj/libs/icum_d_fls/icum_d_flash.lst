                         264 --262: /*******************************************************************************
                         265 --263: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0002]:[ICUMFW_UD_U2B_D_FLS_0002]
                         266 --264: * Function Name : d_FLS_SelectFpsys_ram
                         267 --265: * Description   : Switch the FCU to access the specified flash area address.
                         268 --266: * Arguments     : flash_addr
                         269 --267: *                  flash area address.
                         270 --268: * Return Value  : ER_OK
                         271 --269: ********************************************************************************/
                         272 --270: uint32_t d_FLS_SelectFpsys_ram(const uint32_t flash_addr)
                         273 --271: {
                         274 --272:     if ((START_ADDR_DF_FPSYS2 <= flash_addr) && (START_ADDR_DF_FPSYS3 > flash_addr))
                         275 --273:     {
                         276 --274:         g_fls_selected_fpsys = R_RFD_FACI2;
                         277 --275:     }
                         278 --276:     else
                         279 --277:     {
                         280 --278:         g_fls_selected_fpsys = R_RFD_FACI0;
                         281 --279:     }
                         282 --281:     d_FLS_WriteProtectOffFaci_ram(g_fls_selected_fpsys);
                         283 --283:     return (ER_OK);
                         284 --284: }
