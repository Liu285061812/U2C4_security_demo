                       15043 --1339: * Function Name : d_FLS_ClrBusGuardFromPE_ram
                       15044 --1340: * Description   : Bus guard cancellation. (FACI0/1 Register and FACI0/1 Command area)
                       15045 --1341: * Arguments     : none
                       15046 --1342: * Return Value  : none
                       15047 --1343: *******************************************************************************************/
                       15048 --1344: void d_FLS_ClrBusGuardFromPE_ram(void)
                       15049 --1345: {
                       15050 --1346:     /* Enables write access of protected registers */
                       15051 --1347:     PBGERRSLV61.PBGKCPROT.UINT32 = KCE_EN;
                       15052 --1349:     /* Bus Guard Disabled */
                       15053 --1350:     if (R_RFD_FACI0 == g_fls_selected_fpsys)
                       15054 --1351:     {
                       15055 --1352:         /* Flash Sequencer Register Area and Command Access Area for CPU(PE)(FACI0) */
                       15056 --1353:         /* => Cancel Access Guard from PE */
                       15057 --1354:         PBG61.PBGPROT0_1.UINT32 &= ~ICUM_PBGPROT_EN;
                       15058 --1355:     }
