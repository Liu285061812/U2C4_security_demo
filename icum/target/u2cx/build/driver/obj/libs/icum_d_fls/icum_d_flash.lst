                       18413 --1541:                 }
                       18414 --1542:             }
                       18415 --1543:             else
                       18416 --1544:             {
                       18417 --1545:                 /* go to next step when already PE mode */
                       18418 --1546:             }
                       18419 --1547:         }
                       18420 --1548:         else
                       18421 --1549:         {
                       18422 --1550:             /* go to next step when operating_mode is R_RFD_MODE_READ */
                       18423 --1551:         }
                       18424 --1552:     }
                       18425 --1553:     else
                       18426 --1554:     {
                       18427 --1555:         /* Do nothing */

                                                                      Page 307
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       18428 --1556:     }
                       18429 --1558:     if (ER_OK == lul_res)
                       18430 --1559:     {
