                       13976 --2106:         }
                       13977 --2107:         else if ((AG_D_FLS_SECURITY == target_area)
                       13978 --2108:                 && (D_FLS_ZERO_U32 != (uint32_t)g_fls_ctrl[interface].context.id)
                       13979 --2109:                 && ((uint32_t)context_id != (uint32_t)g_fls_ctrl[interface].context.id))
                       13980 --2110:         {
