                       13568 --1676:                 break;
                       13569 --1678:             case D_FACI_CMD_STATUS_CLEAR:
                       13570 --1679:                             /* Impossible !!     */
                       13571 --1680:             case D_FACI_CMD_BLANK_CHECK:
