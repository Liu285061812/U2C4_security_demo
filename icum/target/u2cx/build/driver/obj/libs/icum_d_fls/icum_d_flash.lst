                       15459 --1784: static uint32_t d_FLS_IssueCommandCtrl_ram(void)
                       15460 --1785: {
                       15461 --1786:     uint32_t     lstag_fls_err;
                       15462 --1787:     uint8_t      retry;
                       15463 --1789:     retry = (uint8_t)false;
                       15464 --1790:     /* Set FACI Command code to FACICMD(8bit) */
                       15465 --1791:     lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                       15466 --1792:     if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                       15467 --1793:     {
                       15468 --1794:         /* retry */
                       15469 --1795:         retry = (uint8_t)true;
                       15470 --1796:     }
                       15471 --1797:     else
                       15472 --1798:     {
                       15473 --1799:         /* Err Check */
                       15474 --1800:         lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                       15475 --1801:         if (lstag_fls_err == FLS_ERR_NONE)
                       15476 --1802:         {
                       15477 --1803:             /* Cancel Normal end */
                       15478 --1804:             lstag_fls_err = FLS_ERR_CANCEL_END;
                       15479 --1805:         }
                       15480 --1806:         else
                       15481 --1807:         {
                       15482 --1808:             /* Err Check NG */
                       15483 --1809:             /* retry */
                       15484 --1810:             retry = (uint8_t)true;
                       15485 --1811:         }
                       15486 --1812:     }
                       15487 --1814:     if ((uint32_t)true == (uint32_t)retry)
                       15488 --1815:     {
                       15489 --1816:         /* Retry */
                       15490 --1818:         /* Set FACI Command code to FACICMD(8bit) */
                       15491 --1819:         lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                       15492 --1820:         if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                       15493 --1821:         {
                       15494 --1822:             /* Do nothing */
                       15495 --1823:         }

                                                                      Page 258
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       15496 --1824:         else
                       15497 --1825:         {
                       15498 --1826:             /* Error Check */
                       15499 --1827:             lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                       15500 --1828:             if (lstag_fls_err == FLS_ERR_NONE)
                       15501 --1829:             {
                       15502 --1830:                 /* Cancel Normal end */
                       15503 --1831:                 lstag_fls_err = FLS_ERR_CANCEL_END;
                       15504 --1832:             }
                       15505 --1833:             else
                       15506 --1834:             {
                       15507 --1835:                 /* Retry error */
                       15508 --1836:             }
                       15509 --1837:         }
                       15510 --1838:     }
                       15511 --1839:     else
                       15512 --1840:     {
                       15513 --1841:         /* Do nothing */
                       15514 --1842:     }
                       15515 --1844:     /* Error Check NG */
                       15516 --1845:     return (lstag_fls_err);
                       15517 --1847: }
                       15518 --1849: /**************************************************************************************
                       15519 --1850: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0029]:[ICUMFW_UD_U2B_D_FLS_0029]
                       15520 --1851: * Function Name : d_FLS_CheckProcessingCompletion_ram
                       15521 --1852: * Description   : Check whether the command is completed
                       15522 --1853: * Arguments     : none
                       15523 --1854: * Return Value  : ER_OK  : FSTAT.FRDY = 1
                       15524 --1855: *                        None of the below is in progress.
                       15525 --1856: *                 ER_IN_PROCESS : FSTAT.FRDY = 0
                       15526 --1857: *                        Processing of the command "Program", "Block Erase",
                       15527 --1858: *                         "Program/Erasure Suspend", "Program/Erasure Resume",
                       15528 --1859: *                         "Forced Stop", "Blank Check", "Config Program", 
                       15529 --1860: *                         "Lock Bit Program", "Lock Bit Read", or "OTP Set" is in
                       15530 --1861: *                         progress.
                       15531 --1862: *                 ER_D_FLS_FACITOUT : FACI timeout
                       15532 --1863: ***************************************************************************************/
                       15533 --1864: static uint32_t d_FLS_CheckProcessingCompletion_ram(void)
                       15534 --1865: {
                       15535 --1866:     uint32_t res;
                       15536 --1867:     uint32_t lul_now;
                       15537 --1868:     uint32_t lul_frdy;
                       15538 --1869:     uint32_t saved_psw;
                       15539 --1870:     T_u4_RFDReturn  l_bu4_returnValue ;
                       15540 --1871:     
                       15541 --1872:     res = ER_IN_PROCESS;
                       15542 --1873:     /* Disable EI Level Maskable Interrupt */
                       15543 --1874:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                       15544 --1876:     l_bu4_returnValue = R_RFD_GetFaciSequenceReady((T_u2_FACI)g_fls_selected_fpsys);
                       15545 --1877:     
                       15546 --1878:     if (R_RFD_STS_READY == l_bu4_returnValue)
                       15547 --1879:     {
                       15548 --1880:         lul_frdy = R_RFD_STS_READY;
                       15549 --1881:     }
                       15550 --1882:     else
                       15551 --1883:     {
                       15552 --1884:         lul_frdy = D_FLS_ZERO_U32;
                       15553 --1885:     }
                       15554 --1886:     
                       15555 --1887:     /* Check FACI command time out */
                       15556 --1888:      D_OST_GetHardCounter(&lul_now);

                                                                      Page 259
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                       15557 --1890:     /* Enable EI Level Maskable Interrupt */
                       15558 --1891:     ENABLE_INTERRUPT_WITH_CHECK(saved_psw);
                       15559 --1893:     if (D_FLS_ZERO_U32 != lul_frdy)
                       15560 --1894:     {
                       15561 --1895:         res = ER_OK;
                       15562 --1896:     }
                       15563 --1897:     else
                       15564 --1898:     {
                       15565 --1899:         if (g_fls_ctrl[g_fls_selected_fpsys].prm.max_time
                       15566 --1900:             < (uint32_t)(lul_now - g_fls_ctrl[g_fls_selected_fpsys].prm.faci_start_time))
                       15567 --1901:         {
                       15568 --1902:             /* Issue Forced Stop Command */
                       15569 --1903:             (void)d_FLS_IssueCommandCtrl_ram();
                       15570 --1904:             res = ER_D_FLS_FACITOUT;
                       15571 --1905:         }
                       15572 --1906:         else
                       15573 --1907:         {
                       15574 --1908:             g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter++;
                       15575 --1910:             /* Max times of check FRDY bit */
                       15576 --1911:             if (LIMIT_CHECK_FRDY < g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter)
                       15577 --1912:             {
                       15578 --1913:                 /* Issue Forced Stop Command */
                       15579 --1914:                 (void)d_FLS_IssueCommandCtrl_ram();
                       15580 --1915:                 res = ER_D_FLS_FACITOUT;
                       15581 --1916:             }
                       15582 --1917:             else
                       15583 --1918:             {
                       15584 --1919:                  /* waiting FSTATR_FRDY */
                       15585 --1920:                  /* do nothing yet */
                       15586 --1921:             }
                       15587 --1922:         }
                       15588 --1923:     }
                       15589 --1924:     return (res);
                       15590 --1925: }
