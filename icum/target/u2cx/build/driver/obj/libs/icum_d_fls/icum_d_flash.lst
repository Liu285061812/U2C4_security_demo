                        1673 --1784: static uint32_t d_FLS_IssueCommandCtrl_ram(void)
                        1674 --1785: {
                        1675 --1786:     uint32_t     lstag_fls_err;
                        1676 --1787:     uint8_t      retry;
                        1677 --1789:     retry = (uint8_t)false;
                        1678 --1790:     /* Set FACI Command code to FACICMD(8bit) */
                        1679 --1791:     lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                        1680 --1792:     if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                        1681 --1793:     {
                        1682 --1794:         /* retry */
                        1683 --1795:         retry = (uint8_t)true;
                        1684 --1796:     }
                        1685 --1797:     else
                        1686 --1798:     {
                        1687 --1799:         /* Err Check */
                        1688 --1800:         lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                        1689 --1801:         if (lstag_fls_err == FLS_ERR_NONE)
                        1690 --1802:         {
                        1691 --1803:             /* Cancel Normal end */
                        1692 --1804:             lstag_fls_err = FLS_ERR_CANCEL_END;
                        1693 --1805:         }
                        1694 --1806:         else
                        1695 --1807:         {
                        1696 --1808:             /* Err Check NG */
                        1697 --1809:             /* retry */

                                                                      Page 29
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        1698 --1810:             retry = (uint8_t)true;
                        1699 --1811:         }
                        1700 --1812:     }
                        1701 --1814:     if ((uint32_t)true == (uint32_t)retry)
                        1702 --1815:     {
                        1703 --1816:         /* Retry */
                        1704 --1818:         /* Set FACI Command code to FACICMD(8bit) */
                        1705 --1819:         lstag_fls_err = d_FLS_ForcedStopCommand_ram();
                        1706 --1820:         if (lstag_fls_err == ER_D_FLS_FSTOPTOUT)
                        1707 --1821:         {
                        1708 --1822:             /* Do nothing */
                        1709 --1823:         }
                        1710 --1824:         else
                        1711 --1825:         {
                        1712 --1826:             /* Error Check */
                        1713 --1827:             lstag_fls_err = g_fls_ctrl[g_fls_selected_fpsys].prm.p_error_check();
                        1714 --1828:             if (lstag_fls_err == FLS_ERR_NONE)
                        1715 --1829:             {
                        1716 --1830:                 /* Cancel Normal end */
                        1717 --1831:                 lstag_fls_err = FLS_ERR_CANCEL_END;
                        1718 --1832:             }
                        1719 --1833:             else
                        1720 --1834:             {
                        1721 --1835:                 /* Retry error */
                        1722 --1836:             }
                        1723 --1837:         }
                        1724 --1838:     }
                        1725 --1839:     else
                        1726 --1840:     {
                        1727 --1841:         /* Do nothing */
                        1728 --1842:     }
                        1729 --1844:     /* Error Check NG */
                        1730 --1845:     return (lstag_fls_err);
                        1731 --1847: }
                        1732 --1849: /**************************************************************************************
                        1733 --1850: * Function ID   : [ICUMFW_CD_U2B_D_FLS_0029]:[ICUMFW_UD_U2B_D_FLS_0029]
                        1734 --1851: * Function Name : d_FLS_CheckProcessingCompletion_ram
                        1735 --1852: * Description   : Check whether the command is completed
                        1736 --1853: * Arguments     : none
                        1737 --1854: * Return Value  : ER_OK  : FSTAT.FRDY = 1
                        1738 --1855: *                        None of the below is in progress.
                        1739 --1856: *                 ER_IN_PROCESS : FSTAT.FRDY = 0
                        1740 --1857: *                        Processing of the command "Program", "Block Erase",
                        1741 --1858: *                         "Program/Erasure Suspend", "Program/Erasure Resume",
                        1742 --1859: *                         "Forced Stop", "Blank Check", "Config Program", 
                        1743 --1860: *                         "Lock Bit Program", "Lock Bit Read", or "OTP Set" is in
                        1744 --1861: *                         progress.
                        1745 --1862: *                 ER_D_FLS_FACITOUT : FACI timeout
                        1746 --1863: ***************************************************************************************/
                        1747 --1864: static uint32_t d_FLS_CheckProcessingCompletion_ram(void)
                        1748 --1865: {
                        1749 --1866:     uint32_t res;
                        1750 --1867:     uint32_t lul_now;
                        1751 --1868:     uint32_t lul_frdy;
                        1752 --1869:     uint32_t saved_psw;
                        1753 --1870:     T_u4_RFDReturn  l_bu4_returnValue ;
                        1754 --1871:     
                        1755 --1872:     res = ER_IN_PROCESS;
                        1756 --1873:     /* Disable EI Level Maskable Interrupt */
                        1757 --1874:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                        1758 --1876:     l_bu4_returnValue = R_RFD_GetFaciSequenceReady((T_u2_FACI)g_fls_selected_fpsys);

                                                                      Page 30
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        1759 --1877:     
                        1760 --1878:     if (R_RFD_STS_READY == l_bu4_returnValue)
                        1761 --1879:     {
                        1762 --1880:         lul_frdy = R_RFD_STS_READY;
                        1763 --1881:     }
                        1764 --1882:     else
                        1765 --1883:     {
                        1766 --1884:         lul_frdy = D_FLS_ZERO_U32;
                        1767 --1885:     }
                        1768 --1886:     
                        1769 --1887:     /* Check FACI command time out */
                        1770 --1888:      D_OST_GetHardCounter(&lul_now);
                        1771 --1890:     /* Enable EI Level Maskable Interrupt */
                        1772 --1891:     ENABLE_INTERRUPT_WITH_CHECK(saved_psw);
                        1773 --1893:     if (D_FLS_ZERO_U32 != lul_frdy)
                        1774 --1894:     {
                        1775 --1895:         res = ER_OK;
                        1776 --1896:     }
                        1777 --1897:     else
                        1778 --1898:     {
                        1779 --1899:         if (g_fls_ctrl[g_fls_selected_fpsys].prm.max_time
                        1780 --1900:             < (uint32_t)(lul_now - g_fls_ctrl[g_fls_selected_fpsys].prm.faci_start_time))
                        1781 --1901:         {
                        1782 --1902:             /* Issue Forced Stop Command */
                        1783 --1903:             (void)d_FLS_IssueCommandCtrl_ram();
                        1784 --1904:             res = ER_D_FLS_FACITOUT;
                        1785 --1905:         }
                        1786 --1906:         else
                        1787 --1907:         {
                        1788 --1908:             g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter++;
                        1789 --1910:             /* Max times of check FRDY bit */
                        1790 --1911:             if (LIMIT_CHECK_FRDY < g_fls_ctrl[g_fls_selected_fpsys].prm.faci_check_counter)
                        1791 --1912:             {
                        1792 --1913:                 /* Issue Forced Stop Command */
                        1793 --1914:                 (void)d_FLS_IssueCommandCtrl_ram();
                        1794 --1915:                 res = ER_D_FLS_FACITOUT;
                        1795 --1916:             }
                        1796 --1917:             else
                        1797 --1918:             {
                        1798 --1919:                  /* waiting FSTATR_FRDY */
                        1799 --1920:                  /* do nothing yet */
                        1800 --1921:             }
                        1801 --1922:         }
                        1802 --1923:     }
                        1803 --1924:     return (res);
                        1804 --1925: }
