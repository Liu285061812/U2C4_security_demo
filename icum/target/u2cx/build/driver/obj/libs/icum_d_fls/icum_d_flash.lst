                        3807 --452: *                 ER_D_FLS_FACITOUT
                        3808 --453: ********************************************************************************************/
                        3809 --454: uint32_t D_FLS_CancelReq_ram(const uint32_t target_area, const uint32_t bank)
                        3810 --455: {
                        3811 --456:     uint32_t lul_fls_status;
                        3812 --457:     uint32_t iface;
                        3813 --459:     iface = R_RFD_FACI0;
                        3814 --461:     lul_fls_status = d_FLS_GetInterface_ram(target_area, bank, &iface);
                        3815 --462:     if (ER_OK == lul_fls_status)
                        3816 --463:     {
                        3817 --464:         g_fls_ctrl[iface].prm.ope_mode            = (uint16_t)R_RFD_MODE_DFPE;
                        3818 --465:         g_fls_ctrl[iface].prm.commad_req          = D_FLS_CMDREQ_ON;
                        3819 --466:         g_fls_ctrl[iface].prm.command_code        = D_FACI_CMD_FORCED_STOP;
                        3820 --467:         g_fls_ctrl[iface].prm.flash_addr          = D_FLS_ZERO_U32;
                        3821 --468:         g_fls_ctrl[iface].prm.p_data              = NULL;
                        3822 --469:         g_fls_ctrl[iface].prm.data_size_in_bytes  = D_FLS_ZERO_U32;
                        3823 --470:         g_fls_ctrl[iface].prm.p_pre_processing    = &d_FLS_PreProcessingCancel_ram;
                        3824 --471:         g_fls_ctrl[iface].prm.p_faci_commad_set   = &d_FLS_IssueCommandCtrl_ram;
                        3825 --472:         g_fls_ctrl[iface].prm.p_write_size_in_bytes = &d_FLS_GetDummyWriteSize_ram;
                        3826 --473:         g_fls_ctrl[iface].prm.p_error_check       = &d_FLS_CheckFaciErrors_ram;
                        3827 --474:         g_fls_ctrl[iface].prm.success_resp        = ER_OK;
                        3828 --475:         g_fls_ctrl[iface].prm.p_num               = D_FLS_ZERO_U32;
                        3829 --477:         lul_fls_status = d_FLS_Handler_ram(iface);
                        3830 --478:     } /* end of if (ER_OK == lul_fls_status) */
                        3831 --479:     else
                        3832 --480:     {
                        3833 --481:         /* Do nothing */
                        3834 --482:     }
                        3835 --484:     return (lul_fls_status);
                        3836 --485: }
