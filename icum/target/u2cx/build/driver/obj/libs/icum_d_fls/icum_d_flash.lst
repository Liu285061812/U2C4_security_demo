                        2230 --2370: *********************************************************************************/
                        2231 --2371: uint32_t D_FLS_SetUPGPProtect_ram(uint32_t flag1, uint32_t flag2)
                        2232 --2372: {
                        2233 --2373:     /* rewrite value */
                        2234 --2374:     uint32_t value;
                        2235 --2375:     /* retry count */
                        2236 --2376:     uint32_t count;
                        2237 --2378:     /* variable initialization */
                        2238 --2379:     value = D_FLS_UPGP1_PROTECT | D_FLS_UPGP2_PROTECT;
                        2239 --2380:     count = D_FLS_UPGP_RETRY;
                        2240 --2382:     if (D_FLS_UPGP_OFF == flag1)
                        2241 --2383:     {
                        2242 --2384:         /* UPGP1 and UPGP2 are Disable */
                        2243 --2385:         if (D_FLS_UPGP_OFF == flag2)
                        2244 --2386:         {
                        2245 --2387:             value &= ~(D_FLS_UPGP1_PROTECT | D_FLS_UPGP2_PROTECT);
                        2246 --2388:         }

                                                                      Page 38
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        2247 --2389:         /* UPGP1 is Disable, UPGP2 is Enable */
                        2248 --2390:         else
                        2249 --2391:         {
                        2250 --2392:             value = D_FLS_UPGP2_PROTECT;
                        2251 --2393:         }
                        2252 --2394:     }
                        2253 --2395:     else
                        2254 --2396:     {
                        2255 --2397:         /* UPGP1 is Enable, UPGP2 is Disable */
                        2256 --2398:         if (D_FLS_UPGP_OFF == flag2)
                        2257 --2399:         {
                        2258 --2400:             value = D_FLS_UPGP1_PROTECT;
                        2259 --2401:         }
                        2260 --2402:         /* UPGP1 and UPGP2 are Enable */
                        2261 --2403:         else
                        2262 --2404:         {
                        2263 --2405:             value = D_FLS_UPGP1_PROTECT | D_FLS_UPGP2_PROTECT;
                        2264 --2406:         }
                        2265 --2407:    }
                        2266 --2408:     /* rewrite UP1EN and UP2EN */
                        2267 --2409:     WRITE_PROT_REG(ICUM_CTLREG.ICUM_UPGPS.UINT32, value, count);
                        2268 --2411:     return ER_OK;
                        2269 --2412: }
