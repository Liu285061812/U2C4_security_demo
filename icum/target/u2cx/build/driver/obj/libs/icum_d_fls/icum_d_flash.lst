                       18432 --1562:          /* Shifts the mode of the target memory of the target FACI to the P/E mode */
                       18433 --1563:         (void)R_RFD_ShiftToPEMode((T_u2_FACI)g_fls_selected_fpsys, (T_en_FACIMode)operating_mode);
                       18434 --1564:         
                       18435 --1565:         /* Waiting for operation mode change  */
