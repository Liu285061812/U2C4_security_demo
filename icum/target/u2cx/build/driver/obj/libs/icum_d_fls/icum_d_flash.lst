                       18586 --1725:     {
                       18587 --1726:         lul_dummy = ICUM_FCCTL.ICUM_FCBWCTL.UINT32;
                       18588 --1727:         ICUM_FCCTL.ICUM_FCBWCTL.UINT32 = D_FLS_ZERO_U32;
                       18589 --1728:         ICUM_FCCTL.ICUM_FCBWCTL.UINT32 |= FCBWCTL_ICHCLR;
                       18590 --1729:         ICUM_FCCTL.ICUM_FCBWCTL.UINT32 |= lul_dummy;
                       18591 --1730:         /* Dummy Read ( ICUM_FCCTLICUM_FCBWCTL = 0 Bus transaction execution) */
                       18592 --1731:         lul_dummy = ICUM_FCCTLICUM_FCBWCTL;
                       18593 --1732:         /* Synchronize memory */
                       18594 --1733:         __SYNCM();
                       18595 --1734:         /* Synchronize pipeline */
                       18596 --1735:         __SYNCP();
                       18597 --1736:         /* Re-prefetch after clearing the prefetched instructions and data. */
                       18598 --1737:         __SYNCI();
                       18599 --1738:     }
                       18600 --1739:     else
                       18601 --1740:     {
                       18602 --1741:         /* Nothing to do for read mode/DF_PE mode */
                       18603 --1742:     }
                       18604 --1744:     return;
                       18605 --1745: }
