                        8116 --1636: static uint32_t d_FLS_Err2Status_ram(const uint32_t error_code)
                        8117 --1637: {
                        8118 --1638:     uint32_t lul_fls_status;
                        8119 --1640:     if (FLS_ERR_NONE == error_code)
                        8120 --1641:     {
                        8121 --1642:         lul_fls_status = ER_OK;
                        8122 --1643:     }
                        8123 --1644:     else if (FLS_ERR_CANCEL_END == error_code)
                        8124 --1645:     {   /* cancel normal end */
                        8125 --1646:         lul_fls_status = ER_OK;
                        8126 --1647:     }
                        8127 --1648:     else if (D_FLS_ZERO_U32 != (error_code & FLS_ERR_PROTECTION))
                        8128 --1649:     {
                        8129 --1650:         lul_fls_status = ER_D_FLS_PROTECTION;
                        8130 --1651:     }
                        8131 --1652:     else if (D_FLS_ZERO_U32 != (error_code & FLS_ERR_PROG))
                        8132 --1653:     {
                        8133 --1654:         switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code)
                        8134 --1655:         {
                        8135 --1656:             case D_FACI_CMD_PROGRAM:
                        8136 --1657:             case D_FACI_CMD_MULTI_PROGRAM:
                        8137 --1658:                 lul_fls_status = ER_D_FLS_WRITE;
                        8138 --1659:                 break;
                        8139 --1661:             case D_FACI_CMD_BLOCK_ERASE:
                        8140 --1662:                 lul_fls_status = ER_D_FLS_ERASE;
                        8141 --1663:                 break;
                        8142 --1665:             case D_FACI_CMD_FORCED_STOP:
                        8143 --1666:                 lul_fls_status = ER_D_FLS_CANCEL;
                        8144 --1667:                 break;
                        8145 --1669:             case D_FACI_CMD_SECURITY_ERASE:
                        8146 --1670:             case D_FACI_CMD_SECURITY_PROGRAM:
                        8147 --1671:             case D_FACI_CMD_SWITCH_ERASE:
                        8148 --1672:             case D_FACI_CMD_SWITCH_PROGRAM:
                        8149 --1673:             case D_FACI_CMD_TAG_ERASE:
                        8150 --1674:             case D_FACI_CMD_TAG_UPDATE:
                        8151 --1675:                 lul_fls_status = ER_D_FLS_WRITE;
                        8152 --1676:                 break;
                        8153 --1678:             case D_FACI_CMD_STATUS_CLEAR:
                        8154 --1679:                             /* Impossible !!     */
                        8155 --1680:             case D_FACI_CMD_BLANK_CHECK:
                        8156 --1681:                             /* Impossible !!     */
                        8157 --1682:             case D_FACI_CMD_PE_RESUME:
                        8158 --1683:                             /* Impossible !!     */

                                                                      Page 136
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000rps1.si
                        8159 --1684:             default:
                        8160 --1685:                 lul_fls_status = ER_D_FLS_INTERNAL;
                        8161 --1686:                 break;
                        8162 --1687:         } /* end of switch ((uint32_t)g_fls_ctrl[g_fls_selected_fpsys].prm.command_code) */
                        8163 --1688:     }   /* end of else if (0U != (error_code & FLS_ERR_PROG)) */
                        8164 --1689:     else
                        8165 --1690:     {
                        8166 --1691:         /* other */
                        8167 --1692:         lul_fls_status = ER_D_FLS_INTERNAL;
                        8168 --1693:     }
                        8169 --1694:     return (lul_fls_status);
                        8170 --1695: }
