                        2838 --338:                 g_fls_ctrl[fpsys].prm.p_set_ctrl_prm = NULL;
                        2839 --339:             }
                        2840 --340:             else
                        2841 --341:             {
                        2842 --342:                 lul_fls_status = ER_IN_PROCESS;
