                        7448 --2364: * Function name: D_FLS_SetUPGPProtect_ram
                        7449 --2365: * Description  : Enable/Disable the UPGP1 and UPGP2 protection
                        7450 --2366: * Arguments    : flag1  : Enable(D_FLS_UPGP_ON) / Disable(D_FLS_UPGP_OFF)
                        7451 --2367: *                flag2  : Enable(D_FLS_UPGP_ON) / Disable(D_FLS_UPGP_OFF)
                        7452 --2368: * Private value: none
                        7453 --2369: * Return Value : ER_OK
                        7454 --2370: *********************************************************************************/
                        7455 --2371: uint32_t D_FLS_SetUPGPProtect_ram(uint32_t flag1, uint32_t flag2)
                        7456 --2372: {
                        7457 --2373:     /* rewrite value */
                        7458 --2374:     uint32_t value;
                        7459 --2375:     /* retry count */
                        7460 --2376:     uint32_t count;
                        7461 --2378:     /* variable initialization */
                        7462 --2379:     value = D_FLS_UPGP1_PROTECT | D_FLS_UPGP2_PROTECT;
                        7463 --2380:     count = D_FLS_UPGP_RETRY;
                        7464 --2382:     if (D_FLS_UPGP_OFF == flag1)
                        7465 --2383:     {
                        7466 --2384:         /* UPGP1 and UPGP2 are Disable */
                        7467 --2385:         if (D_FLS_UPGP_OFF == flag2)
                        7468 --2386:         {
                        7469 --2387:             value &= ~(D_FLS_UPGP1_PROTECT | D_FLS_UPGP2_PROTECT);
                        7470 --2388:         }
                        7471 --2389:         /* UPGP1 is Disable, UPGP2 is Enable */
                        7472 --2390:         else
                        7473 --2391:         {
                        7474 --2392:             value = D_FLS_UPGP2_PROTECT;
                        7475 --2393:         }
                        7476 --2394:     }
                        7477 --2395:     else
                        7478 --2396:     {
                        7479 --2397:         /* UPGP1 is Enable, UPGP2 is Disable */
                        7480 --2398:         if (D_FLS_UPGP_OFF == flag2)
                        7481 --2399:         {
                        7482 --2400:             value = D_FLS_UPGP1_PROTECT;
                        7483 --2401:         }
                        7484 --2402:         /* UPGP1 and UPGP2 are Enable */
                        7485 --2403:         else
                        7486 --2404:         {
                        7487 --2405:             value = D_FLS_UPGP1_PROTECT | D_FLS_UPGP2_PROTECT;
                        7488 --2406:         }
                        7489 --2407:    }
                        7490 --2408:     /* rewrite UP1EN and UP2EN */
                        7491 --2409:     WRITE_PROT_REG(ICUM_CTLREG.ICUM_UPGPS.UINT32, value, count);
                        7492 --2411:     return ER_OK;
                        7493 --2412: }
