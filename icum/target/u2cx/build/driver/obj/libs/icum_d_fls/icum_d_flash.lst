                        2874 --375:                         }
                        2875 --376:                     }
                        2876 --377:                     else
                        2877 --378:                     {
                        2878 --379:                         /* All Block Complete !! */
                        2879 --380:                         lul_fls_status = d_FLS_SetOperatingMode_ram((uint16_t)R_RFD_MODE_READ, D_FACI_CMD_DUMMY_CMD);
