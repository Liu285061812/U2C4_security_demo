                        1950 --1020: * Function name: d_REMAP_SetRemapTbl
                        1951 --1021: * Description  : Register user-specified area in the remap table
                        1952 --1022: * Arguments    : (IN)phys_base        : Physical Address
                        1953 --1023: * Return Value : ER_OK
                        1954 --1024: *                ER_D_REMAP_RETRYOVER : Retry Over at writing Remap Register
                        1955 --1025: ***************************************************************************************/
                        1956 --1026: static uint32_t d_REMAP_SetRemapTbl(uint32_t phys_base)
                        1957 --1027: {
                        1958 --1028:     uint32_t uiRet = ER_OK;
                        1959 --1029:     uint32_t ret_sts;
                        1960 --1030:     uint32_t loop_cnt;
                        1961 --1031:     uint32_t index_no = REMAP_TBL_MAX - NUM4;
                        1962 --1033:     /* 1. Search for unused or registered */
                        1963 --1034:     for (loop_cnt = COUNT_ZERO; loop_cnt < (REMAP_TBL_MAX - NUM4); loop_cnt += NUM2)
                        1964 --1035:     {
                        1965 --1036:         if (REGST_NOUSE == (uint32_t)s_remap_tbl[loop_cnt].reg_flag)
                        1966 --1037:         {
                        1967 --1038:             /* 1-1. If register flag is REGST_NOUSE, set loop_cnt to index_no and finish the for loop */
                        1968 --1039:             index_no = loop_cnt;
                        1969 --1040:             break;
                        1970 --1041:         }
                        1971 --1042:         else if (phys_base == s_remap_tbl[loop_cnt].phys_address)
                        1972 --1043:         {
                        1973 --1044:             /* 1-2. If register flag is not REGST_NOUSE and phys_base is already remapped, return without doing anything. */
                        1974 --1045:             break;
                        1975 --1046:         }
                        1976 --1047:         else
                        1977 --1048:         {
                        1978 --1049:             /* No Operation */
                        1979 --1050:         }
                        1980 --1051:     }
                        1981 --1053:     /* 2. Check whether current return code is ER_OK and index number is not initial value */
                        1982 --1054:     if ((REMAP_TBL_MAX - NUM4) > index_no)
                        1983 --1055:     {
                        1984 --1056:         /* 2-1. Synchronize memory */
                        1985 --1057:         SYNC_MEMORY();
                        1986 --1058:         /* 2-2. Set physical base address to ICUMX_SCIREMAP2Mn register */
                        1987 --1059:         ret_sts = d_REMAP_Exec(index_no, phys_base);
                        1988 --1060:         /* 2-3. Check whether return code from d_REMAP_Exec function is ER_OK */

                                                                      Page 34
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00013k01.si
                        1989 --1061:         if (ER_OK == ret_sts)
                        1990 --1062:         {
                        1991 --1063:             /* 2-3-1. Synchronize memory */
                        1992 --1064:             SYNC_MEMORY();
                        1993 --1065:             /* 2-3-2. Set to remap table */
                        1994 --1066:             s_remap_tbl[index_no].reg_flag = (uint8_t)index_no;
                        1995 --1067:             s_remap_tbl[index_no].lru_count = 1U;
                        1996 --1068:             s_remap_tbl[index_no].reg_count = 1U;
                        1997 --1069:             s_remap_tbl[index_no].phys_address = phys_base;
                        1998 --1070:             s_remap_tbl[index_no+1U].phys_address = phys_base + BIAS_2MB;
                        1999 --1071:             /* 2-3-3. Set the number of the index that the area is registered by user. */
                        2000 --1072:             s_user_set_no = index_no + 1U;
                        2001 --1073:         }
                        2002 --1074:         else
                        2003 --1075:         {
                        2004 --1076:             /* 2-4. Error writing to remap register */
                        2005 --1077:             uiRet = ER_D_REMAP_RETRYOVER;
                        2006 --1078:         }
                        2007 --1079:     }
                        2008 --1080:     else
                        2009 --1081:     {
                        2010 --1082:         /* No Operation */
                        2011 --1083:     }
                        2012 --1084:     return (uiRet);
                        2013 --1085: }
                        2014 --1086: #endif /* !defined(TARGET_DEVICE_S4H) */
