                        1562 --796: * Function ID  : [ICUMFW_CD_S4_D_REMAP_0011]:[ICUMFW_UD_S4_D_REMAP_0011]
                        1563 --797: * Function name: D_REMAP_CheckGetLogicalAddrs
                        1564 --798: * Description  : Check & Get Logical Address
                        1565 --799: * Arguments    : (IN)phys_addr           Physical Address
                        1566 --800: *                (OUT)*p_logical_addr    Logical Address
                        1567 --801: * Return Value : ER_OK
                        1568 --802: *                ER_PARAM             : Pointer is NULL
                        1569 --803: *                ER_D_REMAP_STATE     : Not Initialize
                        1570 --804: *                ER_D_REMAP_NOREGIST  : Not Registered Physical Address
                        1571 --805: *                ER_D_REMAP_ILLEGALADR: Illegal Address
                        1572 --806: ***************************************************************************************/
                        1573 --807: uint32_t  D_REMAP_CheckGetLogicalAddrs(uint32_t phys_addr, uint32_t *p_logical_addr)
                        1574 --808: {
                        1575 --809:     uint32_t    uiRet = ER_OK;
                        1576 --810:     uint32_t    phys_base;
                        1577 --811:     uint32_t    offset_adrs;
                        1578 --812:     uint32_t    index_no;
                        1579 --813:     uint32_t    ret_sts;
                        1580 --814:     uint32_t    find_flg = REMAP_NOTFIND;
                        1581 --815:     uint32_t    find_no = COUNT_ZERO;
                        1582 --817:     /* 1. If pointer is NULL, Parameter Error */
                        1583 --818:     if (NULL == p_logical_addr)
                        1584 --819:     {
                        1585 --820:         uiRet = ER_PARAM;
                        1586 --821:     }
                        1587 --822:     /* 2. Check Initialize status */
                        1588 --823:     else if (REMAP_NOTINIT == s_init_sts)
                        1589 --824:     {
                        1590 --825:         uiRet = ER_D_REMAP_STATE;
                        1591 --826:     }
                        1592 --827:     else
                        1593 --828:     {
                        1594 --829:         /* 3. Generate Physical Base Address and Offset Address */
                        1595 --830:         phys_base = phys_addr & SEP_BASE_ADRS;
                        1596 --831:         offset_adrs = phys_addr & SEP_OFF_ADRS;
                        1597 --833:         if (PHYS_ADRS15_BASE == phys_base)
                        1598 --834:         {
                        1599 --835:             /* 4. Case of RT-SRAM Remap Area */
                        1600 --836:             *p_logical_addr = offset_adrs + REMAP_ADRS15_BASE;
                        1601 --837:         }
                        1602 --838:         else if (PHYS_ADRS12_BASE  == phys_base)
                        1603 --839:         {
                        1604 --840:             /* 5. Case of  MFIS Remap Area */
                        1605 --841:             *p_logical_addr = offset_adrs + REMAP_ADRS12_BASE;
                        1606 --842:         }
                        1607 --843:         else if (PHYS_ADRS13_BASE  == phys_base)
                        1608 --844:         {
                        1609 --845:             /* 6. Case of  RPC (Flash) Remap Area */
                        1610 --846:             *p_logical_addr = offset_adrs + REMAP_ADRS13_BASE;
                        1611 --847:         }
                        1612 --848:         else if (PHYS_ADRS14_BASE  == phys_base)
                        1613 --849:         {
                        1614 --850:             /* 7. Case of  Secure Engine Remap Area */
                        1615 --851:             *p_logical_addr = offset_adrs + REMAP_ADRS14_BASE;
                        1616 --852:         }
                        1617 --853:         else
                        1618 --854:         {
                        1619 --855:             /* 8. Case of Not Fixed Area, Check Specified Address Area */
                        1620 --856:             ret_sts = D_MISC_CheckArea(phys_addr);
                        1621 --857:             if (AREA_REMAP != ret_sts)
                        1622 --858:             {

                                                                      Page 28
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00013k01.si
                        1623 --859:                 /* If Specified Address is not in Remap Area, Return with PARAMETER ERROR */
                        1624 --860:                 uiRet = ER_D_REMAP_ILLEGALADR;
                        1625 --861:             }
                        1626 --862:             else
                        1627 --863:             {
                        1628 --864:                 /* 9. Search position same as Physical Base Address */
                        1629 --865:                 for (index_no = COUNT_ZERO; (REMAP_REG_MAX - NUM4) > index_no; index_no += NUM2)
                        1630 --866:                 {
                        1631 --867:                     if (phys_base  == s_remap_tbl[index_no].phys_address)
                        1632 --868:                     {
                        1633 --869:                         find_flg = REMAP_FIND;
                        1634 --870:                         find_no = index_no;
                        1635 --871:                         break;
                        1636 --872:                     }
                        1637 --873:                     else
                        1638 --874:                     {
                        1639 --875:                         /* No Operation */
                        1640 --876:                     }
                        1641 --877:                 }
                        1642 --879:                 /* 9-1. Not Found same Physical Base Address, Not Register Error */
                        1643 --880:                 if (REMAP_NOTFIND == find_flg)
                        1644 --881:                 {
                        1645 --882:                     uiRet = ER_D_REMAP_NOREGIST;
                        1646 --883:                 }
                        1647 --884:                 else
                        1648 --885:                 {
                        1649 --886:                     /* 10. Generate and Set Logical Address */
                        1650 --887:                     *p_logical_addr = s_remap_tbl[find_no].remap_address + offset_adrs;
                        1651 --888:                 }
                        1652 --889:             }
                        1653 --890:         }
                        1654 --891:     }
                        1655 --893:     return (uiRet);
                        1656 --894: }
                        1657 --895: #endif  /* defined(FSW_REMAP_DRIVER) */
