                        1015 --492: /*!****************************************************************************************************************//**
                        1016 --493:  * \ingroup     HASHHMACAPIsInternal
                        1017 --494:  * \brief       Perform hash block final processing and outer key input and acquire Tag.
                        1018 --495:  * \param       [in] p_ctx           An address of HASH context
                        1019 --496:  * \param       [out] p_tag          An address of digest
                        1020 --497:  * \return
                        1021 --498:  *  - #HASH_RET_OK:                  Successfully done.
                        1022 --499:  *  - #HASH_RET_PARAMERR:            Argument parameter NULL.
                        1023 --500:  *  - #HASH_RET_TIMEOUTERR:          process timeouted.
                        1024 --501:  * \par Global Variables
                        1025 --502:  *  - None
                        1026 --503:  * \par Registers Used
                        1027 --504:  *  - #ICUM_SHADCNT, #ICUM_SHAFIFOCNT
                        1028 --505:  *  - #ICUM_SHAIDAT, #ICUM_SHAODAT, #ICUM_SHACNT, #ICUM_SHASTS, #ICUM_SHASTSC, #ICUM_SHADID0, #ICUM_SHADID1, <br>
                        1029 --506:  *    #ICUM_SHADID2, #ICUM_SHADID3, #ICUM_SHADID4, #ICUM_SHADID5, #ICUM_SHADID6, #ICUM_SHADID7, #ICUM_SHADIL0, <br>
                        1030 --507:  *    #ICUM_SHADIL1, #ICUM_SHADDCNT (Used by sub functions)
                        1031 --508:  * \par Precondition
                        1032 --509:  *  - None
                        1033 --510:  * \par Detailed description
                        1034 --511:  *      - Perform hash block final processing and outer key input, then output Tag from register.
                        1035 --512:  *
                        1036 --513:  * Pseudo-code for the function can be found below.
                        1037 --514:  * -# If p_ctx != NULL
                        1038 --515:  *   -# Set the address of p_ctx->hash_ctx to p_hctx
                        1039 --516:  *   -# Perform block process preprocessing with #r_hash_cmn_preprocess_block
                        1040 --517:  *   -# If ret == HASH_RET_OK
                        1041 --518:  *     -# Get block size with #r_hash_cmn_get_block_size and set it to hash_block_size
                        1042 --519:  *     -# If p_hctx->transfer_prm.icup.leftover_msg_len == 0U
                        1043 --520:  *       -# 1 is set to the IDATA_LAST and IDATA_ZERO bit of the register #ICUM_SHADCNT
                        1044 --521:  *     -# Else
                        1045 --522:  *       -# Set left_idata_num as the remainder of the leftover_msg_len divided by HASH_WORD_SIZE
                        1046 --523:  *       -# Convert last_idata_num from byte size to bit size
                        1047 --524:  *       -# 1 is set to the IDATA_LAST bit of the register #ICUM_SHADCNT
                        1048 --525:  *       -# last_idata_num is set to  the IDATA_NUM bit of the register #ICUM_SHADCNT
                        1049 --526:  *       -# Execute block processing for leftover_msg_len size from leftover_msg using #r_hash_cmn_set_idat
                        1050 --527:  *     -# Round up leftover_msg_len to a multiple of 4 using #r_hash_cmn_roundup_4 and set it to roundup_len.
                        1051 --528:  *     -# If roundup_len != hash_block_size
                        1052 --529:  *       -# 1 is set to the IDAT bit of the register #ICUM_SHAFIFOCNT
                        1053 --530:  *     -# Else
                        1054 --531:  *       -# Do nothing
                        1055 --532:  *     -# Wait for IDATA_READY with #r_hash_cmn_wait_for_idata_ready
                        1056 --533:  *     -# Set function result to ret
                        1057 --534:  *     -# If ret == HASH_RET_OK

                                                                      Page 19
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000tec1.si
                        1058 --535:  *       -# Input the outer key with #r_hash_hmac_set_outerkey
                        1059 --536:  *       -# If ret == HASH_RET_OK
                        1060 --537:  *         -# Get output data of size hash_len to p_digest with #r_hash_cmn_get_output_data
                        1061 --538:  *         -# Set function result to ret
                        1062 --539:  *       -# Else
                        1063 --540:  *         -# Do nothing
                        1064 --541:  *     -# Else
                        1065 --542:  *       -# Do nothing
                        1066 --543:  *   -# Else
                        1067 --544:  *     -# Do nothing
                        1068 --545:  * -# Else
                        1069 --546:  *   -# Set #HASH_RET_PARAMERR to ret
                        1070 --547:  * -# Clear p_ctx using #r_hash_cmn_set_byte.
                        1071 --548:  * -# Return ret
                        1072 --549:  *
                        1073 --550:  * \callgraph
                        1074 --551:  *********************************************************************************************************************/
