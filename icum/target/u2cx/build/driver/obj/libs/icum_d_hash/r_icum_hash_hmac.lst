                        1408 --681: /*!****************************************************************************************************************//**
                        1409 --682:  * \ingroup     HASHHMACAPIsInternal
                        1410 --683:  * \brief       Input inner key to register
                        1411 --684:  * \param       [in] p_ctx           An address of HASH context
                        1412 --685:  * \param       [in] p_key           An address of key data
                        1413 --686:  * \param       [in] key_len         Byte length of key data
                        1414 --687:  * \return
                        1415 --688:  *  - #HASH_RET_OK:                  Successfully done.
                        1416 --689:  *  - #HASH_RET_PARAMERR:            Argument parameter NULL.
                        1417 --690:  *  - #HASH_RET_LENGTHERR:           HASH block size error.
                        1418 --691:  *  - #HASH_RET_TIMEOUTERR:          process timeouted.
                        1419 --692:  * \par Global Variables
                        1420 --693:  *  - None
                        1421 --694:  * \par Registers Used
                        1422 --695:  *  - #ICUM_SHADCNT, #ICUM_SHAFIFOCNT
                        1423 --696:  *  - #ICUM_SHAIDAT,  #ICUM_SHASTS (Used by sub functions)
                        1424 --697:  * \par Precondition
                        1425 --698:  *  - None
                        1426 --699:  * \par Detailed description
                        1427 --700:  *      - Input inner key to register.
                        1428 --701:  *
                        1429 --702:  * Pseudo-code for the function can be found below.
                        1430 --703:  * -# If p_ctx != NULL
                        1431 --704:  *   -# Get block size with #r_hash_cmn_get_block_size and set it to hash_block_size
                        1432 --705:  *   -# If hash_block_size == 0U
                        1433 --706:  *     -# Set #HASH_RET_LENGTHERR to ret
                        1434 --707:  *   -# Else
                        1435 --708:  *     -# If key_len == 0U
                        1436 --709:  *       -# 1 is set to the IDATA_LAST, IDATA_ZERO and IPAD bit of the register #ICUM_SHADCNT
                        1437 --710:  *     -# Else
                        1438 --711:  *       -# Set left_idata_num as the remainder of the key_len divided by HASH_WORD_SIZE
                        1439 --712:  *       -# Convert last_idata_num from byte size to bit size
                        1440 --713:  *       -# 1 is set to the IDATA_LAST and IPAD bit of the register #ICUM_SHADCNT
                        1441 --714:  *       -# last_idata_num is set to  the IDATA_NUM bit of the register #ICUM_SHADCNT
                        1442 --715:  *       -# Execute block processing for key_len size from p_key using #r_hash_cmn_set_idat
                        1443 --716:  *     -# Round up leftover_msg_len to a multiple of 4 using #r_hash_cmn_roundup_4 and set it to roundup_len.
                        1444 --717:  *     -# If roundup_len != hash_block_size
                        1445 --718:  *       -# 1 is set to the IDAT bit of the register #ICUM_SHAFIFOCNT
                        1446 --719:  *     -# Else
                        1447 --720:  *       -# Do nothing
                        1448 --721:  *     -# Wait for IDATA_READY with #r_hash_cmn_wait_for_idata_ready
                        1449 --722:  *     -# Set function result to ret
                        1450 --723:  * -# Else
                        1451 --724:  *   -# Set #HASH_RET_PARAMERR to ret
                        1452 --725:  * -# Return ret
                        1453 --726:  *
                        1454 --727:  * \callgraph
                        1455 --728:  *********************************************************************************************************************/
