                        4171 --1609: * Function ID   : [ICUMFW_CD_S4_D_HASH_0034]:[ICUMFW_UD_S4_D_HASH_0034]
                        4172 --1610: * Function Name : r_hash_cmn_exec_block
                        4173 --1611: **********************************************************************************************************************/
                        4174 --1612: /*!****************************************************************************************************************//**
                        4175 --1613:  * \ingroup     HASHCommonAPIsInternal
                        4176 --1614:  * \brief       Perform HASH block processing.
                        4177 --1615:  * \param       [in,out] p_ctx          An address of hash context
                        4178 --1616:  * \param       [in] p_msg              An inputting message
                        4179 --1617:  * \param       [in] msg_len            The length of the message in bytes
                        4180 --1618:  * \param       [in] hash_block_size    HASH block size
                        4181 --1619:  * \return
                        4182 --1620:  *  - #HASH_RET_OK:                  Successfully done.
                        4183 --1621:  *  - #HASH_RET_PARAMERR:            There is an error in the parameter.
                        4184 --1622:  *  - #HASH_RET_LENGTHERR:           Buffer overflow.
                        4185 --1623:  *  - #HASH_RET_TIMEOUTERR:          Operation timeouted.
                        4186 --1624:  * \par Global Variables
                        4187 --1625:  *  - None
                        4188 --1626:  * \par Registers Used
                        4189 --1627:  *  - #ICUM_SHASTS
                        4190 --1628:  *  - #ICUM_SHAIDAT, #ICUM_SHAFIFOCNT (Used by sub functions)
                        4191 --1629:  * \par Precondition
                        4192 --1630:  *  - None
                        4193 --1631:  * \par Detailed description
                        4194 --1632:  *      - Perform HASH block processing. <br>
                        4195 --1633:  *        This process is called from a hash operation or an HMAC operation.
                        4196 --1634:  *
                        4197 --1635:  * Pseudo-code for the function can be found below. 
                        4198 --1636:  * -# Set #HASH_RET_OK to ret
                        4199 --1637:  * -# Set the argument msg_len to rem_size
                        4200 --1638:  * -# Set 0 to msg_offset
                        4201 --1639:  * -# If (p_ctx != NULL) && (p_msg != NULL)
                        4202 --1640:  *   -# If p_ctx->transfer_prm.icup.leftover_msg_len < #HASH_LEFTOVER_MAX
                        4203 --1641:  *     -# If p_ctx->transfer_prm.icup.leftover_msg_len != 0
                        4204 --1642:  *       -# Copy msg data after the remaining data until the buffer is filled with #r_hash_cmn_cpy_byte
                        4205 --1643:  *       -# Execute block processing for block size from leftover_msg using #r_hash_cmn_set_idat
                        4206 --1644:  *       -# Set msg_offset to hash_block_size - leftover_msg_len
                        4207 --1645:  *       -# Subtract the value of (hash_block_size - leftover_msg_len) from rem_size
                        4208 --1646:  *       -# Set #HASH_LEFTOVER_MAX size 0 to p_ctx->transfer_prm.icup.leftover_msg with #r_hash_cmn_set_byte
                        4209 --1647:  *       -# Set 0 to p_ctx->transfer_prm.icup.leftover_msg_len
                        4210 --1648:  *       -# Wait IDATA_READY is 1 with #r_hash_cmn_wait_sts
                        4211 --1649:  *     -# Else
                        4212 --1650:  *       -# Do nothing
                        4213 --1651:  *     -# If ret == #HASH_RET_OK
                        4214 --1652:  *       -# Loop while rem_size is more than hash_block_size
                        4215 --1653:  *         -# Execute block processing for block size from p_msg[msg_offset] using #r_hash_cmn_set_idat
                        4216 --1654:  *         -# Add hash_block_size to msg_offset
                        4217 --1655:  *         -# Subtract hash_block_size from rem_size
                        4218 --1656:  *         -# Wait for IDATA_READY with #r_hash_cmn_wait_for_idata_ready
                        4219 --1657:  *         -# Set function result to ret
                        4220 --1658:  *         -# If ret == #HASH_RET_OK
                        4221 --1659:  *           -# Break
                        4222 --1660:  *         -# Else
                        4223 --1661:  *           -# Do nothing
                        4224 --1662:  *       -# If ret == #HASH_RET_OK
                        4225 --1663:  *         -# If rem_size != 0
                        4226 --1664:  *           -# Copy the leftover messages into the buffer with #r_hash_cmn_cpy_byte
                        4227 --1665:  *           -# Set rem_size to p_ctx->transfer_prm.icup.leftover_msg_len
                        4228 --1666:  *         -# Else
                        4229 --1667:  *           -# Do nothing
                        4230 --1668:  *         -# Get intermediate data with #r_hash_cmn_get_intermediate

                                                                      Page 72
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000c8s1.si
                        4231 --1669:  *       -# Else
                        4232 --1670:  *         -# Do nothing
                        4233 --1671:  *     -# Else
                        4234 --1672:  *       -# Do nothing
                        4235 --1673:  *   -# Else
                        4236 --1674:  *     -# Set #HASH_RET_LENGTHERR to ret
                        4237 --1675:  * -# Else
                        4238 --1676:  *   -# Set #HASH_RET_PARAMERR to ret
                        4239 --1677:  * -# Return ret
                        4240 --1678:  *
                        4241 --1679:  * \callgraph
                        4242 --1680:  *********************************************************************************************************************/
                        4243 --1681: static e_r_hash_ret_t r_hash_cmn_exec_block(st_r_hash_ctx_t* const p_ctx, const uint8_t* const p_msg,
                        4244 	.align	2
                        4245 	.align	2
                        4246 	.align	2
