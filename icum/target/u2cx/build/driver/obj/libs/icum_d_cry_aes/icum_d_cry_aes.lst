                         175 --144: * Function ID  : [ICUMFW_CD_S4_D_AES_0001]:[ICUMFW_UD_S4_D_AES_0001]
                         176 --145: * Function name: D_AES_Init
                         177 --146: * Description  : Initialization and initial value setting.
                         178 --147: * Arguments    : p_callback : address of callback function
                         179 --148: * Return Value : ER_OK
                         180 --149: *                ER_PARAM
                         181 --150: ***************************************************************************************/
                         182 --151: uint32_t D_AES_Init(init_callback_t* p_callback)
                         183 --152: {
                         184 --153:     uint32_t err;
                         185 --154:     uint32_t count_nb;
                         186 --156:     err = ER_OK;
                         187 --157:     count_nb = D_AES_ZERO_U32;
                         188 --159:     if (NULL == p_callback)
                         189 --160:     {
                         190 --161:         g_p_aes_callbackFunc = NULL;
                         191 --162:         err = ER_PARAM;
                         192 --163:     }
                         193 --164:     else
                         194 --165:     {
                         195 --166:         /* Set the initial value to callback function. */
                         196 --167:         g_p_aes_callbackFunc = p_callback;
                         197 --168:         /* Set ICUM_AESCTRL register */
                         198 --169: #if defined(TARGET_DEVICE_S4X) || defined(TARGET_DEVICE_V4H)
                         199 --170:         UNLOCK_REG_PROT(ICUMX_CTLREGICUMX_PERIREGPROT);
                         200 --171:         ICUM_AESCTRL = (ICUM_AESCTRL & ~(RST0)) | (PRM_RST0_INIT);
                         201 --172:         D_AES_WAIT_REG_VALUE(PRM_RST0_INIT, ICUM_AESCTRL, RST0);
                         202 --173:         ICUM_AESCTRL = (ICUM_AESCTRL & ~(RST1)) | (PRM_RST1_INIT);
                         203 --174:         D_AES_WAIT_REG_VALUE(PRM_RST1_INIT, ICUM_AESCTRL, RST1);
                         204 --175:         ICUM_AESCTRL = (ICUM_AESCTRL & ~(RST2)) | (PRM_RST2_INIT);
                         205 --176:         D_AES_WAIT_REG_VALUE(PRM_RST2_INIT, ICUM_AESCTRL, RST2);
                         206 --177:         LOCK_REG_PROT(ICUMX_CTLREGICUMX_PERIREGPROT);
                         207 --178:         /* Set ICUM_AESDMACLKRATE register */
                         208 --179:         ICUM_AESDMACLKRATE = DMA_DATA;
                         209 --180: #else
                         210 --181:         ICUM_AESCTRL = (ICUM_AESCTRL & ~(RST0 | RST1 | RST2)) | (PRM_RST0_INIT | PRM_RST1_INIT | PRM_RST2_INIT);
                         211 --182: #endif
                         212 --183:         /* Set the initial value to context#2. */
                         213 --184:         g_ctx2_state = NO_USE_CTX2;
                         214 --185:         /* Set the initial value to Key restriction status */
                         215 --186:         g_key_restriction.key_length = D_AES_KEY_SIZE_IN_BYTES_128BIT;
                         216 --187:         g_key_restriction.counter = D_AES_ZERO_U16;
                         217 --188:         g_aes_gen_key_length_id = D_AES_ZERO_U32;
                         218 --189:         g_aes_atonce_id_use_mng = D_AES_ZERO_U32;
                         219 --190:         /* Check key length id */
                         220 --191:         for(count_nb = D_AES_ZERO_U32; (uint32_t)D_AES_KEYLEN_ID_USE_MNG > count_nb; count_nb++)
                         221 --192:         {
                         222 --193:             g_key_restriction.key_length_id[count_nb] = D_AES_ZERO_U32;
                         223 --194:         }
                         224 --195:     }
                         225 --197:     return err;
                         226 --198: }
