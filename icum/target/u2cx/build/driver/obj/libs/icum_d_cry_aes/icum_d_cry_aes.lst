                         251 --224: * Return Value : ER_OK
                         252 --225: ***************************************************************************************/
                         253 --226: static uint32_t d_AES_SetParam(aes_setparam_t* p_param)
                         254 --227: {
                         255 --228:     /* Context #0 only */
                         256 --229:     uint32_t iv_flag;
                         257 --230:     uint32_t saved_psw;
                         258 --231:     uint32_t keysel;
                         259 --232:     uint32_t i;
                         260 --233:     uint32_t index;
                         261 --234:     volatile uint32_t *p_key_reg[D_AES_KEY_NUM];
                         262 --236:     iv_flag = D_AES_ZERO_U32;
                         263 --237:     saved_psw = D_AES_ZERO_U32;
                         264 --238:     keysel = D_AES_ZERO_U32;
                         265 --240:     /* Disable EI Level Maskable Interrupt */
                         266 --241:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                         267 --243:     if (D_AES_FIRST_CIPHER == (uint32_t)p_param->first)
                         268 --244:     {
                         269 --245:         /* Set execute and first status */
                         270 --246:         g_aes_drv_ctrl.status = (D_AES_STS_EXECUTE | D_AES_STS_FIRST);
                         271 --247:     }
                         272 --248:     else
                         273 --249:     {
                         274 --250:         /* Set execute and suspend status */
                         275 --251:         g_aes_drv_ctrl.status = (D_AES_STS_EXECUTE | D_AES_STS_SUSPEND);
                         276 --252:     }
                         277 --254:     /* Set ICUM_AESKEY register */
                         278 --255:     if (D_AES_KEY_SIZE_IN_BYTES_128BIT == (uint32_t)p_param->key_length)
                         279 --256:     {   /* 128bit */
                         280 --257:         keysel = D_AES_SET_KEYSEL_0;
                         281 --258:     }
                         282 --259:     else if (D_AES_KEY_SIZE_IN_BYTES_192BIT == (uint32_t)p_param->key_length)
                         283 --260:     {   /* 192bit */
                         284 --261:         keysel = D_AES_SET_KEYSEL_1;
                         285 --262:     }
                         286 --263:     else
                         287 --264:     {   /* 256bit */
                         288 --265:         keysel = D_AES_SET_KEYSEL_2;
                         289 --266:     }
                         290 --267:     ICUM_AESKEY = (ICUM_AESKEY & ~(KEYSEL)) | keysel;
