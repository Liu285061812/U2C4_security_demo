                         464 --463:         else
                         465 --464:         {
                         466 --465:             break;
                         467 --466:         }
                         468 --467:     }
                         469 --469:     /* Clear control status */
                         470 --470:     g_aes_drv_ctrl.status = D_AES_STS_NONE;
                         471 --472:     return err;
                         472 --473: }
