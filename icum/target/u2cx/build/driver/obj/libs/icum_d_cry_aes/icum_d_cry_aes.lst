                         234 --207: *                                     D_AES_CIPHER_MODE_CTR
                         235 --208: *                                     D_AES_CIPHER_MODE_CFB
                         236 --209: *                                     D_AES_CIPHER_MODE_OFB
                         237 --210: *                                     D_AES_CIPHER_MODE_XTS
                         238 --211: *                                     D_AES_CIPHER_MODE_CMAC
                         239 --212: *                                     D_AES_CIPHER_MODE_MP
                         240 --213: *                direction   : cipher direction
                         241 --214: *                              Range: D_AES_DIR_ENCRYPTION
                         242 --215: *                                     D_AES_DIR_DECRYPTION
                         243 --216: *                key_type    : key type
                         244 --217: *                              Range: D_AES_KEYTYPE_PLAIN
                         245 --218: *                                     D_AES_KEYTYPE_ROMKEY_0
