                         132 --97: * Function name: d_AES_ConvertAddress
                         133 --98: * Description  : Convert logical address to physical address.
                         134 --99: * Arguments    : (IN)const uint32_t insrc
                         135 --100: *                (IN)const uint32_t indest
                         136 --101: *                (IN)const uint32_t inauth
                         137 --102: *                (OUT)uint32_t *p_outsrc
                         138 --103: *                (OUT)uint32_t *p_outdest
                         139 --104: *                (OUT)uint32_t *p_outauth
                         140 --105: *                (IN)const uint16_t mode
                         141 --106: * Return Value : ER_OK
                         142 --107: ***************************************************************************************/
                         143 --108: static uint32_t d_AES_ConvertAddress(
                         144 --109:     const uint32_t insrc, const uint32_t indest, const uint32_t inauth,
                         145 --110:     uint32_t *p_outsrc, uint32_t *p_outdest, uint32_t *p_outauth,
                         146 --111:     const uint16_t mode)
                         147 --112: {
                         148 --114:     switch ((uint32_t)mode)
                         149 --115:     {
                         150 --116:         case D_AES_CIPHER_MODE_CMAC:
                         151 --117:             (void)D_REMAP_GetPhysAddrs(insrc, p_outsrc);
                         152 --118:             *p_outdest = indest;
                         153 --119:             break;
                         154 --121:         case D_AES_CIPHER_MODE_GCM:
                         155 --122:         case D_AES_CIPHER_MODE_CCM:
                         156 --123:             (void)D_REMAP_GetPhysAddrs(insrc, p_outsrc);
                         157 --124:             if (D_AES_ZERO_U32 != indest)
                         158 --125:             {
                         159 --126:                 (void)D_REMAP_GetPhysAddrs(indest, p_outdest);
                         160 --127:             }
                         161 --128:             else
                         162 --129:             {
                         163 --130:                 /* do nothing */
                         164 --131:             }
                         165 --133:             if (D_AES_ZERO_U32 != inauth)
                         166 --134:             {
                         167 --135:                 (void)D_REMAP_GetPhysAddrs(inauth, p_outauth);
                         168 --136:             }
                         169 --137:             else
                         170 --138:             {
                         171 --139:                 /* do nothing */
                         172 --140:             }

                                                                      Page 4
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000130g1.si
                         173 --141:             break;
                         174 --143:         default:
                         175 --144:             (void)D_REMAP_GetPhysAddrs(insrc, p_outsrc);
                         176 --145:             (void)D_REMAP_GetPhysAddrs(indest, p_outdest);
                         177 --146:             break;
                         178 --147:     }
                         179 --149:     return ER_OK;
                         180 --150: }
                         181 --151: #endif
