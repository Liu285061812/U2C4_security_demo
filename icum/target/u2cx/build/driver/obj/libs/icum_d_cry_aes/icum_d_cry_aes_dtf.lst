                         361 --341: ***************************************************************************************/
                         362 --342: static uint32_t d_AES_SetParamDtf(aes_setparam_t *p_param)
                         363 --343: {
                         364 --344:     uint32_t keysel;
                         365 --345:     uint32_t saved_psw;
                         366 --346:     uint32_t i;
                         367 --347:     uint32_t index;
                         368 --348:     volatile uint32_t *p_key_reg[D_AES_KEY_NUM];
                         369 --350:     keysel = D_AES_ZERO_U32;
                         370 --351:     saved_psw = D_AES_ZERO_U32;
                         371 --353:     /* Disable EI Level Maskable Interrupt */
                         372 --354:     DISABLE_INTERRUPT_WITH_CHECK(saved_psw);
                         373 --356:     g_aes_dtf_flag = FLG_ON;
                         374 --358:     /* Set ICUM_AESCTRL register */
                         375 --359:     ICUM_AESCTRL = (ICUM_AESCTRL & ~(DISTDTF));
                         376 --361:     /* Key length setting */
                         377 --362:     if (D_AES_KEY_SIZE_IN_BYTES_128BIT == (uint32_t)p_param->key_length)
                         378 --363:     {
                         379 --364:         /* 128bit */
                         380 --365:         keysel = D_AES_SET_KEYSEL_0;
                         381 --366:     }
                         382 --367:     else if (D_AES_KEY_SIZE_IN_BYTES_192BIT == (uint32_t)p_param->key_length)
                         383 --368:     {
                         384 --369:         /* 192bit */
                         385 --370:         keysel = D_AES_SET_KEYSEL_1;
                         386 --371:     }
                         387 --372:     else
                         388 --373:     {
                         389 --374:         /* 256bit */
                         390 --375:         keysel = D_AES_SET_KEYSEL_2;
                         391 --376:     }
                         392 --378:     ICUM_AESKEY = (ICUM_AESKEY & ~(KEYSEL)) |
                         393 --379:                     /* Set 00 or 01 or 10 : key length */
                         394 --380:                      keysel;
                         395 --382:     /* Set processing according to Context */
                         396 --383:     /* For CCM */
                         397 --384:     if (D_AES_CIPHER_MODE_CCM == (uint32_t)p_param->cipher_mode)
                         398 --385:     {
                         399 --386:         (void)d_AES_SetParamCcm(p_param->direction);
                         400 --387:     }
                         401 --388:     /* Other than CCM */
                         402 --389:     else
                         403 --390:     {
                         404 --391:         (void)d_AES_SetParamOtherCcm(p_param->cipher_mode, p_param->direction);
                         405 --392:     } /* end of else */
                         406 --394:     /* Branch by key_type */
                         407 --395:     if (D_AES_KEYTYPE_ROMKEY_0 != (uint32_t)p_param->key_type)
                         408 --396:     {
                         409 --397:         /* Enter key value */
                         410 --398:         /* Set ICUM_AESCTRL register */
                         411 --399:         ICUM_AESCTRL = (ICUM_AESCTRL & ~(IDATDEST)) |
                         412 --400:                         /* Set 01 : Key register KEY 1 */
                         413 --401:                         (PRM_IDATDEST_KEY);
                         414 --403:         /* EX_KEY 0: Set key bit [127:0] */
                         415 --404:         ICUM_AESKEY = (ICUM_AESKEY & ~(EX_KEY)) |
                         416 --405:                         /* Set 0 : Set key bit [127:0] */

                                                                      Page 8
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000130g1.si
                         417 --406:                         (PRM_EX_KEY_SET_127_0);
                         418 --408:        /* Start at a random index */
                         419 --409:         D_OST_GetHardCounter(&index);
                         420 --410:         index %= D_AES_KEY_NUM;
                         421 --412:         /* Set registers for key input */
                         422 --413:         *(p_key_reg + ADDR_0TH) = (volatile uint32_t *)&ICUM_AESDID0;
                         423 --414:         *(p_key_reg + ADDR_1ST) = (volatile uint32_t *)&ICUM_AESDID1;
                         424 --415:         *(p_key_reg + ADDR_2ND) = (volatile uint32_t *)&ICUM_AESDID2;
                         425 --416:         *(p_key_reg + ADDR_3RD) = (volatile uint32_t *)&ICUM_AESDID3;
                         426 --418:         /* Set key from a random index */
                         427 --419:         for (i = D_AES_ZERO_U32; i < D_AES_KEY_NUM; i++)
                         428 --420:         {
                         429 --421:             *(p_key_reg[index]) = p_param->p_aes_key[index];
                         430 --422:             index = (index + 1U) % D_AES_KEY_NUM;
                         431 --423:         }
                         432 --425:         if ((D_AES_KEY_SIZE_IN_BYTES_192BIT == (uint32_t)p_param->key_length) ||
                         433 --426:             (D_AES_KEY_SIZE_IN_BYTES_256BIT == (uint32_t)p_param->key_length))
                         434 --427:         {
                         435 --428:             /* EX_KEY 1: Set key bit [191:128] or [256:128] */
                         436 --429:             ICUM_AESKEY = (ICUM_AESKEY & ~(EX_KEY)) |
                         437 --430:                             /* Set 1 : Set key bit [191:128] or [256:128] */
                         438 --431:                             (PRM_EX_KEY_SET_256_128);
                         439 --432:             
                         440 --433:             if (D_AES_KEY_SIZE_IN_BYTES_192BIT == (uint32_t)p_param->key_length)
                         441 --434:             {
                         442 --435:                 ICUM_AESDID0 = *(p_param->p_aes_key + ADDR_4TH);
                         443 --436:                 ICUM_AESDID1 = *(p_param->p_aes_key + ADDR_5TH);
                         444 --437:             }
                         445 --438:             else
                         446 --439:             {
                         447 --440:                 ICUM_AESDID0 = *(p_param->p_aes_key + ADDR_4TH);
                         448 --441:                 ICUM_AESDID1 = *(p_param->p_aes_key + ADDR_5TH);
                         449 --442:                 ICUM_AESDID2 = *(p_param->p_aes_key + ADDR_6TH);
                         450 --443:                 ICUM_AESDID3 = *(p_param->p_aes_key + ADDR_7TH);
                         451 --444:             }
                         452 --445:         } /* end of if ((D_AES_KEY_SIZE_IN_BYTES_192BIT == p_param->key_length) || */
                         453 --446:         else
                         454 --447:         {
                         455 --448:             /* Do Nothing */
                         456 --449:         }
                         457 --450:     } /* end of if (D_AES_KEYTYPE_ROMKEY_0 != p_param->key_type) */
                         458 --451:     else
                         459 --452:     {
                         460 --453:         /* Do Nothing */
                         461 --454:     }
                         462 --456:     /* Enable EI Level Maskable Interrupt */
                         463 --457:     ENABLE_INTERRUPT_WITH_CHECK(saved_psw);
                         464 --459:     return ER_OK;
                         465 --460: }
