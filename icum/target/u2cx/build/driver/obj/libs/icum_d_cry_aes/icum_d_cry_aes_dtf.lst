                         183 --154: * Function ID  : [ICUMFW_CD_S4_D_AES_0096]:[ICUMFW_UD_S4_D_AES_0096]
                         184 --155: * Function name: d_AES_SetParamCcm
                         185 --156: * Description  : Parameter setting for DTF (for CCM)
                         186 --157: * Arguments    : cipher_mode          : Encryption mode
                         187 --158: *                                              D_AES_CIPHER_MODE_CCM
                         188 --159: *                direction            : cipher direction
                         189 --160: *                                       Range: D_AES_DIR_ENCRYPTION
                         190 --161: *                                              D_AES_DIR_DECRYPTION
                         191 --162: * Return Value : none
                         192 --163: ***************************************************************************************/
                         193 --164: static void d_AES_SetParamCcm(uint8_t direction)
                         194 --165: {
                         195 --166:     g_ctx2_state = USE_CTX2;
                         196 --167:     /* Set ICUM_AESCTRL register */
                         197 --168: #if defined(TARGET_DEVICE_S4X) || defined(TARGET_DEVICE_V4H)
                         198 --169:     UNLOCK_REG_PROT(ICUMX_CTLREGICUMX_PERIREGPROT);
                         199 --170: #endif
                         200 --171:     ICUM_AESCTRL = (ICUM_AESCTRL & ~(RST2)) |
                         201 --172:                      /* Set 1 : Initialize KEY_2, IV_CTR_2, GHASH_2, SubKEY_2 */
                         202 --173:                       (PRM_RST2_INIT);
                         203 --174: #if defined(TARGET_DEVICE_S4X) || defined(TARGET_DEVICE_V4H)
                         204 --175:     D_AES_WAIT_REG_VALUE(PRM_RST2_INIT, ICUM_AESCTRL, RST2);
                         205 --176:     LOCK_REG_PROT(ICUMX_CTLREGICUMX_PERIREGPROT);
                         206 --177: #endif
                         207 --179:     /* Set ICUM_AESCCTL1 register */
                         208 --180:     ICUM_AESCCTL1 = (ICUM_AESCCTL1 & ~(K2SEL | MOD2)) |
                         209 --181:                      /* Set 000 : AES0.DIDi [i = 0 to 3] is set */
                         210 --182:                       (PRM_K2SEL_PLAIN
                         211 --183:                      /* context #2. CCM mode */
                         212 --184:                      | PRM_MOD2_CCM);
                         213 --186:     if (D_AES_DIR_ENCRYPTION == (uint32_t)direction)
                         214 --187:     {
                         215 --188:         ICUM_AESCCTL1 = (ICUM_AESCCTL1 & ~(ENCMODE2)) |
                         216 --189:                          /* Set 0 : ENCRYPTION MODE */
                         217 --190:                           (PRM_ENCMODE2_ENC);
                         218 --191:     }
                         219 --192:     else
                         220 --193:     {
                         221 --194:         ICUM_AESCCTL1 = (ICUM_AESCCTL1 & ~(ENCMODE2)) |
                         222 --195:                          /* Set 1 : DECRYPTION MODE */
                         223 --196:                           (PRM_ENCMODE2_DEC);
                         224 --197:     }
                         225 --199:     /* Set ICUM_AESCTRL register */
                         226 --200:     ICUM_AESCTRL = (ICUM_AESCTRL & ~(CTX | BYTE_ORDER | DATREGSW)) |
                         227 --201:                      /* Set 010 : context #2 */
                         228 --202:                       (PRM_CTX_2
                         229 --203:                      /* Set 0 : Convert byte order */
                         230 --204:                      | PRM_BYTE_ORDER_APPLY
                         231 --205:                      /* Set 1 : Use AES0DIDi/AES0DODi */
                         232 --206:                      | PRM_DATREGSW_DIDI_DODI);
                         233 --207: }

                                                                      Page 5
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000130g1.si
