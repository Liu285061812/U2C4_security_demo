                          79 --39: /* Number of resources for soft timer */
                          80 --40: #define NUMBER_OF_SOFT_TIMER    ((uint32_t)8U)
                          81 --42: /* Released the resource of soft timer */
                          82 --43: #define RELEASED_SOFT_TIMER     ((uint32_t)0UL)
                          83 --45: /* H - Bus clock Slowest value (25MHz) */
                          84 --46: #define CLK_HBUS                ((uint32_t)(25UL*1000UL*1000UL))
                          85 --48: /* ICUM_OSTMn Unit Clock Name */
                          86 --49: #define PCLK                    (CLK_HBUS)
                          87 --51: /* 10m secs is 100Hz */
                          88 --52: #define F_100HZ                 ((uint32_t)(100UL))
                          89 --54: /* Number of counts for 10m sec */
                          90 --55: #define COUNT_10M_SEC_FOR_ERR   (PCLK/F_100HZ)
                          91 --57: #define INTRRUPT_INTERVAL_M_SEC ((uint32_t)10UL)
                          92 --59: /* Value when counter is Stopped  */
                          93 --60: #define OVER_COUNTER            ((uint32_t)0xffffffffUL)
                          94 --62: /* Stops the counter and clears the REG_ICUM_OSTM0.TE.OSTMnTE bit */
                          95 --63: #define STOP_TRIGGER            ((uint8_t)0x01U)
                          96 --65: /* Starts the counter and sets REG_ICUM_OSTM0.TE.OSTMnTE = 1 */
                          97 --66: #define START_TRIGGER           ((uint8_t)0x01U)
                          98 --68: /* OSTM0MD1 = 1:Freerun mode */
                          99 --69: #define FREERUN_MODE            ((uint8_t)0x02U)
                         100 --71: /* Invalid soft timer id (0) */
                         101 --72: #define INVALID_ID              (0UL)
                         102 --74: /* First id of soft timer */
                         103 --75: #define FIRST_ID                (1UL)
                         104 --77: /*  */
                         105 --78: #define OST_ZERO                (0UL)
                         106 --80: /* Indicate soft timer is running. */
                         107 --81: #define SOFT_TIMER_RUN          ((uint8_t)true)
                         108 --83: /* Indicate soft timer is stopped. */
                         109 --84: #define SOFT_TIMER_STOP         ((uint8_t)false)
