                         155 --104:     /* ICUM_ICWDTA0 = 7: EI Level Interrupt Control Registers
                         156 --105:         bit15 CTxxx This bit indicates an interrupt channel type. This bit is read only.
                         157 --106:             * 0: Detection in synchronization with an edge is currently selected.
                         158 --107:               1: Detection of the high level is currently selected.
                         159 --108:         bit12 RFxxx
                         160 --109:             * 0: No interrupt request is made.
                         161 --110:               1: Interrupt request is made.
                         162 --111:         bit7 MKxxx This is an interrupt request mask bit.
                         163 --112:             * 0: Enables interrupt processing
                         164 --113:               1: Disables interrupt processing
                         165 --114:         bit6 TBxxx This bit is used to select the way to determine the interrupt vector
                         166 --115:             * 0: Direct jumping to an address determined from the level of priority
                         167 --116:               1: Referencing a table
                         168 --117:         bit2 to 0 = 7 These bits specify the interrupt priority as one of 8 levels,
