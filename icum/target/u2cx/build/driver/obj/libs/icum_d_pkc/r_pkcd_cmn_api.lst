                         531 --207: /**********************************************************************************************************************
                         532 --208: * Function Name : r_pkcd_cmn_cpy_by_64bounds
                         533 --209: **********************************************************************************************************************/
                         534 --210: /*!****************************************************************************************************************//**
                         535 --211:  * \ingroup     PKCDCommonAPIsInternal
                         536 --212:  * \brief       Copy data from/to #PKCD_CMN_PKCCRAM to/from external memory.
                         537 --213:  * \param       [out] p_dest      A destination address which points 32bits alignment
                         538 --214:  * \param       [in]  p_src       A source address which points 32bit alignment
                         539 --215:  * \param       [in]  len         Copying length in bytes, which must be multiple of 4.
                         540 --216:  * \return
                         541 --217:  *  - None
                         542 --218:  * \par Security components
                         543 --219:  *  - No
                         544 --220:  * \par Global Variables
                         545 --221:  *  - None
                         546 --222:  * \par Registers Used
                         547 --223:  *  - None
                         548 --224:  * \par Precondition
                         549 --225:  *  - None
                         550 --226:  * \par Detailed description
                         551 --227:  *  - Copy data from/to #PKCD_CMN_PKCCRAM to/from external memory, <br>
                         552 --228:  *    so that it can follow the #PKCD_CMN_PKCCRAM data arragement spec.
                         553 --229:  *  - A data on external RAM is considered as a big endian binary, <br>
                         554 --230:  *    and a data on #PKCD_CMN_PKCCRAM is considered as <br>
                         555 --231:  *    a bigendian sequence of 64bit units which endianness is little.
                         556 --232:  * \par Remarks
                         557 --233:  *  - None
                         558 --234:  *
                         559 --235:  * Pseudo-code for the function can be found below.
                         560 --236:  * -# if src is #PKCD_CMN_PKCCRAM and dest is #PKCD_CMN_PKCCRAM then
                         561 --237:  *   -# Set src's swap of 4-byte units value
                         562 --238:  *   -# Set dest's swap of 4-byte units value
                         563 --239:  *   -# Loop while i is less than len<br>
                         564 --240:  *      Add 4 to i for each loop
                         565 --241:  *     -# Copy src to dest in word unit considering swap
                         566 --242:  *     -# Increment src and dest to next word
                         567 --243:  *     -# Reverse swap sign
                         568 --244:  * -# else if src is #PKCD_CMN_PKCCRAM and dest is external RAM
                         569 --245:  *   -# Set src's swap of 4-byte units value
                         570 --246:  *   -# Loop while i is less than len<br>
                         571 --247:  *      Add 4 to i for each loop
                         572 --248:  *     -# Copy src which converted endianness considering swap to word dest in word units
                         573 --249:  *     -# Increment src and dest to next word
                         574 --250:  *     -# Reverse swap sign
                         575 --251:  * -# else if src is external RAM and dest is #PKCD_CMN_PKCCRAM
                         576 --252:  *   -# Set dest's swap of 4-byte units value
                         577 --253:  *   -# Loop while i is less than len<br>
                         578 --254:  *      Add 4 to i for each loop
                         579 --255:  *     -# Copy src which converted endianness considering swap to word dest in word units
                         580 --256:  *     -# Increment src and dest to next word
                         581 --257:  *     -# Reverse swap sign
                         582 --258:  * -# else
                         583 --259:  *   -# Copy with #r_pkcd_cmn_cpy_word()
                         584 --260:  * -# Return
                         585 --261:  *
                         586 --262:  * \callgraph
                         587 --263:  *********************************************************************************************************************/

                                                                      Page 11
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00002pc1.si
