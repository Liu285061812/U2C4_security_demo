                        1930 --759:  *      #PKCD_CMN_ICUM_PKCCB0CR is 1
                        1931 --760:  *     -# Increment timeout_cnt
                        1932 --761:  *   -# If #PKCD_CMN_PKCD_OPE_TIMEOUT > timeout_cnt
                        1933 --762:  *     -# If #PKCD_CMN_ICUM_PKCCB0STR == 1 is true, set ret to #PKCD_RET_OK, otherwise set ret to #PKCD_RET_PKCCERR
                        1934 --763:  *   -# Else
                        1935 --764:  *     -# Set ret to #PKCD_RET_PKCCTIMEOUTERR
                        1936 --765:  * -# Else
                        1937 --766:  *   -# Set async operation flag with the #r_pkcd_cmn_set_async_ope
                        1938 --767:  *   -# The BEME bit of the register #PKCD_CMN_ICUM_PKCCB0CR is set to 1
                        1939 --768:  *   -# The PKCSTRT bit of the register #PKCD_CMN_ICUM_PKCCB0CR is set to 1
                        1940 --769:  *   -# Set ret to #PKCD_RET_OK
                        1941 --770:  * -# Return ret
