                        2891 --1290: * Function Name : r_pkcd_ecdhx_precalc_params
                        2892 --1291: **********************************************************************************************************************/
                        2893 --1292: /*!*********************************************************************************************************************
                        2894 --1293:  * \ingroup     PKCDECDHXAPIsInternal
                        2895 --1294:  * \brief       Prepare pre-calculation values.
                        2896 --1295:  * \param       [in] p_prm     Parameters to be calculated
                        2897 --1296:  * \return
                        2898 --1297:  *  - #PKCD_RET_OK:                       Successfully done.
                        2899 --1298:  *  - #PKCD_RET_INTERNALERR:              Internal processing failed.
                        2900 --1299:  *  - #PKCD_RET_PKCCTIMEOUTERR:           PKCC operation timeouted
                        2901 --1300:  *  - #PKCD_RET_PKCCERR:                  An error occurred while the PKCC operations.
                        2902 --1301:  * \par Security components
                        2903 --1302:  *  - No
                        2904 --1303:  * \par Global Variables
                        2905 --1304:  *  - #PKCD_ECDHX_WWORK, #PKCD_ECDHX_PBYTES, #PKCD_ECDHX_OFFSET_VAL, #PKCD_ECDHX_PWORK,
                        2906 --1305:  *    #PKCD_ECDHX_WORK1, #PKCD_ECDHX_R2WORK, #PKCD_ECDHX_PDT_P, #PKCD_ECDHX_WORKUNIT
                        2907 --1306:  *    #PKCD_ECDHX_A24RWORK, #PKCD_ECDHX_X1RWORK, #PKCD_ECDHX_X2RWORK, #PKCD_ECDHX_X3RWORK,
                        2908 --1307:  *    #PKCD_ECDHX_Z3RWORK, #PKCD_ECDHX_WORK2
                        2909 --1308:  * \par Registers Used
                        2910 --1309:  *  - #PKCD_CMN_ICUM_PKCCB0DPW
                        2911 --1310:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,
                        2912 --1311:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB,
                        2913 --1312:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPT (Used by sub functions)
                        2914 --1313:  * \par Precondition
                        2915 --1314:  *  - #PKCD_ECDHX_OFFSET_VAL, #PKCD_ECDHX_PBYTES must have been prepared.
                        2916 --1315:  * \par Detailed description
                        2917 --1316:  *      - Prepare pre-calculation values.
                        2918 --1317:  *      - Calculate T = -p^(-1), a24*R and initial values of x1*R, x2*R, x3*R, z3*R.
                        2919 --1318:  *
                        2920 --1319:  * Pseudo-code for the function can be found below.
                        2921 --1320:  *  -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        2922 --1321:  *  -# Set #PKCD_ECDHX_WWORK address as the top of PKCC DPW area.
                        2923 --1322:  *  -# Set the size of field p as the PKCC DL and BDL value.
                        2924 --1323:  *  -# Calculate (p_prm->point.u - p) with #r_pkcd_cmn_AMinusB.
                        2925 --1324:  *  -# If (p_prm->point.u - p) >= 0 then
                        2926 --1325:  *    -# Set (p_prm->point.u - p) into p_prm->point.u.
                        2927 --1326:  *  -# Copy the field of the given curve p to #PKCD_ECDHX_PWORK area.
                        2928 --1327:  *  -# Copy a24 to the work area #PKCD_ECDHX_WORK1.
                        2929 --1328:  *  -# Calculate {T over p} = -1/p mod 2^64 with #r_pkcd_cmn_MinusCInv and set ret to the return value.
                        2930 --1329:  *  -# Calculate R^2 mod p with #r_pkcd_cmn_R2ModC and add the return value to ret.
                        2931 --1330:  *  -# Set R^2 mod p into the work area #PKCD_ECDHX_R2WORK with #r_pkcd_cmn_cpy_by_64bounds.
                        2932 --1331:  *  -# Calculate a24*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        2933 --1332:  *  -# Set a24*R mod p into work area #PKCD_ECDHX_A24RWORK with #r_pkcd_cmn_cpy_by_64bounds.
                        2934 --1333:  *  -# Calculate x1*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        2935 --1334:  *  -# Set x1*R mod p into work area #PKCD_ECDHX_X1RWORK with #r_pkcd_cmn_cpy_by_64bounds.
                        2936 --1335:  *  -# Calculate x2*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        2937 --1336:  *  -# Set x2*R mod p into work area #PKCD_ECDHX_X2RWORK with #r_pkcd_cmn_cpy_by_64bounds.
                        2938 --1337:  *  -# Set x3*R mod p into work area #PKCD_ECDHX_X3RWORK with #r_pkcd_cmn_cpy_word.
                        2939 --1338:  *  -# Set z3*R mod p into work area #PKCD_ECDHX_Z3RWORK with #r_pkcd_cmn_cpy_word.
                        2940 --1339:  *  -# Extract the return value with #r_pkcd_cmn_extract_result Sand set ret to it.
                        2941 --1340:  *  -# Return ret
                        2942 --1341:  *
                        2943 --1342:  * \callgraph
                        2944 --1343:  *********************************************************************************************************************/
                        2945 --1344: static pkcd_ret_t r_pkcd_ecdhx_precalc_params(st_ecdhx_smult_buffer_t* const p_prm)
                        2946 	.align	2

