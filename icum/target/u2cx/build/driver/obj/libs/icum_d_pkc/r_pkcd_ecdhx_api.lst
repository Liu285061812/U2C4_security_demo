                        1672 --719: /*!****************************************************************************************************************//**
                        1673 --720:  * \ingroup     PKCDECDHXAPIsInternal
                        1674 --721:  * \brief       #R_PKCD_EcdhXKeyWrap argument check function.
                        1675 --722:  * \param       [in] p_ctx              A pointer to a structure that summarizes the parameters required by X25519.
                        1676 --723:  * \param       [in] p_buf              A buffer used for internal processing of PKC-Driver.
                        1677 --724:  * \param       [in] p_priv_key_raw     Byte array of scalar data.
                        1678 --725:  * \param       [in] p_pub_key_raw      Byte array of u-coordinate data.
                        1679 --726:  * \param       [in] p_priv_key         A driver-dependent format of a private key structure.
                        1680 --727:  * \param       [in] p_pub_key          A driver-dependent format of a public key structure.
                        1681 --728:  * \return
                        1682 --729:  *  - #PKCD_RET_OK:                       Successfully done.
                        1683 --730:  *  - #PKCD_RET_INTERNALERR:              Internal processing failed.
                        1684 --731:  *  - #PKCD_RET_PARAMERR:                 NULL arguments entered.
                        1685 --732:  *  - #PKCD_RET_LENGTHERR:                Invalid curve length entered.
                        1686 --733:  *  - #PKCD_RET_KEY_PARAMERR:             A driver-dependent format of key data including invalid parameters entered.
                        1687 --734:  * \par Security components
                        1688 --735:  *  - No
                        1689 --736:  * \par Global Variables
                        1690 --737:  *  - None
                        1691 --738:  * \par Registers Used
                        1692 --739:  *  - None
                        1693 --740:  * \par Precondition
                        1694 --741:  *  - None
                        1695 --742:  * \par Detailed description
                        1696 --743:  *  - Check the arguments received by the #r_pkcd_ec_key_wrap function.
                        1697 --744:  *  - Call #r_pkcd_ecdhx_chk_priv_scalar to check the argument p_priv_key_raw.
                        1698 --745:  *  - Call #r_pkcd_ecdhx_chk_point to check the argument p_pub_key_raw.
                        1699 --746:  * \par Remarks
                        1700 --747:  *  - None
                        1701 --748:  *
                        1702 --749:  * Pseudo-code for the function can be found below.
                        1703 --750:  *  -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        1704 --751:  *  -# If (NULL != p_ctx) and (NULL != p_buf) and (NULL != p_priv_key) and (NULL != p_pub_key)
                        1705 --752:  *    -# If (NULL != p_ctx->p_curve_info)
                        1706 --753:  *      -# If p_ctx->p_curve_info->curve_len is equal to curve length of curve25519
                        1707 --754:  *        -# Set ret to #PKCD_RET_OK
                        1708 --755:  *      -# Else
                        1709 --756:  *        -# Set ret to #PKCD_RET_LENGTHERR.
                        1710 --757:  *    -# Else
                        1711 --758:  *      -# Set ret to #PKCD_RET_PARAMERR.
                        1712 --759:  *    -# If (#PKCD_RET_OK == ret)
                        1713 --760:  *      -# Check the argument p_priv_key_raw with #r_pkcd_ecdhx_chk_priv_scalar, and set ret to the return value.
                        1714 --761:  *      -# If #PKCD_RET_OK == ret
                        1715 --762:  *        -# Check the argument p_pub_key_raw with #r_pkcd_ecdhx_chk_point, and set ret to the return value.
                        1716 --763:  *  -# Else
                        1717 --764:  *    -# Set ret to #PKCD_RET_PARAMERR.
                        1718 --765:  *  -# If #PKCD_RET_OK == ret
                        1719 --766:  *    -# If a pointer to the private key in the argument p_priv_key is not NULL,
                        1720 --767:  *       and a pointer to the public key in the argument p_priv_key is not NULL
                        1721 --768:  *      -# If a pointer to the publuc key is not NULL
                        1722 --769:  *        -# Do nothing.
                        1723 --770:  *      -# Else
                        1724 --771:  *        -# Set ret to #PKCD_RET_PARAMERR.
                        1725 --772:  *    -# Else
                        1726 --773:  *      -# Set ret to #PKCD_RET_PARAMERR.
                        1727 --774:  *  -# Return ret
                        1728 --775:  *
                        1729 --776:  * \callgraph
                        1730 --777:  *********************************************************************************************************************/
                        1731 --778: static pkcd_ret_t r_pkcd_ecdhx_chk_key_wrap_arg(const st_pkc_ecdhx_ctx_t* const p_ctx,
