                        1302 --564: **********************************************************************************************************************/
                        1303 --565: /*!****************************************************************************************************************//**
                        1304 --566:  * \ingroup     PKCDECDHXAPIsInternal
                        1305 --567:  * \brief       #R_PKCD_EcScalarMultInit argument check function.
                        1306 --568:  * \param       [in]   p_scalar_or_privkey      A scalar value or a driver-dependent format of a private key.
                        1307 --569:  * \param       [in]   p_point_or_pubkey        An u-coordinate value or a driver-dependent format of a public key.
                        1308 --570:  * \param       [in]   p_ctx                    A pointer to a structure that summarizes parameters required by X25519.
                        1309 --571:  * \param       [in]   p_buf                    A Buffer used for internal processing of PKC-Driver
                        1310 --572:  * \return
                        1311 --573:  *  - #PKCD_RET_OK:                       Successfully done.
                        1312 --574:  *  - #PKCD_RET_INTERNALERR:              Internal processing failed.
                        1313 --575:  *  - #PKCD_RET_PARAMERR:                 NULL arguments entered.
                        1314 --576:  *  - #PKCD_RET_LENGTHERR:                Invalid argument length entered.
                        1315 --577:  *  - #PKCD_RET_KEY_PARAMERR:             A driver-dependent format of key data including invalid parameters entered
                        1316 --578:  *  - #PKCD_RET_KEY_LENGTHERR:            A driver-dependent format of key data including invalid key length entered
                        1317 --579:  * \par Security components
                        1318 --580:  *  - No
                        1319 --581:  * \par Global Variables
                        1320 --582:  *  - None

                                                                      Page 24
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000120g1.si
                        1321 --583:  * \par Registers Used
                        1322 --584:  *  - None
                        1323 --585:  * \par Precondition
                        1324 --586:  *  - None
                        1325 --587:  * \par Detailed description
                        1326 --588:  *  - Check the arguments received by the #R_PKCD_EcdhXScalarMultInit function.
                        1327 --589:  *  - Call #r_pkcd_ecdhx_chk_curve_info to check the curve information of p_ctx.
                        1328 --590:  *  - Call #r_pkcd_ecdhx_chk_priv_key to check a given private key in the argument p_scalar_or_privkey.
                        1329 --591:  *  - Call #r_pkcd_ecdhx_chk_priv_scalar to check a given scalar value in the argument p_scalar_or_privkey.
                        1330 --592:  *  - Call #r_pkcd_ecdhx_chk_pub_key to check a given public key in the argument p_point_or_pubkey.
                        1331 --593:  *  - Call #r_pkcd_ecdhx_chk_point to check a given u-coordinate value in the argument p_point_or_pubkey.
                        1332 --594:  * \par Remarks
                        1333 --595:  *  - None
                        1334 --596:  *
                        1335 --597:  * Pseudo-code for the function can be found below.
                        1336 --598:  *  -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        1337 --599:  *  -# If (NULL != p_scalar_or_privkey) and (NULL != p_point_or_pubkey)
                        1338 --600:  *     and (NULL != p_ctx) and (NULL != p_buf)
                        1339 --601:  *      -# Check the curve information with #r_pkcd_ecdhx_chk_curve_info,
                        1340 --602:  *         and set ret to the result.
                        1341 --603:  *      -# If (#PKCD_RET_OK == ret)
                        1342 --604:  *        -# If (#PKC_DATA_TYPE_KEY_BINARY == p_scalar_or_privkey->data_type)
                        1343 --605:  *          -# If (NULL != p_scalar_or_privkey->p_sel_data)
                        1344 --606:  *            -# Check if given private key binary is valid with #r_pkcd_ecdhx_chk_priv_key,
                        1345 --607:  *               and set ret to the result.
                        1346 --608:  *          -# Else
                        1347 --609:  *            -# Set ret to #PKCD_RET_PARAMERR.
                        1348 --610:  *        -# Else if (#PKC_DATA_TYPE_BYTE == p_scalar_or_privkey->data_type)
                        1349 --611:  *          -# Check if given private scalar is valid with #r_pkcd_ecdhx_chk_priv_scalar,
                        1350 --612:  *             and set ret to the result.
                        1351 --613:  *        -# Else
                        1352 --614:  *          -# Set ret to #PKCD_RET_PARAMERR.
                        1353 --615:  *        -# If (#PKCD_RET_OK == ret)
                        1354 --616:  *          -# If (#PKC_DATA_TYPE_KEY_BINARY == p_point_or_pubkey->data_type)
                        1355 --617:  *            -# If (NULL != p_point_or_pubkey->p_sel_data)
                        1356 --618:  *              -# Check if given public key binary is valid with #r_pkcd_ecdhx_chk_pub_key,
                        1357 --619:  *                 and set ret to the result.
                        1358 --620:  *            -# Else
                        1359 --621:  *              -# Set ret to #PKCD_RET_PARAMERR.
                        1360 --622:  *          -# Else if (#PKC_DATA_TYPE_BYTE == p_point_or_pubkey->data_type)
                        1361 --623:  *            -# Check if given public point data is valid with #r_pkcd_ecdhx_chk_point,
                        1362 --624:  *               and set ret to the result.
                        1363 --625:  *          -# Else
                        1364 --626:  *            -# Set ret to #PKCD_RET_PARAMERR.
                        1365 --627:  *  -# Else
                        1366 --628:  *      -# Set ret to #PKCD_RET_PARAMERR.
                        1367 --629:  *  -# Return ret
                        1368 --630:  *
                        1369 --631:  * \callgraph
                        1370 --632:  *********************************************************************************************************************/
                        1371 --633: static pkcd_ret_t r_pkcd_ecdhx_chk_scalar_mult_init_arg(const st_pkc_select_data_t* const p_scalar_or_privkey,
