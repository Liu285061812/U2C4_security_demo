                        3557 --1497: /*!*********************************************************************************************************************
                        3558 --1498:  * \ingroup     PKCDECDHXAPIsInternal
                        3559 --1499:  * \brief       Performs scalar multiplication of the point on curve25519.
                        3560 --1500:  * \param       [in]  p_point_out           The address of an multiplying point P1(X1, Y1, Z1).
                        3561 --1501:  * \param       [in]  p_scalar              The address of a scalar value.
                        3562 --1502:  * \param       [in]  p_works               The address of a work area structure which contains 3 work area addresses.
                        3563 --1503:  * \param       [in]  processing_bits       The number of bits to be processed.
                        3564 --1504:  * \param       [in,out]  p_executed_bits   The number of bits processed.
                        3565 --1505:  * \return
                        3566 --1506:  *  - #PKCD_RET_OK:                  Successfully done.
                        3567 --1507:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        3568 --1508:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        3569 --1509:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        3570 --1510:  * \par Security components
                        3571 --1511:  *  - No
                        3572 --1512:  * \par Global Variables
                        3573 --1513:  *  - #PKCD_ECDHX_PBYTES, #PKCD_ECDHX_PWORK, #PKCD_ECDHX_WORK1, #PKCD_ECDHX_WORK2,#PKCD_ECDHX_WORK3,
                        3574 --1514:  *    #PKCD_ECDHX_X2RWORK, #PKCD_ECDHX_X3RWORK, #PKCD_ECDHX_Z2RWORK, #PKCD_ECDHX_Z3RWORK,
                        3575 --1515:  *    #PKCD_ECDHX_WORKUNIT, #PKCD_ECDHX_OFFSET_VAL
                        3576 --1516:  * \par Registers Used
                        3577 --1517:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,
                        3578 --1518:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB,
                        3579 --1519:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
                        3580 --1520:  * \par Precondition
                        3581 --1521:  *  - #PKCD_ECDHX_PBYTES, #PKCD_ECDHX_PDT_P, #PKCD_ECDHX_PWORK, #PKCD_ECDHX_OFFSET_VAL must have been prepared.
                        3582 --1522:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW, #PKCD_CMN_ICUM_PKCCB0DPT
                        3583 --1523:  *    and DPT value must have been set beforehand.
                        3584 --1524:  * \par Detailed description
                        3585 --1525:  *      - Performs scalar multiplication of the point on curve25519.
                        3586 --1526:  * \par Remarks
                        3587 --1527:  *  - None
                        3588 --1528:  *
                        3589 --1529:  * Pseudo-code for the function can be found below. Some values are represented in Montgomery format.
                        3590 --1530:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        3591 --1531:  * -# If p_executed_bits == 0 ,then
                        3592 --1532:  *   -# Set 0 into #PKCD_ECDHX_SWAP.
                        3593 --1533:  * -# Set p_executed_bits into the start bit index to be processed on this execution.
                        3594 --1534:  * -# If (p_executed_bits + processing_bits) < (the total number of bits to be processed) then
                        3595 --1535:  *   -# Set (p_executed_bits + processing_bits) into the last bit index to be processed on this execution.
                        3596 --1536:  * -# Else
                        3597 --1537:      -# Set (the total number of bits to be processed) into the last bit index to be processed on this execution.
                        3598 --1538:  * -# For the bits between the start bit index and the last bit index of the given scalar, do the following
                        3599 --1539:  *   -# Acquire the bit k_t in p_scalar which corresponds to the loop index and set it into #PKCD_ECDHX_SWAP.
                        3600 --1540:  *   -# Swap x2 and x3 with #r_pkcd_ecdhx_cswap when #PKCD_ECDHX_SWAP == 1, and add the return value to ret.
                        3601 --1541:  *   -# Swap z2 and z3 with #r_pkcd_ecdhx_cswap when #PKCD_ECDHX_SWAP == 1, and add the return value to ret.
                        3602 --1542:  *   -# Set the bit k_t into #PKCD_ECDHX_SWAP.
                        3603 --1543:  *   -# Perform the scalar manipulation.
                        3604 --1544:  * -# Set the last bit index into p_executed_bits
                        3605 --1545:  * -# If #PKCD_RET_OK == ret then
                        3606 --1546:  *   -# If p_executed_bits is not equal to the nuber of total number of bits to be processed then
                        3607 --1547:  *     -# Add #PKCD_RET_PROCESSING to ret
                        3608 --1548:  *   -# Else
                        3609 --1549:  *     -# Swap x2*R and x3*R with #r_pkcd_ecdhx_cswap when #PKCD_ECDHX_SWAP == 1, and add the return value to ret.
                        3610 --1550:  *     -# Swap z2*R and z3*R with #r_pkcd_ecdhx_cswap when #PKCD_ECDHX_SWAP == 1, and add the return value to ret.
                        3611 --1551:  *     -# Clear the work area to be used in the following operation with #r_pkcd_cmn_ram_clr.
                        3612 --1552:  *     -# Calculate p-2 with #r_pkcd_cmn_AMinusBModC and add the return value to ret.

                                                                      Page 63
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_000120g1.si
                        3613 --1553:  *     -# Calculate z2 = (z2*R)*(R^(-1)) with #r_pkcd_cmn_ARInvModC and add the return value to ret
                        3614 --1554:  *     -# Calculate z2^(p-2) mod p with #r_pkcd_cmn_AExpBModCCon and add the return value to ret.
                        3615 --1555:  *     -# Calculate x2*(z2^(p-2)) mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        3616 --1556:  *     -# Calculate with #r_pkcd_cmn_ARInvModC and add the return value to ret.
                        3617 --1557:  * -# Extract the return value with r_pkcd_cmn_extract_result.
                        3618 --1558:  * -# Return ret
                        3619 --1559:  *
