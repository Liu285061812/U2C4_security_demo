                        4056 --1652: /*!*********************************************************************************************************************
                        4057 --1653:  * \ingroup     PKCDECDHXAPIsInternal
                        4058 --1654:  * \brief       Performs scalar multiplication of the point on curve25519.<br>
                        4059 --1655:  *              Called at the for-loop in #r_pkcd_ecdhx_point_smult.
                        4060 --1656:  * \param       [in]  p_works           The address of a work area structure which contains 3 work area addresses.
                        4061 --1657:  * \return
                        4062 --1658:  *  - #PKCD_RET_OK:                  Successfully done.
                        4063 --1659:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        4064 --1660:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        4065 --1661:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        4066 --1662:  * \par Security components
                        4067 --1663:  *  - No
                        4068 --1664:  * \par Global Variables
                        4069 --1665:  *  - #PKCD_ECDHX_PWORK, #PKCD_ECDHX_WORKUNIT, #PKCD_ECDHX_ARWORK, #PKCD_ECDHX_A2RWORK,
                        4070 --1666:  *    #PKCD_ECDHX_BRWORK, #PKCD_ECDHX_B2RWORK, #PKCD_ECDHX_ERWORK, #PKCD_ECDHX_DARWORK,
                        4071 --1667:  *    #PKCD_ECDHX_CBRWORK, #PKCD_ECDHX_A24RWORK, #PKCD_ECDHX_X1RWORK, #PKCD_ECDHX_X2RWORK,
                        4072 --1668:  *    #PKCD_ECDHX_X3RWORK, #PKCD_ECDHX_Z2RWORK, S#PKCD_ECDHX_Z3RWORK
                        4073 --1669:  *
                        4074 --1670:  * \par Registers Used
                        4075 --1671:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,
                        4076 --1672:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB,
                        4077 --1673:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
                        4078 --1674:  * \par Precondition
                        4079 --1675:  *  - #PKCD_ECDHX_PBYTES, #PKCD_ECDHX_PDT_P, #PKCD_ECDHX_R2WORK, #PKCD_ECDHX_PWORK must have been prepared.
                        4080 --1676:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW, #PKCD_CMN_ICUM_PKCCB0DPT
                        4081 --1677:  *    and DPT value must have been set beforehand.
                        4082 --1678:  * \par Detailed description
                        4083 --1679:  *      - Operates scalar multiplication of the point on curve25519.
                        4084 --1680:  *      - Called at the for-loop in #r_pkcd_ecdhx_point_smult.
                        4085 --1681:  * \par Remarks
                        4086 --1682:  *  - None
                        4087 --1683:  *
                        4088 --1684:  * Pseudo-code for the function can be found below. Some values are represented in Montgomery format.
                        4089 --1685:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        4090 --1686:  * -# Calculate A*R = (x2 + z2)*R mod p with #r_pkcd_cmn_APlusBModC and set ret to the return value.
                        4091 --1687:  * -# Calculate AA*R = (A^2)*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4092 --1688:  * -# Calculate B*R = (x2 - z2)*R mod p with #r_pkcd_cmn_AMinusBModC and add the return value to ret.
                        4093 --1689:  * -# Calculate BB*R = (B^2)*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4094 --1690:  * -# Calculate E*R = (AA - BB)*R mod p with #r_pkcd_cmn_AMinusBModC and add the return value to ret.
                        4095 --1691:  * -# Calculate C*R = (x3 + z3)*R mod p with #r_pkcd_cmn_APlusBModC and add the return value to ret.
                        4096 --1692:  * -# Calculate D*R = (x3 - z3)*R mod p with #r_pkcd_cmn_AMinusBModC and add the return value to ret.
                        4097 --1693:  * -# Calculate DA*R = D*A*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4098 --1694:  * -# Calculate CB*R = C*B*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4099 --1695:  * -# Calculate DA*R + CB*R mod p with #r_pkcd_cmn_APlusBModC and add the return value to ret.
                        4100 --1696:  * -# Calculate x3*R = ((DA + CB)^2)*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4101 --1697:  * -# Calculate (DA - CB)*R mod p with #r_pkcd_cmn_AMinusBModC and add the return value to ret.
                        4102 --1698:  * -# Calculate ((DA - CB)^2)*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4103 --1699:  * -# Calculate z3*R = (x1*(DA - CB)^2)*R with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4104 --1700:  * -# Calculate x2*R = AA*BB*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4105 --1701:  * -# Calculate a24*E*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4106 --1702:  * -# Calculate (AA + a24*E)*R mod p with #r_pkcd_cmn_APlusBModC and add the return value to ret.
                        4107 --1703:  * -# Calculate z2*R = (E*(AA + a24*E))*R mod p with #r_pkcd_cmn_ABRInvModC and add the return value to ret.
                        4108 --1704:  * -# Extract the return value with #r_pkcd_cmn_extract_result.
                        4109 --1705:  * -# Return ret
                        4110 --1706:  *
                        4111 --1707:  * \callgraph
                        4112 --1708:  *********************************************************************************************************************/
                        4113 --1709: static pkcd_ret_t r_pkcd_ecdhx_point_smult_loop(st_ecdhx_wks_t* const p_works)
