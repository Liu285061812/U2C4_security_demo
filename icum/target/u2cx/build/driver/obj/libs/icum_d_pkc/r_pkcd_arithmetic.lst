                          73 --34: /* PRQA S 0751 ++ # D009 For commonality of functions, confirm that the size is correct and use the cast value. */
                          74 --35: /* PRQA S 0488 ++ # D007 Consider not to overrun the size of the array pointed to by the pointer.*/
                          75 --36: /* PRQA S 1532 ++ # D014 Since files are grouped by function, they are called from different files. */
                          76 --37: /* PRQA S 2981 ++ # D020 Local variable ret of APIs sets INTERNALERR to the initial value
