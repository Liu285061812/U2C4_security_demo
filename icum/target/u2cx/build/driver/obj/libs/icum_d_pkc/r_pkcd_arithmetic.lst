                        2278 --833: /**********************************************************************************************************************
                        2279 --834: * Function Name : r_pkcd_cmn_reduce_small_modulus
                        2280 --835: **********************************************************************************************************************/
                        2281 --836: /*!****************************************************************************************************************//**
                        2282 --837:  * \ingroup     PKCDCommonAPIsInternal
                        2283 --838:  * \brief       Calculates remainder of double size value
                        2284 --839:  * \param       [in] p_a           An address of divident. Must be aligned to a 4 byte boundary.
                        2285 --840:  * \param       [in] p_wk_mod      An address of work area where modulus is set. <br>
                        2286 --841:  *                                 The data must be aligned with bottom.
                        2287 --842:  * \param       [in] p_wk_r2mod    An address of work area where R^2 mod modulus is set. <br>
                        2288 --843:  *                                 The data must be aligned with bottom.
                        2289 --844:  * \param       [in] a_size        Byte length of a
                        2290 --845:  * \param       [in] mod_size      Byte length of modulus, make it the same value as the DL size set in PKCC.
                        2291 --846:  * \param       [in] wk_size       Byte length of work area
                        2292 --847:  * \param       [in] p_wk1         An address of work area
                        2293 --848:  * \param       [in] p_wk2         An address of work area
                        2294 --849:  * \param       [out] wk_out       An address of work area to output
                        2295 --850:  * \return
                        2296 --851:  *  - #PKCD_RET_OK:                  Successfully done.
                        2297 --852:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        2298 --853:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted.
                        2299 --854:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        2300 --855:  * \par Security components
                        2301 --856:  *  - No
                        2302 --857:  * \par Global Variables
                        2303 --858:  *  - None
                        2304 --859:  * \par Registers Used
                        2305 --860:  *  - #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, #PKCD_CMN_ICUM_PKCCB0DPC, <br>
                        2306 --861:  *    #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0OMR, <br>
                        2307 --862:  *    #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0STR (Used by sub functions)
                        2308 --863:  * \par Precondition
                        2309 --864:  *  - #PKCD_CMN_ICUM_PKCCB0DPT and its T data must have been initialized beforehand.
                        2310 --865:  * \par Detailed description
                        2311 --866:  *      - Calculates remainder of double size value.

                                                                      Page 40
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000p081.si
                        2312 --867:  *      - PKCC does not support modulo operations which modulus is too smaller than the dividend. <br>
                        2313 --868:  *        So, this function separates dividend by two parts and calculates each remainder. <br>
                        2314 --869:  *        The separation is done as follows...
                        2315 --870:  *        - a[0~N-1] = a[0~DL-1] + (2^DL) * a[DL~N-1]
                        2316 --871:  *      - And remainders are calculated over above 2 terms separately.
                        2317 --872:  *      - The remainder length must be less than 2048.
                        2318 --873:  * \par Remarks
                        2319 --874:  *  - None
                        2320 --875:  *
                        2321 --876:  * Pseudo-code for the function can be found below.
                        2322 --877:  * -# Clear p_wk1
                        2323 --878:  * -# Clear p_wk2
                        2324 --879:  * -# Set mod_size /2 to half_dl
                        2325 --880:  * -# Set little endian 0x00000001 to temp
                        2326 --881:  * -# Copy temp to the offset (wk_size - half_dl - 4) position of the p_wk1
                        2327 --882:  * -# Caluculate (DL)*R mod modulus with PKCC S = ABR^(-1) mod C
                        2328 --883:  * -# Caluculate (2^DL)*R) mod modulus with PKCC S = ABR^(-1) mod C
                        2329 --884:  * -# Set a_size - mod_size to a0_size
                        2330 --885:  * -# Set mod_size to a1_size
                        2331 --886:  * -# Clear p_wk2
                        2332 --887:  * -# Copy a to the offset (wk_size - a0_size) position of the p_wk2
                        2333 --888:  * -# Caluculate a0' = a0 * 2^DL mod modulus with PKCC S = ABR^(-1) mod C
                        2334 --889:  * -# Copy the  offset (a0_size) position of a to the offset (wk_size - a1_size) position of the p_wk1
                        2335 --890:  * -# Caluculate a1*R mod modulus with PKCC S = ABR^(-1) mod C
                        2336 --891:  * -# Caluculate a1' = a1 mod modulus with PKCC S = AR^(-1) mod C
                        2337 --892:  * -# Caluculate (a0' + a1') mod modulus with PKCC S = A + B mod C
                        2338 --893:  * -# Copy result of (a0' + a1') mod modulus to wkout
                        2339 --894:  * -# Return ret
                        2340 --895:  *
                        2341 --896:  * \callgraph
                        2342 --897:  *********************************************************************************************************************/
                        2343 --898: pkcd_ret_t r_pkcd_cmn_reduce_small_modulus(const uint8_t* const p_a, const uint8_t* const p_wk_mod,
                        2344 	.align	2
                        2345 	.align	2
