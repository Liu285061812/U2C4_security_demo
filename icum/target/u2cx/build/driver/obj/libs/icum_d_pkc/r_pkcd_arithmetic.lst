                        2882 --1061:  *  - No
                        2883 --1062:  * \par Global Variables
                        2884 --1063:  *  - None
                        2885 --1064:  * \par Registers Used
                        2886 --1065:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,
                        2887 --1066:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB,
                        2888 --1067:  *    #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
