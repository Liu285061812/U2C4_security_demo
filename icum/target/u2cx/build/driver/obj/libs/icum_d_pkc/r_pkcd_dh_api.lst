                        2804 --987: /*!****************************************************************************************************************//**
                        2805 --988:  * \ingroup     PKCDDHAPIsInternal
                        2806 --989:  * \brief       Get private key
                        2807 --990:  * \param       [in]  p_extra_random   An adress of random value whose size is order q length + 8 bytes is set.
                        2808 --991:  * \param       [in]  extra_random_len The length of the extra random value in bytes.
                        2809 --992:  * \param       [in]  p_q              order q in DH parameters.
                        2810 --993:  * \param       [in]  q_len            The length of the order q value in bytes.
                        2811 --994:  * \param       [in]  p_buf            Buffer to store the value of q-1.
                        2812 --995:  *                                     Prepare in the same byte size as q.
                        2813 --996:  * \param       [out] p_priv_key       An address where the private key is output. <br>
                        2814 --997:  *                                     The length of output is equal to that of the order q.
                        2815 --999:  * \return
                        2816 --1000:  *  - #PKCD_RET_OK:                  Successfully done.
                        2817 --1001:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        2818 --1002:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        2819 --1003:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        2820 --1004:  * \par Security components
                        2821 --1005:  *  - No
                        2822 --1006:  * \par Global Variables
                        2823 --1007:  *  - None
                        2824 --1008:  * \par Registers Used
                        2825 --1009:  *  - #PKCD_CMN_ICUM_PKCCB0DPT, #PKCD_CMN_ICUM_PKCCB0DPW
                        2826 --1010:  *    #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,
                        2827 --1011:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        2828 --1012:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
                        2829 --1013:  *
                        2830 --1014:  * \par Precondition
                        2831 --1015:  *  - None.
                        2832 --1016:  * \par Detailed description
                        2833 --1017:  *  - Generate a private key according to process 6 in 5.6.1.1.3 Key-Pair Generation Using Extra Random Bits of <br>
                        2834 --1018:  *    NIST SP800-56A Revision 3. <br>
                        2835 --1019:  *    In PKC-Driver, N used in the above process is the byte length of q, so q is always chosen for M.
                        2836 --1020:  *
                        2837 --1021:  * \par Remarks
                        2838 --1022:  *  - None
                        2839 --1023:  *
                        2840 --1024:  * Pseudo-code for the function can be found below.
                        2841 --1025:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        2842 --1026:  * -# Copy p_q to p_buf.
                        2843 --1027:  * -# Subtract 1 from q set in p_buf.

                                                                      Page 50
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010es1.si
                        2844 --1028:  * -# Calculate random value mod (q-1) with #r_pkcd_cmn_reduce_even_modulus.
                        2845 --1029:  *    The result is output to p_priv_key
                        2846 --1030:  * -# If #PKCD_RET_OK == ret then
                        2847 --1031:  *   -# Loop while i is q_len or less increment i for each loop
                        2848 --1032:  *     -# If p_priv_key[q_len - i] equal #PKCD_CMN_UINT8_MAX
                        2849 --1033:  *       -# Set p_priv_key[q_len - i] to 0 and check the next byte.
                        2850 --1034:  *     -# Else
                        2851 --1035:  *       -# Add 1 to p_priv_key[q_len - i] and end the loop.
                        2852 --1036:  * -# Else
                        2853 --1037:  *   -# Do nothing.
                        2854 --1038:  * -# Return ret
                        2855 --1039:  *
                        2856 --1040:  * \callgraph
                        2857 --1041:  *********************************************************************************************************************/
