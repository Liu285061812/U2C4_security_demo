                        2520 --859: * Function Name : r_pkcd_dh_keygen_operate
                        2521 --860: **********************************************************************************************************************/
                        2522 --861: /*!****************************************************************************************************************//**
                        2523 --862:  * \ingroup     PKCDDHAPIsInternal
                        2524 --863:  * \brief       Perform a key generation.
                        2525 --864:  * \param       [in]      p_ctx            A pointer to a structure that summarizes the parameters required by DH.
                        2526 --865:  * \param       [in,out]  p_prm            Parameters to be calculated
                        2527 --866:  * \param       [in]      p_operate_opt    Indicate if the function returns while PKCC is running.
                        2528 --867:  * \return
                        2529 --868:  *  - #PKCD_RET_OK:                  Successfully done.
                        2530 --869:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        2531 --870:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        2532 --871:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        2533 --872:  * \par Security components
                        2534 --873:  *  - No
                        2535 --874:  * \par Global Variables
                        2536 --875:  *  - None
                        2537 --876:  * \par Registers Used
                        2538 --877:  *  - #PKCD_CMN_ICUM_PKCCB0DPT, #PKCD_CMN_ICUM_PKCCB0DPW
                        2539 --878:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,
                        2540 --879:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        2541 --880:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
                        2542 --881:  *
                        2543 --882:  * \par Precondition
                        2544 --883:  *  - The DH Context value must have been set beforehand.
                        2545 --884:  * \par Detailed description
                        2546 --885:  *      - Generate private key x. <br>
                        2547 --886:  *        If the order q in DH parameters is 2048 bits or less, calculate with based on the method of
                        2548 --887:  *        5.6.1.1.3 of NIST SP800-56A. <br>
                        2549 --888:  *        If q is larger than 2048bit, calculate with the following formula. <br>
                        2550 --889:  *          x = c mod q

                                                                      Page 45
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010es1.si
                        2551 --890:  *          (c is a random number equal byte length of q , and q is order q in DH parameters)
                        2552 --891:  *      - Generate public key with y = g^x mod p.
                        2553 --892:  *        g is generator in DH parameters.
                        2554 --893:  *        p is modulus in DH parameters.
                        2555 --894:  *      - A modular exponentioation use R_PKCD_DhModExpInit/Operate/Final
                        2556 --895:  * \par Remarks
                        2557 --896:  *  - None
                        2558 --897:  *
                        2559 --898:  * Pseudo-code for the function can be found below.
                        2560 --899:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        2561 --900:  * -# Initialize the variable p_buf with p_prm->pub_key.
                        2562 --901:  *    Since the buffer after p_prm->pub_key is not used in the r_pkcd_dh(2)_get_priv_key function,
                        2563 --902:  *    it is used as a temporary buffer.
                        2564 --903:  * -# Generate private key with #r_pkcd_dh_get_priv_key.
                        2565 --904:  * -# Use #r_pkcd_cmn_ram_clr to clear the value of the random number that is the private key stored in p_prm.
                        2566 --905:  * -# If #PKCD_RET_OK == ret then
                        2567 --906:  *   -# Set data type of base to #PKC_DATA_TYPE_BYTE
                        2568 --907:  *   -# Set data pointer of base to p_ctx->p_dh_param->p_g->p_data;
                        2569 --908:  *   -# Set data length of base to p_ctx->p_dh_param->p_g->len;
                        2570 --909:  *   -# Set data type of exponent to #PKC_DATA_TYPE_BYTE
                        2571 --910:  *   -# Set data pointer of exponent to p_prm->priv_key;
                        2572 --911:  *   -# Set data length of exponent to p_ctx->p_dh_param->p_q->len;
                        2573 --912:  *   -# Prepare modular exponentiation with #R_PKCD_DhModExpInit
                        2574 --913:  *   -# If #PKCD_RET_OK == ret then
                        2575 --914:  *     -# Perform modular exponentiation with #R_PKCD_DhModExpOperate
                        2576 --915:  *     -# Set p_prm->modexp_called to #PKC_BOOL_TRUE
                        2577 --916:  *   -# Else
                        2578 --917:  *     -# Do nothing.
                        2579 --918:  * -# Else
                        2580 --919:  *   -# Do nothing.
                        2581 --920:  * -# Return ret
                        2582 --921:  *
                        2583 --922:  * \callgraph
                        2584 --923:  *********************************************************************************************************************/
                        2585 --924: static pkcd_ret_t r_pkcd_dh_keygen_operate(const st_pkc_dh_ctx_t* const p_ctx,
                        2586 	.align	2
                        2587 	.align	2
                        2588 	.align	2
                        2589 ..gh.f.a.2.e.12:
                        2590 	.type	..gh.f.a.2.e.12,@object
                        2591 	.size	..gh.f.a.2.e.12,0
                        2592 	.global	_r_pkcd_dh_keygen_operate..C.3A.5Cwork.5CSW.5Cdemo.5CSecurity.5CU2C.5Cu2c_demo_project.5Cicum.5Ctarget.5Cu2cx.5Cbuild.5Cdriver.5Cobj.5Clibs.5Cicum_d_pkc.5Cr_pkcd_dh_api.
                        2593 _r_pkcd_dh_keygen_operate..C.3A.5Cwork.5CSW.5Cdemo.5CSecurity.5CU2C.5Cu2c_demo_project.5Cicum.5Ctarget.5Cu2cx.5Cbuild.5Cdriver.5Cobj.5Clibs.5Cicum_d_pkc.5Cr_pkcd_dh_api.:
