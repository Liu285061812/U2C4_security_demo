                        4460 --1592: /**********************************************************************************************************************
                        4461 --1593: * Function Name : r_pkcd_ec_scalar_mul_sec
                        4462 --1594: **********************************************************************************************************************/
                        4463 --1595: /*!****************************************************************************************************************//**
                        4464 --1596:  * \ingroup     PKCDECAPIsInternal
                        4465 --1597:  * \brief       Perform scalar multiplication for points on elliptic curves with the additive splitting
                        4466 --1598:  *              and randomizing projective coordinates.
                        4467 --1599:  * \param       [in]  p_prm          An address of a structure that contains coordinates of points on the elliptic
                        4468 --1600:  *                                   curve, a scalar, and two random data used in scalar multiplication
                        4469 --1601:  *                                   with the additive splitting and randomizing the projective coordinates.
                        4470 --1602:  * \param       [in]  p_coeff1       An address of coefficient a of curve domain
                        4471 --1603:  * \param       [in]  curve_len      A byte size of curve length.
                        4472 --1604:  * \param       [out] p_wk_xyz_out   An address of work area where the resulting point is palaced. <br>
                        4473 --1605:  *                                   The data is set at the bottom.
                        4474 --1606:  * \return
                        4475 --1607:  *  - #PKCD_RET_OK:                  Successfully done.
                        4476 --1608:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        4477 --1609:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        4478 --1610:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        4479 --1611:  * \par Security components
                        4480 --1612:  *  - No
                        4481 --1613:  * \par Global Variables
                        4482 --1614:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P, #PKCD_EC_PDT_N, #PKCD_EC_PWORK, #PKCD_EC_WORK1,
                        4483 --1615:  *    #PKCD_EC_WORK2, #PKCD_EC_WORK3, #PKCD_EC_WORK6, #PKCD_EC_R2MOD, #PKCD_EC_SCALARWORK, #PKCD_EC_ARPWORK,
                        4484 --1616:  *    #PKCD_EC_XYZWORKEXT
                        4485 --1617:  * \par Registers Used
                        4486 --1618:  *  - #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, #PKCD_CMN_ICUM_PKCCB0DPC, <br>
                        4487 --1619:  *    #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPT
                        4488 --1620:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        4489 --1621:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        4490 --1622:  * \par Precondition
                        4491 --1623:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P, #PKCD_EC_PDT_N and #PKCD_EC_PWORK
                        4492 --1624:  *    must have been prepared.
                        4493 --1625:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        4494 --1626:  * \par Detailed description
                        4495 --1627:  *  - Perform scalar multiplication for points on elliptic curves.
                        4496 --1628:  *  - Resulting point (XR, YR, ZR) are set in wk_xyx_out.
                        4497 --1629:  * \par Remarks
                        4498 --1630:  *  - None
                        4499 --1631:  *
                        4500 --1632:  * Pseudo-code for the function can be found below.

                                                                      Page 81
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
                        4501 --1633:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        4502 --1634:  * -# Initialize the variable mod_size with the curvel length rounded up to a multiple of 8.
                        4503 --1635:  * -# Set data pointer of arp_data.
                        4504 --1636:  * -# Set ##PKCD_CMN_ICUM_PKCCB0DPT to #PKCD_EC_PDT_N.
                        4505 --1637:  * -# Calculate R^2 mod n with #r_pkcd_cmn_R2ModC.
                        4506 --1638:  * -# Calculate p_prm->random_data (hereinafter referred to as rand) mod n with #r_pkcd_cmn_reduce_small_modulus,
                        4507 --1639:  *    and add the return value to ret.
                        4508 --1640:  * -# Calculate -rand mod n with r_pkcd_cmn_AMinusBModC.
                        4509 --1641:  * -# Calculate (rand + scalar) mod n with #r_pkcd_cmn_APlusBModC.
                        4510 --1642:  * -# Set #PKCD_CMN_ICUM_PKCCB0DPT to #PKCD_EC_PDT_P.
                        4511 --1643:  * -# Converte affine coordinates to projective coordinates with the #r_pkcd_ec_affine_to_proj_sec <br>
                        4512 --1644:  *    R^2 mod p is also calculated within this function.
                        4513 --1645:  * -# Calculate a*R mod p with S = ABR^(-1) mod C.
                        4514 --1646:  * -# <B>--- If #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        4515 --1647:  * -# If (#PKCD_EC_CURVE_NIST_P521_LEN != curve_len), then
                        4516 --1648:  *   -# Set DL, BDL to curve_len + 64 bits with the #r_pkcd_cmn_set_dl.
                        4517 --1649:  * -# <B>--- Endif #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        4518 --1650:  * -# Calculate (-rand mod n) * (x*Z*R, y*Z*R, Z*R) with mode #PKCD_CMN_MODE_PNTSCALARMUL of #r_pkcd_cmn_run.
                        4519 --1651:  * -# Calculate [(scalar + rand) mod n]  * (x*Z*R, y*Z*R, R) with mode #PKCD_CMN_MODE_PNTSCALARMUL of #r_pkcd_cmn_run.
                        4520 --1652:  * -# Calculate (-rand mod n) * (x*Z*R, y*Z*R, Z*R) + [(scalar + rand) mod n] * (x*Z*R, y*Z*R, Z*R)
                        4521 --1653:  *    with #r_pkcd_ec_point_add.
                        4522 --1654:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        4523 --1655:  * -# Return ret.
                        4524 --1656:  *
                        4525 --1657:  * \callgraph
                        4526 --1658:  *********************************************************************************************************************/
                        4527 --1659: static pkcd_ret_t r_pkcd_ec_scalar_mul_sec(const st_ec_prm_smult_t* const p_prm, const uint8_t* const p_coeff1,
                        4528 	.align	2
