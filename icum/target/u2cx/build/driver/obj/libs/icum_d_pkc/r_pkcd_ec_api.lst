                        6301 --2131: * Function Name : r_pkcd_ec_affine_to_proj_sec
                        6302 --2132: **********************************************************************************************************************/
                        6303 --2133: /*!****************************************************************************************************************//**
                        6304 --2134:  * \ingroup     PKCDECAPIsInternal
                        6305 --2135:  * \brief       Convert from affine coordinates to projective coordinates witn random z coordinate.
                        6306 --2136:  * \param       [in]  p_x            An address of affine x-coordinate.

                                                                      Page 114
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
                        6307 --2137:  * \param       [in]  p_y            An address of affine y-coordinate.
                        6308 --2138:  * \param       [in]  curve_len      A byte size of curve length.
                        6309 --2139:  * \param       [in]  p_random       An address of random data used for radomizing projective coordinates.
                        6310 --2140:  * \param       [out] p_wk_xyz_out   An address of work area where projective coordinates after conversion are set.
                        6311 --2141:  * \return
                        6312 --2142:  *  - #PKCD_RET_OK:                  Successfully done.
                        6313 --2143:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        6314 --2144:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        6315 --2145:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        6316 --2146:  * \par Security components
                        6317 --2147:  *  - No
                        6318 --2148:  * \par Global Variables
                        6319 --2149:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P, #PKCD_EC_PWORK, #PKCD_EC_R2MOD, #PKCD_EC_WORK1,
                        6320 --2150:  *    #PKCD_EC_WORK2, #PKCD_EC_WORK5, #PKCD_EC_WORK7, #PKCD_EC_XYZWORKEXT
                        6321 --2151:  * \par Registers Used
                        6322 --2152:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        6323 --2153:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        6324 --2154:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        6325 --2155:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        6326 --2156: * \par Precondition
                        6327 --2157:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P and #PKCD_EC_PWORK must have been prepared.
                        6328 --2158:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        6329 --2159:  * \par Detailed description
                        6330 --2160:  *  - Convert the affine coordinates of (x, y) to projective coordinates of (x*Z*R, y*Z*R, Z*R)
                        6331 --2161:  *    where Z is a random value passed by the argument p_random.
                        6332 --2162:  * \par Remarks
                        6333 --2163:  *  - None
                        6334 --2164:  *
                        6335 --2165:  * Pseudo-code for the function can be found below.
                        6336 --2166:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        6337 --2167:  * -# Set data pointer of p_wk_xyz_out
                        6338 --2168:  * -# Set #PKCD_CMN_ICUM_PKCCB0DPT to #PKCD_EC_PDT_P.
                        6339 --2169:  * -# Calculate R^2 mod p with the #r_pkcd_cmn_R2ModC, and add the return value to ret.
                        6340 --2170:  * -# <B>--- If #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        6341 --2171:  * -# If (#PKCD_EC_CURVE_NIST_P521_LEN != curve_len), then
                        6342 --2172:  *   -# Calculate R^3 mod p with #r_pkcd_cmn_ABRInvModC, and add the return value to ret.
                        6343 --2173:  *   -# Set #PKCD_EC_WORK3 to 2^64 with #r_pkcd_cmn_cpy_by_64bounds.
                        6344 --2174:  *   -# Calculate (R^2) * (2^64) mod p with #r_pkcd_cmn_ABRInvModC, and add the return value to ret.
                        6345 --2175:  * -# <B>--- Endif #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        6346 --2176:  * -# Calculate Z*R (or Z*R*2^64 if if #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1
                        6347 --2177:  *    and the curve length < #PKCD_EC_CURVE_LEN_MAX)
                        6348 --2178:  *    with the #r_pkcd_cmn_ABRInvModC, and add the return value to ret.
                        6349 --2179:  *    (Z is a random value passed by the argument p_random.)
                        6350 --2180:  * -# Calculate x*R with the #r_pkcd_cmn_ABRInvModC, and add the return value to ret.
                        6351 --2181:  * -# Calculate x*Z*R (or x*Z*R*2^64 if if #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1
                        6352 --2182:  *    and curve length < #PKCD_EC_CURVE_LEN_MAX)
                        6353 --2183:  *    with the #r_pkcd_cmn_ABRInvModC, and add the returen value to ret.
                        6354 --2184:  *    Copy the calculation result to x area of p_wk_xyz_out with #r_pkcd_cmn_cpy_by_64bounds.
                        6355 --2185:  * -# Calculate y*R with the #r_pkcd_cmn_ABRInvModC, and add the returen value to ret.
                        6356 --2186:  * -# Calculate y*Z*R (or y*Z*R*2^64 if if #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1
                        6357 --2187:  *    and the curve length < #PKCD_EC_CURVE_LEN_MAX)
                        6358 --2188:  *    with the #r_pkcd_cmn_ABRInvModC, and add the returen value to ret.
                        6359 --2189:  *    Copy the calculation result to y area of p_wk_xyz_out with #r_pkcd_cmn_cpy_by_64bounds.
                        6360 --2190:  * -# Copy Z*R (or Z*R*2^64 if if #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1
                        6361 --2191:  *    and the curve length < #PKCD_EC_CURVE_LEN_MAX)
                        6362 --2192:  *    to z area of p_wk_xyz_out with #r_pkcd_cmn_cpy_by_64bounds.
                        6363 --2193:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        6364 --2194:  * -# Return ret
                        6365 --2195:  *
                        6366 --2196:  * \callgraph
                        6367 --2197:  *********************************************************************************************************************/

                                                                      Page 115
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
