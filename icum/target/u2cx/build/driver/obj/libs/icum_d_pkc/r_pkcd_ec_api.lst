                        5201 --1843:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        5202 --1844:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        5203 --1845:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        5204 --1846:  * \par Precondition
                        5205 --1847:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_PDT_P, #PKCD_EC_PDT_N, #PKCD_EC_PWORK, #PKCD_EC_NWORK must have been prepared.
                        5206 --1848:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        5207 --1849:  * \par Detailed description
                        5208 --1850:  *  - ECDSA signature generation. <br>
                        5209 --1851:  *  - The random scalar uses the value of modulus n.
                        5210 --1852:  * \par Remarks
                        5211 --1853:  *  - None
                        5212 --1854:  *
                        5213 --1855:  * Pseudo-code for the function can be found below.
                        5214 --1856:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        5215 --1857:  * -# Initialize the variable ret2 with #PKCD_RET_INTERNALERR.
                        5216 --1858:  * -# Set #PKCD_EC_PDT_N to #PKCD_CMN_ICUM_PKCCB0DPT.
                        5217 --1859:  * -# Calculate R^2 mod n with the #r_pkcd_cmn_R2ModC.
                        5218 --1860:  * -# Calculate x * R mod n with the #r_pkcd_cmn_ABRInvModC.
                        5219 --1861:  * -# Calculate r = x mod n with the #r_pkcd_cmn_ARInvModC.
                        5220 --1862:  * -# Copy r to r area of p_sign with the #r_pkcd_cmn_cpy_by_64bounds
                        5221 --1863:  * -# Check the r is zero with #r_pkcd_cmn_cmp_zero_word and set the result to cmp_ret.
                        5222 --1864:  * -# If 0 != cmp_ret then
                        5223 --1865:  *   -# Set ret2 to #PKCD_RET_OK.
                        5224 --1866:  * -# Else
                        5225 --1867:  *   -# Set ret2 to #PKCD_RET_EC_ZERO_SIGNATURE.
                        5226 --1868:  * -# Calculate r * R mod n with the #r_pkcd_cmn_ABRInvModC.
                        5227 --1869:  * -# Calculate r * d mod n with the #r_pkcd_cmn_ABRInvModC.

                                                                      Page 94
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
                        5228 --1870:  * -# Calculate (z + r * d) mod n with the #r_pkcd_cmn_APlusBModC.
                        5229 --1871:  * -# Calculate the random scalar k inversion with #r_pkcd_ec_inverse
                        5230 --1872:  * -# Calculate R * k^(-1) mod n with the #r_pkcd_cmn_ABRInvModC.
                        5231 --1873:  * -# Set the upper n bits of digest (= z) to work area with the #r_pkcd_ec_set_digest_to_work.
                        5232 --1874:  * -# Calculate (z + r * d) mod n with the #r_pkcd_cmn_APlusBModC.
                        5233 --1875:  * -# Calculate k^(-1) mod n with the #r_pkcd_ec_inverse.
                        5234 --1876:  * -# Calculate R * k^(-1) mod n with the #r_pkcd_cmn_ABRInvModC.
                        5235 --1877:  * -# Calculate s = (z + r * d) * k^(-1) mod n with the #r_pkcd_cmn_ABRInvModC.
                        5236 --1878:  * -# Copy s to s area of p_sign with the #r_pkcd_cmn_cpy_by_64bounds
                        5237 --1879:  * -# Check the s is zero with #r_pkcd_cmn_cmp_zero_word and set the result to cmp_ret.
                        5238 --1880:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        5239 --1881:  * -# If 0 != cmp_ret then
                        5240 --1882:  *   -# Set ret2 to #PKCD_RET_OK.
                        5241 --1883:  * -# Else
                        5242 --1884:  *   -# Set ret2 to #PKCD_RET_EC_ZERO_SIGNATURE.
                        5243 --1885:  * -# If #PKCD_RET_OK == ret then
                        5244 --1886:  *   -# If #PKCD_RET_EC_ZERO_SIGNATURE != ret2 then
                        5245 --1887:  *     -# Set curve_len to p_sign->len * #PKCD_EC_SIGN_DATA_NUM.
                        5246 --1888:  *   -# Else
                        5247 --1889:  *     -# Set ret to #PKCD_RET_EC_ZERO_SIGNATURE.
                        5248 --1890:  * -# Return ret
                        5249 --1891:  *
                        5250 --1892:  * \callgraph
