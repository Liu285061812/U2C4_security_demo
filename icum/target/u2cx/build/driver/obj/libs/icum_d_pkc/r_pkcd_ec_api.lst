                       12481 --4528: /*!****************************************************************************************************************//**
                       12482 --4529:  * \ingroup      PKCDECAPIsInternal
                       12483 --4530:  * \brief        Generate a random z coordinate.
                       12484 --4531:  * \param       [in]   p_ctx          A pointer to a structure that summarizes the parameters required by EC.
                       12485 --4532:  * \param       [out]  p_out          A destination address.
                       12486 --4533:  * \return
                       12487 --4534:  *  - #PKCD_RET_OK:                     Successfully done.
                       12488 --4535:  *  - #PKCD_RET_INTERNALERR:            Internal processing failed.
                       12489 --4536:  *  - #PKCD_RET_DRBGAPIERR:             The DRBG API passed by user returned error.
                       12490 --4537:  * \par Security components
                       12491 --4538:  *  - No
                       12492 --4539:  * \par Global Variables
                       12493 --4540:  *  - None

                                                                      Page 220
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
                       12494 --4541:  * \par Registers Used
                       12495 --4542:  *  - None
                       12496 --4543:  * \par Precondition
                       12497 --4544:  *  - None
                       12498 --4545:  * \par Detailed description
                       12499 --4546:  *  - Generate a random z coordinate.
                       12500 --4547:  * \par Remarks
                       12501 --4548:  *  - None
                       12502 --4549:  *
                       12503 --4550:  * Pseudo-code for the function can be found below.
                       12504 --4551:  *  -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                       12505 --4552:  *  -# Generate random data whose length is curve_len with a DRBG API passed by a user,
                       12506 --4553:  *     and set p_out to the random data.
                       12507 --4554:  *  -# Set drv_ret to the return value of the DRBG API.
                       12508 --4555:  *  -# If (#PKCD_CMN_EXTERNAL_API_OK == drbg_ret)
                       12509 --4556:  *    -# Set ret to #PKCD_RET_OK.
                       12510 --4557:  *  -# Else
                       12511 --4558:  *    -# Set ret to #PKCD_RET_DRBGAPIERR.
                       12512 --4559:  *  -# Count the number of 0s in the upper bits of the field order p with #r_pkcd_cmn_find_msb,
                       12513 --4560:  *     and set zeros to the result.
                       12514 --4561:  *  -# Set zeros_byte to zeros / 8.
                       12515 --4562:  *  -# Set zeros_bit to zeros mod 8.
                       12516 --4563:  *  -# Loop while i is less than zeros_byte<br>
                       12517 --4564:  *     Increment i for each loop
                       12518 --4565:  *    -# Set p_out[i] to 0.
                       12519 --4566:  *  -# Set p_out[i] to (0xFF >> (zeros_bit + 1U)) & p_out[i].
                       12520 --4567:  *  -# Return ret.
                       12521 --4568:  *
                       12522 --4569:  * \callgraph
                       12523 --4570:  *********************************************************************************************************************/
