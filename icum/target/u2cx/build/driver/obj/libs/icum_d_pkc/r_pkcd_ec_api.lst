                        7501 --2507: /*!****************************************************************************************************************//**
                        7502 --2508:  * \ingroup     PKCDECAPIsInternal
                        7503 --2509:  * \brief       Calculate wR
                        7504 --2510:  * \param       [in]   p_sign_s          An address of  signature s.
                        7505 --2511:  * \param       [in]   curve_len     A byte size of curve length.
                        7506 --2512:  * \param       [out]  p_wk_wR       An address of work area to set the result of wR.  The data is set at the bottom.
                        7507 --2513:  * \return
                        7508 --2514:  *  - #PKCD_RET_OK:                  Successfully done.
                        7509 --2515:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        7510 --2516:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        7511 --2517:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        7512 --2518:  * \par Security components
                        7513 --2519:  *  - No
                        7514 --2520:  * \par Global Variables
                        7515 --2521:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_PDT_N, #PKCD_EC_NWORK,
                        7516 --2522:  *    #PKCD_EC_WORK1, #PKCD_EC_WORK2, #PKCD_EC_WORK3, #PKCD_EC_R2MOD, #PKCD_EC_SCALARWORK

                                                                      Page 136
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
                        7517 --2523:  * \par Registers Used
                        7518 --2524:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        7519 --2525:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        7520 --2526:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        7521 --2527:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        7522 --2528: * \par Precondition
                        7523 --2529:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_PDT_N and #PKCD_EC_NWORK must have been prepared.
                        7524 --2530:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        7525 --2531:  * \par Detailed description
                        7526 --2532:  *  - Calculate wR used in the calculation process of ECDSA verify by the following formula.
                        7527 --2533:  *        - wR = s^(-1) * R. s is signature. R is montgomery coefficient.
                        7528 --2534:  * \par Remarks
                        7529 --2535:  *  - None
                        7530 --2536:  *
                        7531 --2537:  * Pseudo-code for the function can be found below.
