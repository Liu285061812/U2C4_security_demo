                        7537 --2543:  * -# Copy wR to p_wk_wR with the #r_pkcd_cmn_cpy_word
                        7538 --2544:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        7539 --2545:  * -# Return ret
                        7540 --2546:  *
                        7541 --2547:  * \callgraph
                        7542 --2548:  *********************************************************************************************************************/
