                        7758 --2584: /*!****************************************************************************************************************//**
                        7759 --2585:  * \ingroup     PKCDECAPIsInternal
                        7760 --2586:  * \brief       Calculate U1 or U2 used in ECDSA verify.
                        7761 --2587:  * \param       [in]   p_wk_zr       An address of work area where z or r. The data must be aligned with bottom. <br>
                        7762 --2588:  *                                        - z is the number of bits of order n from the top of digest.
                        7763 --2589:  *                                        - r is signature.
                        7764 --2590:  * \param       [in]   p_wk_wR       An address of work area where wR. The data must be aligned with bottom.
                        7765 --2591:  *                                        - w is s^(-1) mod n. s is signature.
                        7766 --2592:  *                                        - R is montgomery coefficient.
                        7767 --2593:  * \param       [in]   curve_len     A byte size of curve length.
                        7768 --2594:  * \param       [out]  p_u           An address of the buffer to set the result of U.
                        7769 --2595:  * \return
                        7770 --2596:  *  - #PKCD_RET_OK:                  Successfully done.
                        7771 --2597:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        7772 --2598:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        7773 --2599:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        7774 --2600:  * \par Security components
                        7775 --2601:  *  - No
                        7776 --2602:  * \par Global Variables
                        7777 --2603:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_PDT_N, #PKCD_EC_NWORK, #PKCD_EC_WORK1, #PKCD_EC_WORK2, #PKCD_EC_SCALARWORK
                        7778 --2604:  * \par Registers Used
                        7779 --2605:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        7780 --2606:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        7781 --2607:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        7782 --2608:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        7783 --2609: * \par Precondition
                        7784 --2610:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_PDT_N and #PKCD_EC_NWORK must have been prepared.
                        7785 --2611:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        7786 --2612:  * \par Detailed description
                        7787 --2613:  *  - Calculate U by the following calculation formula.
                        7788 --2614:  *        - U1 = zw mod n
                        7789 --2615:  *        - U2 = rw mod n
                        7790 --2616:  * \par Remarks
                        7791 --2617:  *  - None

