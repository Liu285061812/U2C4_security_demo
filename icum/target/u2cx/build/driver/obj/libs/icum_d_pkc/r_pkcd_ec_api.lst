                          66 --27: /* PRQA S 0303 ++ # D001 Cast for accessing the area of register address */
                          67 --28: /* PRQA S 0306 ++ # D002 Cast for accessing the area of PKCCRAM address */
                          68 --29: /* PRQA S 0306 ++ # D003 Cast to use address as an integer value */
                          69 --30: /* PRQA S 0310,0316,3305 ++ # D005 In order not to disclose the structure used internally, after receiving
                          70 --31:                         it with type uint8_t* or void*, cast it to the type of the structure. */
                          71 --32: /* PRQA S 0311 ++ # D006 No problem because the value of the target variable is not changed in the subsequent
                          72 --33:                         processing.*/
                          73 --34: /* PRQA S 0488 ++ # D007 Consider not to overrun the size of the array pointed to by the pointer.*/
                          74 --35: /* PRQA S 0750 ++ # D008 Use union to efficiently use RAM area. */
                          75 --36: /* PRQA S 0751 ++ # D009 For commonality of functions, confirm that the size is correct and use the cast value. */
                          76 --37: /* PRQA S 0751 ++ # D010 Cast required to calculated the value to set in the register. */
                          77 --38: /* PRQA S 1503 ++ # D013 No problem if it is unused because it is an API called from outside the library */
                          78 --39: /* PRQA S 1505, 1532 ++ # D014 Since files are grouped by function, they are called from different files. */
                          79 --40: /* PRQA S 2053 ++ # D016 No problem because it is a comment explaining the process. */
                          80 --41: /* PRQA S 2913,3383,3384 ++ # D018 Have confirmed in advance that the value doesn't wrap around. */
                          81 --42: /* PRQA S 2981 ++ # D020 Local variable ret of APIs sets INTERNALERR to the initial value
                          82 --43:                         as a countermeasure against attacks that pass through processing. */
                          83 --44: /* PRQA S 2984,2985 ++ # D021 Because it is calculated in consideration of future expansion */
                          84 --45: /* PRQA S 3120 ++ # D023 Because it is a constant for the bit position and dosen't change in synchronization
                          85 --46:                         with other values. */
                          86 --47: /* PRQA S 3453,3469,3472 ++ # D026 If it is a function, overhead is large, so it corresponds with macro. */
                          87 --48: /* PRQA S 3673 ++ # D029 Because future extensions may edit values in buffer. */
                          88 --49: /* PRQA S 5002 ++ # D030 There is no problem because it is used in a system that can distinguish
                          89 --50:                     file names of 8 characters or more. */
