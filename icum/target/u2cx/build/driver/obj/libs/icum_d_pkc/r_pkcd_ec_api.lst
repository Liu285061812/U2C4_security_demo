                        6823 --2288: /**********************************************************************************************************************
                        6824 --2289: * Function Name : r_pkcd_ec_projective_to_affine
                        6825 --2290: **********************************************************************************************************************/
                        6826 --2291: /*!****************************************************************************************************************//**
                        6827 --2292:  * \ingroup     PKCDECAPIsInternal
                        6828 --2293:  * \brief       Convert from projective coordinates to affine coordinates.
                        6829 --2294:  * \param       [in]   p_wk_xyx       An address of work area where projective coordinates.
                        6830 --2295:  * \param       [in]   curve_len      A byte size of curve length.
                        6831 --2296:  * \param       [out]  p_x            An address of the buffer that sets the affine x coordinate after conversion. <br>
                        6832 --2297:  *                                        If NULL is set, do not calculate the value.
                        6833 --2298:  * \param       [out]  p_y            An address of the buffer that sets the affine y coordinate after conversion. <br>
                        6834 --2299:  *                                        If NULL is set, do not calculate the value.
                        6835 --2300:  * \return
                        6836 --2301:  *  - #PKCD_RET_OK:                  Successfully done.
                        6837 --2302:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        6838 --2303:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        6839 --2304:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        6840 --2305:  * \par Security components
                        6841 --2306:  *  - No
                        6842 --2307:  * \par Global Variables
                        6843 --2308:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P, #PKCD_EC_R2MOD, #PKCD_EC_WORK1, #PKCD_EC_WORK2,
                        6844 --2309:  *    #PKCD_EC_XYZWORKEXT
                        6845 --2310:  * \par Registers Used
                        6846 --2311:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        6847 --2312:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        6848 --2313:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        6849 --2314:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        6850 --2315:  * \par Precondition
                        6851 --2316:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL and #PKCD_EC_PDT_P must have been prepared.
                        6852 --2317:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        6853 --2318:  *  - If #PKCD_CFG_OVF_WORKAROUND_ENABLE == 1 and the curve length < #PKCD_EC_CURVE_LEN_MAX,

                                                                      Page 124
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000vdg1.si
                        6854 --2319:  *    DL must be set to the curve length + 64bits, otherwise, the curve length must be set.
                        6855 --2320:  * \par Detailed description
                        6856 --2321:  *  - Convert the projective coordinates of (XR, YR, ZR) to affine coordinates of (x, y).
                        6857 --2322:  *  - (x = X/Z, y = Y/Z)
                        6858 --2323:  * \par Remarks
                        6859 --2324:  *  - None
                        6860 --2325:  *
                        6861 --2326:  * Pseudo-code for the function can be found below.
                        6862 --2327:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        6863 --2328:  * -# Set data pointer of p_wk_xyx
                        6864 --2329:  * -# Set #PKCD_EC_PDT_P to #PKCD_CMN_ICUM_PKCCB0DPT.
                        6865 --2330:  * -# <B>--- If #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        6866 --2331:  * -# Set DL, BDL to curve_len with the #r_pkcd_cmn_set_dl.
                        6867 --2332:  * -# <B>--- Endif #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        6868 --2333:  * -# Remove montgomery coefficient R from ZR with the #r_pkcd_cmn_ARInvModC.
                        6869 --2334:  * -# Calculate Z^(-1) with #r_pkcd_ec_inverse.
                        6870 --2335:  * -# <B>--- If #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        6871 --2336:  * -# If (#PKCD_EC_CURVE_NIST_P521_LEN != curve_len), then
                        6872 --2337:  *   -# Set DL, BDL to curve_len + 64 bits with the #r_pkcd_cmn_set_dl.
                        6873 --2338:  * -# <B>--- Endif #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        6874 --2339:  * -# If NULL != p_x then
                        6875 --2340:  *   -# Calculate x = X/Z with the #r_pkcd_cmn_ABRInvModC.
                        6876 --2341:  *   -# Copy x to p_x with the #r_pkcd_cmn_cpy_by_64bounds
                        6877 --2342:  * -# If NULL != p_y then
                        6878 --2343:  *   -# Calculate y = Y/Z with the #r_pkcd_cmn_ABRInvModC.
                        6879 --2344:  *   -# Copy y to p_y with the #r_pkcd_cmn_cpy_by_64bounds
                        6880 --2345:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        6881 --2346:  * -# Return ret
                        6882 --2347:  *
                        6883 --2348:  * \callgraph
                        6884 --2349:  *********************************************************************************************************************/
