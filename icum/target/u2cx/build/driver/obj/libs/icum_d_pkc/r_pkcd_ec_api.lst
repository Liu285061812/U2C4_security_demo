                        4104 --1481: /*!****************************************************************************************************************//**
                        4105 --1482:  * \ingroup     PKCDECAPIsInternal
                        4106 --1483:  * \brief       Perform scalar multiplication for points on elliptic curves.
                        4107 --1484:  * \param       [in]  p_x            Affine cordinate x address
                        4108 --1485:  * \param       [in]  p_y            Affine cordinate y address
                        4109 --1486:  * \param       [in]  p_scalar       Scalar value address
                        4110 --1487:  * \param       [in]  p_coeff1       An address of coefficient a of curve domain
                        4111 --1488:  * \param       [in]  curve_len      A byte size of curve length.
                        4112 --1489:  * \param       [in]  sync_option    Indicate if the function returns while PKCC is running.
                        4113 --1490:  * \param       [out] p_wk_xyz_out   An address of work area where Point (XR, YR, ZR) is resulting. <br>
                        4114 --1491:  *                                   The data is set at the bottom.
                        4115 --1492:  * \return
                        4116 --1493:  *  - #PKCD_RET_OK:                  Successfully done.
                        4117 --1494:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed.
                        4118 --1495:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        4119 --1496:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        4120 --1497:  * \par Security components
                        4121 --1498:  *  - No
                        4122 --1499:  * \par Global Variables
                        4123 --1500:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P, #PKCD_EC_PWORK, #PKCD_EC_WORK1, #PKCD_EC_WORK2,
                        4124 --1501:  *    #PKCD_EC_WORK7, #PKCD_EC_R2MOD, #PKCD_EC_SCALARWORK, #PKCD_EC_ARPWORK, #PKCD_EC_XYZWORKEXT
                        4125 --1502:  * \par Registers Used
                        4126 --1503:  *  - #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, #PKCD_CMN_ICUM_PKCCB0DPC, <br>
                        4127 --1504:  *    #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPT
                        4128 --1505:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        4129 --1506:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        4130 --1507:  * \par Precondition
                        4131 --1508:  *  - #PKCD_EC_OFFSET_VAL, #PKCD_EC_OFFSET_DL64VAL, #PKCD_EC_PDT_P and #PKCD_EC_PWORK, must have been prepared.
                        4132 --1509:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) and #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        4133 --1510:  * \par Detailed description
                        4134 --1511:  *  - Perform scalar multiplication for points on elliptic curves.
                        4135 --1512:  *  - Resulting coordinate (XR, YR, ZR) are set in wk_xyx_out.
                        4136 --1513:  * \par Remarks
                        4137 --1514:  *  - None
                        4138 --1515:  *
                        4139 --1516:  * Pseudo-code for the function can be found below.
                        4140 --1517:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        4141 --1518:  * -# Set data pointer of arp_data.
                        4142 --1519:  * -# Set #PKCD_EC_PDT_P to #PKCD_CMN_ICUM_PKCCB0DPT.
                        4143 --1520:  * -# Converte affine coordinates to projective coordinates with the #r_pkcd_ec_affine_to_projective <br>
                        4144 --1521:  *    R^2 mod p is also calculated within this function.
                        4145 --1522:  * -# Calculate a*R mod p with S = ABR^(-1) mod C
                        4146 --1523:  * -# <B>--- If #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        4147 --1524:  * -# If (#PKCD_EC_CURVE_NIST_P521_LEN != curve_len), then
                        4148 --1525:  *   -# Set DL, BDL to curve_len + 64 bits with the #r_pkcd_cmn_set_dl.
                        4149 --1526:  * -# <B>--- Endif #PKCD_CFG_OVF_WORKAROUND_ENABLE is 1 ---</B>
                        4150 --1527:  * -# Calculate scalar * (x*R, y*R, R) with mode #PKCD_CMN_MODE_PNTSCALARMUL of #r_pkcd_cmn_run
                        4151 --1528:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        4152 --1529:  * -# Return ret
                        4153 --1530:  *
                        4154 --1531:  * \callgraph
                        4155 --1532:  *********************************************************************************************************************/
