                        5291 --1716: /**********************************************************************************************************************
                        5292 --1717: * Function Name : r_pkcd_ed25519_point_decompress
                        5293 --1718: **********************************************************************************************************************/
                        5294 --1719: /*!*********************************************************************************************************************
                        5295 --1720:  * \ingroup     PKCDEDDSAAPIsInternal
                        5296 --1721:  * \brief       Decompress an octet string into a point (XR, YR, ZR).
                        5297 --1722:  * \param       [in]  p_compressed          The address of a decompressing octet string.
                        5298 --1723:  * \param       [in]  p_algo_opt1         The address of a precalculated (p + 3)/8 value.
                        5299 --1724:  * \param       [in]  p_algo_opt2    The address of a precalculated (p - 1)/4 value.
                        5300 --1725:  * \param       [out] p_p3                  The address of where the decompressed point (XR, YR, ZR) is output.
                        5301 --1726:  * \param       [in]  p_works               The address of a work area structure which contains 6 work area addresses.
                        5302 --1727:  * \return
                        5303 --1728:  *  - #PKCD_RET_OK:                  Successfully done.
                        5304 --1729:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        5305 --1730:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        5306 --1731:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        5307 --1732:  *  - #PKCD_RET_EDDSA_DECOMPERR:     Failed in deriving square root of x^2 modulo p.
                        5308 --1733:  * \par Security components
                        5309 --1734:  *  - No
                        5310 --1735:  * \par Global Variables
                        5311 --1736:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP
                        5312 --1737:  * \par Registers Used
                        5313 --1738:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        5314 --1739:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        5315 --1740:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        5316 --1741:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        5317 --1742:  *
                        5318 --1743:  * \par Precondition

                                                                      Page 95
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000ijg1.si
                        5319 --1744:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP <br>
                        5320 --1745:  *    must have been prepared.
                        5321 --1746:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        5322 --1747:  * \par Detailed description
                        5323 --1748:  *      - Decompress an octet string into a point (XR, YR, ZR). <br>
                        5324 --1749:  *        The decompression of an octet string is done following the method written in section 5.1.3 RFC8032.
                        5325 --1750:  * \par Remarks
                        5326 --1751:  *  - None
                        5327 --1752:  *
                        5328 --1753:  * Pseudo-code for the function can be found below.
                        5329 --1754:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        5330 --1755:  * -# Initialize the variable ret2 with #PKCD_RET_INTERNALERR.
                        5331 --1756:  * -# Copy the octet string into a buffer converting its endianness into big endian.
                        5332 --1757:  * -# Get the most significant bit of the buffer data. The bit is the least significant bit of x-coordinate.
                        5333 --1758:  * -# Clear the most significant bit of the buffer data. The remained bits are of y-coordinate's.
                        5334 --1759:  * -# From here, derive the x-coordinate value. Where some of intermediate values are saved in montogomery format.
                        5335 --1760:  * -# Calculate u = y^2 - 1 from y and #PKCD_EDDSA_R2MODP with #r_pkcd_cmn_ABRInvModC, #r_pkcd_cmn_ARInvModC,
                        5336 --1761:  *    #r_pkcd_cmn_AMinusBModC.
                        5337 --1762:  * -# Calculate v = dy^2 + 1 from y and #PKCD_EDDSA_DRMODP with #r_pkcd_cmn_ABRInvModC, #r_pkcd_cmn_APlusBModC.
                        5338 --1763:  * -# Calculate u/v from u and v with #r_pkcd_cmn_ARInvModC, #r_pkcd_cmn_modinv_fermat, #r_pkcd_cmn_ABRInvModC.
                        5339 --1764:  * -# Calculate x_candidate = (u/v)^((p+3)/8) from (u/V) and ((p+3)/8) with #r_pkcd_cmn_AExpBModC.
                        5340 --1765:  * -# Calculate x_candidate^2 from (x candidate) and #PKCD_EDDSA_R2MODP with #r_pkcd_cmn_ABRInvModC,
                        5341 --1766:  *    #r_pkcd_cmn_ARInvModC.
                        5342 --1767:  * -# Calculate -(u/v) with #r_pkcd_cmn_AMinusBModC.
                        5343 --1768:  * -# Correct the square root value if needed.<br>If (x candidate)^2 != (u/v) Then,
                        5344 --1769:  *   -# If x_candidate^2 is not equal to -(u/v) Then,
                        5345 --1770:  *     -# Decompression result in fail. And set ret2 = #PKCD_RET_EDDSA_DECOMPERR.
                        5346 --1771:  *   -# Else Calculate x_candidate = x_candidate * 2^((p-1)/4) with #r_pkcd_cmn_ABRInvModC.
                        5347 --1772:  * -# Recover x-coordinate value.
                        5348 --1773:  *   -# If the saved LSBit of x equals to that of the x_candidate,
                        5349 --1774:  *     -# x_candidate is the actual x value.
                        5350 --1775:  *     -# Then caluculate XR with #r_pkcd_cmn_ABRInvModC.
                        5351 --1776:  *   -# Else,
                        5352 --1777:  *     -# (p - x_candidate) is the actual x value, So calculate (p - x_candidate) mod p with #r_pkcd_cmn_AMinusBModC.
                        5353 --1778:  *     -# Then caluculate XR with #r_pkcd_cmn_ABRInvModC.
                        5354 --1779:  * -# Calculate ZR from #PKCD_EDDSA_R2MODP with #r_pkcd_cmn_ARInvModC
                        5355 --1780:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        5356 --1781:  * -# If (#PKCD_RET_OK == ret) and (#PKCD_RET_EDDSA_DECOMPERR == ret2)
                        5357 --1782:  *   -# Set ret to #PKCD_RET_EDDSA_DECOMPERR
                        5358 --1783:  * -# Else
                        5359 --1784:  *   -# Do nothing
                        5360 --1785:  * -# Return ret
                        5361 --1786:  *
                        5362 --1787:  * \callgraph
                        5363 --1788:  *********************************************************************************************************************/
                        5364 --1789: static pkcd_ret_t r_pkcd_ed25519_point_decompress(const uint8_t* const p_compressed, const uint8_t* const p_algo_opt1,
                        5365 	.align	2
