                        8193 --2655: /**********************************************************************************************************************
                        8194 --2656: * Function Name : r_pkcd_eddsa_point_add_inline
                        8195 --2657: **********************************************************************************************************************/
                        8196 --2658: /*!*********************************************************************************************************************
                        8197 --2659:  * \ingroup     PKCDEDDSAAPIsInternal
                        8198 --2660:  * \brief       Operates point addition on the projective coordinate Twisted Edwards Curve.
                        8199 --2661:  * \param       [in]  p_p1      The address of an adding point P1(X1, Y1, Z1).
                        8200 --2662:  * \param       [in]  p_p2      The address of an adding point P2(X2, Y2, Z2).
                        8201 --2663:  * \param       [out] p_p3      The address of an added point P3(X3, Y3, Z3).
                        8202 --2664:  * \param       [in]  p_dpwks   The address of a work area structure which contains 6 work area addresses in DP format.
                        8203 --2665:  * \return
                        8204 --2666:  *  - #PKCD_RET_OK:                  Successfully done.
                        8205 --2667:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        8206 --2668:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        8207 --2669:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        8208 --2670:  * \par Security components
                        8209 --2671:  *  - No
                        8210 --2672:  * \par Global Variables
                        8211 --2673:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP, #PKCD_EDDSA_ARMODP
                        8212 --2674:  * \par Registers Used
                        8213 --2675:  *  - #PKCD_CMN_ICUM_PKCCB0DPT, #PKCD_CMN_ICUM_PKCCB0DPC
                        8214 --2676:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        8215 --2677:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        8216 --2678:  *    #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        8217 --2679:  * \par Precondition
                        8218 --2680:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP, #PKCD_EDDSA_ARMODP must have been prepared.
                        8219 --2681:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        8220 --2682:  * \par Detailed description
                        8221 --2683:  *      - Operates point addition on the projective coordinate Twisted Edwards Curve.
                        8222 --2684:  *      - The addition is done following the method written in section 6 of  <br>
                        8223 --2685:  *        D.J.Bernstein, P.Birkner, M.Joye, T.Lange and C.Peters "Twisted Edwards Curves".
                        8224 --2686:  * \par Remarks
                        8225 --2687:  *  - None
                        8226 --2688:  *
                        8227 --2689:  * Pseudo-code for the function can be found below.
                        8228 --2690:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        8229 --2691:  * -# Set #PKCD_EDDSA_PDT_P and #PKCD_EDDSA_PWORK area as PKCC DPT and DPC area respectively.
                        8230 --2692:  * -# Calculate A = Z1 * Z2 using PKCC S=ABR^(-1) mod C mode.
                        8231 --2693:  * -# Calculate B = A * A using PKCC S=ABR^(-1) mod C mode.
                        8232 --2694:  * -# Calculate C = X1 * X2 using PKCC S=ABR^(-1) mod C mode.
                        8233 --2695:  * -# Calculate D = Y1 * Y2 using PKCC S=ABR^(-1) mod C mode.
                        8234 --2696:  * -# Calculate E = d * C * D using PKCC S=ABR^(-1) mod C mode.
                        8235 --2697:  * -# Calculate F = B - E using PKCC S=(A-B) mod C mode.
                        8236 --2698:  * -# Calculate G = B + E using PKCC S=(A+B) mod C mode.
                        8237 --2699:  * -# Calculate Z3 = F * G using PKCC S=ABR^(-1) mod C mode.
                        8238 --2700:  * -# Calculate Y3 = A * G * (D - aC) using PKCC S=ABR^(-1) mod C and S=(A-B) mod C mode.
                        8239 --2701:  * -# Calculate X3 = A * F * ((X1+Y1) * (X2+Y2) - C - D) using PKCC S=ABR^(-1) mod C, S=(A+B) mod C and
                        8240 --2702:  *  S=(A-B) mod C mode.
                        8241 --2703:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        8242 --2704:  * -# Return ret
                        8243 --2705:  *
                        8244 --2706:  * \callgraph
                        8245 --2707:  *********************************************************************************************************************/
                        8246 --2708: static pkcd_ret_t r_pkcd_eddsa_point_add_inline(const u_eddsa_work_t* const p_p1, const u_eddsa_work_t* const p_p2,
                        8247 	.align	2
                        8248 	.align	2
