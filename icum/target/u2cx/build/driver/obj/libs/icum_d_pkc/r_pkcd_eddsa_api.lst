                        8975 --2826: * Function Name : r_pkcd_eddsa_point_dbl_inline
                        8976 --2827: **********************************************************************************************************************/
                        8977 --2828: /*!*********************************************************************************************************************
                        8978 --2829:  * \ingroup     PKCDEDDSAAPIsInternal
                        8979 --2830:  * \brief       Operates point doubling on the projective coordinate Twisted Edwards Curve.
                        8980 --2831:  * \param       [in]  p_p1      The address of an doubling point P1(X1, Y1, Z1).
                        8981 --2832:  * \param       [out] p_p3      The address of an doubled point P3(X3, Y3, Z3).
                        8982 --2833:  * \param       [in]  p_dpwks   The address of a work area structure which contains 6 work area addresses in DP format.
                        8983 --2834:  * \return

                                                                      Page 160
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000ijg1.si
                        8984 --2835:  *  - #PKCD_RET_OK:                  Successfully done.
                        8985 --2836:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        8986 --2837:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        8987 --2838:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        8988 --2839:  * \par Security components
                        8989 --2840:  *  - No
                        8990 --2841:  * \par Global Variables
                        8991 --2842:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP, #PKCD_EDDSA_ARMODP
                        8992 --2843:  * \par Registers Used
                        8993 --2844:  *  - #PKCD_CMN_ICUM_PKCCB0DPT, #PKCD_CMN_ICUM_PKCCB0DPC
                        8994 --2845:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        8995 --2846:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        8996 --2847:  *    #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        8997 --2848:  * \par Precondition
                        8998 --2849:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP, #PKCD_EDDSA_ARMODP must have been prepared.
                        8999 --2850:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        9000 --2851:  * \par Detailed description
                        9001 --2852:  *      - Operates point doubling on the projective coordinate Twisted Edwards Curve.
                        9002 --2853:  *      - The doubling is done following the method written in section 6 of  <br>
                        9003 --2854:  *        D.J.Bernstein, P.Birkner, M.Joye, T.Lange and C.Peters "Twisted Edwards Curves".
                        9004 --2855:  * \par Remarks
                        9005 --2856:  *  - None
                        9006 --2857:  *
                        9007 --2858:  * Pseudo-code for the function can be found below.
                        9008 --2859:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        9009 --2860:  * -# Set #PKCD_EDDSA_PDT_P and #PKCD_EDDSA_PWORK area as PKCC DPT and DPC area respectively.
                        9010 --2861:  * -# Calculate B = (X1 + Y1)^2 using PKCC S=(A+B) mod C and S=ABR^(-1) mod C mode.
                        9011 --2862:  * -# Calculate C = X1 * X1 using PKCC S=ABR^(-1) mod C mode.
                        9012 --2863:  * -# Calculate D = Y1 * Y1 using PKCC S=ABR^(-1) mod C mode.
                        9013 --2864:  * -# Calculate E = a * C using PKCC S=ABR^(-1) mod C mode.
                        9014 --2865:  * -# Calculate F = E + D using PKCC S=(A+B) mod C mode.
                        9015 --2866:  * -# Calculate H = Z1 * Z1 using PKCC S=ABR^(-1) mod C mode.
                        9016 --2867:  * -# Calculate J = F - 2H using PKCC S=(A-B) mod C mode.
                        9017 --2868:  * -# Calculate Z3 = F * J using PKCC S=ABR^(-1) mod C mode.
                        9018 --2869:  * -# Calculate X3 = (B - C - D) * J using PKCC S=ABR^(-1) mod C and S=(A-B) mod C mode.
                        9019 --2870:  * -# Calculate Y3 = F * (E - D) using PKCC S=ABR^(-1) mod C and S=(A-B) mod C mode.
                        9020 --2871:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        9021 --2872:  * -# Return ret
                        9022 --2873:  *
                        9023 --2874:  * \callgraph
                        9024 --2875:  *********************************************************************************************************************/
                        9025 --2876: static pkcd_ret_t r_pkcd_eddsa_point_dbl_inline(const u_eddsa_work_t* const p_p1, const u_eddsa_work_t* const p_p3,
                        9026 	.align	2
