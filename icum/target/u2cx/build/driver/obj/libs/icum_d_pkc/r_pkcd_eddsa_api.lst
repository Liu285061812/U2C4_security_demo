                        4891 --1585: /**********************************************************************************************************************
                        4892 --1586: * Function Name : r_pkcd_eddsa_point_compress
                        4893 --1587: **********************************************************************************************************************/
                        4894 --1588: /*!*********************************************************************************************************************
                        4895 --1589:  * \ingroup     PKCDEDDSAAPIsInternal
                        4896 --1590:  * \brief     Compress a point (XR, YR, ZR) into octet string.
                        4897 --1591:  * \param       [in]  p_p1          The address of a compressing point structure.
                        4898 --1592:  * \param       [out] p_comp        The address where the compressed point is output.
                        4899 --1593:  * \param       [in]  p_wk1         The address of a 64bytes work area in #PKCD_CMN_PKCCRAM.
                        4900 --1594:  * \param       [in]  p_wk2         The address of a 64bytes work area in #PKCD_CMN_PKCCRAM.
                        4901 --1595:  * \param       [in,out] p_wk3      The address of a 64bytes work area in #PKCD_CMN_PKCCRAM.
                        4902 --1596:  * \return
                        4903 --1597:  *  - #PKCD_RET_OK:                  Successfully done.
                        4904 --1598:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        4905 --1599:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        4906 --1600:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        4907 --1601:  * \par Security components
                        4908 --1602:  *  - No
                        4909 --1603:  * \par Global Variables
                        4910 --1604:  *  - #PKCD_EDDSA_PWORK, #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_PBYTES
                        4911 --1605:  * \par Registers Used
                        4912 --1606:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        4913 --1607:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        4914 --1608:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        4915 --1609:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        4916 --1610:  * \par Precondition
                        4917 --1611:  *  - #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_PBYTES must have been prepared.
                        4918 --1612:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPT and #PKCD_CMN_ICUM_PKCCB0DPW <br>
                        4919 --1613:  *    value must have been set beforehand.
                        4920 --1614:  * \par Detailed description
                        4921 --1615:  *      - Compress a point (XR, YR, ZR) into octet string. <br>

                                                                      Page 88
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000ijg1.si
                        4922 --1616:  *        The compression of (x, y) coordinates is done following the method written in section 5.1.2 RFC8032.
                        4923 --1617:  * \par Remarks
                        4924 --1618:  *  - None
                        4925 --1619:  *
                        4926 --1620:  * Pseudo-code for the function can be found below.
                        4927 --1621:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        4928 --1622:  * -# Clear buffer data with #r_pkcd_cmn_ram_clr.
                        4929 --1623:  * -# Remove a montgomery constant R from ZR using #r_pkcd_cmn_ARInvModC.
                        4930 --1624:  * -# Calculate 1/Z mod p with the #r_pkcd_cmn_modinv_fermat.
                        4931 --1625:  * -# Derive (x, y) unprojecting (X, Y, Z) coordinates.
                        4932 --1626:  *   -# Calculate x = X/Z multiplying XR and 1/Z with the #r_pkcd_cmn_ABRInvModC.
                        4933 --1627:  *   -# Calculate y = Y/Z multiplying XR and 1/Z with the #r_pkcd_cmn_ABRInvModC.
                        4934 --1628:  * -# If (PKCD_EDDSA_PBYTES == PKCD_EDDSA_CURVE_EDWARDS25519_LEN)
                        4935 --1629:  *   -# Copy the y-coordinate into a buffer.
                        4936 --1630:  *   -# Clear the most significant bit of the y-coordinate in the buffer.
                        4937 --1631:  *   -# Get the least significant bit of the x-coordinate.
                        4938 --1632:  *   -# Or the most significant bit of the y-coordinate in the buffer with the
                        4939 --1633:  *      least significant bit of the x-coordinate.
                        4940 --1634:  *   -# Copy the buffer data into the output area indicated by p_comp converting its endianness into little endian.
                        4941 --1635:  * -# Else
