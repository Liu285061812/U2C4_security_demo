                        7674 --2461: * Function Name : r_pkcd_ed448_smult_base
                        7675 --2462: **********************************************************************************************************************/
                        7676 --2463: /*!*********************************************************************************************************************
                        7677 --2464:  * \ingroup     PKCDEDDSAAPIsInternal
                        7678 --2465:  * \brief       Operates base point scalar multiplication on the projective coordinate Twisted Edwards Curve.
                        7679 --2466:  * \param       [out] p_p3              The address of an multiplied point P3(X3, Y3, Z3).
                        7680 --2467:  * \param       [in]  p_temp            The address of a 192byte work area for temporal value.
                        7681 --2468:  * \param       [in]  p_temp2           The address of a 192byte work area for temporal value.
                        7682 --2469:  * \param       [in]  p_scalar          The address of a scalar value.
                        7683 --2470:  * \param       [in]  p_works           The address of a work area structure which contains 6 work area addresses.
                        7684 --2471:  * \param       [in]  processing_bits   The number of bits to be processed.
                        7685 --2472:  * \param       [in,out]  p_executed_bits   The number of bits processed.
                        7686 --2473:  * \return
                        7687 --2474:  *  - #PKCD_RET_OK:                  Successfully done.
                        7688 --2475:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        7689 --2476:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        7690 --2477:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        7691 --2478:  * \par Security components
                        7692 --2479:  *  - No
                        7693 --2480:  * \par Global Variables
                        7694 --2481:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK <br>
                        7695 --2482:  *    (If #PKCD_CFG_USE_ED448_PRECALC_TABLE_16 == 1 then)  g_ed448_comb_table_16 <br>
                        7696 --2483:  *    (If #PKCD_CFG_USE_ED448_PRECALC_TABLE_256 == 1 then) g_ed448_comb_table_256
                        7697 --2484:  * \par Registers Used
                        7698 --2485:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        7699 --2486:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        7700 --2487:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        7701 --2488:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        7702 --2489:  * \par Precondition
                        7703 --2490:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK must have been prepared.
                        7704 --2491:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        7705 --2492:  * \par Detailed description
                        7706 --2493:  *      - Operates scalar multiplication of the projective coordinate base point on Twisted Edwards Curve.
                        7707 --2494:  *      - The scalar multiplication is done using the binary method.
                        7708 --2495:  * \par Remarks
                        7709 --2496:  *  - None
                        7710 --2497:  *
                        7711 --2498:  * Pseudo-code for the function can be found below. Some values are represented in Montgomery format.
                        7712 --2499:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        7713 --2500:  * -# If #PKCD_CFG_USE_ED448_PRECALC_TABLE_16 is declared, the loop of the window method is done
                        7714 --2501:  *      {curve448 bit size}/4 times .
                        7715 --2502:  *    And if #PKCD_CFG_USE_ED448_PRECALC_TABLE_256 is declared, the loop of the window method is done
                        7716 --2503:  *      {curve448 bit size}/16 times.
                        7717 --2504:  * -# If p_executed_bits == 0 Then prepare neutral element (0, 1, 1) for temporary value as follows,
                        7718 --2505:  *   -# Set #PKCD_EDDSA_PDT_P as PKCC DPT area.
                        7719 --2506:  *   -# Clear an x-coordinate value with #r_pkcd_cmn_ram_clr.
                        7720 --2507:  *   -# Calculate R for a y-coordinate with #r_pkcd_cmn_ARInvModC.
                        7721 --2508:  *   -# Copy R for a z-coordinate with #r_pkcd_cmn_cpy_by_64bounds.
                        7722 --2509:  * -# Set the neutral element as the adding point for the case of a target bit in binary method == 0.
                        7723 --2510:  * -# Set the P1 as the adding point for the case of a target bit in binary method == 1.
                        7724 --2511:  * -# Use the number at p_executed_bits as the starting index of the bit for the binary method.
                        7725 --2512:  * -# Derive the last index of the bit for the binary method from processing bits.
                        7726 --2513:  * -# For the bits between the starting index and the last index of the given scalar, do following
                        7727 --2514:  *   -# Assume the scalar value separated into 4 or 16 parts, and acquire the each bit at the loop index
                        7728 --2515:  *      of the separated parts.
                        7729 --2516:  *      For example if scalar value is separated into 4 parts, bit[192+idx], bit[128+idx], bit[64+idx] and
                        7730 --2517:  *      bit[0+idx] are acquired.
                        7731 --2518:  *      And in this case, 2^(192+idx)+2^(128+idx)+2^(64+idx)+2^(0+idx) is used for the window value.
                        7732 --2519:  *      All the scalar multiplication result with base point and available window values
                        7733 --2520:  *      are prepared as g_ed448_comb_table_16 and g_ed448_comb_table_256.
                        7734 --2521:  *   -# Double the point in the temporary area.

                                                                      Page 138
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000ijg1.si
                        7735 --2522:  *   -# Add an {base point} x {window value} result to the point in the temporary area.
                        7736 --2523:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        7737 --2524:  * -# If the value of the return code variable is #PKCD_RET_OK Then,
                        7738 --2525:  *   -# Update the number at p_executed_bits with resulting loop index.
                        7739 --2526:  *   -# If the updated number is not equal to curve field size,
                        7740 --2527:  *     -# Set #PKCD_RET_PROCESSING into the return code variable.
                        7741 --2528:  *   -# Else,
                        7742 --2529:  *     -# All the bits executed, so copy result into p_p3.
                        7743 --2530:  * -# Return ret
                        7744 --2531:  *
                        7745 --2532:  * \callgraph
                        7746 --2533:  *********************************************************************************************************************/
                        7747 --2534: static pkcd_ret_t r_pkcd_ed448_smult_base(u_eddsa_work_t* const p_p3, u_eddsa_work_t* const p_temp,
                        7748 	.align	2
