                        6054 --1922: /**********************************************************************************************************************
                        6055 --1923: * Function Name : r_pkcd_ed448_point_decompress
                        6056 --1924: **********************************************************************************************************************/
                        6057 --1925: /*!*********************************************************************************************************************
                        6058 --1926:  * \ingroup     PKCDEDDSAAPIsInternal
                        6059 --1927:  * \brief       Decompress an octet string into a point (XR, YR, ZR).
                        6060 --1928:  * \param       [in]  p_compressed          The address of a decompressing octet string.
                        6061 --1929:  * \param       [in]  p_algo_opt1           The address of a precalculated (p + 1)/4 value.
                        6062 --1930:  * \param       [out] p_p3                  The address of where the decompressed point (XR, YR, ZR) is output.
                        6063 --1931:  * \param       [in]  p_works               The address of a work area structure which contains 6 work area addresses.
                        6064 --1932:  * \return
                        6065 --1933:  *  - #PKCD_RET_OK:                  Successfully done.
                        6066 --1934:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        6067 --1935:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        6068 --1936:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        6069 --1937:  *  - #PKCD_RET_EDDSA_DECOMPERR:     Failed in deriving square root of x^2 modulo p.
                        6070 --1938:  * \par Security components
                        6071 --1939:  *  - No
                        6072 --1940:  * \par Global Variables
                        6073 --1941:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP
                        6074 --1942:  * \par Registers Used
                        6075 --1943:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        6076 --1944:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        6077 --1945:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        6078 --1946:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        6079 --1947:  *
                        6080 --1948:  * \par Precondition
                        6081 --1949:  *  - #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_DRMODP <br>
                        6082 --1950:  *    must have been prepared.
                        6083 --1951:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        6084 --1952:  * \par Detailed description
                        6085 --1953:  *      - Decompress an octet string into a point (XR, YR, ZR). <br>
                        6086 --1954:  *        The decompression of an octet string is done following the method written in section 5.1.3 RFC8032.
                        6087 --1955:  * \par Remarks
                        6088 --1956:  *  - None

                                                                      Page 109
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000ijg1.si
                        6089 --1957:  *
                        6090 --1958:  * Pseudo-code for the function can be found below.
                        6091 --1959:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        6092 --1960:  * -# Initialize the variable ret2 with #PKCD_RET_INTERNALERR.
                        6093 --1961:  * -# Copy the octet string into a buffer converting its endianness into big endian.
                        6094 --1962:  *    The first 3 bytes of data set zero padding.
                        6095 --1963:  * -# Get the most significant bit of the buffer data. The bit is the least significant bit of x-coordinate.
                        6096 --1964:  * -# From here, derive the x-coordinate value. Where some of intermediate values are saved in montogomery format.
                        6097 --1965:  * -# Calculate u = y^2 - 1 from y and #PKCD_EDDSA_R2MODP with #r_pkcd_cmn_ABRInvModC, #r_pkcd_cmn_ARInvModC,
                        6098 --1966:  *    #r_pkcd_cmn_AMinusBModC.
                        6099 --1967:  * -# Calculate v = dy^2 - 1 from y and #PKCD_EDDSA_DRMODP with #r_pkcd_cmn_ABRInvModC, #r_pkcd_cmn_AMinusBModC.
                        6100 --1968:  * -# Calculate u/v from u and v with #r_pkcd_cmn_ARInvModC, #r_pkcd_cmn_modinv_fermat, #r_pkcd_cmn_ABRInvModC.
                        6101 --1969:  * -# Calculate x_candidate = (u/v)^((p+1)/4) from (u/v) and ((p+1)/4) with #r_pkcd_cmn_AExpBModC.
                        6102 --1970:  * -# Calculate x_candidate^2 from (x candidate) and #PKCD_EDDSA_R2MODP with #r_pkcd_cmn_ABRInvModC,
                        6103 --1971:  *    #r_pkcd_cmn_ARInvModC.
                        6104 --1972:  * -# Calculate -(u/v) with #r_pkcd_cmn_AMinusBModC.
                        6105 --1973:  * -# If (x candidate)^2 == (u/v)
                        6106 --1974:  *   -# Set ret2 to #PKCD_RET_OK.
                        6107 --1975:  * -# Else
                        6108 --1976:  *   -# Set ret2 to #PKCD_RET_EDDSA_DECOMPERR.
                        6109 --1977:  * -# Recover x-coordinate value.
                        6110 --1978:  *   -# If the saved LSBit of x equals to that of the x_candidate,
                        6111 --1979:  *     -# x_candidate is the actual x value.
                        6112 --1980:  *     -# Then caluculate XR with #r_pkcd_cmn_ABRInvModC.
                        6113 --1981:  *   -# Else,
                        6114 --1982:  *     -# (p - x_candidate) is the actual x value, So calculate (p - x_candidate) mod p with #r_pkcd_cmn_AMinusBModC.
                        6115 --1983:  *     -# Then caluculate XR with #r_pkcd_cmn_ABRInvModC.
                        6116 --1984:  * -# Calculate ZR from #PKCD_EDDSA_R2MODP with #r_pkcd_cmn_ARInvModC
                        6117 --1985:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        6118 --1986:  * -# If (#PKCD_RET_OK == ret) and (#PKCD_RET_EDDSA_DECOMPERR == ret2)
                        6119 --1987:  *   -# Set ret to #PKCD_RET_EDDSA_DECOMPERR
                        6120 --1988:  * -# Else
                        6121 --1989:  *   -# Do nothing
                        6122 --1990:  * -# Return ret
                        6123 --1991:  *
                        6124 --1992:  * \callgraph
                        6125 --1993:  *********************************************************************************************************************/
                        6126 --1994: static pkcd_ret_t r_pkcd_ed448_point_decompress(const uint8_t* const p_compressed, const uint8_t* const p_algo_opt1,
                        6127 	.align	2
