                        6713 --2111: /*!*********************************************************************************************************************
                        6714 --2112:  * \ingroup     PKCDEDDSAAPIsInternal
                        6715 --2113:  * \brief     Operates point scalar multiplication on the projective coordinate Twisted Edwards Curve.
                        6716 --2114:  * \param       [in]  p_p1              The address of an multiplying point P1(X1, Y1, Z1).
                        6717 --2115:  * \param       [out] p_p3              The address of an multiplied point P3(X3, Y3, Z3).
                        6718 --2116:  * \param       [in]  p_temp            The address of a 192byte work area for temporal value.
                        6719 --2117:  * \param       [in]  p_neutral         The address of a 192byte work area for neutral element value.
                        6720 --2118:  * \param       [in]  p_scalar          The address of a scalar value.
                        6721 --2119:  * \param       [in]  p_works           The address of a work area structure which contains 6 work area addresses.
                        6722 --2120:  * \param       [in]  processing_bits   The number of bits to be processed.
                        6723 --2121:  * \param       [in,out]  p_executed_bits   The number of bits processed.
                        6724 --2122:  * \return
                        6725 --2123:  *  - #PKCD_RET_OK:                  Successfully done.
                        6726 --2124:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        6727 --2125:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        6728 --2126:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        6729 --2127:  * \par Security components
                        6730 --2128:  *  - No
                        6731 --2129:  * \par Global Variables
                        6732 --2130:  *  - #PKCD_EDDSA_PBYTES, #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK
                        6733 --2131:  * \par Registers Used
                        6734 --2132:  *  - #PKCD_CMN_ICUM_PKCCB0DPT
                        6735 --2133:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        6736 --2134:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        6737 --2135:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPW (Used by sub functions)
                        6738 --2136:  * \par Precondition
                        6739 --2137:  *  - #PKCD_EDDSA_PBYTES, #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_R2MODP, #PKCD_EDDSA_PWORK must have been prepared.
                        6740 --2138:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit), #PKCD_CMN_ICUM_PKCCB0DPW value must have been set beforehand.
                        6741 --2139:  * \par Detailed description
                        6742 --2140:  *      - Operates scalar multiplication of the projective coordinate point on Twisted Edwards Curve.
                        6743 --2141:  *      - The scalar multiplication is done using the binary method.
                        6744 --2142:  * \par Remarks
                        6745 --2143:  *  - None
                        6746 --2144:  *
                        6747 --2145:  * Pseudo-code for the function can be found below. Some values are represented in Montgomery format.
                        6748 --2146:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        6749 --2147:  * -# If (PKCD_EDDSA_PBYTES == PKCD_EDDSA_CURVE_EDWARDS25519_LEN)
                        6750 --2148:  *   -# Set all_bits to (#PKCD_EDDSA_PBYTES * #PKCD_CMN_BITSOFBYTE).
                        6751 --2149:  * -# Else

                                                                      Page 121
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000ijg1.si
                        6752 --2150:  *   -# Set all_bits to (#PKCD_EDDSA_CURVE_EDWARDS448_LEN * #PKCD_CMN_BITSOFBYTE).
                        6753 --2151:  * -# If p_executed_bits == 0 Then prepare neutral element (0, 1, 1) as follows,
                        6754 --2152:  *   -# Set #PKCD_EDDSA_PDT_P as PKCC DPT area.
                        6755 --2153:  *   -# Clear an x-coordinate value with #r_pkcd_cmn_ram_clr.
                        6756 --2154:  *   -# Calculate R for a y-coordinate with #r_pkcd_cmn_ARInvModC.
                        6757 --2155:  *   -# Copy R for a z-coordinate with #r_pkcd_cmn_cpy_by_64bounds.
                        6758 --2156:  *   -# Copy neutral element value into temporary area also.
                        6759 --2157:  * -# Set the neutral element as the adding point for the case of a target bit in binary method == 0.
                        6760 --2158:  * -# Set the P1 as the adding point for the case of a target bit in binary method == 1.
                        6761 --2159:  * -# Use the number at p_executed_bits as the starting index of the bit for the binary method.
                        6762 --2160:  * -# Derive the last index of the bit for the binary method from processing bits.
                        6763 --2161:  * -# For the bits between the starting index and the last index of the given scalar, do following
                        6764 --2162:  *   -# Acquire the bit in the scalar which corresponds to the loop index.
                        6765 --2163:  *   -# Double the point in the temporary area.
                        6766 --2164:  *   -# Add P1 or the neutral element into the temporary value depending on if the bit is 1 or 0 respectively.
                        6767 --2165:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        6768 --2166:  * -# If the value of the return code variable is #PKCD_RET_OK Then,
                        6769 --2167:  *   -# Update the number at p_executed_bits with resulting loop index.
                        6770 --2168:  *   -# If the updated number is not equal to curve field size,
                        6771 --2169:  *     -# Set #PKCD_RET_PROCESSING into the return code variable.
                        6772 --2170:  *   -# Else,
                        6773 --2171:  *     -# All the bits executed, so copy result into p_p3.
                        6774 --2172:  * -# Return ret
                        6775 --2173:  *
                        6776 --2174:  * \callgraph
                        6777 --2175:  *********************************************************************************************************************/
                        6778 --2176: static pkcd_ret_t r_pkcd_eddsa_point_smult(u_eddsa_work_t* const p_p1, u_eddsa_work_t* const p_p3,
                        6779 	.align	2
