                       11867 --3904: /*!****************************************************************************************************************//**
                       11868 --3905:  * \ingroup     PKCDEDDSAAPIsInternal
                       11869 --3906:  * \brief       #R_PKCD_EddsaKeyWrap argument check function.
                       11870 --3907:  * \param       [in] p_ctx              A pointer to a structure that summarizes the parameters required by EC.
                       11871 --3908:  * \param       [in] p_buf              Buffer used for internal processing of PKC-Driver
                       11872 --3909:  * \param       [in] p_priv_key_raw     Byte array of private key.
                       11873 --3910:  * \param       [in] p_pub_key_raw      Byte array of public key.
                       11874 --3911:  * \param       [in] p_priv_key         Output EdDSA private key of key binary format.
                       11875 --3912:  * \param       [in] p_pub_key          Output EdDSA public key of key binary format.
                       11876 --3913:  * \return
                       11877 --3914:  *  - #PKCD_RET_OK:                       Successful completion
                       11878 --3915:  *  - #PKCD_RET_INTERNALERR:              Internal processing failed
                       11879 --3916:  *  - #PKCD_RET_PARAMERR:                 Invalid argument entered
                       11880 --3917:  *  - #PKCD_RET_LENGTHERR:                Invalid argument length entered
                       11881 --3918:  * \par Security components
                       11882 --3919:  *  - No
                       11883 --3920:  * \par Global Variables
                       11884 --3921:  *  - None
                       11885 --3922:  * \par Registers Used
                       11886 --3923:  *  - None
                       11887 --3924:  * \par Precondition
                       11888 --3925:  *  - None
                       11889 --3926:  * \par Detailed description
                       11890 --3927:  *  - Check the arguments received by the #R_PKCD_EddsaKeyWrap function.
                       11891 --3928:  * \par Remarks
                       11892 --3929:  *  - None
                       11893 --3930:  *
                       11894 --3931:  * Pseudo-code for the function can be found below.
                       11895 --3932:  *  -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                       11896 --3933:  *  -# If (NULL != p_ctx) and (NULL != p_buf) and (NULL != p_priv_key) and (NULL != p_pub_key)
                       11897 --3934:  *    -# If (NULL != p_ctx->p_curve_info)
                       11898 --3935:  *      -# Check the curve length with is valid with #r_pkcd_eddsa_chk_curve_len,
                       11899 --3936:  *         and set ret to the return value.
                       11900 --3937:  *      -# If (#PKCD_RET_OK == ret)
                       11901 --3938:  *        -# Check the argument p_priv_key_raw with #r_pkcd_eddsa_chk_scalar, and set ret to the return value.
                       11902 --3939:  *        -# If (#PKCD_RET_OK == ret)
                       11903 --3940:  *          -# Check the argument p_pub_key_raw with #r_pkcd_eddsa_chk_scalar, and set ret to the return value.
                       11904 --3941:  *          -# If (#PKCD_RET_OK == ret)
                       11905 --3942:  *            -# Set the argument p_priv_key into #st_pkcd_eddsa_key_bin_t * argument p_priv_key_bin.
                       11906 --3943:  *            -# If (NULL != p_priv_key_bin->p_private) and (NULL != p_priv_key_bin->p_public)
                       11907 --3944:  *              -# Set the argument p_pub_key into #st_pkcd_eddsa_key_bin_t * argument p_pub_key_bin.
                       11908 --3945:  *              -# If (NULL != p_pub_key_bin->p_public)
                       11909 --3946:  *                -# Do nothing.
                       11910 --3947:  *              -# Else
                       11911 --3948:  *                -# Set ret to #PKCD_RET_KEY_PARAMERR.
                       11912 --3949:  *            -# Else
                       11913 --3950:  *              -# Set ret to #PKCD_RET_KEY_PARAMERR.
                       11914 --3951:  *          -# Else
                       11915 --3952:  *            -# Do nothing.
                       11916 --3953:  *        -# Else

