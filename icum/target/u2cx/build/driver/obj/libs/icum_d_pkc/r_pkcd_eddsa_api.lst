                        4595 --1494: /**********************************************************************************************************************
                        4596 --1495: * Function Name : r_pkcd_eddsa_precalc_params
                        4597 --1496: **********************************************************************************************************************/
                        4598 --1497: /*!*********************************************************************************************************************
                        4599 --1498:  * \ingroup     PKCDEDDSAAPIsInternal
                        4600 --1499:  * \brief       Prepare pre-calculation values.
                        4601 --1500:  * \param       [in] p_crv     Curve domain parameters.
                        4602 --1501:  * \return
                        4603 --1502:  *  - #PKCD_RET_OK:                       Successfully done.
                        4604 --1503:  *  - #PKCD_RET_INTERNALERR:              Internal processing failed
                        4605 --1504:  *  - #PKCD_RET_PKCCTIMEOUTERR:           PKCC operation timeouted
                        4606 --1505:  *  - #PKCD_RET_PKCCERR:                  An error occurred while the PKCC operations.
                        4607 --1506:  * \par Security components
                        4608 --1507:  *  - No
                        4609 --1508:  * \par Global Variables
                        4610 --1509:  *  - #PKCD_EDDSA_WWORK, #PKCD_EDDSA_PBYTES, #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_PWORK, #PKCD_EDDSA_LWORK,
                        4611 --1510:  *    #PKCD_EDDSA_WORK1, #PKCD_EDDSA_WORK2, #PKCD_EDDSA_R2MODL, #PKCD_EDDSA_PDT_L, #PKCD_EDDSA_R2MODP,
                        4612 --1511:  *    #PKCD_EDDSA_PDT_P, #PKCD_EDDSA_ARMODP, #PKCD_EDDSA_DRMODP
                        4613 --1512:  * \par Registers Used
                        4614 --1513:  *  - #PKCD_CMN_ICUM_PKCCB0DPW
                        4615 --1514:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR, <br>
                        4616 --1515:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        4617 --1516:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS, #PKCD_CMN_ICUM_PKCCB0DPT (Used by sub functions)
                        4618 --1517:  * \par Precondition
                        4619 --1518:  *  - #PKCD_EDDSA_OFFSET_VAL, #PKCD_EDDSA_PBYTES must have been prepared.
                        4620 --1519:  * \par Detailed description
                        4621 --1520:  *      - Prepare pre-calculation values.
                        4622 --1521:  *
                        4623 --1522:  * - Pseudo-code for the function can be found below.
                        4624 --1523:  *   -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        4625 --1524:  *   -# Set #PKCD_EDDSA_WWORK address as the top of PKCC DPW area.
                        4626 --1525:  *   -# Set the size of field p as the PKCC DL and BDL value.
                        4627 --1526:  *   -# Copy the field value p of the given curve into #PKCD_EDDSA_PWORK area.
                        4628 --1527:  *   -# Copy the order value l of the given curve into #PKCD_EDDSA_LWORK area.
                        4629 --1528:  *   -# Copy the coefficient1 value of the given curve into #PKCD_EDDSA_WORK1 area.
                        4630 --1529:  *   -# Copy the coefficient2 value of the given curve into #PKCD_EDDSA_WORK2 area.
                        4631 --1530:  *   -# Calculate {T over l} = -1/l mod 2^64 with #r_pkcd_cmn_MinusCInv.
                        4632 --1531:  *   -# Calculate R^2 mod l with #r_pkcd_cmn_R2ModC.
                        4633 --1532:  *   -# Calculate {T over p} = -1/p mod 2^64 with #r_pkcd_cmn_MinusCInv.
                        4634 --1533:  *   -# Calculate R^2 mod p with #r_pkcd_cmn_R2ModC.
                        4635 --1534:  *   -# Calculate aR mod p with #r_pkcd_cmn_ABRInvModC.
                        4636 --1535:  *   -# Calculate dR mod p with #r_pkcd_cmn_ABRInvModC.
                        4637 --1536:  *   -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        4638 --1537:  *   -# Return ret
