                        2465 --2655:  * -# Calculate the least significant byte of wk_n_minus1 AND 0xFE, so make N-1.
                        2466 --2656:  * -# Copy n to wk_n_minus1 of keygenerate buffer.
                        2467 --2657:  * -# Convert wk_n_minus1 to PKCC format and copy it to wk_n_minus1.
                        2468 --2658:  * -# Get the least significant byte of N - 1.
                        2469 --2659:  * -# Loop while in the following case
                        2470 --2660:  *   - The timeout counter has not exceeded the #PKCD_RSA_MILLER_RABIN_DIV2_LOOP_TIMEOUT
                        2471 --2661:  *   - The lsb is even
