                        1329 --1420:     {
                        1330 --1421:         if (PKC_BOOL_FALSE != p_ctx->sec_mod_exp)
                        1331 --1422:         {

                                                                      Page 23
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        1332 --1423:             ret = r_pkcd_rsa_calc_m_sec(p_prm->msg, p_prm->msg_len, p_prm->p, p_prm->dp, p_prm->pq_len,
                        1333 --1424:                                     p_prm->random_p, sync_option, PKC_BOOL_TRUE);
                        1334 --1425:         }
                        1335 --1426:         else
                        1336 --1427:         {
                        1337 --1428:             ret = r_pkcd_rsa_calc_m(p_prm->msg, p_prm->msg_len, p_prm->p, p_prm->dp, p_prm->pq_len, sync_option,
                        1338 --1429:                                     PKC_BOOL_TRUE);
                        1339 --1430:         }
                        1340 --1432:         p_prm->operate_call_cnt = PKCD_RSA_CRT_OPERATE_CALLED_ONCE;
                        1341 --1433:         ret = (PKCD_RET_OK == ret) ? PKCD_RET_PROCESSING : ret;
                        1342 --1435:         /* Clear the private key value stored in p_prm */
                        1343 --1436:         r_pkcd_cmn_ram_clr(p_prm->p, sizeof(p_prm->p));
                        1344 --1437:         r_pkcd_cmn_ram_clr(p_prm->dp, sizeof(p_prm->dp));
