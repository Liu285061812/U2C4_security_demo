                        1354 --1447:         else
                        1355 --1448:         {
                        1356 --1449:             ret = r_pkcd_rsa_calc_m(p_prm->msg, p_prm->msg_len, p_prm->q, p_prm->dq, p_prm->pq_len, sync_option,
                        1357 --1450:                                     PKC_BOOL_FALSE);
                        1358 --1451:         }
                        1359 --1453:         p_prm->operate_call_cnt = PKCD_RSA_CRT_OPERATE_CALLED_TWICE;
                        1360 --1455:         /* Clear the private key value stored in p_prm */
                        1361 --1456:         r_pkcd_cmn_ram_clr(p_prm->q, sizeof(p_prm->q));
                        1362 --1457:         r_pkcd_cmn_ram_clr(p_prm->dq, sizeof(p_prm->dq));
                        1363 --1458:         r_pkcd_cmn_ram_clr(p_prm->random_q, sizeof(p_prm->random_q));
