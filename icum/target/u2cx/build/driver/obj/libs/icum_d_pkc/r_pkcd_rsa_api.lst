                        2849 --3073:  *   -# Get the least significant byte of A or C(hereinafter called the "AC").
                        2850 --3074:  *   -# Get the least significant byte of B or D(hereinafter called the "BD").
                        2851 --3075:  *   -# If (AC is even) and (BD is even) then
                        2852 --3076:  *     -# Calculate AC = AC / 2 with the #r_pkcd_cmn_ADiv2
                        2853 --3077:  *     -# Calculate BD = BD / 2 with the #r_pkcd_cmn_ADiv2
                        2854 --3078:  *   -# Else
                        2855 --3079:  *     -# Backup BD to p_buf.
                        2856 --3080:  *     -# Calculate AC = AC + y with the #r_pkcd_rsa_ex_gcd_APlusB

                                                                      Page 48
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        2857 --3081:  *     -# Calculate AC = AC / 2 with the #r_pkcd_cmn_ADiv2
                        2858 --3082:  *     -# Restore p_buf to BD.
                        2859 --3083:  *     -# Backup AC to p_buf.
                        2860 --3084:  *     -# Calculate BD = BD - x with the #r_pkcd_rsa_ex_gcd_AMinusB
                        2861 --3085:  *     -# Calculate BD = BD / 2 with the #r_pkcd_cmn_ADiv2
                        2862 --3086:  *     -# Restore p_buf to AC.
                        2863 --3087:  *   -# Get the least significant byte of uv.
                        2864 --3088:  *   -# Increment timeout count.
                        2865 --3089:  * -# If timeout count >= #PKCD_RSA_EX_GCD_LOOP_TIMEOUT then
                        2866 --3090:  *   -# Set ret to #PKCD_RET_PKCCTIMEOUTERR
                        2867 --3091:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        2868 --3092:  * -# Return ret
