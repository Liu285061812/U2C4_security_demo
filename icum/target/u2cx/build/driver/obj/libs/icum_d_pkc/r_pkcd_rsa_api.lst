                        1735 --1854:  *   - The timeout counter has not exceeded the #PKCD_RSA_EX_GCD_LOOP_TIMEOUT
                        1736 --1855:  *   - The x and y are even
                        1737 --1856:  *   - There was no error in PKCC operation
                        1738 --1857:  *   -# Calculate u = u/2 with the #r_pkcd_cmn_ADiv2
                        1739 --1858:  *   -# Calculate v = v/2 with the #r_pkcd_cmn_ADiv2
                        1740 --1859:  *   -# Increment div2_cnt
                        1741 --1860:  *   -# Increment timeout count
                        1742 --1861:  * -# If timeout count >= #PKCD_RSA_EX_GCD_LOOP_TIMEOUT then
                        1743 --1862:  *   -# Set ret to #PKCD_RET_PKCCTIMEOUTERR
                        1744 --1863:  * -# Set x and y value to xy.
                        1745 --1864:  * -# Set u, A, and B to wks_u.
                        1746 --1865:  * -# Set v, C, and D to wks_v.
                        1747 --1866:  * -# Check if u is 0 and set the result to cmp_ret
                        1748 --1867:  * -# Check if v is 0 and set the result to cmp_ret2
                        1749 --1868:  * -# Loop while in the following case
