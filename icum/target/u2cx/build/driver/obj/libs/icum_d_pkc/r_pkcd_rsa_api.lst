                        1308 --1398:  *   -# Use #r_pkcd_cmn_ram_clr to clear the potentially private key value stored in p_prm.
                        1309 --1399:  * -# Else if #PKCD_RSA_CRT_OPERATE_CALLED_ONCE == p_prm->operate_call_cnt then
                        1310 --1400:  *   -# If #PKC_BOOL_FALSE != p_ctx->sec_mod_exp, then
                        1311 --1401:  *     -# Calculate m2 with the #r_pkcd_rsa_calc_m_sec.
                        1312 --1402:  *   -# Else
                        1313 --1403:  *     -# Calculate m2 with the #r_pkcd_rsa_calc_m.
                        1314 --1404:  *   -# Set #PKCD_RSA_CRT_OPERATE_CALLED_TWICE to p_prm->operate_call_cnt
                        1315 --1405:  *   -# Use #r_pkcd_cmn_ram_clr to clear the potentially private key value stored in p_prm.
                        1316 --1406:  * -# Else
                        1317 --1407:  *   -# Do nothing
                        1318 --1408:  * -# Return ret
                        1319 --1409:  *
                        1320 --1410:  * \callgraph
                        1321 --1411:  *********************************************************************************************************************/
                        1322 --1412: static pkcd_ret_t r_pkcd_rsa_modexp_crt_operate(st_rsa_prm_modexp_crt_t* const p_prm,
                        1323 --1413:                                                 const st_pkc_rsa_ctx_t * const p_ctx,
                        1324 --1414:                                                 const e_pkc_sync_opt_t sync_option)
                        1325 --1415: {
                        1326 --1416:     pkcd_ret_t ret = PKCD_RET_INTERNALERR;
