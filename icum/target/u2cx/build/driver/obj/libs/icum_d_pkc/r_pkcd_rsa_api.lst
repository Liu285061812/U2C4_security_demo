                        2494 --2684:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        2495 --2685:  * -# Return ret
                        2496 --2686:  *
                        2497 --2687:  * \callgraph
                        2498 --2688:  *********************************************************************************************************************/
