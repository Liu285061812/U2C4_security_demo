                        1479 --1581:     r_pkcd_cmn_ram_clr(PKCD_RSA_SPAREWORK1->half.h, PKCD_RSA_WORKUNITHALF);
                        1480 --1582:     r_pkcd_cmn_ram_clr(PKCD_RSA_WORK3->half.l, PKCD_RSA_WORKUNITHALF);
                        1481 --1583:     r_pkcd_cmn_cpy_by_64bounds(PKCD_RSA_WORK3->half.l + PKCD_RSA_OFFSET_VALHALF(pq_len), p_qinv, pq_len);
                        1482 --1584:     ret |= r_pkcd_cmn_ABRInvModC(PKCD_RSA_WORK3->half.l, PKCD_RSA_WORK3->half.h, PKCD_RSA_WORK1->half.h,
                        1483 --1585:                                     PKCD_RSA_WORK2->half.l, PKCD_RSA_WORKUNITHALF);
                        1484 --1586:     ret |= r_pkcd_cmn_ABRInvModC(PKCD_RSA_WORK2->half.l, PKCD_RSA_WORK2->half.h, PKCD_RSA_WORK1->half.h,
