                        1446 --1545:     r_pkcd_cmn_ram_clr(PKCD_RSA_SPAREWORK1->half.h, PKCD_RSA_WORKUNITHALF);
                        1447 --1546:     r_pkcd_cmn_ram_clr(PKCD_RSA_SPAREWORK1->half.l, PKCD_RSA_WORKUNITHALF);
                        1448 --1547:     ret = r_pkcd_cmn_AMinusB(p_wk_m2, PKCD_RSA_WORK1->half.h, PKCD_RSA_SPAREWORK1->half.h, PKCD_RSA_WORKUNITHALF);
                        1449 --1548:     r_pkcd_cmn_cpy_by_64bounds((uint8_t*)&sign_trial,  /* No problem with casting to pointer size */
