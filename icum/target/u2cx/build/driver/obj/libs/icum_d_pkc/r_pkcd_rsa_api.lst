                        2064 --2225:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        2065 --2226:  *    #PKCD_CMN_ICUM_PKCCB0DPC, #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
                        2066 --2227:  * \par Precondition
                        2067 --2228:  *  - None
                        2068 --2229:  * \par Detailed description
                        2069 --2230:  *      - Calculate m1, m2 to be used in CRT mode.
                        2070 --2231:  *      - The m1, m2 is calculated according to the following calculation formula. (C is msg)
                        2071 --2232:  *        - m1 = (C mod p) ^ dp mod p
                        2072 --2233:  *        - m2 = (C mod q) ^ dq mod q
                        2073 --2234:  * \par Remarks
                        2074 --2235:  *  - None
                        2075 --2236:  *
                        2076 --2237:  * Pseudo-code for the function can be found below.
                        2077 --2238:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        2078 --2239:  * -# If is_mod_p == 1 then
                        2079 --2240:  *   -# Set #PKCD_RSA_WORK1->half.h to p_wk_pq.
                        2080 --2241:  *   -# Set #PKCD_RSA_WORK2->half.h to p_wk_r2mod.
                        2081 --2242:  *   -# Set #PKCD_RSA_SPAREWORK1->half.h to p_wk_cmodpq.
                        2082 --2243:  *   -# Set #PKCD_RSA_WORK3->half.h to p_wk_dpq.
                        2083 --2244:  *   -# Set #PKCD_RSA_WORK4->half.h to p_wk_m.
                        2084 --2245:  *   -# Set #PKCD_RSA_PDT_1 to p_dpt.
                        2085 --2246:  * -# Else
                        2086 --2247:  *   -# Set #PKCD_RSA_WORK1->half.l to p_wk_pq.
                        2087 --2248:  *   -# Set #PKCD_RSA_WORK2->half.l to p_wk_r2mod.
                        2088 --2249:  *   -# Set #PKCD_RSA_SPAREWORK1->half.l to p_wk_cmodpq.
                        2089 --2250:  *   -# Set #PKCD_RSA_WORK3->half.l to p_wk_dpq.
                        2090 --2251:  *   -# Set #PKCD_RSA_WORK4->half.l to p_wk_m.
                        2091 --2252:  *   -# Set #PKCD_RSA_PDT_2 to p_dpt.
                        2092 --2253:  * -# Set #PKCD_RSA_WWORK to #PKCD_CMN_ICUM_PKCCB0DPW.
                        2093 --2254:  * -# Set p_dpt to #PKCD_CMN_ICUM_PKCCB0DPT.
                        2094 --2255:  * -# Set pq_len to DL and BDL bit of #PKCD_CMN_ICUM_PKCCB0OMR with the #r_pkcd_cmn_set_dl
                        2095 --2256:  * -# Calculate T of p_wk_pq with the #r_pkcd_cmn_MinusCInv
