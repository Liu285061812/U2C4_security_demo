                        2243 --2412:     {
                        2244 --2413:         p_wk_pq     = PKCD_RSA_WORK1->half.h;
                        2245 --2414:         p_wk_r2mod  = PKCD_RSA_WORK2->half.h;
                        2246 --2415:         p_wk_cmodpq = PKCD_RSA_SPAREWORK1->half.h;

                                                                      Page 38
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        2247 --2416:         p_wk_exp    = PKCD_RSA_WORK3->half.h;
                        2248 --2417:         p_wk_m      = PKCD_RSA_WORK4->half.h;
                        2249 --2418:         p_dpt       = PKCD_RSA_PDT_1;
                        2250 --2419:     }
