                        2870 --3094:  * \callgraph
                        2871 --3095:  *********************************************************************************************************************/
                        2872 --3096: static pkcd_ret_t r_pkcd_rsa_ex_gcd_calc_even(const st_rsa_ex_gcd_calc_even_wks_t* const p_wks,
                        2873 --3097:                                                 const st_rsa_ex_gcd_xy_t* const p_xy, const uint32_t len,
                        2874 --3098:                                                 uint8_t* const p_buf)
                        2875 --3099: {
                        2876 --3100:     pkcd_ret_t ret = PKCD_RET_OK;
                        2877 --3101:     uint32_t lsb;
                        2878 --3102:     uint32_t lsb2;
                        2879 --3103:     volatile uint32_t timeout_cnt;
                        2880 --3105:     lsb = r_pkcd_cmn_get_lsb_work_unit(p_wks->p_wk_uv, PKCD_RSA_WORKUNIT);
                        2881 --3106:     timeout_cnt = 0U;
                        2882 --3107:     while ((PKCD_RSA_EX_GCD_LOOP_TIMEOUT > timeout_cnt) && ((lsb & 0x01U) == 0x00U) && (PKCD_RET_OK == ret))
                        2883 --3108:     {
                        2884 --3109:         /* Perform processing when u or v is even */
                        2885 --3110:         /* uv = uv /2 */
                        2886 --3111:         ret = r_pkcd_cmn_ADiv2(p_wks->p_wk_uv, p_wks->p_wk_uv, PKCD_RSA_WORKUNIT);
                        2887 --3113:         /* check AC & BD even */
                        2888 --3114:         lsb = r_pkcd_cmn_get_lsb_work_unit(p_wks->p_wk_AC, PKCD_RSA_WORKUNIT);
                        2889 --3115:         lsb2 = r_pkcd_cmn_get_lsb_work_unit(p_wks->p_wk_BD, PKCD_RSA_WORKUNIT);
                        2890 --3116:         if (((lsb & 0x01U) == 0x00U) && ((lsb2 & 0x01U) == 0x00U))
                        2891 --3117:         {
                        2892 --3118:             /* AC = AC/2 */
                        2893 --3119:             ret |= r_pkcd_cmn_ADiv2(p_wks->p_wk_AC, p_wks->p_wk_AC, PKCD_RSA_WORKUNIT);
                        2894 --3121:             /* BD = BD/2*/
                        2895 --3122:             ret |= r_pkcd_cmn_ADiv2(p_wks->p_wk_BD, p_wks->p_wk_BD, PKCD_RSA_WORKUNIT);
                        2896 --3123:         }
                        2897 --3124:         else
                        2898 --3125:         {
                        2899 --3126:             /* AC = (AC + y)/2 (y is p_xy->p_y) */
                        2900 --3127:             r_pkcd_cmn_ram_clr(p_wks->p_wk_xy, PKCD_RSA_WORKUNIT);
                        2901 --3128:             r_pkcd_cmn_cpy_by_64bounds(p_wks->p_wk_xy + PKCD_RSA_OFFSET_VAL(p_xy->ylen), p_xy->p_y, p_xy->ylen);
                        2902 --3129:             r_pkcd_cmn_cpy_word(p_buf, p_wks->p_wk_BD, PKCD_RSA_WORKUNIT);   /* wk_BD backup */
                        2903 --3131:             /* wk_BD use as a temp work */
                        2904 --3132:             ret |= r_pkcd_rsa_ex_gcd_APlusB(p_wks->p_wk_AC, p_wks->p_signAC, p_wks->p_wk_xy, 0U, len, p_wks->p_wk_BD);
                        2905 --3133:             ret |= r_pkcd_cmn_ADiv2(p_wks->p_wk_AC, p_wks->p_wk_AC, PKCD_RSA_WORKUNIT);
                        2906 --3134:             r_pkcd_cmn_cpy_word(p_wks->p_wk_BD, p_buf, PKCD_RSA_WORKUNIT);   /* wk_BD restore */
                        2907 --3136:             /* BD = (BD - x)/2  (x is p_xy->p_x)*/
                        2908 --3137:             r_pkcd_cmn_ram_clr(p_wks->p_wk_xy, PKCD_RSA_WORKUNIT);
                        2909 --3138:             r_pkcd_cmn_cpy_by_64bounds(p_wks->p_wk_xy + PKCD_RSA_OFFSET_VAL(p_xy->xlen), p_xy->p_x, p_xy->xlen);
                        2910 --3139:             r_pkcd_cmn_cpy_word(p_buf, p_wks->p_wk_AC, PKCD_RSA_WORKUNIT);   /* wk_AC backup */
                        2911 --3141:             /* wk_BD use as a temp work */
                        2912 --3142:             ret |= r_pkcd_rsa_ex_gcd_AMinusB(p_wks->p_wk_BD, p_wks->p_signBD, p_wks->p_wk_xy, 0U, len, p_wks->p_wk_AC);
                        2913 --3143:             ret |= r_pkcd_cmn_ADiv2(p_wks->p_wk_BD, p_wks->p_wk_BD, PKCD_RSA_WORKUNIT);
                        2914 --3144:             r_pkcd_cmn_cpy_word(p_wks->p_wk_AC, p_buf, PKCD_RSA_WORKUNIT);   /* wk_AC restore */
                        2915 --3145:         }
                        2916 --3147:         lsb = r_pkcd_cmn_get_lsb_work_unit(p_wks->p_wk_uv, PKCD_RSA_WORKUNIT);
                        2917 --3148:         timeout_cnt += 1U;

                                                                      Page 49
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        2918 --3149:     }   /* while ((lsb & 0x01) == 0x00) */
                        2919 --3151:     /* If loop is timeout, return error */
                        2920 --3152:     if (timeout_cnt >= PKCD_RSA_EX_GCD_LOOP_TIMEOUT)
                        2921 --3153:     {
                        2922 --3154:         ret |= PKCD_RET_PKCCTIMEOUTERR;
                        2923 --3155:     }
                        2924 --3156:     else
                        2925 --3157:     {
                        2926 --3158:         /* Do nothing */
                        2927 --3159:     }
                        2928 --3161:     /* Extract the return value from the ORed result */
                        2929 --3162:     ret = r_pkcd_cmn_extract_result(ret);
                        2930 --3164:     return ret;
                        2931 --3165: }
