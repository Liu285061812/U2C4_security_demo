                        2340 --2519:  * -# Else
                        2341 --2520:  *   -# Set ret to #PKCD_RET_RSA_COMPOSITE
                        2342 --2521:  * -# Return ret
                        2343 --2522:  *
                        2344 --2523:  * \callgraph
                        2345 --2524:  *********************************************************************************************************************/
                        2346 --2525: static pkcd_ret_t r_pkcd_rsa_pre_prime_test(const uint8_t* const p_d, const uint32_t dlen)
                        2347 --2526: {
                        2348 --2527:     pkcd_ret_t ret = PKCD_RET_INTERNALERR;
                        2349 --2528:     uint32_t i;
                        2350 --2529:     uint32_t tmp;
                        2351 --2530:     uint32_t lsb;
                        2352 --2532:     /* set DL */
                        2353 --2533:     r_pkcd_cmn_set_dl(dlen, 0U);
                        2354 --2535:     /* set DPT and work areas */
                        2355 --2536:     r_pkcd_cmn_ram_clr(PKCD_RSA_PDT_1, PKCD_RSA_WORKUNITPDT);
                        2356 --2537:     r_pkcd_cmn_ram_clr(PKCD_RSA_WORK1->full, PKCD_RSA_WORKUNIT);
                        2357 --2538:     r_pkcd_cmn_ram_clr(PKCD_RSA_WORK2->full, PKCD_RSA_WORKUNIT);
                        2358 --2539:     r_pkcd_cmn_ram_clr(PKCD_RSA_WORK3->full, PKCD_RSA_WORKUNIT);
                        2359 --2540:     PKCD_CMN_ICUM_PKCCB0DPT = PKCD_RSA_FORMAT_DP_DPT(PKCD_RSA_PDT_1);
                        2360 --2541:     PKCD_CMN_ICUM_PKCCB0DPW = PKCD_RSA_FORMAT_DP_DPW(PKCD_RSA_WWORK);
                        2361 --2542:     PKCD_CMN_ICUM_PKCCB0DPA = PKCD_RSA_FORMAT_DP_UNIT(PKCD_RSA_WORK1->full);
                        2362 --2543:     PKCD_CMN_ICUM_PKCCB0DPC = PKCD_RSA_FORMAT_DP_UNIT(PKCD_RSA_WORK2->full);
                        2363 --2544:     PKCD_CMN_ICUM_PKCCB0DPS = PKCD_RSA_FORMAT_DP_UNIT(PKCD_RSA_WORK3->full);
                        2364 --2546:     /* set prime data */
                        2365 --2547:     r_pkcd_cmn_cpy_by_64bounds(PKCD_RSA_WORK1->full + PKCD_RSA_OFFSET_VAL(dlen), p_d, dlen);
                        2366 --2549:     lsb = r_pkcd_cmn_get_lsb_work_unit(PKCD_RSA_WORK1->full, PKCD_RSA_WORKUNIT);
                        2367 --2550:     if ((lsb & 0x01U) != 0x00U)
                        2368 --2551:     {

                                                                      Page 40
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        2369 --2552:         for (i = 0U; i < PKCD_RSA_PRIME_TBL_SIZE; i++ )
                        2370 --2553:         {
                        2371 --2554:             /* Call WDT callback */
                        2372 --2555:             r_pkcd_rsa_call_wdtclr();
                        2373 --2557:             /* set divisor */
                        2374 --2558:             tmp = r_pkcd_cmn_ch_endian32(g_rsa_prime_table[i]);
                        2375 --2559:             r_pkcd_cmn_cpy_by_64bounds(PKCD_RSA_WORK2->full + PKCD_RSA_OFFSET_VAL(sizeof(uint32_t)),
                        2376 --2560:                                         (uint8_t*)&tmp, sizeof(uint32_t)); /* No problem with casting pointer size */
                        2377 --2562:             /* set montgomery_T of Prime C */
                        2378 --2563:             tmp = r_pkcd_cmn_ch_endian32(g_rsa_mont_reduction_table[i].h);
                        2379 --2564:             r_pkcd_cmn_cpy_by_64bounds(PKCD_RSA_PDT_1, (uint8_t*)&tmp, sizeof(uint32_t)); /* No problem with casting to
                        2380 --2565:                                                                                              pointer size */
