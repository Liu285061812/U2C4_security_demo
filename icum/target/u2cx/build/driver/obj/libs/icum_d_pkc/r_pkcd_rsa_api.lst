                        2254 --2423:         p_wk_r2mod  = PKCD_RSA_WORK2->half.l;
                        2255 --2424:         p_wk_cmodpq = PKCD_RSA_SPAREWORK1->half.l;
                        2256 --2425:         p_wk_exp    = PKCD_RSA_WORK3->half.l;
                        2257 --2426:         p_wk_m      = PKCD_RSA_WORK4->half.l;
                        2258 --2427:         p_dpt       = PKCD_RSA_PDT_2;
                        2259 --2428:     }
                        2260 --2430:     /* prepare operation */
                        2261 --2431:     PKCD_CMN_ICUM_PKCCB0DPT = PKCD_RSA_FORMAT_DP_DPT(p_dpt);
                        2262 --2432:     PKCD_CMN_ICUM_PKCCB0DPW = PKCD_RSA_FORMAT_DP_DPW(PKCD_RSA_WWORK);
                        2263 --2434:     /* Calculate p-1 (or q-1) */
                        2264 --2435:     /* Use p_wk_r2mod as a buffer for 0x00000001, and use p_wk_m as a buffer for p-1 (or q-1) */
                        2265 --2436:     r_pkcd_cmn_set_dl(pq_len, pq_len);
                        2266 --2437:     r_pkcd_cmn_cpy_by_64bounds(p_wk_pq + PKCD_RSA_OFFSET_VALHALF(pq_len), p_pq, pq_len);
                        2267 --2438:     r_pkcd_cmn_cpy_by_64bounds(p_wk_r2mod + PKCD_RSA_OFFSET_VALHALF(sizeof(g_rsa_one)), g_rsa_one, sizeof(g_rsa_one));
                        2268 --2439:     ret = r_pkcd_cmn_AMinusB(p_wk_pq, p_wk_r2mod, p_wk_m, PKCD_RSA_WORKUNITHALF);
                        2269 --2441:     /* Clear PKCD_RSA_WORK3 */
                        2270 --2442:     r_pkcd_cmn_ram_clr(PKCD_RSA_WORK3->full, PKCD_RSA_WORKUNIT);
                        2271 --2444:     /* Calculate random*(p-1) (or random*(q-1)) */
                        2272 --2445:     /* Use p_wk_r2mod as a buffer for random number */
                        2273 --2446:     r_pkcd_cmn_cpy_by_64bounds(p_wk_r2mod + PKCD_RSA_OFFSET_VALHALF(PKCD_CMN_BITS64), p_random, PKCD_CMN_BITS64);
                        2274 --2447:     ret |= r_pkcd_cmn_AB64(p_wk_r2mod, p_wk_m, PKCD_RSA_WORK3->half.h, PKCD_RSA_WORKUNITHALF);
                        2275 --2449:     /* Calculate random*(p-1) + dp or random*(q-1) + dq  */
                        2276 --2450:     r_pkcd_cmn_set_dl(pq_len + PKCD_CMN_BITS64, pq_len);
                        2277 --2451:     r_pkcd_cmn_cpy_by_64bounds(PKCD_RSA_WORK3->half.l + PKCD_RSA_OFFSET_VALHALF(pq_len), p_dpq, pq_len);
                        2278 --2452:     ret |= r_pkcd_cmn_APlusB(PKCD_RSA_WORK3->half.h, PKCD_RSA_WORK3->half.l, p_wk_exp, PKCD_RSA_WORKUNITHALF);
                        2279 --2454:     /* Prepare C mod p (or q) */
                        2280 --2455:     r_pkcd_cmn_set_dl(pq_len, pq_len);
                        2281 --2456:     ret |= r_pkcd_cmn_MinusCInv(p_wk_pq,
                        2282 --2457:                                 (uint8_t*)PKCD_RSA_FORMAT_DP_DPT(p_dpt),/* No problem with casting to pointer size */
                        2283 --2458:                                 PKCD_RSA_WORKUNITHALF);
                        2284 --2459:     ret |= r_pkcd_cmn_R2ModC(p_wk_pq, p_wk_r2mod, PKCD_RSA_WORKUNITHALF);
                        2285 --2460:     ret |= r_pkcd_cmn_reduce_small_modulus(p_msg, p_wk_pq, p_wk_r2mod, msg_len, pq_len, PKCD_RSA_WORKUNITHALF,
                        2286 --2461:                                             p_wk_cmodpq, p_wk_m, p_wk_cmodpq);
