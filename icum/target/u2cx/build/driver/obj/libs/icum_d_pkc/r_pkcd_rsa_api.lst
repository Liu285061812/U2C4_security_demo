                        1553 --1662:  *      -# Copy p at p_key_bin->p_p to #PKCD_RSA_WORK2 with #r_pkcd_cmn_cpy_by_64bounds.
                        1554 --1663:  *      -# Set #PKCD_CMN_ICUM_PKCCB0DPT to the address of #PKCD_RSA_PDT_1.
