                        1451 --1550:                                 sizeof(uint32_t));
                        1452 --1551:     timeout_cnt = 0U;
                        1453 --1552:     while ((PKCD_RSA_REDUCE_LOOP_TIMEOUT > timeout_cnt) && (0U == sign_trial))

                                                                      Page 25
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        1454 --1553:     {
                        1455 --1554:         p_wk_m2  = (p_wk_m2  != PKCD_RSA_SPAREWORK1->half.h) ?
                        1456 --1555:                     PKCD_RSA_SPAREWORK1->half.h : PKCD_RSA_SPAREWORK1->half.l;
                        1457 --1556:         p_wk_dmy = (p_wk_dmy != PKCD_RSA_SPAREWORK1->half.l) ?
                        1458 --1557:                     PKCD_RSA_SPAREWORK1->half.l : PKCD_RSA_SPAREWORK1->half.h;
                        1459 --1558:         ret |= r_pkcd_cmn_AMinusB(p_wk_m2, PKCD_RSA_WORK1->half.h, p_wk_dmy, PKCD_RSA_WORKUNITHALF);
                        1460 --1559:         r_pkcd_cmn_cpy_by_64bounds((uint8_t*)&sign_trial, /* No problem with casting to pointer size */
                        1461 --1560:                                     p_wk_dmy + PKCD_RSA_OFFSET_VALHALF(pq_len + sizeof(uint32_t)),
                        1462 --1561:                                     sizeof(uint32_t));
                        1463 --1562:         timeout_cnt += 1U;
                        1464 --1563:     }
                        1465 --1565:     /* If loop is timeout, return error */
                        1466 --1566:     if (timeout_cnt >= PKCD_RSA_REDUCE_LOOP_TIMEOUT)
                        1467 --1567:     {
                        1468 --1568:         ret |= PKCD_RET_PKCCTIMEOUTERR;
                        1469 --1569:     }
                        1470 --1570:     else
                        1471 --1571:     {
                        1472 --1572:         /* Do nothing */
