                        2100 --2261:  * -# Return ret
                        2101 --2262:  *
                        2102 --2263:  * \callgraph
                        2103 --2264:  *********************************************************************************************************************/
                        2104 --2265: static pkcd_ret_t r_pkcd_rsa_calc_m(const uint8_t* const p_msg, const uint32_t msg_len, const uint8_t* const p_pq,
                        2105 --2266:                                     const uint8_t* const p_dpq, const uint32_t pq_len,
                        2106 --2267:                                     const e_pkc_sync_opt_t sync_option, const e_pkc_bool_t is_mod_p)
                        2107 --2268: {
                        2108 --2269:     pkcd_ret_t ret = PKCD_RET_INTERNALERR;
                        2109 --2270:     uint8_t * p_wk_pq;
                        2110 --2271:     const uint8_t * p_wk_r2mod;
                        2111 --2272:     uint8_t * p_wk_cmodpq;
                        2112 --2273:     uint8_t * p_wk_dpq;
                        2113 --2274:     const uint8_t * p_wk_m;
                        2114 --2275:     const uint8_t * p_dpt;
                        2115 --2277:     /* set work */
