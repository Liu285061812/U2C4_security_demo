                        3120 --3363: /*!****************************************************************************************************************//**
                        3121 --3364:  * \ingroup     PKCDRSAAPIsInternal
                        3122 --3365:  * \brief       Format the calculation result D of the binary extended gbd algorithm
                        3123 --3366:  * \param       [in,out]  p_wk_D       An adress of work area where D. The data must be aligned with bottom.
                        3124 --3367:  * \param       [in]      signD        A signed flag of D.
                        3125 --3368:  * \param       [in]      p_wk_m       An adress of work area where modulus. The data must be aligned with bottom.
                        3126 --3369:  * \param       [in]      p_wk_temp    An adress of work area where temporary.
                        3127 --3370:  * \param       [in]      len          A byte size of data length.
                        3128 --3371:  * \return
                        3129 --3372:  *  - #PKCD_RET_OK:                  Successfully done.
                        3130 --3373:  *  - #PKCD_RET_INTERNALERR:         Internal processing failed
                        3131 --3374:  *  - #PKCD_RET_PKCCTIMEOUTERR:      PKCC operation timeouted
                        3132 --3375:  *  - #PKCD_RET_PKCCERR:             An error occurred while the PKCC operations.
                        3133 --3376:  * \par Security components
                        3134 --3377:  *  - No
                        3135 --3378:  * \par Global Variables
                        3136 --3379:  *  - None
                        3137 --3380:  * \par Registers Used
                        3138 --3381:  *  - #PKCD_CMN_ICUM_PKCCB0CR, #PKCD_CMN_ICUM_PKCCB0OMR, #PKCD_CMN_ICUM_PKCCB0STR,  <br>
                        3139 --3382:  *    #PKCD_CMN_ICUM_PKCCB0STC, #PKCD_CMN_ICUM_PKCCB0DPA, #PKCD_CMN_ICUM_PKCCB0DPB, <br>
                        3140 --3383:  *    #PKCD_CMN_ICUM_PKCCB0DPS (Used by sub functions)
                        3141 --3384:  * \par Precondition
                        3142 --3385:  *  - #PKCD_CMN_ICUM_PKCCB0OMR (DL bit) value must have been set beforehand.
                        3143 --3386:  * \par Detailed description
                        3144 --3387:  *      - Format the calculation result D of the binary extended gbd algorithm in the following case.
                        3145 --3388:  *        -  If |D| is lager than modulus m, calculate |D| mod m.
                        3146 --3389:  *        -  If D is negative, subtruct D from moduls m.
                        3147 --3390:  *      - If the processing loop exceeds the specified number, an error is returned.
                        3148 --3391:  * \par Remarks
                        3149 --3392:  *  - None
                        3150 --3393:  *
                        3151 --3394:  * Pseudo-code for the function can be found below.
                        3152 --3395:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        3153 --3396:  * -# Clear timeout counter.
                        3154 --3397:  * -# Compare |D| and m with #r_pkcd_cmn_cmp_work_unit and set compare result to cmp_ret.
                        3155 --3398:  * -# Loop while in the following case
                        3156 --3399:  *   - The timeout counter has not exceeded the #PKCD_RSA_REDUCE_LOOP_TIMEOUT
                        3157 --3400:  *   - D is greater than m
                        3158 --3401:  *   - There was no error in PKCC operation
                        3159 --3402:  *   -# Calculate |D'| = |D| - m with #r_pkcd_cmn_AMinusB
                        3160 --3403:  *   -# Compare |D'| and m with #r_pkcd_cmn_cmp_work_unit and set compare result to cmp_ret.
                        3161 --3404:  *   -# Increment timout count

                                                                      Page 53
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000bis1.si
                        3162 --3405:  * -# If timeout count >= #PKCD_RSA_REDUCE_LOOP_TIMEOUT then
                        3163 --3406:  *   -# Set ret to #PKCD_RET_PKCCTIMEOUTERR
                        3164 --3407:  * -# If signD != 0 then
                        3165 --3408:  *   -# Calculate m - D' with #r_pkcd_cmn_AMinusB
                        3166 --3409:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        3167 --3410:  * -# Return ret
                        3168 --3411:  *
                        3169 --3412:  * \callgraph
                        3170 --3413:  *********************************************************************************************************************/
                        3171 --3414: static pkcd_ret_t r_pkcd_rsa_ex_gcd_format_D(const uint8_t* const p_wk_D, const uint32_t signD,
                        3172 --3415:                                                 const uint8_t* const p_wk_m, uint8_t* const p_wk_temp,
                        3173 --3416:                                                 const uint32_t len)
                        3174 --3417: {
                        3175 --3418:     pkcd_ret_t ret = PKCD_RET_INTERNALERR;
                        3176 --3419:     volatile uint32_t timeout_cnt;
                        3177 --3420:     int32_t cmp_ret;
                        3178 --3422:     /* If |D| is larger than m, calculate |D| - m */
                        3179 --3423:     timeout_cnt = 0U;
                        3180 --3424:     ret = r_pkcd_cmn_cmp_work_unit(p_wk_D, p_wk_m, p_wk_temp, len, PKCD_RSA_WORKUNIT, &cmp_ret);
                        3181 --3425:     while ((PKCD_RSA_REDUCE_LOOP_TIMEOUT > timeout_cnt) && (cmp_ret > 0) && (PKCD_RET_OK == ret))
                        3182 --3426:     {
                        3183 --3427:         ret = r_pkcd_cmn_AMinusB(p_wk_D, p_wk_m, p_wk_D, PKCD_RSA_WORKUNIT);
                        3184 --3428:         ret |= r_pkcd_cmn_cmp_work_unit(p_wk_D, p_wk_m, p_wk_temp, len, PKCD_RSA_WORKUNIT, &cmp_ret);
                        3185 --3429:         timeout_cnt += 1U;
                        3186 --3430:     }
                        3187 --3432:     /* If loop is timeout, return error */
                        3188 --3433:     if (timeout_cnt >= PKCD_RSA_REDUCE_LOOP_TIMEOUT)
                        3189 --3434:     {
                        3190 --3435:         ret |= PKCD_RET_PKCCTIMEOUTERR;
                        3191 --3436:     }
                        3192 --3437:     else
                        3193 --3438:     {
                        3194 --3439:         /* Do nothing */
                        3195 --3440:     }
                        3196 --3442:     /* If D is negative, subtruct D from modulus m  */
                        3197 --3443:     if (0U != signD)
                        3198 --3444:     {
                        3199 --3445:         ret |= r_pkcd_cmn_AMinusB(p_wk_m, p_wk_D, p_wk_D, PKCD_RSA_WORKUNIT);
                        3200 --3446:     }
                        3201 --3447:     else
                        3202 --3448:     {
                        3203 --3449:         /* Do nothing */
                        3204 --3450:     }
                        3205 --3452:     /* Extract the return value from the ORed result */
                        3206 --3453:     ret = r_pkcd_cmn_extract_result(ret);
                        3207 --3455:     return ret;
                        3208 --3456: }
                        3209 --3457: /***********************************************************************************************************************
                        3210 --3458: * End of function r_pkcd_rsa_ex_gcd_format_D()
