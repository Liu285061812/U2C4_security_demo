                        2186 --2354:  *  - None
                        2187 --2355:  * \par Detailed description
                        2188 --2356:  *      - Calculate m1, m2 to be used in CRT mode.
                        2189 --2357:  *      - The m1, m2 is calculated as follows. (C is msg. r_p and r_q are 8-byte random values.)
                        2190 --2358:  *        - m1 = (C mod p) ^ (dp + r_p * (p - 1)) mod p
                        2191 --2359:  *        - m2 = (C mod q) ^ (dq + r_q * (q - 1)) mod q
                        2192 --2360:  * \par Remarks
                        2193 --2361:  *  - None
                        2194 --2362:  *
                        2195 --2363:  * Pseudo-code for the function can be found below.
                        2196 --2364:  * -# Initialize the variable ret with #PKCD_RET_INTERNALERR.
                        2197 --2365:  * -# If is_mod_p == 1 then
                        2198 --2366:  *   -# Set #PKCD_RSA_WORK1->half.h to p_wk_pq.
                        2199 --2367:  *   -# Set #PKCD_RSA_WORK2->half.h to p_wk_r2mod.
                        2200 --2368:  *   -# Set #PKCD_RSA_SPAREWORK1->half.h to p_wk_cmodpq.
                        2201 --2369:  *   -# Set #PKCD_RSA_WORK3->half.h to p_wk_dpq.
                        2202 --2370:  *   -# Set #PKCD_RSA_WORK4->half.h to p_wk_m.
                        2203 --2371:  *   -# Set #PKCD_RSA_PDT_1 to p_dpt.
                        2204 --2372:  * -# Else
                        2205 --2373:  *   -# Set #PKCD_RSA_WORK1->half.l to p_wk_pq.
                        2206 --2374:  *   -# Set #PKCD_RSA_WORK2->half.l to p_wk_r2mod.
                        2207 --2375:  *   -# Set #PKCD_RSA_SPAREWORK1->half.l to p_wk_cmodpq.
                        2208 --2376:  *   -# Set #PKCD_RSA_WORK3->half.l to p_wk_dpq.
                        2209 --2377:  *   -# Set #PKCD_RSA_WORK4->half.l to p_wk_m.
                        2210 --2378:  *   -# Set #PKCD_RSA_PDT_2 to p_dpt.
                        2211 --2379:  * -# Set #PKCD_RSA_WWORK to #PKCD_CMN_ICUM_PKCCB0DPW.
                        2212 --2380:  * -# Set p_dpt to #PKCD_CMN_ICUM_PKCCB0DPT.
                        2213 --2381:  * -# Set DL and BDL bit of #PKCD_CMN_ICUM_PKCCB0OMR to pq_len with the #r_pkcd_cmn_set_dl.
                        2214 --2382:  * -# Calculate p_wk_pq - 1 with #r_pkcd_cmn_AMinusB.
                        2215 --2383:  * -# Calculate random * (p_wk_pq - 1) with #r_pkcd_cmn_AB64.
                        2216 --2384:  * -# Set DL bit of #PKCD_CMN_ICUM_PKCCB0OMR to pq_len + #PKCD_CMN_BITS64.
                        2217 --2385:  * -# Calculate random * (p_wk_pq - 1) + p_dpq with #r_pkcd_cmn_APlusB.
                        2218 --2386:  * -# Set p_wk_exp to random * (p_wk_pq - 1) + p_dpq.
                        2219 --2387:  * -# Set DL bit of #PKCD_CMN_ICUM_PKCCB0OMR to pq_len.
                        2220 --2388:  * -# Calculate T of p_wk_pq with the #r_pkcd_cmn_MinusCInv.
                        2221 --2389:  * -# Calculate R^2 mod p_wk_pq with the #r_pkcd_cmn_R2ModC.
                        2222 --2390:  * -# Calculate C mod p_wk_pq with the #r_pkcd_cmn_reduce_small_modulus.
                        2223 --2391:  * -# Set BDL bit of #PKCD_CMN_ICUM_PKCCB0OMR to pq_len + 2 * #PKCD_CMN_BITS64 with the #r_pkcd_cmn_set_dl.
                        2224 --2392:  * -# Calculate m = (C mod p_wk_pq)^p_wk_exp mod p_wk_pq with the #r_pkcd_cmn_AExpBModCCon
                        2225 --2393:  * -# Extract the return value from ret with #r_pkcd_cmn_extract_result, and set ret to it.
                        2226 --2394:  * -# Return ret.
                        2227 --2395:  *
                        2228 --2396:  * \callgraph
                        2229 --2397:  *********************************************************************************************************************/
                        2230 --2398: static pkcd_ret_t r_pkcd_rsa_calc_m_sec(const uint8_t* const p_msg, const uint32_t msg_len, const uint8_t* const p_pq,
                        2231 --2399:                                     const uint8_t* const p_dpq, const uint32_t pq_len, const uint8_t* const p_random,
                        2232 --2400:                                     const e_pkc_sync_opt_t sync_option, const e_pkc_bool_t is_mod_p)
                        2233 --2401: {
                        2234 --2402:     pkcd_ret_t ret = PKCD_RET_INTERNALERR;
                        2235 --2403:     uint8_t * p_wk_pq;
                        2236 --2404:     uint8_t * p_wk_r2mod;
                        2237 --2405:     uint8_t * p_wk_cmodpq;
                        2238 --2406:     const uint8_t * p_wk_exp;
                        2239 --2407:     uint8_t * p_wk_m;
                        2240 --2408:     const uint8_t * p_dpt;
                        2241 --2410:     /* set work */
