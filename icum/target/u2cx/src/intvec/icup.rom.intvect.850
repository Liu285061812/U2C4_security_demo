-------------------------------------------------------------------------------
-------------  Interrupt service routine of unused interrupts

  .global  __unused_isr
  .extern _infinite_loop
  .text
__unused_isr:
  jr _infinite_loop

-------------------------------------------------------------------------------
-------------  Firmware entry point

  .global  firmware_entry
  .text
firmware_entry:
    -- ***************
    -- GHS POINTERS
    -- ***************
ghs_pointers:

    -- set global pointer
    mov     ___ghsbegin_sdabase, gp

    -- set text pointer
    mov     ___ghsbegin_robase, tp

    -- set stack pointer and align on 32-bit word
    mov     (___ghsend_stack-4), sp
    mov     -4, r1
    and     r1 ,sp

    -- ***************
    -- START
    -- ***************

    -- jump to the initialization functions of the library
    -- and from there to main()

    jr      __start

-------------------------------------------------------------------------------

-- the symbol _PEID_ is defined at gpj level

#if   (_PEID_ == 0x07)
#include <icum_irq_define_pub.h>

#define RESET_ENABLE                    0x00000001u

#else
    #error  Wrong _PEID_ definition
#endif

-------------------------------------------------------------------------------
--
-- MANUALLY CREATED
--
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-------------  ICUP interrupt vector table
-------------------------------------------------------------------------------

  .global __irqTbl2
  .global __FW_ENTRY

  .section ".rom.intvect", .text
  .offset 0x0000
__FW_ENTRY:
    jr firmware_entry

