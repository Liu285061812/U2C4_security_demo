[Merged Library]
    :binDirRelative=../../../build/driver/out
    :outputDirRelative=../../../build/driver/obj

    -I../../../../../target/${cfg_family}/include/common/
    -I../../../../../generic/include/common/
    -I../../../../../target/${cfg_family}/include/device/
    -I../../../../../target/${cfg_family}/include/driver/

    -section .text=.icum_driver.text
    -section .rodata=.icum_driver.rodata
    -section .bss=.icum_driver.bss
    -section .data=.icum_driver.data

    -o icum_d_remap.a

icum_d_remap.c
