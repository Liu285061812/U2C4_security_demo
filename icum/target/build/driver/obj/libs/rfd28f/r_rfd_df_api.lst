                         402 --312: /**********************************************************************************************************************
                         403 --313: **  Function Name   : R_RFD_EraseDFRequest
                         404 --314: **  
                         405 --315: **  - Outline
                         406 --316: **      Erases the contents of the data flash memory
                         407 --317: **  - Format
                         408 --318: **      void
                         409 --319: **          R_RFD_EraseDFRequest(
                         410 --320: **              T_u4_RfdAddress  i_u4_Start,
                         411 --321: **              T_u4_RfdAddress  i_u4_End
                         412 --322: **          );
                         413 --323: **  - Input parameter

                                                                      Page 8
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010o41.si
                         414 --324: **      i_u4_Start        : Start address of the erasure area
                         415 --325: **      i_u4_End          : End address of the erasure area
                         416 --326: **  - Return
                         417 --327: **      non return value
                         418 --328: **  - Preconditions
                         419 --329: **      The state of the flash memory must be the READY state
                         420 --330: **      The flash access status must not be the command-locked state
                         421 --331: **      The FACI mode must be the data flash P/E mode
                         422 --332: **  
                         423 --333: **  - Traceability        : [Covers:UD_02_110]
                         424 --334: **********************************************************************************************************************/
                         425 --336: void
                         426 --337: R_RFD_EraseDFRequest(T_u4_RfdAddress i_u4_Start, T_u4_RfdAddress i_u4_End)
                         427 --338: {
                         428 --339:     /* !CERT-C rule DCL00 (QAC message 3227) */
                         429 --340:     
                         430 --341:     /* Definition of the local variables */
                         431 --342:     T_u2_FACI       l_bu2_targetFaci;   /* Target FACI  */
                         432 --343:     
                         433 --344:     /* Initialization of the local variables  */
                         434 --345:     l_bu2_targetFaci    = 0U;
                         435 --346:     
                         436 --347:     
                         437 --348:     /* Acquire FACI number */
                         438 --349:     l_bu2_targetFaci = R_RFD_DFAddressToFaciNumber(i_u4_Start);
                         439 --350:     
                         440 --351:     if (l_bu2_targetFaci != R_RFD_INVALID_FACI)     /* !CERT-C rule INT02 (QAC message 2101) */
                         441 --352:     {
                         442 --353:         /* Switch the FACI base address and FACI command issue area */
                         443 --354:         rfd_fv0_SetFaci(l_bu2_targetFaci);
                         444 --355:         
                         445 --356:         
                         446 --357:         /* Flash Sequencer Process Switch Register */
                         447 --358:         /* Suspension-priority mode */
                         448 --359:         if (R_RFD_ERASURE_SUSPENDED_MODE == R_RFD_SUSPENSION_PRIORITY_MODE)
                         449 --360:         {
                         450 --361:             R_RFD_REG_FCPSR = R_RFD_VALUE_FCPSR_SUSPRI_MODE;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                         451 --362:         }
                         452 --363:         /* Erasure-priority mode */
                         453 --364:         else if (R_RFD_ERASURE_SUSPENDED_MODE == R_RFD_ERASURE_PRIORITY_MODE)
                         454 --365:         {
                         455 --366:             R_RFD_REG_FCPSR = R_RFD_VALUE_FCPSR_ERSPRI_MODE;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                         456 --367:         }
                         457 --368:         /* No having a mode */
                         458 --369:         else
                         459 --370:         {
                         460 --371:             /* no operation */
                         461 --372:         }
                         462 --373:         
                         463 --374:         /* Area erasure */
                         464 --375:         rfd_fv0_MultiErase(i_u4_Start, i_u4_End);
                         465 --376:         
                         466 --377:     } /* if (l_bu2_targetFaci != R_RFD_INVALID_FACI) */
                         467 --378:     
                         468 --379:     else
                         469 --380:     {
                         470 --381:         /* no operation */
                         471 --382:     }
                         472 --383:     
                         473 --384:     return;
                         474 --385:     

