                         501 --414: void
                         502 --415: R_RFD_WriteDFRequest(T_u4_RfdAddress i_u4_Start, T_u2 i_u2_Length, T_pu4_RfdBuffer i_pu4_Data)
                         503 --416: {
                         504 --417:     /* !CERT-C rule DCL00 (QAC message 3227) */
                         505 --418:     
                         506 --419:     /* Definition of the local variables */
                         507 --420:     T_u2_FACI       l_bu2_targetFaci;   /* Target FACI  */
                         508 --421:     
                         509 --422:     /* Initialization of the local variables  */
                         510 --423:     l_bu2_targetFaci = 0U;
                         511 --424:     
                         512 --425:     
                         513 --426:     /* Acquire FACI number */
                         514 --427:     l_bu2_targetFaci = R_RFD_DFAddressToFaciNumber(i_u4_Start);
                         515 --428:     
