                         532 --445:         }
                         533 --446:         /* Writing length is 16 bytes */
                         534 --447:         else if (i_u2_Length == R_RFD_LENGTH_DATA_16BYTES)  /* !CERT-C rule INT02 (QAC message 2101) */
                         535 --448:         {

                                                                      Page 10
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010o41.si
                         536 --449:             rfd_fv0_MultiWrite(i_u4_Start, i_u2_Length, i_pu4_Data);
                         537 --450:         }
                         538 --451:         /* Writing length is 32bytes */
                         539 --452:         else if (i_u2_Length == R_RFD_LENGTH_DATA_32BYTES)  /* !CERT-C rule INT02 (QAC message 2101) */
                         540 --453:         {
                         541 --454:             rfd_fv0_MultiWrite(i_u4_Start, i_u2_Length, i_pu4_Data);
                         542 --455:         }
                         543 --456:         /* Writing length is 64bytes */
                         544 --457:         else if (i_u2_Length == R_RFD_LENGTH_DATA_64BYTES)  /* !CERT-C rule INT02 (QAC message 2101) */
                         545 --458:         {
                         546 --459:             rfd_fv0_MultiWrite(i_u4_Start, i_u2_Length, i_pu4_Data);
                         547 --460:         }
                         548 --461:         /* Writing length is 128bytes */
                         549 --462:         else if (i_u2_Length == R_RFD_LENGTH_DATA_128BYTES) /* !CERT-C rule INT02 (QAC message 2101) */
                         550 --463:         {
