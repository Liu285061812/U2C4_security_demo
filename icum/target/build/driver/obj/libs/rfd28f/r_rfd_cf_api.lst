                        4461 --1785: **********************************************************************************************************************/
                        4462 --1787: void
                        4463 --1788: R_RFD_WriteSwitchRequest(T_pu4_RfdBuffer i_pu4_Data)
                        4464 --1789: {
                        4465 --1790:     /* !MISRA-C 2012 rule 8.13 (QAC message 3673) */
                        4466 --1791:     /* !CERT-C rule DCL00 (QAC message 3227)      */
                        4467 --1792:     
                        4468 --1793:     /* Definition of the local variables */
                        4469 --1794:     T_u1    l_bu1_writingCount;     /* Number of writes               */ /* !CERT-C rule DCL00 (QAC message 3204) */
                        4470 --1795:     T_u4    l_bu4_loopCount;        /* loop count for "for statement" */
                        4471 --1796:     
                        4472 --1797:     /* Initialization of the local variables  */
                        4473 --1798:     l_bu1_writingCount = (T_u1)(R_RFD_LENGTH_SWITCH_AREA_WRITE >> R_RFD_CONVERT_TO_WRITING_COUNT);
                        4474 --1799:     l_bu4_loopCount    = 0U;
                        4475 --1800:     
                        4476 --1801:     
                        4477 --1802:     /* Switch the FACI base address and FACI command issue area */
                        4478 --1803:     /* Switch Area is FACI0                                     */
                        4479 --1804:     rfd_fv0_SetFaci(R_RFD_FACI0);
                        4480 --1805:         
                        4481 --1806:     
                        4482 --1807:     
                        4483 --1808:     /* Set start address */
                        4484 --1809:     R_RFD_REG_FSADDR = R_RFD_CVA_ADDRESS;               /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4485 --1810:     
                        4486 --1811:     /* Issue the switch erasure command */
                        4487 --1812:     R_RFD_CMD_ISSUING_AREA = R_RFD_CMD_SWITCH_WRITE;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4488 --1813:     
                        4489 --1814:     /* Write the writing count */
                        4490 --1815:     R_RFD_CMD_ISSUING_AREA = l_bu1_writingCount;        /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4491 --1816:     
                        4492 --1817:     
                        4493 --1818:     /* Write to the Switch Area */
                        4494 --1819:     for (l_bu4_loopCount = 0U; l_bu4_loopCount < l_bu1_writingCount; l_bu4_loopCount++)
                        4495 --1820:     {                                                   /* !CERT-C rule INT02 (QAC message 2100)      */
                        4496 --1821:         R_RFD_CMD_ISSUING_AREA_4BYTE = i_pu4_Data[l_bu4_loopCount];
                        4497 --1822:                                                         /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4498 --1823:     }
                        4499 --1824:     
                        4500 --1825:     /* Issue the run command */
                        4501 --1826:     R_RFD_CMD_ISSUING_AREA = R_RFD_CMD_RUN;             /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4502 --1827:     
                        4503 --1828:     return;
                        4504 --1829:     

