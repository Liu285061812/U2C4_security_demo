                        6734 --2032:     }
                        6735 --2033:     /* Erasure-priority mode */
                        6736 --2034:     else if (R_RFD_ERASURE_SUSPENDED_MODE == R_RFD_ERASURE_PRIORITY_MODE)
                        6737 --2035:     {
                        6738 --2036:         R_RFD_REG_FCPSR = R_RFD_VALUE_FCPSR_ERSPRI_MODE;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        6739 --2037:     }
                        6740 --2038:     /* No having a mode */
                        6741 --2039:     else
                        6742 --2040:     {
