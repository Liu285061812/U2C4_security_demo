                        4326 --1648: /**********************************************************************************************************************
                        4327 --1649: **  Function Name   : R_RFD_EraseSwitchRequest
                        4328 --1650: **  
                        4329 --1651: **  - Outline
                        4330 --1652: **      Erases the contents of the Switch Area on the back side (invalid side)
                        4331 --1653: **  - Format
                        4332 --1654: **      void
                        4333 --1655: **          R_RFD_EraseSwitchRequest(void);
                        4334 --1656: **  - Input parameter
                        4335 --1657: **      non input parameter
                        4336 --1658: **  - Return
                        4337 --1659: **      R_RFD_OK               : Normal End
                        4338 --1660: **      R_RFD_ERR_SWITCH_DATA  : VAPC value in the TAG Area is not correct
                        4339 --1661: **                               SEDF bit or DEDF bit in the DFERSTR is valid
                        4340 --1662: **  - Preconditions
                        4341 --1663: **      The state of the flash memory must be the READY state
                        4342 --1664: **      The flash access status must not be the command-locked state
                        4343 --1665: **      The FACI mode must be the data flash P/E mode
                        4344 --1666: **      The Tag Update command must be completed normally
                        4345 --1667: **  
                        4346 --1668: **  - Traceability        : [Covers:UD_03_150]
                        4347 --1669: **********************************************************************************************************************/
                        4348 --1671: T_u4_RFDReturn
                        4349 --1672: R_RFD_EraseSwitchRequest(void)
                        4350 --1673: {
                        4351 --1674:     /* Definition of the local variables */
                        4352 --1675:     T_u4_RFDReturn  l_bu4_returnValue;  /* Return value for this function   */
                        4353 --1676:     T_bl            l_bl1_errorFlag;    /* Error flag                       */
                        4354 --1677:     T_u4            l_bu4_TagVAPC;      /* Value of VAPC in TAG Area        */
                        4355 --1678:     
                        4356 --1679:     /* Initialization of the local variables  */
                        4357 --1680:     l_bu4_returnValue = R_RFD_OK;
                        4358 --1681:     l_bl1_errorFlag   = R_RFD_FALSE;
                        4359 --1682:     l_bu4_TagVAPC     = 0U;
                        4360 --1683:     
                        4361 --1684:     
                        4362 --1685:     /* Beginning of the Critical Section */
                        4363 --1686:     R_RFD_HOOK_EnterCriticalSection();
                        4364 --1687:     
                        4365 --1688:     /* Switch the FACI base address and FACI command issue area */
                        4366 --1689:     /* Switch Area is FACI0                                     */
                        4367 --1690:     rfd_fv0_SetFaci(R_RFD_FACI0);
                        4368 --1691:     
                        4369 --1692:     #ifndef    __RH850_PROVIDED_MULTI_STAGE_ADDRESS_BUFFER__
                        4370 --1693:         /* Valid the R_RFD_VALUE_DFERSTC_ERRCLR */
                        4371 --1694:         R_RFD_REG_DFERSTC = R_RFD_VALUE_DFERSTC_ERRCLR;     /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4372 --1695:     #else
                        4373 --1696:         /* Valid the R_RFD_VALUE_DFSERSTC_SSTCLR */
                        4374 --1697:         R_RFD_REG_DFSERSTC = R_RFD_VALUE_DFSERSTC_SSTCLR;   /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4375 --1698:         
                        4376 --1699:         /* Valid the R_RFD_VALUE_DFDERSTC_DSTCLR */
                        4377 --1700:         R_RFD_REG_DFDERSTC = R_RFD_VALUE_DFDERSTC_DSTCLR;   /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4378 --1701:     #endif  /* __RH850_PROVIDED_MULTI_STAGE_ADDRESS_BUFFER__ */
                        4379 --1702:     
                        4380 --1703:     /* Read value from VAPC in TAG Area */
                        4381 --1704:     l_bu4_TagVAPC = R_RFD_FLAG_TAGVAPC;                 /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4382 --1705:     

                                                                      Page 74
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000e781.si
                        4383 --1706:     /* Check ECC 2bit Error or 1bit Error is occurred */
                        4384 --1707:     l_bl1_errorFlag = rfd_fbl_CheckDFEccError();
                        4385 --1708:     
                        4386 --1709:     /* ECC 2bit Error or 1bit Error is NOT occurred */
                        4387 --1710:     if (l_bl1_errorFlag == R_RFD_FALSE)     /* !CERT-C rule INT02 (QAC message 2100) */
                        4388 --1711:     {
                        4389 --1712:         /* VAPC value in the TAG is NOT written completely */
                        4390 --1713:         if (l_bu4_TagVAPC != R_RFD_VALUE_WRITTEN_COMPLETELY)
                        4391 --1714:         {
                        4392 --1715:             /* There is a not completed data */
                        4393 --1716:             l_bl1_errorFlag = R_RFD_TRUE;
                        4394 --1717:             
                        4395 --1718:             /* Set Return value */
                        4396 --1719:             l_bu4_returnValue = R_RFD_ERR_SWITCH_DATA;
                        4397 --1720:         }
                        4398 --1721:         /* VAPC value in the TAG is written completely */
                        4399 --1722:         else
                        4400 --1723:         {
                        4401 --1724:             /* no operation */
                        4402 --1725:         }
                        4403 --1726:     } /* if (l_bl1_errorFlag == R_RFD_FALSE) */
                        4404 --1727:     
                        4405 --1728:     /* ECC 2bit Error or 1bit Error is occurred */
                        4406 --1729:     else
                        4407 --1730:     {
                        4408 --1731:         /* There is a not completed data */
                        4409 --1732:         l_bl1_errorFlag = R_RFD_TRUE;
                        4410 --1733:         
                        4411 --1734:         /* Set Return value */
                        4412 --1735:         l_bu4_returnValue = R_RFD_ERR_SWITCH_DATA;
                        4413 --1736:     }
                        4414 --1737:     
                        4415 --1738:     /* End of the Critical Section */
                        4416 --1739:     R_RFD_HOOK_ExitCriticalSection();
                        4417 --1740:     
                        4418 --1741:     
                        4419 --1742:     if (l_bl1_errorFlag == R_RFD_FALSE)     /* !CERT-C rule INT02 (QAC message 2100) */
                        4420 --1743:     {
                        4421 --1744:         
                        4422 --1745:         /* Set start address */
                        4423 --1746:         R_RFD_REG_FSADDR = R_RFD_SWA_BASE_FACI0;                /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4424 --1747:         
                        4425 --1748:         /* Issue the switch erasure command */
                        4426 --1749:         R_RFD_CMD_ISSUING_AREA = R_RFD_CMD_SWITCH_ERASE;        /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4427 --1750:         
                        4428 --1751:         /* Issue the run command */
                        4429 --1752:         R_RFD_CMD_ISSUING_AREA = R_RFD_CMD_RUN;                 /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        4430 --1753:         
                        4431 --1754:     } /* if (l_bl1_errorFlag == R_RFD_FALSE) */
                        4432 --1755:     
                        4433 --1756:     else
                        4434 --1757:     {
                        4435 --1758:         /* no operation */
                        4436 --1759:     }
                        4437 --1760:     
                        4438 --1761:     return(l_bu4_returnValue);
                        4439 --1762:     
                        4440 --1763: }
