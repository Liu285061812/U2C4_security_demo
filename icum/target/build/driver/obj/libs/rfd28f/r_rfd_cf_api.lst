                        3317 --1594:     l_bu1_writingCount = (T_u1)(R_RFD_LENGTH_PROPERTY_WRITE >> R_RFD_CONVERT_TO_WRITING_COUNT);
                        3318 --1595:     l_bu4_loopCount    = 0U;
