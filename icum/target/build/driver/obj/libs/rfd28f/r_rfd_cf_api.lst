                        6710 --2008: void
                        6711 --2009: R_RFD_EraseExtendedDataRequest(T_u4_RfdAddress i_u4_Start)
                        6712 --2010: {
                        6713 --2011:     /* !CERT-C rule DCL00 (QAC message 3227) */
                        6714 --2012:     
                        6715 --2013:     /* Definition of the local variables */
                        6716 --2014:     
                        6717 --2015:     /* No local variables         */
                        6718 --2016:     
                        6719 --2017:     /* Initialization of the local variables */
                        6720 --2018:     
                        6721 --2019:     /* No local variables             */
                        6722 --2020:     
                        6723 --2021:     
                        6724 --2022:     /* Switch the FACI base address and FACI command issue area */
                        6725 --2023:     /* Switch Area is FACI0                                     */
                        6726 --2024:     rfd_fv0_SetFaci(R_RFD_FACI0);
                        6727 --2025:     
                        6728 --2026:     
                        6729 --2027:     /* Flash Sequencer Process Switch Register */
                        6730 --2028:     /* Suspension-priority mode */
                        6731 --2029:     if (R_RFD_ERASURE_SUSPENDED_MODE == R_RFD_SUSPENSION_PRIORITY_MODE)
                        6732 --2030:     {
