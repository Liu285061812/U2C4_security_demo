                        3310 --1587:     T_bl        l_bl1_errorFlag;    /* Error flag                     */
                        3311 --1588:     T_u1        l_bu1_writingCount; /* Number of writes               */ /* !CERT-C rule DCL00 (QAC message 3204) */
                        3312 --1589:     T_u4        l_bu4_loopCount;    /* loop count for "for statement" */
                        3313 --1590:     T_u2_FACI   l_bu2_targetFaci;   /* Target FACI  */
                        3314 --1591:     
                        3315 --1592:     /* Initialization of the local variables  */
