                         771 --636: **  Function Name   : R_RFD_EraseCFRequest
                         772 --637: **  
                         773 --638: **  - Outline
                         774 --639: **      Erases the contents of the code flash memory
                         775 --640: **  - Format
                         776 --641: **      void
                         777 --642: **          R_RFD_EraseCFRequest(
                         778 --643: **              T_u4_RfdAddress  i_u4_Start
                         779 --644: **          );

                                                                      Page 14
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000e781.si
                         780 --645: **  - Input parameter
                         781 --646: **      i_u4_Start        : Start address of the erasure area
                         782 --647: **  - Return
                         783 --648: **      non return value
                         784 --649: **  - Preconditions
                         785 --650: **      The state of the flash memory must be the READY state
                         786 --651: **      The flash access status must not be the command-locked state
                         787 --652: **      The FACI mode must be the code flash P/E mode
                         788 --653: **  
                         789 --654: **  - Traceability        : [Covers:UD_03_110]
                         790 --655: **********************************************************************************************************************/
                         791 --657: void
                         792 --658: R_RFD_EraseCFRequest(T_u4_RfdAddress i_u4_Start)
                         793 --659: {
                         794 --660:     /* !CERT-C rule DCL00 (QAC message 3227) */
                         795 --661:     
                         796 --662:     /* Definition of the local variables */
                         797 --663:     T_u2_FACI       l_bu2_targetFaci;   /* Target FACI  */
                         798 --664:     
                         799 --665:     /* Initialization of the local variables  */
                         800 --666:     l_bu2_targetFaci = 0U;
                         801 --667:     
                         802 --668:     
                         803 --669:     /* Acquire FACI number */
                         804 --670:     l_bu2_targetFaci = R_RFD_CFAddressToFaciNumber(i_u4_Start);
                         805 --671:     
                         806 --672:     /* If target FACI is Valid */
                         807 --673:     if (l_bu2_targetFaci != R_RFD_INVALID_FACI)     /* !CERT-C rule INT02 (QAC message 2101) */
                         808 --674:     {
                         809 --675:         /* Switch the FACI base address and FACI command issue area */
                         810 --676:         rfd_fv0_SetFaci(l_bu2_targetFaci);
                         811 --677:         
                         812 --678:         
                         813 --679:         /* Flash Sequencer Process Switch Register */
                         814 --680:         /* Suspension-priority mode */
                         815 --681:         if (R_RFD_ERASURE_SUSPENDED_MODE == R_RFD_SUSPENSION_PRIORITY_MODE)
                         816 --682:         {
                         817 --683:             R_RFD_REG_FCPSR = R_RFD_VALUE_FCPSR_SUSPRI_MODE;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                         818 --684:         }
                         819 --685:         /* Erasure-priority mode */
                         820 --686:         else if (R_RFD_ERASURE_SUSPENDED_MODE == R_RFD_ERASURE_PRIORITY_MODE)
                         821 --687:         {
                         822 --688:             R_RFD_REG_FCPSR = R_RFD_VALUE_FCPSR_ERSPRI_MODE;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                         823 --689:         }
                         824 --690:         /* No having a mode */
                         825 --691:         else
                         826 --692:         {
                         827 --693:             /* no operation */
                         828 --694:         }
                         829 --695:         
                         830 --696:         /* 1 sector erasure */
                         831 --697:         rfd_fv0_SingleErase(i_u4_Start);
                         832 --698:         
                         833 --699:     } /* if (l_bu2_targetFaci != R_RFD_INVALID_FACI) */
                         834 --700:     
                         835 --701:     /* If target FACI is NOT Valid */
                         836 --702:     else
                         837 --703:     {
                         838 --704:         /* no operation */
                         839 --705:     }
                         840 --706:     

                                                                      Page 15
