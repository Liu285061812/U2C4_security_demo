                        2611 --846:     
                        2612 --847:     
                        2613 --848:     /**********************************************************************************************
                        2614 --849:      *  Check whether the FACI has already been P/E mode.
                        2615 --850:      *  If the FACI is P/E mode, shift to the P/E mode to Read mode
                        2616 --851:      *  by issuing R_RFD_ForcedStopAndErrorClear
                        2617 --852:      *********************************************************************************************/
                        2618 --853:      
                        2619 --854:     /* Whether FACI0 data flash memory has already been check P/E mode   */
                        2620 --855:     /* At this point, R_RFD_CheckPEMode is not return "R_RFD_ERR_NOFACI" */
                        2621 --856:     l_bu4_returnInternal = R_RFD_CheckPEMode(i_u2_TargetFACI, R_RFD_MODE_READ);
                        2622 --857:     
                        2623 --858:     if (l_bu4_returnInternal == R_RFD_STS_BUSY)
                        2624 --859:     {
                        2625 --860:         /* Force stop */
                        2626 --861:         l_bu4_returnInternal = R_RFD_ForcedStopAndErrorClear(i_u2_TargetFACI);
                        2627 --862:         
                        2628 --863:         if (l_bu4_returnInternal == R_RFD_ERR_INTERNAL_HW)
                        2629 --864:         {
                        2630 --865:             /* Set return value */
                        2631 --866:             l_bu4_returnValue = R_RFD_ERR_INTERNAL_HW;
                        2632 --867:             l_bl1_errorFlag   = R_RFD_TRUE;
                        2633 --868:         }
                        2634 --869:         else
                        2635 --870:         {
                        2636 --871:             /* At this point, R_RFD_ForcedStopAndErrorClear is not return "R_RFD_ERR_NOFACI" */
                        2637 --873:             /* Shift to read mode */
                        2638 --874:             l_bu4_returnInternal = R_RFD_ShiftToReadMode(i_u2_TargetFACI);
                        2639 --875:             
                        2640 --876:             if (l_bu4_returnInternal == R_RFD_ERR_INTERNAL_HW)
                        2641 --877:             {
                        2642 --878:                 /* Set return value */
                        2643 --879:                 l_bu4_returnValue = R_RFD_ERR_INTERNAL_HW;
                        2644 --880:                 l_bl1_errorFlag   = R_RFD_TRUE;
                        2645 --881:             }
                        2646 --882:             else
                        2647 --883:             {
                        2648 --884:                 /* no operation */
                        2649 --885:             }
                        2650 --886:         }
                        2651 --887:     } /* if (l_bu4_returnInternal == R_RFD_STS_BUSY) */
                        2652 --888:     
                        2653 --889:     else
                        2654 --890:     {
                        2655 --891:         /* no operation */

                                                                      Page 45
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010dg1.si
                        2656 --892:     }
                        2657 --893:     
                        2658 --894:     if (l_bl1_errorFlag == R_RFD_FALSE) /* !CERT-C rule INT02 (QAC message 2100) */
                        2659 --895:     {
                        2660 --896:         /* Set the value for FAEINT register */
                        2661 --897:         R_RFD_REG_FAEINT = (T_u1)R_RFD_VALUE_FAEINT;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        2662 --898:                                                         /* !CERT-C rule INT02 (QAC message 2100)      */
                        2663 --899:                 
                        2664 --900:     } /* if (l_bl1_errorFlag == R_RFD_FALSE) */
                        2665 --901:     
                        2666 --902:     else
                        2667 --903:     {
                        2668 --904:         /* no operation */
                        2669 --905:     }
                        2670 --906:     
                        2671 --907:     return(l_bu4_returnValue);
                        2672 --908:     
                        2673 --909: }
