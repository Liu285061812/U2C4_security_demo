                        4317 --822: **  - Return
                        4318 --823: **      R_RFD_OK                    : Normal End
                        4319 --824: **      R_RFD_ERR_INTERNAL_HW       : Internal Hardware error
                        4320 --825: **  - Preconditions
                        4321 --826: **      No preconditions

                                                                      Page 73
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010dg1.si
                        4322 --827: **  
                        4323 --828: **  - Traceability          : [Covers:UD_01_320]
                        4324 --829: **********************************************************************************************************************/
                        4325 --831: T_u4_RFDReturn
                        4326 --832: rfd_fu4_InitFACI(T_u2_FACI i_u2_TargetFACI)
                        4327 --833: {
                        4328 --834:     /* !QAC(RCMA) message 1505               */
                        4329 --835:     /* !CERT-C rule DCL00 (QAC message 3227) */
                        4330 --836:     
                        4331 --837:     /* Definition of the local variables */
                        4332 --838:     T_u4_RFDReturn  l_bu4_returnValue;      /* Return value for this function       */
                        4333 --839:     T_u4_RFDReturn  l_bu4_returnInternal;   /* Return value for calling function    */
                        4334 --840:     T_bl            l_bl1_errorFlag;        /* Error flag                           */
                        4335 --841:     
                        4336 --842:     /* Initialization of the local variables */
                        4337 --843:     l_bu4_returnValue    = R_RFD_OK;
                        4338 --844:     l_bu4_returnInternal = R_RFD_OK;
                        4339 --845:     l_bl1_errorFlag      = R_RFD_FALSE;
                        4340 --846:     
                        4341 --847:     
                        4342 --848:     /**********************************************************************************************
                        4343 --849:      *  Check whether the FACI has already been P/E mode.
                        4344 --850:      *  If the FACI is P/E mode, shift to the P/E mode to Read mode
                        4345 --851:      *  by issuing R_RFD_ForcedStopAndErrorClear
                        4346 --852:      *********************************************************************************************/
                        4347 --853:      
                        4348 --854:     /* Whether FACI0 data flash memory has already been check P/E mode   */
                        4349 --855:     /* At this point, R_RFD_CheckPEMode is not return "R_RFD_ERR_NOFACI" */
                        4350 --856:     l_bu4_returnInternal = R_RFD_CheckPEMode(i_u2_TargetFACI, R_RFD_MODE_READ);
                        4351 --857:     
                        4352 --858:     if (l_bu4_returnInternal == R_RFD_STS_BUSY)
                        4353 --859:     {
                        4354 --860:         /* Force stop */
                        4355 --861:         l_bu4_returnInternal = R_RFD_ForcedStopAndErrorClear(i_u2_TargetFACI);
                        4356 --862:         
                        4357 --863:         if (l_bu4_returnInternal == R_RFD_ERR_INTERNAL_HW)
                        4358 --864:         {
                        4359 --865:             /* Set return value */
                        4360 --866:             l_bu4_returnValue = R_RFD_ERR_INTERNAL_HW;
                        4361 --867:             l_bl1_errorFlag   = R_RFD_TRUE;
                        4362 --868:         }
                        4363 --869:         else
                        4364 --870:         {
                        4365 --871:             /* At this point, R_RFD_ForcedStopAndErrorClear is not return "R_RFD_ERR_NOFACI" */
                        4366 --873:             /* Shift to read mode */
                        4367 --874:             l_bu4_returnInternal = R_RFD_ShiftToReadMode(i_u2_TargetFACI);
                        4368 --875:             
                        4369 --876:             if (l_bu4_returnInternal == R_RFD_ERR_INTERNAL_HW)
                        4370 --877:             {
                        4371 --878:                 /* Set return value */
                        4372 --879:                 l_bu4_returnValue = R_RFD_ERR_INTERNAL_HW;
                        4373 --880:                 l_bl1_errorFlag   = R_RFD_TRUE;
                        4374 --881:             }
