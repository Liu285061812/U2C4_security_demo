                         925 --933: T_u4_RFDReturn
                         926 --934: rfd_fu4_ReleaseCommandLock(T_u2_FACI i_u2_TargetFACI)
                         927 --935: {
                         928 --936:     /* !QAC(RCMA) message 1505               */
                         929 --937:     /* !CERT-C rule DCL00 (QAC message 3227) */
                         930 --938:     
                         931 --939:     /* Definition of the local variables */
                         932 --940:     T_u4_RFDReturn  l_bu4_returnValue;      /* Return value for this function */
                         933 --941:     T_u4            l_bu4_FSTATR;           /* FSTATR register value          */
                         934 --942:     T_bl            l_bl1_errorFlag;        /* Error flag                     */
                         935 --943:     
                         936 --944:     /* Initialization of the local variables */
                         937 --945:     l_bu4_returnValue   = R_RFD_OK;
                         938 --946:     l_bu4_FSTATR        = 0U;
                         939 --947:     l_bl1_errorFlag     = R_RFD_FALSE;
                         940 --948:     
                         941 --949:     
                         942 --950:     /* Check the FACI number */
                         943 --951:     l_bu4_returnValue = rfd_fu4_CheckFaciNumber(i_u2_TargetFACI);
                         944 --952:     
                         945 --953:     if (l_bu4_returnValue == R_RFD_ERR_NOFACI)
                         946 --954:     {
                         947 --955:         /* Specified FACI is nonexistence (Set return value) */
                         948 --956:         l_bl1_errorFlag = R_RFD_TRUE;
                         949 --957:     }
                         950 --958:     else
                         951 --959:     {
                         952 --960:         /* no operation */
                         953 --961:     }
                         954 --962:     
                         955 --963:     if (l_bl1_errorFlag == R_RFD_FALSE) /* !CERT-C rule INT02 (QAC message 2100) */
                         956 --964:     {
