                        1571 --1597: /**********************************************************************************************************************
                        1572 --1598: **  Function Name   : R_RFD_SuspendPERequest
                        1573 --1599: **  
                        1574 --1600: **  - Outline
                        1575 --1601: **      Checks whether suspending the processing of the target FACI can be accepted

                                                                      Page 27
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010dg1.si
                        1576 --1602: **  - Format
                        1577 --1603: **      T_u4_RFDReturn
                        1578 --1604: **          R_RFD_SuspendPERequest(
                        1579 --1605: **              T_u2_FACI     i_u2_TargetFACI
                        1580 --1606: **          );
                        1581 --1607: **  - Input parameter
                        1582 --1608: **      i_u2_TargetFACI       : Target FACI whose processing is to be suspended
                        1583 --1609: **  - Return
                        1584 --1610: **      R_RFD_OK              : FRDY bit of the FSTATR_n register is valid at this point
                        1585 --1611: **      R_RFD_STS_BUSY        : SUSRDY bit of the FSTATR_n register value is valid
                        1586 --1612: **      R_RFD_ERR_REJECT      : SUSRDY bit of the FSTATR_n register value is invalid
                        1587 --1613: **      R_RFD_ERR_NOFACI      : Specified FACI is nonexistence
                        1588 --1614: **  - Preconditions
                        1589 --1615: **      The FACI mode must be the code flash P/E mode or data flash P/E mode
                        1590 --1616: **      The flash access status must not be the command-locked state
                        1591 --1617: **  
                        1592 --1618: **  - Traceability            : [Covers:UD_01_180]
                        1593 --1619: **********************************************************************************************************************/
                        1594 --1621: T_u4_RFDReturn
                        1595 --1622: R_RFD_SuspendPERequest(T_u2_FACI i_u2_TargetFACI)
                        1596 --1623: {
                        1597 --1624:     /* !CERT-C rule DCL00 (QAC message 3227) */
                        1598 --1625:     
                        1599 --1626:     /* Definition of the local variables */
                        1600 --1627:     T_u4_RFDReturn  l_bu4_returnValue;      /* Return value for this function */
                        1601 --1628:     T_u4            l_bu4_FSTATR;           /* FSTATR register value          */
                        1602 --1629:     T_bl            l_bl1_errorFlag;        /* Error flag                     */
                        1603 --1630:     
                        1604 --1631:     /* Initialization of the local variables  */
                        1605 --1632:     l_bu4_returnValue   = R_RFD_OK;
                        1606 --1633:     l_bu4_FSTATR        = 0U;
                        1607 --1634:     l_bl1_errorFlag     = R_RFD_FALSE;
                        1608 --1635:     
                        1609 --1636:     
                        1610 --1637:     /* Check FACI number */
                        1611 --1638:     l_bu4_returnValue = rfd_fu4_CheckFaciNumber(i_u2_TargetFACI);
                        1612 --1639:     
                        1613 --1640:     if (l_bu4_returnValue == R_RFD_ERR_NOFACI)
                        1614 --1641:     {
                        1615 --1642:         /* Specified FACI is nonexistence */
                        1616 --1643:         l_bl1_errorFlag = R_RFD_TRUE;
                        1617 --1644:     }
                        1618 --1645:     else
                        1619 --1646:     {
                        1620 --1647:         /* no operation */
                        1621 --1648:     }
                        1622 --1649:     
                        1623 --1650:     if (l_bl1_errorFlag == R_RFD_FALSE)     /* !CERT-C rule INT02 (QAC message 2100) */
                        1624 --1651:     {
                        1625 --1652:         /* Switch the FACI base address and FACI command issue area */
                        1626 --1653:         rfd_fv0_SetFaci(i_u2_TargetFACI);
                        1627 --1654:         
                        1628 --1655:         /* Acquire the FSTATR register value */
                        1629 --1656:         l_bu4_FSTATR = R_RFD_REG_FSTATR;                    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        1630 --1658:         /* Check the FRDY bit of FSTATR register */
                        1631 --1659:         if ((l_bu4_FSTATR & R_RFD_MASK_FSTATR_FRDY) != 0UL)
                        1632 --1660:         {
                        1633 --1661:             /* Set return value */
                        1634 --1662:             l_bu4_returnValue = R_RFD_OK;
                        1635 --1663:         }
                        1636 --1664:         else

                                                                      Page 28
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010dg1.si
                        1637 --1665:         {
                        1638 --1666:             /* Check the SUSRDY bit of FSTATR register */
                        1639 --1667:             /* SUSRDY bit is valid */
                        1640 --1668:             if ((l_bu4_FSTATR & R_RFD_MASK_FSTATR_SUSRDY) != 0UL)
                        1641 --1669:             {
                        1642 --1670:                 R_RFD_CMD_ISSUING_AREA = R_RFD_CMD_SUSPEND; /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                        1643 --1671:                 /* Set return value */
                        1644 --1672:                 l_bu4_returnValue = R_RFD_STS_BUSY;
                        1645 --1673:             }
                        1646 --1674:             /* SUSRDY bit is invalid */
                        1647 --1675:             else
                        1648 --1676:             {
                        1649 --1677:                 /* Set return value */
                        1650 --1678:                 l_bu4_returnValue = R_RFD_ERR_REJECT;
                        1651 --1679:             }
                        1652 --1680:         }
                        1653 --1681:         
                        1654 --1682:     } /* if (l_bl1_errorFlag == R_RFD_FALSE) */
