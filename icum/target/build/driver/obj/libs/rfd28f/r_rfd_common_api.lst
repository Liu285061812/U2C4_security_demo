                         841 --846:     
                         842 --847:     
                         843 --848:     /**********************************************************************************************

                                                                      Page 15
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010dg1.si
                         844 --849:      *  Check whether the FACI has already been P/E mode.
                         845 --850:      *  If the FACI is P/E mode, shift to the P/E mode to Read mode
                         846 --851:      *  by issuing R_RFD_ForcedStopAndErrorClear
                         847 --852:      *********************************************************************************************/
                         848 --853:      
                         849 --854:     /* Whether FACI0 data flash memory has already been check P/E mode   */
                         850 --855:     /* At this point, R_RFD_CheckPEMode is not return "R_RFD_ERR_NOFACI" */
                         851 --856:     l_bu4_returnInternal = R_RFD_CheckPEMode(i_u2_TargetFACI, R_RFD_MODE_READ);
                         852 --857:     
                         853 --858:     if (l_bu4_returnInternal == R_RFD_STS_BUSY)
                         854 --859:     {
                         855 --860:         /* Force stop */
                         856 --861:         l_bu4_returnInternal = R_RFD_ForcedStopAndErrorClear(i_u2_TargetFACI);
                         857 --862:         
                         858 --863:         if (l_bu4_returnInternal == R_RFD_ERR_INTERNAL_HW)
                         859 --864:         {
                         860 --865:             /* Set return value */
                         861 --866:             l_bu4_returnValue = R_RFD_ERR_INTERNAL_HW;
                         862 --867:             l_bl1_errorFlag   = R_RFD_TRUE;
                         863 --868:         }
                         864 --869:         else
                         865 --870:         {
                         866 --871:             /* At this point, R_RFD_ForcedStopAndErrorClear is not return "R_RFD_ERR_NOFACI" */
                         867 --873:             /* Shift to read mode */
                         868 --874:             l_bu4_returnInternal = R_RFD_ShiftToReadMode(i_u2_TargetFACI);
                         869 --875:             
                         870 --876:             if (l_bu4_returnInternal == R_RFD_ERR_INTERNAL_HW)
                         871 --877:             {
                         872 --878:                 /* Set return value */
                         873 --879:                 l_bu4_returnValue = R_RFD_ERR_INTERNAL_HW;
                         874 --880:                 l_bl1_errorFlag   = R_RFD_TRUE;
                         875 --881:             }
                         876 --882:             else
                         877 --883:             {
                         878 --884:                 /* no operation */
                         879 --885:             }
                         880 --886:         }
                         881 --887:     } /* if (l_bu4_returnInternal == R_RFD_STS_BUSY) */
                         882 --888:     
                         883 --889:     else
                         884 --890:     {
                         885 --891:         /* no operation */
                         886 --892:     }
                         887 --893:     
                         888 --894:     if (l_bl1_errorFlag == R_RFD_FALSE) /* !CERT-C rule INT02 (QAC message 2100) */
                         889 --895:     {
                         890 --896:         /* Set the value for FAEINT register */
                         891 --897:         R_RFD_REG_FAEINT = (T_u1)R_RFD_VALUE_FAEINT;    /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                         892 --898:                                                         /* !CERT-C rule INT02 (QAC message 2100)      */
                         893 --899:                 
                         894 --900:     } /* if (l_bl1_errorFlag == R_RFD_FALSE) */
                         895 --901:     
                         896 --902:     else
                         897 --903:     {
                         898 --904:         /* no operation */
                         899 --905:     }
                         900 --906:     
                         901 --907:     return(l_bu4_returnValue);
                         902 --908:     
                         903 --909: }
