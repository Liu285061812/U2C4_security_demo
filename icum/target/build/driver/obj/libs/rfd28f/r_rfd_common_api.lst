                         958 --966:         rfd_fv0_SetFaci(i_u2_TargetFACI);
                         959 --968:         /* Acquire the FSTATR register value */
                         960 --969:         l_bu4_FSTATR = R_RFD_REG_FSTATR;        /* !MISRA-C 2012 rule 11.4 (QAC message 0303) */
                         961 --970:         
                         962 --971:         /* Check the FHVEERR bit of FSTATR register */
                         963 --972:         if ((l_bu4_FSTATR & R_RFD_MASK_FSTATR_FHVEERR) != 0UL)
                         964 --973:         {
                         965 --974:             /* When the FHVEERR bit is valid (Set return value) */

                                                                      Page 17
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010dg1.si
                         966 --975:             l_bu4_returnValue = R_RFD_ForcedStopAndErrorClear(i_u2_TargetFACI);
                         967 --976:         }
                         968 --977:         else
                         969 --978:         {
                         970 --979:             /* When the FHVEERR bit is invalid (Set return value) */
                         971 --980:             l_bu4_returnValue = R_RFD_StatusClear(i_u2_TargetFACI);
                         972 --981:         }
                         973 --982:     } /* if (l_bl1_errorFlag == R_RFD_FALSE) */
                         974 --983:     
                         975 --984:     else
                         976 --985:     {
                         977 --986:         /* no operation */
                         978 --987:     }
                         979 --988:     
                         980 --989:     return (l_bu4_returnValue);
                         981 --990:     
                         982 --991: }
