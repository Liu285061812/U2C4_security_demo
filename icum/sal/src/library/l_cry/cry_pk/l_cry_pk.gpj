[Merged Library]
    :binDirRelative=../../../../../target/${cfg_family}/build/library/out
    :outputDirRelative=../../../../../target/${cfg_family}/build/library/obj

    -o icum_l_cry_pk.a

    -I../../../../../generic/include/common
    -I../../../../../target/${cfg_family}/include/driver
    -I../../../../../../pe/generic/icumif
    -I../../../../include/library
    -I./cry_common
    -I./cry_pkc

    -section .text=.icum_library.text
    -section .rodata=.icum_library.rodata
    -section .bss=.icum_library.bss
    -section .data=.icum_library.data

##  -DR_CRYPT_BIGNUM_BITSIZE=${cfg_bignum_bitsize}
##  -DR_CRYPT_SMALLBIGNUM_BITSIZE=${cfg_smallbignum_bitsize}
    
    ## defines for TomFastMath customization
    -DTFM_ALREADY_SET
    ## -DTFM_NO_ASM
    -DTFM_TIMING_RESISTANT
    
    -DENDIAN_LITTLE
    -DENDIAN_32BITWORD
    ## -DLTC_SMALL_CODE
    -DLTC_RH850
    
./cry_bignum/icum_l_bignum.gpj  [Subproject]
./cry_hash/icum_l_hash.gpj    [Subproject]
./cry_ecc/icum_l_ecc.gpj     [Subproject]
./cry_pkc/icum_l_pkc.gpj        [Subproject]
./cry_pkc_cmn/icum_l_pkc_cmn.gpj [Subproject]
./cry_x_509/icum_l_x509.gpj    [Subproject]
./cry_common/icum_l_common.gpj  [Subproject]
