[Merged Library]
    :binDirRelative=../../../../target/${cfg_family}/build/library/out
    :outputDirRelative=../../../../target/${cfg_family}/build/library/obj

    -I../../../include/library
    -I../../../../generic/include/common
    -I../../../../generic/include/middle
    -I../../../../../pe/generic/icumif
    -I../../../../target/${cfg_family}/include/driver

    -section .text=.icum_library.text
    -section .rodata=.icum_library.rodata
    -section .bss=.icum_library.bss
    -section .data=.icum_library.data

    -o icum_l_toolbox.a

icum_l_toolbox.c
