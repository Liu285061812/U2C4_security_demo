[Merged Library]

	:binDirRelative=./target/${cfg_family}/build/out/

	-I${cfg_device_include}
	-I./target/${cfg_family}/include/device/
	-I./target/${cfg_family}/include/device/rfd

	-o ../../icumfw_lib/${lib_icumfw}

	-Omoredebug
	-G

	-I./target/${cfg_family}/src/driver/d_hash
	-I./target/${cfg_family}/include/driver
	-I./target/${cfg_family}/src/driver/d_fls
	-I${cfg_rfd_root}/include
	-I${cfg_rfd_root}/include/rfd
generic/src/kernel/icum_kernel.gpj		[Merged Library]
target/${cfg_family}/src/driver/icum_driver.gpj		[Merged Library]
sal/src/library/icum_library.gpj		[Merged Library]
#sal/src/salif/r_salif.gpj                               [Merged Library]
generic/src/middle/icum_middle.gpj		[Merged Library]
generic/src/service/icum_service.gpj		[Merged Library]
#target/${cfg_family}/src/startup/icum_startup.gpj      [Merged Library]
target/${cfg_family}/src/startup/icum_startup.gpj		[Merged Library]
