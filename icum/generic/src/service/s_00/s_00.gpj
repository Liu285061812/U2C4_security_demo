[Merged Library]
    :binDirRelative=../../../../target/${cfg_family}/build/service/out
    :outputDirRelative=../../../../target/${cfg_family}/build/service/obj

    -I../../../include/common/
    -I../../../../target/${cfg_family}/include/driver/
    -I../../../include/middle/
    -I../../../include/service/
    -I../../../include/kernel/
    -I../../../../sal/include/library/
#    -I../../../../sal/include/salif/
    -I../../../../../pe/generic/icumif/
    -I../

    -section .text=.icum_service.text
    -section .rodata=.icum_service.rodata
    -section .bss=.icum_service.bss
    -section .data=.icum_service.data

    -o icum_s_00.a
    -Osize 
    -inline_prologue 
    -prepare_dispose

